{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/services/",
        "http://localhost/services/web-design/",
        "http://localhost/pricing/",
        "http://localhost/contact/",
        "http://localhost/work/nest-and-rest-cleaning/",
        "http://localhost/guides/how-much-does-a-website-cost-in-toronto/",
        "http://localhost/web-design-scarborough/"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1800,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.02,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 100,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.98,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.97,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    }
  }
}
