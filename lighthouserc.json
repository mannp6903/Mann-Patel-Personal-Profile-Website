{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/services/",
        "http://localhost/services/web-design/",
        "http://localhost/pricing/",
        "http://localhost/contact/",
        "http://localhost/work/nest-and-rest-cleaning/",
        "http://localhost/guides/how-much-does-a-website-cost-in-toronto/",
        "http://localhost/web-design-scarborough/"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 100 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.98 }]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.97 }]
          }
        }
      ]
    }
  }
}
