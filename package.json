{
  "name": "mann-patel-personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "qa:captures": "node scripts/capture.mjs http://127.0.0.1:4321 qa-output/captures / /services/ /work/ /work/nest-and-rest-cleaning/ /about/ /contact/ /privacy/",
    "qa:lighthouse": "node scripts/lighthouse.mjs http://127.0.0.1:4321 / /services/ /work/nest-and-rest-cleaning/ /contact/",
    "images": "node scripts/make-images.mjs",
    "prelaunch": "node scripts/prelaunch-check.mjs",
    "preview:static": "npm run build && node scripts/export-static-preview.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
