# Copy to .env for local development. Never commit .env (this repository is public).
# In production on Cloudflare, secrets go in the dashboard (Workers & Pages → mann-patel-website → Settings →
# Variables and Secrets); the build settings are applied by `npm run build:cloudflare`.

# ── Site & indexing ─────────────────────────────────────────────
# Production origin, no trailing slash. Production uses https://mannpatel.me (set by scripts/build-cloudflare.mjs).
# Leave empty for local previews.
PUBLIC_SITE_URL=
# preview | production. "production" makes the build fail on unresolved "To confirm" items.
SITE_MODE=preview
# true only on the real production deploy. Previews stay noindex.
SITE_INDEXING=false
# node (local standalone server) | cloudflare
DEPLOY_TARGET=node

# ── Enquiry form delivery ───────────────────────────────────────
# cloudflare = email the owner through Cloudflare Email (production default, set in wrangler.jsonc;
#              needs Email Routing on mannpatel.me and ENQUIRY_TO_EMAIL = a verified destination)
# file    = save to .data/enquiries.jsonl (local testing only; refused in production)
# resend  = email the owner via Resend (optionally also POST to the webhook below)
# webhook = POST each enquiry as JSON to ENQUIRY_WEBHOOK_URL (e.g. a Google Apps Script → Sheet)
# none    = form reports "not connected" (honest 503)
ENQUIRY_DELIVERY=file
# Where owner notifications go (your inbox)
ENQUIRY_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Mann Patel <hello@example.ca>"
ENQUIRY_FROM_EMAIL=
# true = send the visitor an acknowledgement email (requires a verified sending domain)
ENQUIRY_ACKNOWLEDGE=false
RESEND_API_KEY=
ENQUIRY_WEBHOOK_URL=
# Shared secret used to sign webhook payloads (X-Signature header, HMAC-SHA256)
ENQUIRY_WEBHOOK_SECRET=

# ── Spam protection ─────────────────────────────────────────────
# Long random string; signs the form's time-check token. Optional: without it each build
# generates its own random secret.
FORM_TOKEN_SECRET=
# Optional Cloudflare Turnstile (both keys needed to enable)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public phone (Call / WhatsApp / Text buttons) ───────────────
# Your number, e.g. +16475550142. Keep it OUT of the repository: on Cloudflare set it as a
# BUILD variable (Workers & Pages → mann-patel-website → Settings → Build → Variables and secrets).
# The site shows it masked (647-55X-XXXX) and the buttons dial the full number. Empty = buttons hidden.
PUBLIC_CONTACT_PHONE=

# ── Analytics (off unless set) ──────────────────────────────────
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Loads only after the visitor accepts.
PUBLIC_GA4_ID=
