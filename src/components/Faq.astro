---
/** Frequently asked questions as accordions (native <details>, smooth height where supported). */
import { faqs } from '../data/faqs';
import Confirm from './Confirm.astro';
import Heading from './ui/Heading.astro';
import Icon from './ui/Icon.astro';

interface Props {
  id?: string;
  limit?: number;
  more?: boolean;
}
const { id = 'faq', limit, more = false } = Astro.props;
const items = typeof limit === 'number' ? faqs.slice(0, limit) : faqs;
// On phones a long list starts with the first few questions and a button for the rest.
const SHORT = 5;
const folds = items.length > SHORT + 1;
---

<section class="faq section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq__grid">
    <div class="faq__head stack" style="--stack: var(--s-5)">
      <p class="eyebrow">Questions</p>
      <Heading id={`${id}-title`} lines={['Straight', '<span class="accent">answers.</span>']} />
      <p class="muted" data-reveal>
        Something else on your mind? Ask it in your brief, or email me. I answer every message myself.
      </p>
      {
        more && (
          <a class="link-arrow" href="/services/#faq" data-reveal>
            All questions <Icon name="arrow" />
          </a>
        )
      }
    </div>
    <div class="faq__list" id={`${id}-list`} data-faq-list>
      {
        items.map((f, i) => (
          <details class:list={['acc', folds && i >= SHORT && 'acc--extra']} name={id} data-reveal style={`--d:${Math.min(i, SHORT) * 50}`}>
            <summary>
              <span>{f.q}</span>
              <span class="acc__plus" aria-hidden="true" />
            </summary>
            <div class="acc__body">
              <p>{f.a}</p>
              {f.confirm && <Confirm note={f.confirm} />}
            </div>
          </details>
        ))
      }
      {
        folds && (
          <button class="faq__all" type="button" aria-controls={`${id}-list`} aria-expanded="false" data-faq-all hidden>
            Show all {items.length} questions
            <span class="acc__plus" aria-hidden="true" />
          </button>
        )
      }
    </div>
  </div>
</section>

<script>
  // Phones only: fold the questions after the fifth behind one button. Without JavaScript all are shown.
  const mq = window.matchMedia('(max-width: 47.99em)');
  document.querySelectorAll<HTMLElement>('[data-faq-list]').forEach((list) => {
    const btn = list.querySelector<HTMLButtonElement>('[data-faq-all]');
    if (!btn) return;
    let opened = false;
    const apply = () => {
      const fold = mq.matches && !opened;
      list.classList.toggle('is-folded', fold);
      btn.hidden = !fold;
    };
    btn.addEventListener('click', () => {
      opened = true;
      btn.setAttribute('aria-expanded', 'true');
      apply();
      list.querySelector<HTMLElement>('.acc--extra summary')?.focus();
    });
    mq.addEventListener('change', apply);
    apply();
  });
</script>

<style>
  .faq__grid {
    display: grid;
    gap: var(--s-7);
  }
  .faq__head h2 {
    max-width: 10ch;
  }
  .faq__list:global(.is-folded) .acc--extra {
    display: none;
  }
  .faq__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    width: 100%;
    min-height: 3.5rem;
    padding-block: var(--s-3);
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--signal);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .faq__all[hidden] {
    display: none;
  }
  @media (min-width: 64em) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-8);
    }
    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>
