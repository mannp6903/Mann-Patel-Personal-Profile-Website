---
/**
 * Sticky header. Desktop: wordmark + Toronto clock, links, ⌘K quick menu, "Start a project".
 * Phones: a "Menu" button opens a focused side panel (native <dialog>: focus is contained,
 * Esc closes, focus returns). Without JavaScript the links show as a plain row instead.
 */
import { nav, primaryCta, profile } from '../data/site';
import { emailHref } from '../lib/contact';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import Wordmark from './ui/Wordmark.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const sheetLinks = [{ href: '/', label: 'Home' }, ...nav];
---

<header class="hdr" data-header>
  <div class="hdr__bar container">
    <a class="wordmark" href="/">
      <span class="visually-hidden">{profile.name}, home</span>
      <Wordmark class="wordmark__logo" />
    </a>

    <p class="hdr__clock num" aria-hidden="true">
      <span>TOR</span>
      <time data-clock>--:--</time>
    </p>

    <nav class="hdr__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="roll">
                  <span data-text={item.label}>{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <button class="qm-trigger" type="button" data-qm-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" />
        <span class="visually-hidden">Open quick menu</span>
        <kbd aria-hidden="true"><span data-mod>Ctrl</span> K</kbd>
      </button>
      <Button href={primaryCta.href} size="sm" class="hdr__cta">{primaryCta.label}</Button>
      <!-- Phones: the main action stays one tap away in the header. -->
      <Button href="/contact/" size="sm" class="hdr__cta-m">Contact</Button>
      <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false">
        <span class="menu-btn__lines" aria-hidden="true"><i></i><i></i></span>
        <span class="menu-btn__text">Menu</span>
      </button>
    </div>
  </div>

  <dialog class="sheet" id="site-menu" aria-label="Site menu" data-menu>
    <div class="sheet__inner">
      <div class="sheet__top">
        <p class="eyebrow">Explore</p>
        <button class="icon-btn" type="button" data-menu-close>
          <Icon name="close" />
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <nav aria-label="Menu">
        <ol class="sheet__links" role="list">
          {
            sheetLinks.map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== '/' || path === '/') ? 'page' : undefined}>
                  <span class="sheet__label">{item.label}</span>
                  <span class="sheet__indicator" aria-hidden="true"></span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="sheet__foot">
        <Button href={primaryCta.href} class="sheet__cta">{primaryCta.label}</Button>
        {profile.contact.email && (
          <a class="sheet__email" href={emailHref()!} aria-label={`Email Mann at ${profile.contact.email}`}>
            {profile.contact.email}
          </a>
        )}
        <p class="sheet__legal small subtle">
          <a href="/privacy/">Privacy</a><span aria-hidden="true">·</span><a href="/terms/">Terms</a>
        </p>
      </div>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Solid background once the page scrolls.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    // Mobile sheet.
    const sheet = header.querySelector<HTMLDialogElement>('[data-menu]')!;
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
    let closingTimer: ReturnType<typeof setTimeout> | undefined;
    const closeSheet = () => {
      if (!sheet.open || sheet.classList.contains('is-closing')) return;
      sheet.classList.add('is-closing');
      const done = () => {
        sheet.classList.remove('is-closing');
        sheet.close();
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else closingTimer = setTimeout(done, 240);
    };
    openBtn.addEventListener('click', () => {
      sheet.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    sheet.addEventListener('close', () => {
      clearTimeout(closingTimer);
      sheet.classList.remove('is-closing');
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeSheet();
    });
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', closeSheet);
    sheet.addEventListener('click', (event) => {
      if (event.target !== sheet) return;
      const bounds = sheet.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)
        closeSheet();
    });
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => sheet.close()));
    // Wider than a phone? The sheet is not needed.
    matchMedia('(min-width: 64em)').addEventListener('change', (e) => e.matches && sheet.open && sheet.close());

    // Mac users see ⌘, everyone else Ctrl.
    if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
      header.querySelectorAll('[data-mod]').forEach((el) => (el.textContent = '⌘'));
    }
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    /* The desktop layout depends on the header's own width in ems, so enlarged text
       (browser zoom or text size) falls back to the compact Menu layout instead of overflowing. */
    container: hdr / inline-size;
    height: var(--header-h);
    transition: background-color var(--t-base) var(--ease-out), border-color var(--t-base), backdrop-filter var(--t-base);
    border-bottom: 1px solid transparent;
    /* Holds still while the page underneath changes (view transitions in global.css). */
    view-transition-name: site-header;
  }
  /* Reading progress: a lime line along the bottom edge, driven by the scroll position (CSS only). */
  .hdr::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(0);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out);
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hdr::after {
        animation: read-progress linear both;
        animation-timeline: scroll(root block);
      }
      .hdr.is-scrolled::after {
        opacity: 1;
      }
    }
  }
  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }
  .hdr.is-scrolled {
    background: rgb(11 11 12 / 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .hdr__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  /* Wordmark: the outlined MΛNN PΛTEL logo (ui/Wordmark.astro), sized by its height. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  /* The logo is a child component, so these selectors reach it with :global(). */
  .wordmark :global(.wordmark__logo) {
    display: block;
    /* 11 px at 320 px wide (so the header fits beside Contact and Menu), 13 px from about 390 px. */
    height: clamp(0.6875rem, 3.4vw, 0.8125rem);
    width: auto;
    transition: opacity var(--t-fast) var(--ease-out);
  }
  .wordmark:hover :global(.wordmark__logo) {
    opacity: 0.72;
  }
  @media (min-width: 64em) {
    .wordmark :global(.wordmark__logo) {
      height: 0.875rem;
    }
  }

  .hdr__clock {
    display: none;
    gap: 0.6em;
    font-size: var(--fs-xs);
    color: var(--text-3);
    letter-spacing: 0.06em;
    padding-left: var(--s-4);
    border-left: 1px solid var(--line);
  }

  .hdr__nav {
    display: none;
    margin-left: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .hdr__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--s-4);
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  @media (hover: hover) {
    .hdr__nav a:hover {
      color: var(--text);
    }
  }
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
  }
  .hdr__nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--signal);
    transform: translateX(-50%);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }
  .qm-trigger {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 0.6rem 0 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-2);
    transition: border-color var(--t-fast), color var(--t-fast), background-color var(--t-fast);
  }
  .qm-trigger:hover {
    border-color: var(--control);
    color: var(--text);
    background: var(--surface);
  }
  .qm-trigger .icon {
    width: 1.05rem;
    height: 1.05rem;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text-3);
  }
  .hdr__actions :global(.hdr__cta-m) {
    padding-left: 0.95rem;
    gap: var(--s-2);
  }
  /* Very narrow phones: the Menu button keeps its name for screen readers but shows only lines. */
  @container hdr (max-width: 26em) {
    .hdr__actions :global(.hdr__cta-m) {
      padding: 0 1rem;
    }
    .hdr__actions :global(.hdr__cta-m .btn__icon) {
      display: none;
    }
    .menu-btn {
      width: var(--tap);
      padding: 0;
      justify-content: center;
    }
    .menu-btn__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .hdr__cta {
    display: none;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    padding: 0 1rem 0 0.85rem;
    border: 1px solid var(--control);
    border-radius: var(--r-pill);
    background: transparent;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .menu-btn__lines {
    display: grid;
    gap: 5px;
  }
  .menu-btn__lines i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--t-base) var(--ease-out);
  }
  .menu-btn:hover .menu-btn__lines i:last-child {
    transform: scaleX(0.6);
    transform-origin: left;
  }
  /* No JavaScript: no sheet. Show the links as a plain row instead. */
  :global(html:not(.js)) .menu-btn {
    display: none;
  }
  :global(html:not(.js)) .hdr {
    height: auto;
  }
  :global(html:not(.js)) .hdr__bar {
    flex-wrap: wrap;
    padding-block: var(--s-2);
    height: auto;
  }
  :global(html:not(.js)) .hdr__nav {
    display: block;
    margin-left: 0;
    order: 3;
    width: 100%;
  }
  :global(html:not(.js)) .qm-trigger {
    display: none !important;
  }

  @container hdr (min-width: 64em) {
    .hdr__nav {
      display: block;
    }
    .hdr__actions {
      margin-left: var(--s-2);
    }
    .qm-trigger {
      display: inline-flex;
    }
    .hdr__cta {
      display: inline-flex;
    }
    .hdr__actions :global(.hdr__cta-m) {
      display: none;
    }
    .menu-btn {
      display: none;
    }
    .hdr__clock {
      display: inline-flex;
    }
  }

  /* A compact drawer: four destinations, one project action, one direct email link. */
  :global(html:has(#site-menu[open])) {
    overflow: hidden;
  }
  .sheet {
    position: fixed;
    inset: 0;
    width: min(28rem, calc(100% - 0.75rem));
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(5px);
  }
  /* Fit short phones, while allowing scrolling for enlarged text and landscape screens. */
  .sheet__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 4dvh, 2.5rem);
    padding: max(0.75rem, env(safe-area-inset-top)) clamp(1.25rem, 5vw, 2rem) max(1rem, env(safe-area-inset-bottom));
  }
  .sheet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--tap);
  }
  .sheet__top .eyebrow {
    color: var(--text-3);
  }
  .sheet__top .icon-btn {
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .sheet__links {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .sheet__links li {
    border-bottom: 1px solid var(--line);
  }
  .sheet__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--tap);
    padding-block: clamp(0.65rem, 1.65dvh, 1.05rem);
    text-decoration: none;
  }
  .sheet__indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity var(--t-fast), transform var(--t-base) var(--ease-out);
  }
  .sheet__links a[aria-current='page'] .sheet__indicator,
  .sheet__links a:hover .sheet__indicator,
  .sheet__links a:focus-visible .sheet__indicator {
    opacity: 1;
    transform: scale(1);
  }
  .sheet__label {
    font-size: clamp(1.9rem, min(10.5vw, 7.1dvh), 3.25rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    transition: letter-spacing var(--t-slow) var(--ease-out), color var(--t-fast);
  }
  .sheet__links a:hover .sheet__label,
  .sheet__links a:focus-visible .sheet__label {
    letter-spacing: -0.02em;
    color: var(--signal);
  }
  .sheet__links a[aria-current='page'] .sheet__label {
    color: var(--signal);
  }
  .sheet__foot {
    margin-top: auto;
    display: grid;
    gap: 0.5rem;
  }
  .sheet__foot :global(.sheet__cta) {
    width: 100%;
    justify-content: space-between;
  }
  .sheet__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    color: var(--text-2);
    font-size: 0.875rem;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }
  .sheet__email:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .sheet__legal {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }
  .sheet__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
  }
  .sheet__legal a:hover {
    color: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: sheet-in 380ms var(--ease-out);
    }
    .sheet[open] .sheet__links li {
      animation: link-in 420ms var(--ease-out) both;
      animation-delay: calc(60ms + var(--i) * 35ms);
    }
    .sheet.is-closing {
      animation: sheet-out 240ms var(--ease-in-out) forwards;
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes sheet-out {
    to {
      transform: translateX(100%);
    }
  }
  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateX(0.75rem);
    }
  }
</style>
