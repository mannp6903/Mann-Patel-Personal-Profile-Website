---
/**
 * Sticky header. Desktop: wordmark + Toronto clock, links, ⌘K quick menu, "Start a project".
 * Phones: a "Menu" button opens a full-screen sheet (native <dialog>: focus is contained,
 * Esc closes, focus returns). Without JavaScript the links show as a plain row instead.
 */
import { nav, primaryCta, profile } from '../data/site';
import ContactActions from './ContactActions.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const sheetLinks = [{ href: '/', label: 'Home' }, ...nav, { href: '/contact/', label: 'Contact' }];
---

<header class="hdr" data-header>
  <div class="hdr__bar container">
    <a class="wordmark" href="/">
      <span class="visually-hidden">{profile.name}, home</span>
      <span class="wordmark__name" aria-hidden="true">
        {[...profile.name].map((ch) => (ch === ' ' ? <span class="wm-space"> </span> : <span class="wm-ch">{ch}</span>))}
      </span>
      <span class="wordmark__dot" aria-hidden="true"></span>
    </a>

    <p class="hdr__clock num" aria-hidden="true">
      <span>TOR</span>
      <time data-clock>--:--</time>
    </p>

    <nav class="hdr__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="roll">
                  <span data-text={item.label}>{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      <button class="qm-trigger" type="button" data-qm-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" />
        <span class="visually-hidden">Open quick menu</span>
        <kbd aria-hidden="true"><span data-mod>Ctrl</span> K</kbd>
      </button>
      <Button href={primaryCta.href} size="sm" class="hdr__cta">{primaryCta.label}</Button>
      <!-- Phones: the main action stays one tap away in the header. -->
      <Button href="/contact/" size="sm" class="hdr__cta-m">Contact</Button>
      <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">
        <span class="menu-btn__lines" aria-hidden="true"><i></i><i></i></span>
        <span class="menu-btn__text">Menu</span>
      </button>
    </div>
  </div>

  <dialog class="sheet" id="site-menu" aria-label="Site menu" data-menu>
    <div class="sheet__inner container">
      <div class="sheet__top">
        <p class="eyebrow">Menu</p>
        <button class="icon-btn" type="button" data-menu-close>
          <Icon name="close" />
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <nav aria-label="Menu">
        <ol class="sheet__links" role="list">
          {
            sheetLinks.map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== '/' || path === '/') ? 'page' : undefined}>
                  <span class="sheet__no num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="sheet__label">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="sheet__foot">
        <Button href="/contact/">Start a project</Button>
        <ContactActions label="Or reach me directly" showNumber />
        <p class="small subtle">
          <a class="link" href="/privacy/">Privacy</a> · <a class="link" href="/terms/">Terms</a>
        </p>
      </div>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Solid background once the page scrolls.
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    // Mobile sheet.
    const sheet = header.querySelector<HTMLDialogElement>('[data-menu]')!;
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
    const closeSheet = () => {
      if (!sheet.open) return;
      sheet.classList.add('is-closing');
      const done = () => {
        sheet.classList.remove('is-closing');
        sheet.close();
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else setTimeout(done, 260);
    };
    openBtn.addEventListener('click', () => {
      sheet.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    sheet.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeSheet();
    });
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', closeSheet);
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => sheet.close()));
    // Wider than a phone? The sheet is not needed.
    matchMedia('(min-width: 64em)').addEventListener('change', (e) => e.matches && sheet.open && sheet.close());

    // Mac users see ⌘, everyone else Ctrl.
    if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
      header.querySelectorAll('[data-mod]').forEach((el) => (el.textContent = '⌘'));
    }
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    /* The desktop layout depends on the header's own width in ems, so enlarged text
       (browser zoom or text size) falls back to the compact Menu layout instead of overflowing. */
    container: hdr / inline-size;
    height: var(--header-h);
    transition: background-color var(--t-base) var(--ease-out), border-color var(--t-base), backdrop-filter var(--t-base);
    border-bottom: 1px solid transparent;
    /* Holds still while the page underneath changes (view transitions in global.css). */
    view-transition-name: site-header;
  }
  /* Reading progress: a lime line along the bottom edge, driven by the scroll position (CSS only). */
  .hdr::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(0);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out);
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hdr::after {
        animation: read-progress linear both;
        animation-timeline: scroll(root block);
      }
      .hdr.is-scrolled::after {
        opacity: 1;
      }
    }
  }
  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }
  .hdr.is-scrolled {
    background: rgb(11 11 12 / 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  .hdr__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  /* Wordmark: the letters widen one after another on hover. */
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    min-height: var(--tap);
    align-items: center;
    text-decoration: none;
    font-size: 1.1875rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .wordmark__name {
    display: inline-flex;
  }
  .wm-ch {
    display: inline-block;
    font-stretch: 112%;
    transition: font-stretch 600ms var(--ease-out), font-weight 600ms var(--ease-out);
  }
  .wm-space {
    width: 0.28em;
  }
  .wordmark:hover .wm-ch {
    font-stretch: 125%;
    font-weight: 860;
  }
  .wm-ch:nth-child(2) {
    transition-delay: 30ms;
  }
  .wm-ch:nth-child(3) {
    transition-delay: 60ms;
  }
  .wm-ch:nth-child(4) {
    transition-delay: 90ms;
  }
  .wm-ch:nth-child(6) {
    transition-delay: 120ms;
  }
  .wm-ch:nth-child(7) {
    transition-delay: 150ms;
  }
  .wm-ch:nth-child(8) {
    transition-delay: 180ms;
  }
  .wm-ch:nth-child(9) {
    transition-delay: 210ms;
  }
  .wm-ch:nth-child(10) {
    transition-delay: 240ms;
  }
  .wordmark__dot {
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--signal);
    transform: translateY(0.12em);
  }

  .hdr__clock {
    display: none;
    gap: 0.6em;
    font-size: var(--fs-xs);
    color: var(--text-3);
    letter-spacing: 0.06em;
    padding-left: var(--s-4);
    border-left: 1px solid var(--line);
  }

  .hdr__nav {
    display: none;
    margin-left: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .hdr__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--s-4);
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 560;
    text-decoration: none;
    color: var(--text-2);
    transition: color var(--t-fast);
  }
  @media (hover: hover) {
    .hdr__nav a:hover {
      color: var(--text);
    }
  }
  .hdr__nav a[aria-current='page'] {
    color: var(--text);
  }
  .hdr__nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--signal);
    transform: translateX(-50%);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }
  .qm-trigger {
    display: none;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 0.6rem 0 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-2);
    transition: border-color var(--t-fast), color var(--t-fast), background-color var(--t-fast);
  }
  .qm-trigger:hover {
    border-color: var(--control);
    color: var(--text);
    background: var(--surface);
  }
  .qm-trigger .icon {
    width: 1.05rem;
    height: 1.05rem;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text-3);
  }
  .hdr__actions :global(.hdr__cta-m) {
    padding-left: 0.95rem;
    gap: var(--s-2);
  }
  /* Very narrow phones: the Menu button keeps its name for screen readers but shows only lines. */
  @container hdr (max-width: 26em) {
    .hdr__actions :global(.hdr__cta-m) {
      padding: 0 1rem;
    }
    .hdr__actions :global(.hdr__cta-m .btn__icon) {
      display: none;
    }
    .menu-btn {
      width: var(--tap);
      padding: 0;
      justify-content: center;
    }
    .menu-btn__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .hdr__cta {
    display: none;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    padding: 0 1rem 0 0.85rem;
    border: 1px solid var(--control);
    border-radius: var(--r-pill);
    background: transparent;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .menu-btn__lines {
    display: grid;
    gap: 5px;
  }
  .menu-btn__lines i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--t-base) var(--ease-out);
  }
  .menu-btn:hover .menu-btn__lines i:last-child {
    transform: scaleX(0.6);
    transform-origin: left;
  }
  /* No JavaScript: no sheet. Show the links as a plain row instead. */
  :global(html:not(.js)) .menu-btn {
    display: none;
  }
  :global(html:not(.js)) .hdr {
    height: auto;
  }
  :global(html:not(.js)) .hdr__bar {
    flex-wrap: wrap;
    padding-block: var(--s-2);
    height: auto;
  }
  :global(html:not(.js)) .hdr__nav {
    display: block;
    margin-left: 0;
    order: 3;
    width: 100%;
  }
  :global(html:not(.js)) .qm-trigger {
    display: none !important;
  }

  @container hdr (min-width: 64em) {
    .hdr__nav {
      display: block;
    }
    .hdr__actions {
      margin-left: var(--s-2);
    }
    .qm-trigger {
      display: inline-flex;
    }
    .hdr__cta {
      display: inline-flex;
    }
    .hdr__actions :global(.hdr__cta-m) {
      display: none;
    }
    .menu-btn {
      display: none;
    }
    .hdr__clock {
      display: inline-flex;
    }
  }

  /* ── Full-screen sheet ── */
  .sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .sheet__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding-block: var(--s-4) var(--s-6);
  }
  .sheet__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: calc(var(--header-h) - var(--s-4));
  }
  .sheet__links {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .sheet__links li {
    border-bottom: 1px solid var(--line);
  }
  .sheet__links a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-3);
    text-decoration: none;
  }
  .sheet__no {
    font-size: var(--fs-xs);
    color: var(--text-3);
    width: 2ch;
  }
  .sheet__label {
    font-size: clamp(2.4rem, 10vw, 3.6rem);
    font-weight: 760;
    font-stretch: 115%;
    letter-spacing: -0.045em;
    line-height: 1.05;
    transition: font-stretch var(--t-slow) var(--ease-out), color var(--t-fast);
  }
  .sheet__links a:hover .sheet__label,
  .sheet__links a:focus-visible .sheet__label {
    font-stretch: 125%;
    color: var(--signal);
  }
  .sheet__links a[aria-current='page'] .sheet__label {
    color: var(--signal);
  }
  .sheet__foot {
    margin-top: auto;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: sheet-in 520ms var(--ease-out);
    }
    .sheet[open] .sheet__links li {
      animation: link-in 700ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 55ms);
    }
    .sheet.is-closing {
      animation: sheet-out 260ms var(--ease-in-out) forwards;
    }
  }
  @keyframes sheet-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes sheet-out {
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }
</style>
