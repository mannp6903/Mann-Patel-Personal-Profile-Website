---
/**
 * Site header + menu.
 *
 * - Sticky at the top of every page: it tightens and gains a backdrop once you scroll, and
 *   a thin accent line under it shows how far down the page you are.
 * - Desktop: logo, inline links and a "Start a project" button. Nothing floats over content.
 * - Phones: a "Menu" button opens a sheet that drops down from the top, with the links and
 *   the direct contact buttons. The sheet is a native <dialog> (focus stays inside, Esc
 *   closes it, focus returns). Without JavaScript the inline links wrap under the logo.
 */
import { nav, primaryCta, social } from '../data/site';
import Logo from './Logo.astro';
import ContactActions from './ContactActions.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const panelLinks = [{ href: '/', label: 'Home' }, ...nav, { href: primaryCta.href, label: 'Contact' }];
const socials = social.filter((s) => s.url);
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="wordmark" href="/" aria-label="Mann Patel, home">
      <Logo master="text" motion="intro" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a class="hdr-cta" href={primaryCta.href} aria-current={isCurrent(primaryCta.href) ? 'page' : undefined}>
            <span class="hdr-cta-dot" aria-hidden="true"></span>
            {primaryCta.label}
          </a>
        </li>
      </ul>
    </nav>

    <button class="menu-open" type="button" aria-haspopup="dialog" aria-controls="menu-panel" data-menu-toggle>
      <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      Menu
    </button>
  </div>
  <span class="hdr-progress" aria-hidden="true"></span>
</header>

<dialog id="menu-panel" class="menu-panel" aria-label="Menu" data-menu-panel>
  <div class="panel-inner">
    <div class="panel-top">
      <span class="panel-label">Menu</span>
      <button class="panel-close" type="button" data-menu-close>
        <span class="menu-lines is-x" aria-hidden="true"><span></span><span></span></span>
        Close
      </button>
    </div>
    <nav aria-label="Menu">
      <ul class="panel-links" role="list">
        {
          panelLinks.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) && (item.href !== '/' || path === '/') ? 'page' : undefined}>
                <span class="pl-num" aria-hidden="true">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="panel-foot">
      <ContactActions label="Reach me directly" compact />
      {
        socials.length > 0 && (
          <p class="panel-socials">
            <span class="panel-label">Elsewhere</span>
            {socials.map((s) => (
              <a href={s.url!} rel="me noopener">
                {s.label}
              </a>
            ))}
          </p>
        )
      }
      <p class="panel-legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Use</a>
      </p>
    </div>
  </div>
</dialog>

<script>
  const panel = document.querySelector<HTMLDialogElement>('[data-menu-panel]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (panel && typeof panel.showModal === 'function') {
    const close = () => panel.close();
    opener?.addEventListener('click', () => {
      panel.showModal();
      document.documentElement.classList.add('menu-is-open');
    });
    panel.querySelector('[data-menu-close]')?.addEventListener('click', close);
    panel.addEventListener('close', () => document.documentElement.classList.remove('menu-is-open'));
    // A click on the dimmed backdrop (outside the sheet) closes it.
    panel.addEventListener('click', (e) => {
      const r = panel.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) close();
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  } else {
    // Very old browsers: fall back to the inline links.
    document.documentElement.classList.add('no-dialog');
  }

  // Scrolled state + reading progress (one passive listener, one frame per scroll burst).
  if (header) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 8);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      header.style.setProperty('--progress', String(max > 0 ? Math.min(1, y / max) : 0));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  /* Solid, never see-through: content (like the hero photo) scrolls cleanly underneath. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 8px 24px -22px rgb(21 23 26 / 0.6);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    min-height: 4.5rem;
    transition: min-height var(--dur-base) var(--ease-out);
  }
  .is-scrolled .bar {
    min-height: 3.75rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: clamp(1.35rem, 1.2rem + 0.45vw, 1.6rem);
    color: var(--ink);
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  .nav-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-xs);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }
  /* An underline draws in from the left on hover and stays under the current page. */
  .nav-list li:not(.nav-cta) a::after {
    content: '';
    position: absolute;
    left: var(--space-xs);
    right: var(--space-xs);
    bottom: 0.45rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 380ms var(--ease-out);
  }
  .nav-list li:not(.nav-cta) a:hover::after,
  .nav-list li:not(.nav-cta) a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-list a[aria-current='page']::after {
    background: var(--accent);
  }
  .nav-cta {
    margin-left: var(--space-2xs);
  }
  .nav-list .hdr-cta {
    gap: 0.55em;
    padding-inline: 1.1rem;
    background: var(--ink);
    color: var(--paper);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .nav-list .hdr-cta:hover {
    background: var(--accent-text);
  }
  .hdr-cta-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3ecf8e;
    box-shadow: 0 0 0 0 rgb(62 207 142 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hdr-cta-dot {
      animation: ping 2.4s var(--ease-out) infinite;
    }
  }
  @keyframes ping {
    70%,
    100% {
      box-shadow: 0 0 0 0.45rem rgb(62 207 142 / 0);
    }
  }
  .hdr-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
    pointer-events: none;
  }

  .menu-open {
    display: none;
  }
  .menu-lines {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .menu-lines span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .menu-lines span:last-child {
    width: 70%;
  }
  .menu-lines.is-x span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-lines.is-x span:last-child {
    width: 100%;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Phones (with JS): a Menu button replaces the inline links. */
  @media (max-width: 47.99em) {
    :global(.js:not(.no-dialog)) .site-nav {
      display: none;
    }
    :global(.js:not(.no-dialog)) .menu-open {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      min-height: var(--tap);
      padding: 0 var(--space-s);
      border: 1.5px solid var(--line);
      border-radius: var(--radius-pill);
      background: var(--card);
      font: inherit;
      font-weight: 700;
      color: var(--ink);
      cursor: pointer;
    }
  }

  /* Drop-down sheet */
  .menu-panel {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    max-width: 100%;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    background: var(--paper);
    color: var(--ink);
    overflow: auto;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  .menu-panel::backdrop {
    background: rgb(15 16 18 / 0.5);
  }
  .panel-inner {
    display: grid;
    gap: var(--space-l);
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding: calc(env(safe-area-inset-top, 0px) + var(--space-s)) 0 var(--space-l);
  }
  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--line);
  }
  .panel-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .panel-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .panel-links {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .panel-links li + li {
    border-top: 1px solid var(--line);
  }
  .panel-links a {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }
  .pl-num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .panel-links a[aria-current='page'] {
    color: var(--accent-text);
  }
  .panel-foot {
    display: grid;
    gap: var(--space-m);
  }
  .panel-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: baseline;
  }
  .panel-socials .panel-label {
    width: 100%;
  }
  .panel-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .panel-legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink-2);
  }
  .panel-socials a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel[open] {
      animation: sheet-in 460ms cubic-bezier(0.2, 0.9, 0.2, 1);
    }
    .menu-panel[open] .panel-links li {
      animation: link-in 520ms var(--ease-out) backwards;
      animation-delay: calc(120ms + var(--i) * 50ms);
    }
    .menu-panel[open]::backdrop {
      animation: fade-in 300ms var(--ease-out);
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateY(-100%);
    }
  }
  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  :global(html.menu-is-open) {
    overflow: hidden;
  }
</style>
