---
import ContactActions from './ContactActions.astro';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Tell me about your business.',
  text = 'Two minutes is enough. I’ll reply by email with questions or a suggested next step. No obligation, and no automated sales sequence.',
  href = '/contact/',
  label = 'Start a project',
} = Astro.props;
---

<section class="cta section" aria-labelledby="cta-title">
  <div class="container inner" data-reveal>
    <h2 id="cta-title">{title}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a class="btn" href={href}>{label} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ContactActions label="Or reach me directly" />
  </div>
</section>

<style>
  .cta {
    border-top: 1px solid var(--line);
  }
  .inner {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  h2 {
    font-size: var(--step-4);
    max-width: 16ch;
  }
  h2::after {
    content: '';
  }
  .lead {
    max-width: 46ch;
  }
</style>
