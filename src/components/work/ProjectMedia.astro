---
/**
 * A project's real captures composed for a card: the desktop capture in a browser frame, with the phone capture
 * overlapping its corner, on a backdrop from the tokens (design upgrade Phase 5: one frame system, MediaFrame.astro;
 * the backdrop is --pm-bg, which defaults to the dark surface and is a paper tint in the light Selected Work band).
 */
import MediaFrame from './MediaFrame.astro';
import { captures } from '../../data/captures';

interface Props {
  scene: 'nest-and-rest' | 'samp';
  /**
   * The page's main image: the desktop capture gets Astro `priority` (eager, sync, fetchpriority high: the one per
   * page, Website Playbook 16 Nov 2026). The phone capture is always lazy: it sits below the first screen at 390 and
   * 1440 (gate G1, Mann's rule of 17 Nov 2026: lazy below the first screen).
   */
  eager?: boolean;
  /**
   * How wide the desktop capture is drawn, for the browser to pick a file (Nov 2026 audit fixes: measured from
   * 320 to 1920 px wide, so no page downloads a larger file than it shows). Default: the /work/ rows. A `sizes`
   * length in rem is always 16 px, so the larger screens use px.
   */
  sizes?: string;
  /** The same for the phone capture: about a quarter of the card, 5.5–11rem (the CSS below). */
  phoneSizes?: string;
}
const {
  scene,
  eager = false,
  sizes = '(min-width: 90em) 625px, (min-width: 64em) 43vw, 78vw',
  phoneSizes = '(min-width: 90em) 160px, (min-width: 64em) 11vw, 22vw',
} = Astro.props;
const c = captures[scene];
const host = new URL(c.url).host;
---

<div class="pm">
  <MediaFrame
    kind="browser"
    class="pm__desk"
    src={c.desktop.src}
    alt={c.desktop.alt}
    host={host}
    widths={[320, 400, 480, 560, 640, 800, 1000, 1250, 1440]}
    sizes={sizes}
    priority={eager}
  />
  <MediaFrame
    kind="phone"
    class="pm__phone"
    src={c.mobile.src}
    alt={c.mobile.altShort ?? c.mobile.alt}
    widths={[120, 160, 240, 320, 360, 480]}
    sizes={phoneSizes}
  />
</div>

<style>
  .pm {
    position: relative;
    padding: clamp(1rem, 4%, 2.5rem) clamp(1rem, 6%, 3.5rem) clamp(2.5rem, 12%, 5rem) clamp(1rem, 4%, 2.5rem);
    border-radius: var(--r-lg);
    background: var(--pm-bg, var(--bg-2));
    overflow: hidden;
    isolation: isolate;
  }
  .pm :global(.pm__desk) {
    transform-origin: 30% 100%;
    transition: transform var(--dur-4) var(--ease-out);
  }
  .pm :global(.pm__phone) {
    position: absolute;
    right: clamp(0.75rem, 4%, 2rem);
    bottom: clamp(-3rem, -6%, -1rem);
    width: clamp(5.5rem, 24%, 11rem);
    transition: transform var(--dur-4) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .pm :global(.pm__desk),
    :global(.pm-host:hover) .pm :global(.pm__desk),
    :global(a:focus-visible) > .pm :global(.pm__desk),
    :global(.pm-host:focus-within) .pm :global(.pm__desk) {
      transform: scale(1.015) rotate(-0.4deg);
    }
    :global(a:hover) > .pm :global(.pm__phone),
    :global(.pm-host:hover) .pm :global(.pm__phone),
    :global(a:focus-visible) > .pm :global(.pm__phone),
    :global(.pm-host:focus-within) .pm :global(.pm__phone) {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
