---
/**
 * A project's real captures composed for a card: the desktop capture in a plain frame, with the
 * phone capture overlapping its corner, on a panel tinted from the project's own palette.
 */
import { Image } from 'astro:assets';
import { captures } from '../../data/captures';

interface Props {
  scene: 'nest-and-rest' | 'samp';
  /**
   * The page's main image: the desktop capture gets Astro `priority` (eager, sync, fetchpriority high: the one per
   * page, Website Playbook 16 Nov 2026) and the phone capture loads eagerly at low priority. Otherwise both lazy.
   */
  eager?: boolean;
  /**
   * How wide the desktop capture is drawn, for the browser to pick a file (Nov 2026 audit fixes: measured from
   * 320 to 1920 px wide, so no page downloads a larger file than it shows). Default: the /work/ rows. A `sizes`
   * length in rem is always 16 px, so the larger screens use px.
   */
  sizes?: string;
  /** The same for the phone capture: about a quarter of the card, 5.5–11rem (the CSS below). */
  phoneSizes?: string;
}
const {
  scene,
  eager = false,
  sizes = '(min-width: 90em) 625px, (min-width: 64em) 43vw, 78vw',
  phoneSizes = '(min-width: 90em) 160px, (min-width: 64em) 11vw, 22vw',
} = Astro.props;
const c = captures[scene];
const host = new URL(c.url).host;
const loading = eager ? 'eager' : 'lazy';
---

<div class="pm" style={`--tint:${c.tint}`}>
  <div class="pm__desk">
    <span class="pm__bar" aria-hidden="true"><i></i><i></i><i></i><b>{host}</b></span>
    <Image
      src={c.desktop.src}
      alt={c.desktop.alt}
      widths={[480, 540, 600, 680, 800, 1000, 1200]}
      quality={74}
      sizes={sizes}
      priority={eager}
    />
  </div>
  <div class="pm__phone">
    <Image src={c.mobile.src} alt={c.mobile.altShort ?? c.mobile.alt} widths={[160, 200, 280, 360]} sizes={phoneSizes} loading={loading} decoding="async" fetchpriority={eager ? 'low' : undefined} />
  </div>
</div>

<style>
  .pm {
    position: relative;
    padding: clamp(1rem, 4%, 2.5rem) clamp(1rem, 6%, 3.5rem) clamp(2.5rem, 12%, 5rem) clamp(1rem, 4%, 2.5rem);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 90% at 100% 100%, color-mix(in oklab, var(--tint) 38%, transparent), transparent 60%),
      color-mix(in oklab, var(--tint) 10%, var(--bg-2));
    overflow: hidden;
    isolation: isolate;
  }
  .pm__desk {
    border-radius: 12px;
    overflow: hidden;
    background: var(--frame-screen);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
    transform-origin: 30% 100%;
    transition: transform 900ms var(--ease-out);
  }
  .pm__bar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.6rem;
    padding-inline: 0.7rem;
    background: var(--frame-bar);
  }
  .pm__bar i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--frame-dot);
  }
  .pm__bar b {
    margin-left: auto;
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--w-ui);
    color: var(--frame-url);
    transform: translateX(-1rem);
  }
  .pm__phone {
    position: absolute;
    right: clamp(0.75rem, 4%, 2rem);
    bottom: clamp(-3rem, -6%, -1rem);
    width: clamp(5.5rem, 24%, 11rem);
    border-radius: 1.1rem;
    border: 5px solid var(--frame-bezel);
    overflow: hidden;
    background: var(--frame-screen);
    box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.85);
    transition: transform 900ms var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .pm .pm__desk,
    :global(.pm-host:hover) .pm__desk {
      transform: scale(1.015) rotate(-0.4deg);
    }
    :global(a:hover) > .pm .pm__phone,
    :global(.pm-host:hover) .pm__phone {
      transform: translateY(-10px) rotate(2deg);
    }
  }
</style>
