---
/**
 * The one frame for a project capture (design upgrade Phase 5, task 5.1; DESIGN.md → Imagery). Three kinds:
 *   browser  a desktop capture: a plain figure, the media radius and shadow. 22 Nov 2026 (upgrade report R2.2): no drawn
 *            browser bar (three dots and an address pill read as a generated tell); the real address, where it helps,
 *            is a text link beside the capture instead
 *   phone    a phone capture in a bezel
 *   plain    a close-up on a white card with a hairline border
 * Browser and phone frames carry --shadow-media, the single shadow for mockups. Colours come from the --frame-* tokens.
 * The capture is an AVIF picture with a WebP fallback (task 5.2); `widths` should reach twice the shown width wherever
 * the source file is wide enough (gate G2). Quality 55: AVIF at 55 looks the same as WebP at 74 on these captures and is
 * about a fifth smaller (WebP, the fallback for older browsers, gets the same number).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  kind: 'browser' | 'phone' | 'plain';
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** The page's main image: eager, high priority (one per page). */
  priority?: boolean;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  quality?: number;
  class?: string;
}
const { kind, src, alt, widths, sizes, priority = false, loading = 'lazy', fetchpriority, quality = 55, class: cls } = Astro.props;
// Never ask for a file wider than the source: the widest candidate is then the source itself.
const usable = [...new Set(widths.map((w) => Math.min(w, src.width)))].sort((a, b) => a - b);
---

<div class:list={['frame', `frame--${kind}`, cls]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={usable}
    sizes={sizes}
    quality={quality}
    priority={priority || undefined}
    loading={priority ? undefined : loading}
    decoding="async"
    fetchpriority={priority ? undefined : fetchpriority}
    data-src-w={src.width}
  />
</div>

<style>
  .frame {
    overflow: hidden;
    background: var(--frame-screen);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame--browser {
    border-radius: var(--r-md);
    box-shadow: var(--shadow-media);
  }
  .frame--phone {
    border-radius: var(--frame-phone-r, 1.1rem);
    border: var(--frame-phone-bezel, 5px) solid var(--frame-bezel);
    box-shadow: var(--shadow-media);
  }
  .frame--plain {
    border-radius: var(--r-md);
    border: 1px solid var(--line);
  }
</style>
