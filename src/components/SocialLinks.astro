---
/**
 * Social profile buttons. Profiles without a URL yet are shown as greyed placeholders
 * in previews only; production renders only real links (no dead buttons).
 */
import { social } from '../data/site';
import { isProduction } from '../lib/mode';
import PreviewNote from './PreviewNote.astro';

interface Props {
  note?: boolean;
  label?: string;
}
const { note = false, label = 'Mann Patel elsewhere' } = Astro.props;
const visible = social.filter((s) => s.url || !isProduction);
const pending = social.filter((s) => !s.url).map((s) => s.label);

const icons: Record<string, string> = {
  github:
    '<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.25" fill="currentColor"/></svg>',
  facebook:
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v2.9h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2zM8 19H5V9.5h3V19zM6.5 8.2a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5zM19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5S12.8 13 12.8 14.3V19h-3V9.5h2.9v1.3h.04c.4-.76 1.38-1.56 2.85-1.56 3.05 0 3.6 2 3.6 4.6V19z"/></svg>',
};
---

{
  visible.length > 0 && (
    <div class="social-wrap">
      <ul class="social" role="list" aria-label={label}>
        {visible.map((s) => (
          <li>
            {s.url ? (
              <a class="btn-social" href={s.url} rel="me noopener" aria-label={`${s.label}: Mann Patel`} title={s.label} data-contact={s.id}>
                <Fragment set:html={icons[s.id]} />
              </a>
            ) : (
              <span class="btn-social is-pending" role="img" aria-label={`${s.label}, link coming soon`} title={`${s.label}: link coming soon`}>
                <Fragment set:html={icons[s.id]} />
              </span>
            )}
          </li>
        ))}
      </ul>
      {note && pending.length > 0 && <PreviewNote note={`add your ${pending.join(', ')} profile links in src/data/site.ts (hidden in production until then)`} />}
    </div>
  )
}

<style>
  .social-wrap {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  .btn-social {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    border: 1.5px solid currentColor;
    color: inherit;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .btn-social :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  a.btn-social:hover {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-1px);
  }
  :global(.on-night) a.btn-social:hover {
    background: var(--night-ink);
    color: var(--night);
  }
  .btn-social.is-pending {
    opacity: 0.45;
    border-style: dashed;
    cursor: help;
  }
</style>
