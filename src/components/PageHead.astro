---
/** Opening block of inner pages: label, a large line-by-line title, intro, optional extras. */
import Heading from './ui/Heading.astro';
import Field from './fx/Field.astro';

interface Props {
  eyebrow: string;
  lines: string[];
  lead?: string;
  class?: string;
}
const { eyebrow, lines, lead, class: cls } = Astro.props;
---

<header class:list={['ph', cls]} data-field-zone>
  <Field preset="head" class="ph__field" />
  <div class="container ph__inner">
    <p class="eyebrow">{eyebrow}</p>
    <Heading as="h1" lines={lines} class="ph__title" load />
    {lead && <p class="lead ph__lead" data-reveal="load" style="--d:220">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--s-7), 7vw, var(--s-10)) clamp(var(--s-6), 5vw, var(--s-8));
  }
  .ph :global(.ph__field) {
    --fx: 88%;
    --fy: 40%;
    --fw: 70%;
    --fh: 120%;
  }
  @media (max-width: 47.99em) {
    .ph :global(.ph__field) {
      --fx: 100%;
      --fy: 10%;
      --fw: 90%;
      --fh: 70%;
    }
  }
  .ph__inner {
    position: relative;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .ph__inner :global(.ph__title) {
    font-size: var(--fs-h1);
    max-width: 16ch;
  }
  .ph__lead {
    max-width: 52ch;
  }
</style>
