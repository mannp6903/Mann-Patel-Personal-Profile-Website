---
/**
 * Industry page template (SEO audit Phase 3, 14 Nov 2026): /websites-for-cleaning-companies/ and
 * /websites-for-salons-and-spas/. Content: src/data/industry-pages.ts.
 *
 * Order (plan B3): the case study first, with the honest labels from src/content/work/, then the package that
 * fits, the questions, related pages and the free check. Prices come from src/data/packages.ts.
 */
import { accentLine } from '../lib/headline';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import Crumbs from './Crumbs.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import ProjectMedia from './work/ProjectMedia.astro';
import CheckBanner from './CheckBanner.astro';
import { cta } from '../data/site';
import { industryPages, type IndustryPage } from '../data/industry-pages';
import { servicePageBySlug, type ServicePage } from '../data/service-pages';
import { packageById, type Package } from '../data/packages';
import { absoluteUrl } from '../lib/mode';
import { breadcrumbJsonLd, businessRef, packageOffer } from '../lib/seo';
import { projectSite } from '../lib/work';

interface Props {
  page: IndustryPage;
}
const { page } = Astro.props;
const path = `/${page.slug}/`;
const url = absoluteUrl(path);
const pkgs = page.packages.map((id) => packageById(id)).filter(Boolean) as Package[];
const main = pkgs[0];
const work = await getEntry('work', page.caseStudy);
if (!work) throw new Error(`${path}: case study "${page.caseStudy}" not found in src/content/work/`);
const w = work.data;
const site = projectSite(w);
const services = page.services.map((slug) => servicePageBySlug(slug)).filter(Boolean) as ServicePage[];
const others = industryPages.filter((p) => p.slug !== page.slug);
const lines = page.lines.map((l, i) => (i === page.lines.length - 1 ? accentLine(l) : l));

// Structured data matches the page: the service, sold by the business, at the prices shown.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  description: page.description,
  serviceType: 'Website design',
  ...(url ? { url } : {}),
  provider: businessRef(),
  audience: { '@type': 'BusinessAudience', audienceType: page.short },
  areaServed: [
    { '@type': 'City', name: 'Toronto' },
    { '@type': 'AdministrativeArea', name: 'Greater Toronto Area' },
  ],
  offers: pkgs.filter((p) => p.price.amount !== null).map(packageOffer),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: page.short, path },
]);
---

<BaseLayout title={page.title} description={page.description} jsonLd={[serviceLd, faqLd, ...(crumbs ? [crumbs] : [])]}>
  <Crumbs items={[{ label: 'Services', href: '/services/' }, { label: page.short }]} />

  <PageHead lines={lines} lead={page.lead} compact>
    <div class="ip__actions" data-reveal="load" style="--d:5">
      <div class="btn-row">
        <Button href={cta.checkHref}>{cta.check}</Button>
        <a class="link-arrow" href={`/contact/?package=${main.id}#brief`}>Ask about a website <Icon name="arrow" /></a>
      </div>
    </div>
  </PageHead>

  <section class="section section--rule" aria-labelledby="ip-needs-title">
    <div class="container ip__split">
      <h2 id="ip-needs-title" class="ip__h2">{page.needsTitle}</h2>
      <ul class="ip__list" role="list">
        {
          page.needs.map((n) => (
            <li>
              <Icon name="check" />
              <span>{n}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" data-case-study aria-labelledby="case-title">
    <div class="container ip__case">
      <div class="stack" style="--stack: var(--head-gap-2)">
        <h2 id="case-title" class="ip__h2">{page.example.title}</h2>
        <p class="ip__tags small">
          <span>{w.relationship}</span>
          <span>{site.websiteStatus}</span>
        </p>
        <p class="muted">{page.example.body}</p>
        <a class="link-arrow" href={`/work/${work.id}/`}>
          Case study <Icon name="arrow" />
        </a>
      </div>
      <ProjectMedia scene={w.scene} sizes="(min-width: 90em) 640px, (min-width: 64em) 44vw, 84vw" phoneSizes="(min-width: 90em) 160px, (min-width: 64em) 11vw, 22vw" />
    </div>
  </section>

  <section class="section section--rule" data-packages aria-labelledby="ip-pkg-title">
    <div class="container ip__split">
      <h2 id="ip-pkg-title" class="ip__h2">Price</h2>
      <div class="stack" style="--stack: var(--s-4)">
        <p class="ip__price">{page.priceLine}</p>
        <p class="muted small">In Canadian dollars, plus tax.</p>
        <a class="link-arrow" href="/pricing/#pr-compare">What’s included <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ip-faq-title">
    <div class="container ip__split">
      <div class="stack" style="--stack: var(--s-4)">
        <h2 id="ip-faq-title" class="ip__h2">Questions</h2>
      </div>
      <div>
        {
          page.faqs.map((f) => (
            <details class="acc" name="ip-faq">
              <summary>
                <h3 class="acc__q">{f.q}</h3>
                <span class="acc__plus" aria-hidden="true" />
              </summary>
              <div class="acc__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <nav class="section section--rule" aria-labelledby="ip-more-title">
    <div class="container">
      <h2 id="ip-more-title" class="eyebrow">Related</h2>
      <ul class="ip__more" role="list">
        {
          services.map((s) => (
            <li>
              <a class="ip__more-link" href={`/services/${s.slug}/`}>
                <span>{s.short}</span>
                <span class="muted small">{s.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        {
          others.map((o) => (
            <li>
              <a class="ip__more-link" href={`/${o.slug}/`}>
                <span>{o.short}</span>
                <span class="muted small">{o.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <CheckBanner />
</BaseLayout>

<style>
  /* 23 Nov 2026 audit (copy deck §2.4): the needs list and the price line. */
  .ip__list {
    display: grid;
    gap: var(--s-3);
  }
  .ip__list li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .ip__list :global(.icon) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2em;
    color: var(--signal);
  }
  .ip__price {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .ip__actions {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  
  .ip__h2 {
    font-size: var(--fs-h2);
    max-width: 20ch;
  }
  .ip__case {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }
  @media (min-width: 64em) {
    .ip__case {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-8);
    }
  }
  .ip__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .ip__tags span {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--fs-label);
    color: var(--text-2);
  }
  .ip__split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .ip__split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    /* The head stays beside its content instead of leaving an empty column (gate L1, re-audit 18 Nov 2026; as on Home,
       task 3.4). */
    .ip__split > :first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
  .ip__more {
    display: grid;
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .ip__more li {
    border-bottom: 1px solid var(--line);
  }
  .ip__more-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem var(--s-4);
    padding-block: var(--s-4);
    text-decoration: none;
  }
  .ip__more-link > span:first-child {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: -0.02em;
  }
  .ip__more-link > .small {
    grid-column: 1;
  }
  .ip__more-link :global(.icon) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--signal);
    transition: transform var(--dur-1) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ip__more-link:hover :global(.icon),
    .ip__more-link:focus-visible :global(.icon) {
      transform: translateX(4px);
    }
  }
</style>
