---
/**
 * Mann Patel logo: custom "MP" ligature monogram + "MANN PATEL" wordmark outlines
 * (geometry in src/data/logo.json, generated by scripts/make-logo.py).
 * Decorative here: the surrounding link or heading carries the accessible name.
 *
 * Motion: when the parent adds .is-intro (header, once per visit), the monogram strokes
 * draw in, the orange square stamps in and the wordmark slides in. Reduced motion: static.
 */
import logo from '../data/logo.json';

interface Props {
  variant?: 'lockup' | 'mark';
  class?: string;
}
const { variant = 'lockup', class: className } = Astro.props;
const m = logo.monogram;
const d = m.dot;
const viewBox = variant === 'mark' ? m.viewBox : logo.lockup.viewBox;
---

<svg class:list={['logo', `logo--${variant}`, className]} viewBox={viewBox} aria-hidden="true" focusable="false">
  <g
    class="logo-mono"
    fill="none"
    stroke="currentColor"
    stroke-width={m.stroke}
    stroke-linejoin="miter"
    stroke-miterlimit="3"
  >
    <path class="logo-stroke" d={m.m} pathLength="1"></path>
    <path class="logo-stroke logo-stroke--p" d={m.p} pathLength="1"></path>
  </g>
  <rect class="logo-dot" x={d.x} y={d.y} width={d.w} height={d.h}></rect>
  {
    variant === 'lockup' && (
      <g class="logo-word">
        <path fill="currentColor" transform={logo.lockup.wordTransform} d={logo.wordmark.d} />
      </g>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: 1em;
    width: auto;
    overflow: visible;
  }
  .logo-dot {
    fill: var(--logo-dot, var(--accent));
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-stamp);
  }
  :global(a:hover) > .logo .logo-dot,
  :global(a:focus-visible) > .logo .logo-dot {
    transform: translate(18%, -18%) rotate(12deg);
  }

  /* One-time intro (class added by the header script on the first page of a visit). */
  :global(.js-motion) .logo:global(.is-intro) .logo-stroke {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: logo-draw 850ms cubic-bezier(0.65, 0, 0.35, 1) 120ms forwards;
  }
  :global(.js-motion) .logo:global(.is-intro) .logo-stroke--p {
    animation-delay: 620ms;
    animation-duration: 600ms;
  }
  :global(.js-motion) .logo:global(.is-intro) .logo-dot {
    animation: logo-stamp 420ms var(--ease-stamp) 1180ms backwards;
  }
  :global(.js-motion) .logo:global(.is-intro) .logo-word {
    animation: logo-word 700ms var(--ease-out) 520ms backwards;
  }
  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes logo-stamp {
    from {
      opacity: 0;
      transform: scale(2.6) rotate(-35deg);
    }
  }
  @keyframes logo-word {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
  }
</style>
