---
/**
 * Mann Patel logo: the name, set in Fraunces and outlined letter by letter
 * (geometry in src/data/logo.json, generated by scripts/make-logo.py).
 * Decorative here: the surrounding link or heading carries the accessible name.
 *
 *   variant  wordmark (one line) | stacked ("Mann" over "Patel.", for square spaces)
 *   master   optical size of the one-line wordmark: text (header, small) | display (large)
 *   motion   none | intro (header: plays on the first page of a visit, decided in <head>)
 *            | reveal (plays when scrolled into view)
 *
 * Motion: the letters rise into place one after another, the orange full stop drops in
 * and settles, then an orange glint sweeps across the name. Hovering the link replays
 * the glint and the stop hops. Everything is static under reduced motion or without JS.
 */
import logo from '../data/logo.json';

interface Props {
  variant?: 'wordmark' | 'stacked';
  master?: 'display' | 'text';
  motion?: 'none' | 'intro' | 'reveal';
  class?: string;
}
const { variant = 'wordmark', master = 'display', motion = 'none', class: className } = Astro.props;
const part = variant === 'stacked' ? logo.stacked : logo[master];
const [vx, , vw] = part.viewBox.split(' ').map(Number);
const uid = `mp${Math.random().toString(36).slice(2, 8)}`;
const shift = (vw * 0.62).toFixed(1);
---

<svg
  class:list={['logo', `logo--${variant}`, className]}
  viewBox={part.viewBox}
  aria-hidden="true"
  focusable="false"
  data-logo
  data-logo-motion={motion}
>
  <defs>
    <linearGradient
      id={`${uid}-glint`}
      gradientUnits="userSpaceOnUse"
      x1={vx}
      x2={vx + vw}
      y1="0"
      y2="0"
      gradientTransform={`translate(-${shift} 0)`}
    >
      <stop offset="0" stop-color="currentColor"></stop>
      <stop offset="0.41" stop-color="currentColor"></stop>
      <stop offset="0.5" class="logo-glint"></stop>
      <stop offset="0.59" stop-color="currentColor"></stop>
      <stop offset="1" stop-color="currentColor"></stop>
      <animateTransform
        attributeName="gradientTransform"
        type="translate"
        from={`-${shift} 0`}
        to={`${shift} 0`}
        dur="1.15s"
        begin="indefinite"
        fill="freeze"
        calcMode="spline"
        keyTimes="0;1"
        keySplines="0.45 0 0.2 1"
        data-logo-glint></animateTransform>
    </linearGradient>
  </defs>
  <g class="logo-letters" fill={`url(#${uid}-glint)`}>
    {part.letters.map((l, i) => <path class="logo-l" style={`--i:${i}`} d={l.d} />)}
  </g>
  <path class="logo-stop" style={`--i:${part.letters.length}`} d={part.stop}></path>
</svg>

<script>
  // Glint + reveal driver. CSS does the letter and stop motion; this only decides when.
  const root = document.documentElement;
  const motion = root.classList.contains('js-motion');
  const GLINT_MS = 1150;

  const glint = (svg: SVGSVGElement) => {
    const anim = svg.querySelector<SVGAnimationElement>('[data-logo-glint]');
    const last = Number(svg.dataset.glintAt || 0);
    if (!anim || typeof anim.beginElement !== 'function' || performance.now() - last < GLINT_MS) return;
    svg.dataset.glintAt = String(performance.now());
    anim.beginElement();
  };

  // Plays the full sequence once: rise + drop (CSS, .is-playing), then the glint.
  const play = (svg: SVGSVGElement) => {
    svg.classList.add('is-playing');
    const letters = svg.querySelectorAll('.logo-l').length;
    const settle = 160 + letters * 55 + 900;
    window.setTimeout(() => glint(svg), settle - 250);
    window.setTimeout(() => {
      svg.classList.remove('is-playing');
      svg.classList.add('is-played');
    }, settle + 200);
  };

  const logos = Array.from(document.querySelectorAll<SVGSVGElement>('svg[data-logo]'));

  if (motion) {
    // Header intro: <head> already added .logo-intro (first page of the visit), so the
    // letters were animating from the first paint. Finish it with the glint, then tidy up.
    if (root.classList.contains('logo-intro')) {
      logos
        .filter((svg) => svg.dataset.logoMotion === 'intro')
        .forEach((svg) => {
          const letters = svg.querySelectorAll('.logo-l').length;
          window.setTimeout(() => glint(svg), 160 + letters * 55 + 650);
        });
      window.setTimeout(() => root.classList.remove('logo-intro'), 2400);
    }

    // Reveal: play when the logo scrolls into view.
    const reveal = logos.filter((svg) => svg.dataset.logoMotion === 'reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            play(entry.target as SVGSVGElement);
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.35 },
      );
      reveal.forEach((svg) => io.observe(svg));
    } else {
      reveal.forEach((svg) => svg.classList.add('is-played'));
    }

    // Hover / keyboard focus on the surrounding link replays the glint.
    logos.forEach((svg) => {
      const link = svg.closest('a');
      if (!link) return;
      link.addEventListener('pointerenter', () => glint(svg));
      link.addEventListener('focus', () => glint(svg));
    });
  }
</script>

<style>
  .logo {
    display: block;
    height: 1em;
    width: auto;
    overflow: visible;
  }
  .logo-glint {
    stop-color: var(--logo-dot, var(--accent));
  }
  .logo-l,
  .logo-stop {
    transform-box: fill-box;
  }
  .logo-stop {
    fill: var(--logo-dot, var(--accent));
    transform-origin: 50% 100%;
  }

  /* ── Motion (only when JS runs and motion is allowed) ── */

  /* Letters rise out of the baseline, one after another; the stop drops in last. */
  :global(.js-motion.logo-intro) .logo[data-logo-motion='intro'],
  :global(.js-motion) .logo[data-logo-motion='reveal']:not(:global(.is-played)) {
    overflow: hidden;
  }
  :global(.js-motion.logo-intro) .logo[data-logo-motion='intro'] .logo-l,
  :global(.js-motion) .logo:global(.is-playing) .logo-l {
    animation: logo-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(160ms + var(--i) * 55ms) both;
  }
  :global(.js-motion.logo-intro) .logo[data-logo-motion='intro'] .logo-stop,
  :global(.js-motion) .logo:global(.is-playing) .logo-stop {
    animation: logo-drop 760ms cubic-bezier(0.3, 1.5, 0.5, 1) calc(160ms + var(--i) * 55ms + 260ms) both;
  }
  /* Waiting to be revealed: hold everything below the baseline. */
  :global(.js-motion) .logo[data-logo-motion='reveal']:not(:global(.is-playing)):not(:global(.is-played)) .logo-l {
    transform: translateY(105%);
  }
  :global(.js-motion) .logo[data-logo-motion='reveal']:not(:global(.is-playing)):not(:global(.is-played)) .logo-stop {
    opacity: 0;
  }

  /* Hover / focus on the surrounding link: the stop hops (the glint is started by the script). */
  :global(.js-motion) :global(a:hover) > .logo:not(:global(.is-playing)) .logo-stop,
  :global(.js-motion) :global(a:focus-visible) > .logo:not(:global(.is-playing)) .logo-stop {
    animation: logo-hop 620ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  :global(.js-motion.logo-intro) :global(a:hover) > .logo[data-logo-motion='intro'] .logo-stop {
    animation: logo-drop 760ms cubic-bezier(0.3, 1.5, 0.5, 1) calc(160ms + var(--i) * 55ms + 260ms) both;
  }

  @keyframes logo-rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @keyframes logo-drop {
    0% {
      transform: translateY(-320%) scale(0.6);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    70% {
      transform: translateY(0) scale(1.2, 0.8);
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes logo-hop {
    0%,
    100% {
      transform: none;
    }
    35% {
      transform: translateY(-55%) scale(0.92, 1.08);
    }
    65% {
      transform: translateY(0) scale(1.18, 0.84);
    }
  }

  /* Print: always the finished logo, whatever state the motion was in. */
  @media print {
    .logo .logo-l,
    .logo .logo-stop {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  /* Windows high-contrast and similar modes: plain system text colour. */
  @media (forced-colors: active) {
    .logo-letters,
    .logo-stop {
      fill: CanvasText;
    }
  }
</style>
