---
/**
 * A heading revealed line by line: each line rises out of a mask as it scrolls into view (CSS scroll timeline, design
 * upgrade Phase 4), or on load for first-screen headings.
 * `lines` may contain inline HTML such as <span class="accent">…</span>. The text reads as one
 * sentence to screen readers; without motion it is simply visible.
 */
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'p';
  lines: string[];
  id?: string;
  class?: string;
  /** First-screen headings: animate on load in CSS instead of waiting for scroll (fast LCP). */
  load?: boolean;
}
const { as: Tag = 'h2', lines, id, class: cls, load = false } = Astro.props;
---

<Tag id={id} class={cls} data-split={load ? 'load' : ''}>
  {
    lines.map((line, i) => (
      <>
        <span class="line-mask" style={`--i:${i}`}>
          <span set:html={line} />
        </span>
        {i < lines.length - 1 ? ' ' : ''}
      </>
    ))
  }
</Tag>
