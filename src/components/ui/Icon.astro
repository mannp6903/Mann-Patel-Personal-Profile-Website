---
/**
 * One icon set for the whole site: 24px grid, 1.75px stroke, round caps (see DESIGN.md).
 * Decorative by default (aria-hidden). Pass `label` only when the icon is the sole content.
 */
const paths = {
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-ne': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'arrow-down': '<path d="M12 5v14"/><path d="m6 13 6 6 6-6"/>',
