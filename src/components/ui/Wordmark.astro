---
/**
 * The MΛNN PΛTEL wordmark (Nov 2026 brand): Geist Regular capitals, +26% tracking with optical
 * pair spacing, the A's drawn without crossbars. Since 18 Nov 2026 each Λ has a "signal gap", a small slanted break in
 * its right leg (Mann's choice; the paths come from scripts/lambda_gap.py). Outlined, so it needs no font. Letters follow
 * `currentColor`; the two Λ's take lime (`--wm-accent`, default `--signal`) unless `accent` is
 * false. Size it by height, or by width with `height: auto` in CSS.
 * Two cuts (design upgrade gate C4, 18 Nov 2026): `regular` (Geist Regular, +26% tracking) for 20px tall and up (the
 * footer, brand files), and `small` (Geist Medium, +20%, scripts/wordmark_cut.py) for smaller uses (the header), where
 * thin Regular strokes read faint. Minimum heights: 12px for the small cut, 20px for the regular (DESIGN.md → Colour →
 * The wordmark).
 * Website Playbook (16 Nov 2026): an image named in Latin letters, "Mann Patel" (role="img"), so screen readers
 * never spell out the Λ's. A link around it still needs its own name (aria-label); a purely decorative copy sits
 * inside aria-hidden (the footer's).
 */
import { profile } from '../../data/site';

interface Props {
  class?: string;
  /** Rendered height in px (CSS can still override it; width follows the aspect ratio). */
  height?: number;
  /** Colour the two Λ's lime. */
  accent?: boolean;
  /**
   * Mark each letter with data-k-ch so the footer's kinetic script can move it. Each letter is a group with a
   * lime copy on top (.wm__lit) that fades in near the pointer: opacity, not fill (SEO audit Phase 4). Design upgrade
   * Phase 4: each group also carries --n (its place) and --dx (how far it starts from its place in the header's
   * once-per-visit "lock-on", away from the centre).
   */
  kinetic?: boolean;
  /** Which outline set: `regular` (20px tall and up) or `small` (under 20px, drawn from Geist Medium). */
  cut?: 'regular' | 'small';
}
const { class: className, height = 14, accent = true, kinetic = false, cut = 'regular' } = Astro.props;

type Letter = { d: string; c: number; lam?: boolean };
/** One outline per letter, in reading order; `lam` marks the crossbar-less A's (two pieces each: the signal gap); `c` is
 * the letter's centre (x). The regular cut: Geist Regular. */
const regular: Letter[] = [
  { d: 'M92 710V0H212L439 616L665 0H785V710H699V160L496 710H381L178 160V710Z', c: 438 },
  { d: 'M1102 710 1358 0 1474 0 1582 299 1502 324 1416 75 1196 710ZM1603 359 1730 710 1636 710 1523 384Z', c: 1416, lam: true },
  { d: 'M2037 710V0H2159L2510 624V0H2596V710H2468L2123 98V710Z', c: 2316 },
  { d: 'M3020 710V0H3142L3493 624V0H3579V710H3451L3106 98V710Z', c: 3300 },
  {
    d: 'M4393 710V0H4648Q4767 0 4833 57Q4899 114 4899 215Q4899 318 4833 376Q4767 434 4648 434H4479V710ZM4479 350H4648Q4809 350 4809 215Q4809 84 4648 84H4479Z',
    c: 4646,
  },
  { d: 'M5131 710 5387 0 5503 0 5611 299 5531 324 5445 75 5225 710ZM5632 359 5759 710 5665 710 5552 384Z', c: 5445, lam: true },
  { d: 'M6117 710V84H5896V0H6424V84H6203V710Z', c: 6160 },
  { d: 'M6768 710V0H7214V84H6854V313H7202V395H6854V626H7222V710Z', c: 6995 },
  { d: 'M7631 710V0H7717V626H8072V710Z', c: 7851 },
];
/** The small cut: Geist Medium, +20% tracking (printed by scripts/wordmark_cut.py). */
const small: Letter[] = [
  { d: 'M86 710V0H234L445 583L656 0H804V710H696V190L505 709H385L194 190V710Z', c: 445 },
  { d: 'M1055 710 1311 0 1445 0 1552 298 1455 327 1378 103 1168 710ZM1574 358 1701 710 1587 710 1476 387Z', c: 1378, lam: true },
  { d: 'M1942 710V0H2079L2407 579V0H2515V710H2373L2050 144V710Z', c: 2229 },
  { d: 'M2867 710V0H3004L3332 579V0H3440V710H3298L2975 144V710Z', c: 3154 },
  {
    d: 'M4182 710V0H4447Q4569 0 4637 59Q4705 117 4705 221Q4705 290 4674 340Q4643 391 4586 418Q4528 444 4447 444H4290V710ZM4290 346H4444Q4517 346 4555 314Q4593 283 4593 221Q4593 160 4555 129Q4517 99 4444 99H4290Z',
    c: 4444,
  },
  { d: 'M4873 710 5129 0 5263 0 5370 298 5273 327 5196 103 4986 710ZM5392 358 5519 710 5405 710 5294 387Z', c: 5196, lam: true },
  { d: 'M5814 710V99H5596V0H6140V99H5922V710Z', c: 5868 },
  { d: 'M6418 710V0H6880V99H6526V306H6868V402H6526V611H6888V710Z', c: 6653 },
  { d: 'M7227 710V0H7335V670L7278 611H7681V710Z', c: 7454 },
];
const cuts = {
  regular: { letters: regular, viewBox: '92 0 7980 710' },
  small: { letters: small, viewBox: '86 0 7595 710' },
};
const { letters, viewBox } = cuts[cut];
const [vx, , vw] = viewBox.split(' ').map(Number);
const width = Math.round(height * (vw / 710) * 100) / 100;
/** The wordmark's centre in its own units. */
const mid = vx + vw / 2;
---

<svg
  class:list={['wm', className]}
  width={width}
  height={height}
  viewBox={viewBox}
  data-cut={cut}
  fill="currentColor"
  data-accent={accent ? '' : undefined}
  role="img"
  aria-label={profile.name}
  focusable="false"
  >{
    letters.map((l, i) =>
      kinetic ? (
        <g data-k-ch data-lam={l.lam ? '' : undefined} style={`--n:${i};--dx:${Math.round((l.c - mid) * 0.25)}`}>
          <path d={l.d} />
          <path class="wm__lit" d={l.d} />
        </g>
      ) : (
        <path d={l.d} data-lam={l.lam ? '' : undefined} />
      ),
    )
  }</svg
>

<style>
  .wm {
    overflow: visible;
  }
  .wm[data-accent] [data-lam] {
    fill: var(--wm-accent, var(--signal));
  }
</style>
