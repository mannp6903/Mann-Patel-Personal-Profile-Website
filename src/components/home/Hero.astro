---
/**
 * Home hero. Since the growth report of 10 Nov 2026 the H1 names the service and the place in
 * plain words ("Web design and local SEO for Toronto service businesses"); the three-word
 * identity, Found. Answered. Booked., sits underneath as a process strip that says what each
 * word means. Two actions with different jobs: the free check (main) and the work.
 *
 * Mann's real photo is a radio station the visitor tunes in (TuneIn.astro, round 8): it locks at
 * 104.3, which flashes the three words and pings the dot field. Beside the copy on tablets and
 * desktops; right after the buttons on phones.
 *
 * The three words still act out what they say (round 9), once, on arrival and again on hover or
 * tap: "Found." is highlighted like a search match and a map pin drops onto its full stop;
 * "Answered." shows a typing bubble that turns into read ticks; "Booked." gets circled like a
 * date on a calendar. All text is visible from the first frame; reduced motion and no JavaScript
 * show the finished state. Why: docs/16-round-9-headline.md and docs/21-growth-seo-launch.md.
 */
import { profile } from '../../data/site';
import Button from '../ui/Button.astro';
import ContactActions from '../ContactActions.astro';
import Field from '../fx/Field.astro';
import TuneIn from './TuneIn.astro';
---

<section class="hero" aria-labelledby="hero-title" data-field-zone>
  <Field preset="hero" class="hero__field" />
  <div class="hero__inner container">
    <div class="hero__meta">
      <p class="eyebrow hero__where">{profile.name} · Independent website designer</p>
      <p class="status status--live hero__status"><span class="status__dot" aria-hidden="true"></span>Taking new projects</p>
    </div>

    <h1 class="hero__title" id="hero-title">
      <span>Web design and local SEO</span>
      <span class="accent">for Toronto service businesses</span>
    </h1>

    <div class="hero__copy">
      <p class="hero__lead">
        I build mobile-friendly websites, improve how customers find you on Google, and connect your forms and follow-up so
        each enquiry has a clear next step.
      </p>
      <div class="hero__actions">
        <div class="btn-row">
          <Button href="/contact/?package=check-up#check">Get a free website and Google check</Button>
          <Button href="/work/" variant="ghost">See the work</Button>
        </div>
        <p class="hero__proof small">
          Serving North York, Scarborough and the GTA. Your domain and accounts stay in your name.
        </p>
        <ContactActions compact label="Or reach me directly" class="hero__reach" />
      </div>
    </div>

    <TuneIn class="hero__tune" />

    {/* The process strip: each word acts out what it says (round 9); the pin, bubble, ticks and circle are decoration. */}
    <ol class="hero__steps" role="list" aria-label="How it works, in three steps">
      <li class="hero__step">
        <span class="hero__step-n num" aria-hidden="true">01</span>
        <span class="hw hw--found" style="--i:0"><span class="hw__w" style="--t0:0.35s" data-scene>Found<span class="hw__p">.<span class="hw__ring" aria-hidden="true"></span><svg class="hw__pin" viewBox="0 0 24 32" aria-hidden="true" focusable="false"><path d="M12 31c-.6 0-1.1-.3-1.4-.8C7.3 24.9 2 18.6 2 12 2 6.5 6.5 2 12 2s10 4.5 10 10c0 6.6-5.3 12.9-8.6 18.2-.3.5-.8.8-1.4.8Z" /><circle cx="12" cy="12" r="4" /></svg></span></span></span>
        <p class="hero__step-d">Clear service pages and local search, so people nearby can find you on Google and Maps.</p>
      </li>
      <li class="hero__step">
        <span class="hero__step-n num" aria-hidden="true">02</span>
        <span class="hw hw--answered" style="--i:1"><span class="hw__w" style="--t0:1.7s" data-scene>Answered<span class="hw__p">.<span class="hw__bubble" aria-hidden="true"><i style="--k:0"></i><i style="--k:1"></i><i style="--k:2"></i></span><svg class="hw__ticks" viewBox="0 0 30 16" aria-hidden="true" focusable="false"><path style="--k:0" pathLength="1" d="M2 8.6l4.2 4.2L15.4 3.6" /><path style="--k:1" pathLength="1" d="M11.4 11.4l1.4 1.4L22 3.6" /></svg></span></span></span>
        <p class="hero__step-d">Enquiries that reach you, tested end to end, with follow-up so each one gets a reply.</p>
      </li>
      <li class="hero__step">
        <span class="hero__step-n num" aria-hidden="true">03</span>
        <span class="hw hw--accent hw--booked" style="--i:2"><span class="hw__w" style="--t0:3.25s" data-scene>Booked.<svg class="hw__circle" viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" vector-effect="non-scaling-stroke" d="M62 106C22 94 4 66 20 40 38 12 118 3 186 7c66 4 110 26 106 58-4 32-72 50-146 49-60-1-112-12-128-36-9-14 2-30 26-42" /></svg></span></span>
        <p class="hero__step-d">A clear way to request a quote or an appointment. Your booking tool, or you, confirm it.</p>
      </li>
    </ol>
  </div>

</section>

<script>
  import { mountTuner } from '../../scripts/tune';
  import { track } from '../../scripts/analytics';
  import { mountHeroWords } from '../../scripts/hero-words';
  document.querySelectorAll<HTMLElement>('[data-tune]').forEach(mountTuner);
  mountHeroWords();
  // How people find him: by hand or left to the auto-tune. Only the method, nothing else.
  addEventListener('tune:locked', (e) => track('tune_in', { method: (e as CustomEvent<{ how: string }>).detail.how }));
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(var(--s-5), 4vw, var(--s-7));
    overflow: clip;
  }
  /* A faint signal halo behind the portrait. */
  .hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: 10%;
    width: min(70vw, 60rem);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(212 248 74 / 0.09), transparent 70%);
    pointer-events: none;
  }
  /* The signal field: centred low behind the portrait on phones, on the portrait side on desktop. */
  .hero :global(.hero__field) {
    --fx: 50%;
    --fy: 80%;
    --fw: 110%;
    --fh: 62%;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  /* ── Title: the service and the place, in two tones (each half balances its own lines) ── */
  .hero__title {
    position: relative;
    z-index: 2;
    font-size: clamp(2.125rem, 0.95rem + 3.1vw, 4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .hero__title > span {
    display: block;
  }

  /* ── Process strip: Found. Answered. Booked., each with what it means ── */
  .hero__steps {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .hero__step {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    justify-items: start;
  }
  .hero__step-n {
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    color: var(--text-3);
  }
  .hero__step-d {
    max-width: 36ch;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-2);
  }
  /* Phones: one compact row per step (the word, then what it means), so the work stays close. */
  @media (max-width: 39.99em) {
    .hero__steps {
      gap: var(--s-4);
    }
    .hero__step {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: var(--s-3);
      align-items: baseline;
    }
    .hero__step-n {
      display: none;
    }
    .hero__step .hw {
      font-size: 1.6rem;
    }
  }
  @media (min-width: 40em) {
    .hero__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-6);
    }
  }
  .hw {
    display: block;
    font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--track-display);
    padding-bottom: 0.04em;
    transition: letter-spacing 900ms var(--ease-out), color 300ms;
  }
  /* "Booked." is the payoff: same face and weight, in lime. */
  .hw--accent {
    color: var(--signal);
  }
  @media (hover: hover) {
    .hw:not(.hw--accent):hover {
      letter-spacing: -0.02em;
    }
  }
  /* Track into place (light and open, settling to semibold and tight): visible from the first
     frame, so it never delays the page. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hw {
      animation: hw-stretch 1500ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms);
    }
    :global(.js) .hw--accent {
      animation-name: hw-accent;
    }
  }
  @keyframes hw-stretch {
    from {
      font-weight: 300;
      letter-spacing: 0.04em;
    }
  }
  @keyframes hw-accent {
    from {
      letter-spacing: 0.25em;
      filter: blur(6px);
    }
  }
  /* Signal locked: the three words flash lime in turn, like a station light coming on. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero:global(.is-locked) .hw {
      animation:
        hw-stretch 1500ms var(--ease-out) both,
        hw-flash 1100ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms), calc(var(--i) * 160ms);
    }
    :global(.js) .hero:global(.is-locked) .hw--accent {
      animation-name: hw-accent, hw-flash-accent;
    }
  }
  @keyframes hw-flash {
    0%,
    100% {
      color: var(--text);
      text-shadow: none;
    }
    18% {
      color: var(--signal);
      text-shadow: 0 0 0.35em rgb(212 248 74 / 0.45);
    }
  }
  @keyframes hw-flash-accent {
    0%,
    100% {
      text-shadow: none;
    }
    18% {
      text-shadow: 0 0 0.35em rgb(212 248 74 / 0.6);
    }
  }
  /* ── The words act out what they say (round 9) ──
     Finished state (also what reduced motion and no JavaScript show): a lime pin on the full stop
     of "Found.", read ticks over the full stop of "Answered.", and "Booked." circled. */
  .hw__w {
    position: relative;
    display: inline-block;
    isolation: isolate;
    /* Replays when hovered or tapped: the hit area is the word. */
    pointer-events: auto;
  }
  .hw__p {
    position: relative;
  }
  .hw__pin,
  .hw__ring,
  .hw__bubble,
  .hw__ticks,
  .hw__circle {
    position: absolute;
    max-width: none;
    pointer-events: none;
  }
  /* "Found.": a search-match highlight sweeps across, then a pin drops onto the full stop. */
  .hw--found .hw__w::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.12em -0.06em 0.04em;
    border-radius: 0.06em;
    background: var(--signal);
    clip-path: inset(0 100% 0 0);
  }
  /* Offsets are from the bottom of the full stop's box, which sits 0.295em below the baseline;
     the full stop's ink is 0.14em tall (measured in Geist SemiBold). */
  .hw__pin {
    left: 50%;
    bottom: 0.5em;
    width: 0.32em;
    height: 0.43em;
    overflow: visible;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    fill: var(--signal);
  }
  .hw__pin circle {
    fill: var(--bg);
  }
  .hw__ring {
    left: 50%;
    bottom: 0.4em;
    width: 0.3em;
    height: 0.3em;
    border: 0.025em solid var(--signal);
    border-radius: 50%;
    transform: translate(-50%, 50%) scale(0);
    opacity: 0;
  }
  /* "Answered.": someone is typing… then the message is read. */
  .hw__bubble {
    right: -0.04em;
    bottom: 1.06em;
    display: flex;
    align-items: center;
    gap: 0.06em;
    padding: 0.09em 0.12em;
    border-radius: 0.16em 0.16em 0.03em 0.16em;
    background: var(--signal);
    transform: scale(0);
    transform-origin: 100% 100%;
  }
  .hw__bubble i {
    width: 0.075em;
    height: 0.075em;
    border-radius: 50%;
    background: var(--on-signal);
  }
  .hw__ticks {
    left: 50%;
    bottom: 0.53em;
    width: 0.42em;
    height: 0.22em;
    overflow: visible;
    transform: translateX(-22%);
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hw__ticks path,
  .hw__circle path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* "Booked.": circled, like a date on a calendar. */
  /* Wide enough on the right to clear the full stop at the baseline, where the loop curves in. */
  .hw__circle {
    inset: -0.1em -0.4em -0.16em -0.2em;
    width: calc(100% + 0.6em);
    height: calc(100% + 0.26em);
    overflow: visible;
    transform: rotate(-2.5deg);
    fill: none;
    stroke: var(--text);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  @media (min-width: 64em) {
    .hw__circle {
      stroke-width: 3.5;
    }
  }
  /* Stacked lines are tighter on phones and tablets: keep the circle off "Answered." */
  @media (max-width: 63.99em) {
    .hw__circle {
      top: 0.02em;
      height: calc(100% + 0.14em);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .hw--found .hw__w {
      /* backwards only: afterwards the colour is inherited again (the tuner's lock flash). */
      animation: hw-find-ink 1.2s linear backwards;
      animation-delay: var(--t0);
    }
    :global(.js-motion) .hw--found .hw__w::before {
      animation: hw-find 1.2s var(--ease-in-out) both;
      animation-delay: var(--t0);
    }
    :global(.js-motion) .hw__pin {
      animation: hw-pin 750ms cubic-bezier(0.3, 1.2, 0.5, 1) both;
      animation-delay: calc(var(--t0) + 1.05s);
    }
    :global(.js-motion) .hw__ring {
      animation: hw-ring 1s var(--ease-out) forwards;
      animation-delay: calc(var(--t0) + 1.5s);
    }
    :global(.js-motion) .hw__bubble {
      animation: hw-bubble 1.35s var(--ease-out) both;
      animation-delay: var(--t0);
    }
    :global(.js-motion) .hw__bubble i {
      animation: hw-typing 520ms ease-in-out 2 both;
      animation-delay: calc(var(--t0) + 0.2s + var(--k) * 110ms);
    }
    :global(.js-motion) .hw__ticks path {
      animation: hw-draw 380ms var(--ease-out) both;
      animation-delay: calc(var(--t0) + 1.3s + var(--k) * 160ms);
    }
    :global(.js-motion) .hw__circle path {
      animation: hw-draw 950ms var(--ease-in-out) both;
      animation-delay: var(--t0);
    }
  }
  @keyframes hw-find {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    28%,
    66% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes hw-find-ink {
    0%,
    22% {
      color: var(--text);
    }
    30%,
    64% {
      color: var(--on-signal);
    }
    80%,
    100% {
      color: var(--text);
    }
  }
  @keyframes hw-pin {
    0% {
      transform: translate(-50%, -1.6em);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    58% {
      transform: translate(-50%, 0) scale(1.08, 0.82);
    }
    76% {
      transform: translate(-50%, -0.14em);
    }
    100% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
  }
  @keyframes hw-ring {
    0% {
      transform: translate(-50%, 50%) scale(0.3);
      opacity: 0.9;
    }
    100% {
      transform: translate(-50%, 50%) scale(3.4);
      opacity: 0;
    }
  }
  @keyframes hw-bubble {
    0% {
      transform: scale(0);
    }
    14%,
    84% {
      transform: scale(1);
    }
    100% {
      transform: scale(0);
    }
  }
  @keyframes hw-typing {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    50% {
      transform: translateY(-40%);
      opacity: 1;
    }
  }
  @keyframes hw-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--s-6);
  }
  .hero__lead {
    max-width: 46ch;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }
  .hero__proof {
    max-width: 46ch;
    color: var(--text-3);
  }
  .hero__actions {
    display: grid;
    gap: var(--s-5);
  }
  /* Direct contact sits on one line under the buttons: label, then round icons. */
  .hero__actions :global(.hero__reach) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  /* ── Tuner ── */
  .hero :global(.hero__tune) {
    justify-self: start;
  }
  /* Phones: the tuner follows the buttons and starts its show when it scrolls into view. (Placed
     higher, the photo becomes the largest first-screen element and slows the measured LCP.) */
  /* Tablets: the copy and the tuner side by side under the headline. */
  @media (min-width: 40em) and (max-width: 63.99em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
      column-gap: var(--s-6);
    }
    .hero__meta,
    .hero__title,
    .hero__steps {
      grid-column: 1 / -1;
    }
    .hero__copy {
      grid-column: 1;
      align-self: start;
    }
    .hero :global(.hero__tune) {
      grid-column: 2;
      align-self: start;
    }
  }

  /* Phones: the header's Contact button and the footer already carry direct contact. */
  @media (max-width: 39.99em) {
    .hero__actions :global(.hero__reach) {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .hero :global(.hero__field) {
      --fx: 74%;
      --fy: 50%;
      --fw: 62%;
      --fh: 90%;
    }
    .hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr auto;
      column-gap: var(--s-5);
      row-gap: clamp(var(--s-5), 4vh, var(--s-7));
    }
    .hero__meta {
      grid-column: 1 / -1;
    }
    .hero__title {
      grid-column: 1 / 8;
      grid-row: 2;
      align-self: start;
    }
    .hero__steps {
      grid-column: 1 / -1;
      grid-row: 4;
    }
    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 3;
      align-self: start;
      gap: var(--s-5);
    }
    .hero :global(.hero__tune) {
      grid-column: 8 / 13;
      grid-row: 2 / 4;
      align-self: center;
      justify-self: end;
      max-width: 30rem;
    }
    .hero__actions {
      gap: var(--s-4);
    }
  }
</style>
