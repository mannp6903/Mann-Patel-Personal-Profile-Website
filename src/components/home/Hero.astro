---
/**
 * Home hero: cut-out portrait on warm stone, a giant name that slides sideways (direction
 * follows the scroll, speed follows scroll velocity), a location pill with a spinning globe,
 * and the role line. The moving name is decorative (aria-hidden); the real H1 is text.
 * A Pause button stops the movement (WCAG 2.2.2); reduced motion keeps it still.
 */
import { Image } from 'astro:assets';
import cutout from '../../assets/mann-patel-portrait-cutout.png';
import { profile } from '../../data/site';
---

<section class="hx" data-hero>

  <Image
    src={cutout}
    alt="Mann Patel smiling, in a dark green sweatshirt."
    widths={[480, 720, 960, 1060]}
    sizes="(min-width: 64em) 52rem, 120vw"
    width={1060}
    height={1060}
    loading="eager"
    fetchpriority="high"
    class="hx-portrait"
  />

  <p class="hx-loc">
    <span class="hx-loc-text">Based in<br />Toronto, Canada</span>
    <span class="hx-globe" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="20" cy="20" r="17"></circle>
        <path d="M3 20h34M20 3c-5 5-7 11-7 17s2 12 7 17M20 3c5 5 7 11 7 17s-2 12-7 17"></path>
        <ellipse class="hx-meridian" cx="20" cy="20" rx="9" ry="17"></ellipse>
      </svg>
    </span>
  </p>

  <div class="hx-role">
    <svg class="hx-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 5l14 14M19 8v11H8"></path>
    </svg>
    <div class="hx-copy">
      <p class="hx-eyebrow">Based in Toronto, Canada</p>
      <h1 class="hx-title">
        <span class="visually-hidden">{profile.name}: </span>Websites &amp; simpler <br class="br" />systems for small <br class="br" />businesses
      </h1>
      <div class="hx-actions">
        <a class="btn" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--secondary" href="#work">See my work</a>
      </div>
    </div>
  </div>

  <div class="hx-name" aria-hidden="true">
    <div class="hx-track" data-hero-track>
      <span>Mann Patel —&nbsp;</span><span>Mann Patel —&nbsp;</span><span>Mann Patel —&nbsp;</span>
    </div>
  </div>

  <button class="hx-pause" type="button" aria-pressed="false" data-hero-pause>
    <span class="hx-pause-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Pause the moving name</span>
  </button>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const track = hero?.querySelector<HTMLElement>('[data-hero-track]');
  const pauseBtn = hero?.querySelector<HTMLButtonElement>('[data-hero-pause]');
  const motion = document.documentElement.classList.contains('js-motion');

  if (hero && track && pauseBtn && motion) {
    let x = 0; // percent of the track (one copy = 33.333%)
    let dir = -1;
    let lastY = window.scrollY;
    let boost = 0;
    let visible = true;
    let paused = false;
    let raf = 0;
    try {
      paused = sessionStorage.getItem('mp-hero-paused') === '1';
    } catch {
      /* ignore */
    }
    const setPaused = (p: boolean) => {
      paused = p;
      pauseBtn.setAttribute('aria-pressed', String(p));
      try {
        sessionStorage.setItem('mp-hero-paused', p ? '1' : '0');
      } catch {
        /* ignore */
      }
      if (!p) loop();
    };
    const loop = () => {
      cancelAnimationFrame(raf);
      const frame = () => {
        if (paused || !visible) return;
        const y = window.scrollY;
        const dy = y - lastY;
        lastY = y;
        if (dy !== 0) dir = dy > 0 ? -1 : 1;
        boost = Math.max(boost * 0.92, Math.min(Math.abs(dy) * 0.012, 0.5));
        x += dir * (0.02 + boost);
        if (x <= -33.3333) x += 33.3333;
        if (x > 0) x -= 33.3333;
        track.style.transform = `translate3d(${x}%, 0, 0)`;
        raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    };
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    pauseBtn.setAttribute('aria-pressed', String(paused));
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) loop();
    }).observe(hero);
    // Parallax: the portrait drifts down slightly as the hero scrolls away.
    const portrait = hero.querySelector<HTMLElement>('.hx-portrait');
    window.addEventListener(
      'scroll',
      () => {
        if (!visible || !portrait) return;
        portrait.style.setProperty('--py', `${Math.min(window.scrollY * 0.18, 160)}px`);
      },
      { passive: true },
    );
    loop();
  } else if (pauseBtn) {
    pauseBtn.hidden = true;
  }
</script>

<style>
  .hx {
    position: relative;
    isolation: isolate;
    min-height: max(40rem, min(100svh, 62rem));
    background: var(--hero-bg);
    color: var(--ink);
    overflow: hidden;
  }
  .hx-portrait {
    position: absolute;
    z-index: 0;
    bottom: 0;
    left: 50%;
    translate: -50% var(--py, 0px);
    height: min(92%, 58rem, 100vw);
    width: auto;
    max-width: none;
    pointer-events: none;
    user-select: none;
  }
  /* Location pill, attached to the left edge */
  .hx-loc {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 46%;
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding: var(--space-s) var(--space-s) var(--space-s) var(--gutter);
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    line-height: 1.25;
  }
  .hx-globe {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--night-2);
  }
  .hx-globe svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  .hx-meridian {
    transform-origin: 20px 20px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hx-meridian {
      animation: meridian 3.2s linear infinite;
    }
  }
  @keyframes meridian {
    from {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(-1);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Role line on the right */
  .hx-role {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    top: 38%;
    display: grid;
    gap: var(--space-l);
    font-size: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .hx-arrow {
    width: 1.4em;
    height: 1.4em;
  }
  .hx-copy {
    display: grid;
    gap: var(--space-m);
  }
  .hx-eyebrow {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .hx-title {
    font-family: var(--font-display);
    font-size: inherit;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: none;
  }
  .hx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .hx-actions .btn--secondary {
    --btn-bg: transparent;
  }
  /* The giant name */
  .hx-name {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 5vh, 4rem);
    overflow: hidden;
    pointer-events: none;
  }
  .hx-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 3rem + 13vw, 15rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--paper);
    will-change: transform;
  }
  .hx-pause {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    bottom: var(--space-s);
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1.5px solid rgb(21 23 26 / 0.35);
    border-radius: 50%;
    background: rgb(244 241 234 / 0.88); /* readable over the photo as well as the grey */
    color: var(--ink);
    cursor: pointer;
  }
  .hx-pause:hover {
    border-color: var(--ink);
  }
  .hx-pause:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .hx-pause-icon {
    width: 11px;
    height: 13px;
    border-inline: 3.5px solid currentColor;
  }
  .hx-pause[aria-pressed='true'] .hx-pause-icon {
    width: 0;
    height: 0;
    border-inline: 0;
    border-block: 6.5px solid transparent;
    border-left: 11px solid currentColor;
    margin-left: 3px;
  }

  @media (max-width: 47.99em) {
    .hx {
      min-height: max(38rem, min(100svh, 52rem));
    }
    /* Phones: fill a taller box, cropping only the empty sides of the square cut-out. */
    .hx-portrait {
      left: 0;
      translate: 0 var(--py, 0px);
      width: 100%;
      height: min(58%, 32rem);
      object-fit: cover;
      object-position: 50% 0;
    }
    /* Phones: the location becomes a small line above the promise, and the promise and
       both actions sit above the portrait so they are visible without scrolling. */
    .hx-loc {
      display: none;
    }
    .hx-eyebrow {
      display: block;
    }
    .hx-role {
      top: 5.75rem;
      right: var(--gutter);
      left: var(--gutter);
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: var(--space-xs);
      font-size: var(--step-1);
    }
    .hx-arrow {
      width: 1.1em;
      height: 1.1em;
      margin-top: 1.6rem;
    }
    .hx-copy {
      gap: var(--space-s);
    }
    .hx-actions .btn {
      min-height: var(--tap);
      padding: 0.6em 1.05em;
      font-size: var(--step--1);
    }
  }
</style>
