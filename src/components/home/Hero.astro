---
/**
 * Home hero: "Get found. Answer fast. Get booked."
 *
 * The promise is shown, not just told. Beside the real photo, a short sample plays the three
 * steps a customer takes with a local business: they find it on Google, their missed call gets
 * a text back, and they book. As each step plays, the matching phrase in the H1 lights up.
 *
 * - The sample is fictional and labelled "Sample". It is an accessible carousel (APG pattern):
 *   tabs to choose a step, a Pause button, and rotation that stops on hover, on focus, when
 *   off screen, and after the visitor picks a step. Reduced motion: no rotation; tabs still work.
 * - Without JavaScript all three steps are shown one under another.
 * - The H1 text itself never moves, so it paints immediately (LCP).
 * - Layout rule kept from round 4: nothing covers the face in the photo.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/mann-patel-portrait.jpg';
import { profile } from '../../data/site';
import ContactActions from '../ContactActions.astro';
import { freeCheck, freeCheckNote } from '../../data/free-check';

const phrases = ['Get found.', 'Answer fast.', 'Get booked.'];
const steps = [
  { id: 'found', label: 'Found' },
  { id: 'answered', label: 'Answered' },
  { id: 'booked', label: 'Booked' },
];
const tick =
  '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<section class="hp" aria-labelledby="hp-title" data-hp data-step="0">
  <span class="hp-glow" aria-hidden="true"></span>
  <div class="container hp-grid">
    <div class="hp-copy">
      <p class="hp-status hp-in" style="--d:0">
        <span class="hp-pulse" aria-hidden="true"></span>
        Taking new projects · Toronto &amp; the GTA
      </p>
      <h1 id="hp-title" class="hp-title">
        <span class="visually-hidden">{profile.name}: </span>{
          phrases.map((p, i) => (
            <>
              <span class="hp-k" data-k={i}>{p}</span>{' '}
            </>
          ))
        }
      </h1>
      <p class="hp-lead">
        I help Toronto small businesses show up on Google, reply to every call and message, and turn website visits
        into bookings. Set up properly, in your name, by someone who runs a small business too.
      </p>
      <div class="hp-actions hp-in" style="--d:2">
        <a class="btn" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--secondary" href="/contact/?package=check-up#brief" aria-describedby="hp-limit">Free Found &amp; Answered check</a>
      </div>
      <p class:list={['hp-limit', 'hp-in', { 'is-full': freeCheck.fullThisMonth }]} id="hp-limit" style="--d:3">
        <span class="hp-limit-dot" aria-hidden="true"></span>{freeCheckNote}
      </p>
      <ul class="hp-trust hp-in" style="--d:4" role="list">
        <li><span class="hp-tick" set:html={tick} />Written quote before any work</li>
        <li><span class="hp-tick" set:html={tick} />Every account stays in your name</li>
        <li><span class="hp-tick" set:html={tick} />Run by a local business founder</li>
      </ul>
      <ContactActions label="Or reach me directly" class="hp-reach hp-in" />
    </div>

    <div class="hp-visual" data-hp-visual>
      <div class="hp-frame">
        <figure class="hp-photo">
          <div class="hp-clip">
            <Image
              src={portrait}
              alt={profile.portrait?.alt ?? 'Mann Patel'}
              widths={[420, 640, 880, 1060]}
              sizes="(min-width: 30em) 26rem, 92vw"
              loading="eager"
              fetchpriority="high"
              class="hp-img"
            />
            <span class="hp-shutter" aria-hidden="true"></span>
            <span class="hp-glare" aria-hidden="true"></span>
          </div>
          <figcaption class="hp-badge">
            <strong>Mann Patel</strong>
            <span class="hp-time" data-hp-time>Founder · Toronto</span>
          </figcaption>
        </figure>

        <div
          class="hp-story"
          role="region"
          aria-roledescription="carousel"
          aria-label="Sample: how a customer finds, contacts and books a local business"
          data-story
        >
          <div class="hs-head">
            <span class="hs-tag">Sample</span>
            <span class="hs-title">How it works</span>
            <button class="hs-pause" type="button" aria-label="Pause the sample" data-story-pause hidden>
              <span class="hs-pause-icon" aria-hidden="true"></span>
            </button>
          </div>
          <div class="hs-tabs" role="tablist" aria-label="Steps">
            {
              steps.map((st, i) => (
                <button
                  class="hs-tab"
                  type="button"
                  role="tab"
                  id={`hs-tab-${st.id}`}
                  aria-controls={`hs-panel-${st.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-story-tab={i}
                >
                  <span class="hs-label">
                    <span class="hs-n" aria-hidden="true">{i + 1}</span>
                    {st.label}
                  </span>
                  <span class="hs-bar" aria-hidden="true"><span></span></span>
                </button>
              ))
            }
          </div>

          <div class="hs-panels">
            <div class="hs-panel is-active" role="tabpanel" id="hs-panel-found" aria-labelledby="hs-tab-found" data-story-panel="0">
              <p class="hs-step">1 · Found</p>
              <div class="sc-search">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                <span>dog groomer near me</span>
              </div>
              <div class="sc-card sc-pop" style="--p:1">
                <p class="sc-row"><strong>Bloom &amp; Bark Grooming</strong><span class="sc-open">Open</span></p>
                <p class="sc-rating"><span class="sc-stars" aria-hidden="true">★★★★★</span> 4.9 <span class="sc-muted">(127 reviews)</span></p>
                <p class="sc-muted">Dog groomer · Closes 6 p.m.</p>
                <p class="sc-chips" aria-hidden="true"><span>Call</span><span class="is-main">Book</span><span>Directions</span></p>
              </div>
            </div>

            <div class="hs-panel" role="tabpanel" id="hs-panel-answered" aria-labelledby="hs-tab-answered" data-story-panel="1">
              <p class="hs-step">2 · Answered</p>
              <p class="sc-missed">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 3.5h2.6l1.4 4.1-2 1.5a12.3 12.3 0 0 0 6.3 6.3l1.5-2 4.1 1.4v2.6a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M15 4l5 5M20 4l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
                Missed call · 9:41 a.m.
              </p>
              <p class="sc-bubble sc-out sc-pop" style="--p:1">
                <span class="sc-from">Automatic text-back</span>
                Sorry we missed you, we’re with a client! Want to book? Reply here or tap our booking link.
              </p>
              <p class="sc-bubble sc-in sc-pop" style="--p:2">Saturday morning, for a large dog?</p>
            </div>

            <div class="hs-panel" role="tabpanel" id="hs-panel-booked" aria-labelledby="hs-tab-booked" data-story-panel="2">
              <p class="hs-step">3 · Booked</p>
              <div class="sc-cal sc-pop" style="--p:0">
                <p class="sc-date" aria-hidden="true"><span>Sat</span><strong>10:00</strong></p>
                <p class="sc-what"><strong>Full groom, large dog</strong><span class="sc-muted">Saturday 10 a.m. · Priya S.</span></p>
                <span class="sc-ok">Booked</span>
              </div>
              <ul class="sc-list" role="list">
                <li class="sc-pop" style="--p:1"><span class="hp-tick" set:html={tick} />Reminder set for Friday</li>
                <li class="sc-pop" style="--p:2"><span class="hp-tick" set:html={tick} />Added to the enquiry list</li>
                <li class="sc-pop" style="--p:3"><span class="hp-tick" set:html={tick} />Review request after the visit</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hp]');
  const motion = document.documentElement.classList.contains('js-motion');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Live Toronto time on the name badge (it sits on the photo's corner, clear of the face).
  const timeEl = hero?.querySelector<HTMLElement>('[data-hp-time]');
  if (timeEl) {
    const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto', hour: 'numeric', minute: '2-digit' });
    const tick = () => (timeEl.textContent = `Toronto · ${fmt.format(new Date())}`);
    tick();
    window.setInterval(tick, 30_000);
  }

  // ── The sample: Found → Answered → Booked ───────────────────────────────
  const story = hero?.querySelector<HTMLElement>('[data-story]');
  if (hero && story) {
    const tabs = [...story.querySelectorAll<HTMLButtonElement>('[data-story-tab]')];
    const panels = [...story.querySelectorAll<HTMLElement>('[data-story-panel]')];
    const pause = story.querySelector<HTMLButtonElement>('[data-story-pause]')!;
    let index = 0;
    let userPaused = false;
    let hovered = false;
    let focused = false;
    let visible = false;

    const show = (i: number) => {
      index = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('is-done', k < index);
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === index));
      hero.dataset.step = String(index);
    };

    // Rotation runs only while nobody is reading or using it (APG carousel guidance).
    const update = () => {
      const running = motion && !userPaused && !hovered && !focused && visible;
      story.classList.toggle('is-playing', running);
    };
    const setUserPaused = (p: boolean) => {
      userPaused = p;
      pause.setAttribute('aria-label', p ? 'Play the sample' : 'Pause the sample');
      pause.classList.toggle('is-paused', p);
      update();
    };

    hero.classList.add('is-synced');
    story.classList.add('is-js');
    if (motion) {
      story.classList.add('is-auto');
      pause.hidden = false;
      pause.addEventListener('click', () => setUserPaused(!userPaused));
      // The active tab's progress bar is a CSS animation; when it ends, move on.
      story.addEventListener('animationend', (e) => {
        if ((e.target as Element).closest('.hs-bar') && story.classList.contains('is-playing')) show(index + 1);
      });
      story.addEventListener('pointerenter', () => ((hovered = true), update()));
      story.addEventListener('pointerleave', () => ((hovered = false), update()));
      story.addEventListener('focusin', () => ((focused = true), update()));
      story.addEventListener('focusout', (e) => {
        if (!story.contains(e.relatedTarget as Node | null)) {
          focused = false;
          update();
        }
      });
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      }, { threshold: 0.4 }).observe(story);
    }

    tabs.forEach((t, k) =>
      t.addEventListener('click', () => {
        show(k);
        if (motion) setUserPaused(true); // the visitor took over; stop rotating
      }),
    );
    story.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const next = key === 'ArrowRight' ? index + 1 : key === 'ArrowLeft' ? index - 1 : key === 'Home' ? 0 : key === 'End' ? tabs.length - 1 : null;
      if (next === null) return;
      e.preventDefault();
      show(next);
      tabs[index].focus();
      if (motion) setUserPaused(true);
    });
    show(0);
  }

  // ── Pointer effects (mouse/trackpad only, never with reduced motion) ──────
  const visual = hero?.querySelector<HTMLElement>('[data-hp-visual]');
  if (hero && visual && motion && fine) {
    // A soft light follows the pointer across the hero.
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
      hero.style.setProperty('--my', `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
    });

    // The photo leans toward the pointer and the sample card drifts the other way.
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;
    const step = () => {
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      visual.style.setProperty('--rx', x.toFixed(3));
      visual.style.setProperty('--ry', y.toFixed(3));
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(step) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(step);
    };
    visual.addEventListener('pointermove', (e) => {
      const r = visual.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width - 0.5;
      ty = (e.clientY - r.top) / r.height - 0.5;
      visual.style.setProperty('--gx', `${((tx + 0.5) * 100).toFixed(1)}%`);
      visual.style.setProperty('--gy', `${((ty + 0.5) * 100).toFixed(1)}%`);
      visual.classList.add('is-tilting');
      kick();
    });
    visual.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      visual.classList.remove('is-tilting');
      kick();
    });
  }
</script>

<style>
  .hp {
    --mx: 78%;
    --my: 28%;
    position: relative;
    isolation: isolate;
    padding-block: clamp(1.5rem, 0.5rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  /* A warm light behind the hero; it follows the pointer on desktop. */
  .hp-glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(42rem circle at var(--mx) var(--my), rgb(217 72 28 / 0.11), transparent 62%);
    pointer-events: none;
  }
  .hp-grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    align-items: center;
  }
  @media (min-width: 64em) {
    .hp-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(2rem, 4vw, 5rem);
    }
  }

  /* ── Copy ── */
  .hp-copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    min-width: 0;
  }
  .hp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .hp-pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ok);
  }
  .hp-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--ok);
    opacity: 0;
  }
  :global(.js-motion) .hp-pulse::after {
    animation: hp-ring 2.2s var(--ease-out) infinite;
  }
  @keyframes hp-ring {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  /* H1: three short lines. The phrase for the step on screen lights up and underlines. */
  .hp-title {
    font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hp-k {
    position: relative;
    display: block;
    width: fit-content;
    transition: color 450ms var(--ease-out);
  }
  .hp-k::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.1em;
    bottom: 0.02em;
    height: 0.085em;
    border-radius: 0.1em;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .hp.is-synced[data-step='0'] .hp-k[data-k='0'],
  .hp.is-synced[data-step='1'] .hp-k[data-k='1'],
  .hp.is-synced[data-step='2'] .hp-k[data-k='2'] {
    color: var(--accent-text);
  }
  .hp.is-synced[data-step='0'] .hp-k[data-k='0']::after,
  .hp.is-synced[data-step='1'] .hp-k[data-k='1']::after,
  .hp.is-synced[data-step='2'] .hp-k[data-k='2']::after {
    transform: scaleX(1);
  }
  .hp-lead {
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .hp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .hp-limit {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5em;
    margin-top: calc(var(--space-xs) * -1);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .hp-limit-dot {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.45em;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
  }
  .hp-limit.is-full .hp-limit-dot {
    background: var(--control);
  }
  .hp-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .hp-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .hp-tick {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--ok);
    color: #fff;
  }
  .hp-tick :global(svg) {
    width: 0.72rem;
  }
  .hp-copy :global(.hp-reach) {
    margin-top: var(--space-2xs);
    padding-top: var(--space-m);
    border-top: 1px dashed var(--line);
    width: min(100%, 34rem);
  }
  /* Entrance: supporting lines rise in after the headline (the H1 itself never moves). */
  :global(.js-motion) .hp-in,
  :global(.js-motion) .hp-copy :global(.hp-in) {
    animation: hp-rise 700ms var(--ease-out) backwards;
    animation-delay: calc(120ms + var(--d, 4) * 90ms);
  }
  @keyframes hp-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ── Visual ── */
  .hp-visual {
    --rx: 0;
    --ry: 0;
    position: relative;
    display: grid;
    justify-items: center;
    min-width: 0;
  }
  /* A dotted "desk mat" behind the photo. */
  .hp-visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 6% -4% 14% 12%;
    border-radius: 28px;
    background: radial-gradient(circle, rgb(21 23 26 / 0.16) 1.2px, transparent 1.4px) 0 0 / 16px 16px;
    transform: translate(calc(var(--rx) * -14px), calc(var(--ry) * -14px));
  }
  /*
   * Layout rule: nothing may cover the face. The face sits in the middle of the upper half
   * of the photo, so the name badge hangs off the top-right corner (above the head) and the
   * sample card overlaps only the bottom of the photo (the sweatshirt), at every screen width.
   */
  .hp-frame {
    position: relative;
    width: min(100%, 26rem);
    padding-top: 2.25rem; /* room for the badge that hangs above the corner */
  }
  @media (min-width: 64em) {
    .hp-visual {
      justify-items: end;
    }
    .hp-frame {
      width: min(100% - 2.25rem, 26rem);
      margin-bottom: 8rem;
    }
  }
  .hp-photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    transform: perspective(1100px) rotateX(calc(var(--ry) * -7deg)) rotateY(calc(var(--rx) * 9deg));
  }
  .hp-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 28px;
    background: #2c3a33;
    box-shadow: 0 40px 70px -40px rgb(21 23 26 / 0.55), 0 1px 0 rgb(21 23 26 / 0.08);
  }
  .hp-clip :global(.hp-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.04) translate(calc(var(--rx) * -10px), calc(var(--ry) * -10px));
  }
  .hp-glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--gx, 30%) var(--gy, 20%), rgb(255 255 255 / 0.28), transparent 45%);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }
  .hp-visual.is-tilting .hp-glare {
    opacity: 1;
  }
  /* Shutter: a panel that lifts off the photo on load (the photo is painted underneath). */
  .hp-shutter {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: top;
    pointer-events: none;
  }
  :global(.js-motion) .hp-shutter {
    animation: hp-shutter 900ms 100ms cubic-bezier(0.76, 0, 0.24, 1) backwards;
  }
  @keyframes hp-shutter {
    from {
      transform: scaleY(1);
    }
  }
  /* Name badge: a small tag clipped to the top-right corner, above the head. */
  .hp-badge {
    position: absolute;
    z-index: 1;
    top: -2.25rem;
    right: -0.5rem;
    display: grid;
    gap: 0.05rem;
    padding: 0.45rem 0.85rem 0.5rem;
    border-radius: 12px;
    background: var(--card);
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.3;
    box-shadow: 0 12px 26px -16px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(21 23 26 / 0.06);
    transform: rotate(2deg);
  }
  @media (min-width: 64em) {
    .hp-badge {
      right: -1rem;
    }
  }
  .hp-badge strong {
    font-family: var(--font-display);
    font-size: var(--step-0);
  }
  .hp-time {
    font-family: var(--font-mono);
    color: var(--ink-2);
    white-space: nowrap;
  }

