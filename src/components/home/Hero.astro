---
/**
 * Home hero. The H1 is the promise in three words plus one plain sentence. The words stretch
 * into place (variable-font width), so the heading is never hidden while it animates.
 * The portrait is a halftone canvas (src/scripts/halftone.ts) over the real cut-out photo.
 */
import { Image } from 'astro:assets';
import cutout from '../../assets/mann-patel-cutout.png';
import { groups } from '../../data/services';
import { profile } from '../../data/site';
import Button from '../ui/Button.astro';
import ContactActions from '../ContactActions.astro';
import Icon from '../ui/Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__meta">
      <p class="eyebrow">{profile.name} · {profile.location}, Canada</p>
      <p class="status status--live"><span class="status__dot" aria-hidden="true"></span>Taking new projects</p>
    </div>

    <h1 class="hero__title" id="hero-title">
      <span class="hw" style="--i:0">Found.</span>
      <span class="hw" style="--i:1">Answered.</span>
      <span class="hw hw--serif" style="--i:2">Booked.</span>
      <span class="hero__sub">I help small businesses in Toronto and the GTA get all three.</span>
    </h1>

    <div class="hero__copy">
      <p class="hero__lead">
        Your Google profile and real reviews, a quick reply to every call and message, and a website with a
        book-or-quote button on every page. Set up by me, owned by you.
      </p>
      <div class="hero__actions">
        <div class="btn-row">
          <Button href="/contact/">Start a project</Button>
          <Button href="/contact/?package=check-up#brief" variant="ghost">Get the free check</Button>
        </div>
        <ContactActions compact label="Or reach me directly" class="hero__reach" />
      </div>
    </div>

    <figure class="hero__portrait" data-halftone>
      <div class="hp__stage">
        <Image
          src={cutout}
          alt="Mann Patel smiling, in a dark green sweatshirt."
          widths={[360, 540, 720, 914]}
          sizes="(min-width: 64em) 40vw, 92vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          class="hp__img"
          data-ht-img
        />
        <canvas class="hp__canvas" aria-hidden="true" data-ht-canvas></canvas>
      </div>
      <figcaption class="hp__cap">
        <span class="hp__who">
          <span>Mann Patel</span>
          <span class="num subtle">43.65° N · 79.38° W</span>
        </span>
        <button class="hp__toggle" type="button" aria-pressed="false" data-ht-toggle>
          <span class="hp__switch" aria-hidden="true"><i></i></span>
          Show photo
        </button>
      </figcaption>
    </figure>
  </div>

  <nav class="hero__index container" aria-label="What I help with">
    <ol role="list">
      {
        groups.map((g, i) => (
          <li data-reveal style={`--d:${500 + i * 90}`}>
            <a href={`#${g.id}`}>
              <span class="hi__letter num">{g.letter}</span>
              <span class="hi__verb">{g.verb}</span>
              <span class="hi__title subtle">{g.title}</span>
              <Icon name="arrow-down" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<script>
  import { mountHalftone } from '../../scripts/halftone';
  document.querySelectorAll<HTMLElement>('[data-halftone]').forEach(mountHalftone);
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(var(--s-5), 4vw, var(--s-7));
    overflow: clip;
  }
  /* A faint signal halo behind the portrait. */
  .hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: 10%;
    width: min(70vw, 60rem);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(212 248 74 / 0.09), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }

  /* ── Title ── */
  .hero__title {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-stretch: 116%;
  }
  /* The title's box overlaps the portrait on desktop: let the pointer through to the dots,
     except over the words themselves. */
  .hero__title {
    pointer-events: none;
  }
  .hw,
  .hero__sub {
    pointer-events: auto;
    justify-self: start;
  }
  .hw {
    display: block;
    font-stretch: 116%;
    padding-bottom: 0.04em;
    transition: font-stretch 900ms var(--ease-out), font-weight 900ms var(--ease-out), color 300ms;
  }
  .hw--serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: -0.02em;
    line-height: 0.8;
    color: var(--signal);
    padding-bottom: 0.08em;
  }
  @media (hover: hover) {
    .hw:not(.hw--serif):hover {
      font-stretch: 125%;
      font-weight: 900;
    }
  }
  /* Stretch into place: visible from the first frame, so it never delays the page. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hw {
      animation: hw-stretch 1500ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms);
    }
    :global(.js) .hw--serif {
      animation-name: hw-serif;
    }
  }
  @keyframes hw-stretch {
    from {
      font-stretch: 75%;
      font-weight: 500;
      letter-spacing: 0.02em;
    }
  }
  @keyframes hw-serif {
    from {
      letter-spacing: 0.25em;
      filter: blur(6px);
    }
  }
  .hero__sub {
    display: block;
    margin-top: var(--s-5);
    max-width: 24ch;
    font-size: var(--fs-lead);
    font-weight: 560;
    font-stretch: 100%;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--s-6);
  }
  .hero__lead {
    max-width: 46ch;
    color: var(--text-2);
    font-size: 1.0625rem;
  }
  .hero__actions {
    display: grid;
    gap: var(--s-5);
  }
  /* Direct contact sits on one line under the buttons: label, then round icons. */
  .hero__actions :global(.hero__reach) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  /* ── Portrait ── */
  .hero__portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .hp__stage {
    position: relative;
    aspect-ratio: 914 / 964;
  }
  .hp__img,
  .hp__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    transition: opacity 900ms var(--ease-out);
  }
  .hp__canvas {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready) .hp__canvas {
    opacity: 1;
  }
  .hero__portrait:global(.is-ready) .hp__img {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready.is-photo) .hp__canvas {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready.is-photo) .hp__img {
    opacity: 1;
  }
  .hp__cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: 560;
  }
  .hp__who {
    display: grid;
    gap: 0.1rem;
  }
  .hp__who .num {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .hp__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    padding: 0 0.9rem 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--text-2);
    cursor: pointer;
    transition: border-color var(--t-fast), color var(--t-fast);
  }
  .hero__portrait:global(.is-ready) .hp__toggle {
    display: inline-flex;
  }
  .hp__toggle:hover {
    border-color: var(--control);
    color: var(--text);
  }
  .hp__switch {
    position: relative;
    width: 2rem;
    height: 1.125rem;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    border: 1px solid var(--control);
    transition: background-color var(--t-base);
  }
  .hp__switch i {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--text-2);
    transition: transform var(--t-base) var(--ease-spring), background-color var(--t-base);
  }
  .hp__toggle[aria-pressed='true'] .hp__switch {
    background: var(--signal);
    border-color: var(--signal);
  }
  .hp__toggle[aria-pressed='true'] .hp__switch i {
    transform: translateX(0.85rem);
    background: var(--on-signal);
  }

  /* ── Index strip ── */
  .hero__index {
    position: relative;
    z-index: 2;
    margin-top: var(--s-7);
  }
  .hero__index ol {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .hero__index li + li {
    border-top: 1px solid var(--line);
  }
  .hero__index a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    min-height: 4rem;
    padding-block: var(--s-3);
    text-decoration: none;
  }
  .hi__letter {
    font-size: var(--fs-xs);
    color: var(--signal);
  }
  .hi__verb {
    font-weight: 640;
    font-stretch: 110%;
    letter-spacing: -0.01em;
  }
  .hi__title {
    display: none;
    font-size: var(--fs-sm);
  }
  .hero__index .icon {
    color: var(--text-3);
    transition: transform var(--t-base) var(--ease-out), color var(--t-fast);
  }
  .hero__index a:hover .icon {
    transform: translateY(3px);
    color: var(--signal);
  }
  .hero__index a:hover .hi__verb {
    color: var(--signal);
  }

  @media (min-width: 40em) {
    .hero__index ol {
      grid-template-columns: repeat(3, 1fr);
      border-top: 0;
    }
    .hero__index li,
    .hero__index li + li {
      border-top: 1px solid var(--line);
    }
    .hero__index li + li {
      border-left: 1px solid var(--line);
      padding-left: var(--s-5);
    }
    .hero__index a {
      grid-template-columns: 2rem 1fr auto;
      grid-template-areas: 'l v i' 'l t i';
      padding-block: var(--s-5);
    }
    .hi__letter {
      grid-area: l;
      align-self: start;
      padding-top: 0.2em;
    }
    .hi__verb {
      grid-area: v;
    }
    .hi__title {
      display: block;
      grid-area: t;
    }
    .hero__index .icon {
      grid-area: i;
    }
  }

  @media (min-width: 64em) {
    .hero {
      min-height: calc(100svh - var(--header-h));
      display: flex;
      flex-direction: column;
    }
    .hero__inner {
      flex: 1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr;
      column-gap: var(--s-5);
      row-gap: clamp(var(--s-5), 4vh, var(--s-7));
    }
    .hero__meta {
      grid-column: 1 / -1;
    }
    /* The plain sentence sits beside the short last word, like a caption. */
    .hero__title {
      grid-column: 1 / 11;
      grid-row: 2;
      align-self: start;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-6);
      align-items: end;
      font-size: clamp(3.4rem, 0.9rem + 8.3vw, 9.75rem);
    }
    .hw:not(.hw--serif) {
      grid-column: 1 / -1;
    }
    .hw--serif {
      grid-column: 1;
    }
    .hero__sub {
      grid-column: 2;
      margin-top: 0;
      padding-bottom: 0.55em;
      max-width: 22ch;
    }
    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 3;
      align-self: start;
      gap: var(--s-5);
    }
    .hero__portrait {
      grid-column: 7 / 13;
      grid-row: 2 / 4;
      align-self: end;
      justify-self: end;
      max-width: 38rem;
    }
    .hero__index {
      margin-top: var(--s-6);
    }
    .hero__actions {
      gap: var(--s-4);
    }
  }
  @media (min-width: 64em) and (max-height: 760px) {
    .hero__title {
      font-size: clamp(3.4rem, 1.2rem + 7.4vw, 8.5rem);
    }
  }
</style>
