---
/**
 * Home hero (14 Nov 2026, round 3). Who you're dealing with first (Mann's name; his photo is the graph's core),
 * then the outcome he sells across every service, not only websites: found on Google, Maps and AI
 * answers, then enquiries answered and booked. The H1 and lead carry the search words (local SEO,
 * Google Business Profile, GEO/AEO, AI automation, web design, Toronto) in plain sentences. A short
 * list names every service, then one free first step and real prices. The visual is the agent
 * graph (AgentGraph.astro), with Mann's photo as the core node. Kept short on purpose: one H1, one
 * subline, two sentences, a service list, two buttons. Websites are one service among several.
 */
import { profile } from '../../data/site';
import { packageById, priceLabel } from '../../data/packages';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ContactActions from '../ContactActions.astro';
import AgentGraph from './AgentGraph.astro';

const launch = packageById('website-launch')!;
const local = packageById('local-visibility')!;
const services = [
  { href: '/services/local-visibility/', name: 'Local SEO & Google Business Profile' },
  { href: '/services/local-visibility/#ai-search', name: 'AI search visibility (GEO & AEO)' },
  { href: '/services/enquiry-follow-up/', name: 'Enquiry follow-up & AI automation' },
  { href: '/services/enquiry-follow-up/', name: 'Online booking' },
  { href: '/services/web-design/', name: 'Websites & fixes' },
  { href: '/services/#extras', name: 'Care, print & social' },
];
const recent = [
  { href: '/work/samp-hair-spa/', name: 'Samp Hair & Spa', note: 'Salon website, client preview', date: 'Oct 2026' },
  { href: '/work/nest-and-rest-cleaning/', name: 'Nest & Rest Cleaning', note: 'My own business, launched', date: 'Oct 2026' },
];
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <div class="hero__text">
      <div class="hero__hello">
        <p>
          <span class="hero__hi">Hi, I’m {profile.name}.</span>
          <span class="hero__role">Local SEO, websites and AI automation in Scarborough, Toronto</span>
        </p>
        <p class="status status--live hero__status"><span class="status__dot" aria-hidden="true"></span>Taking new projects</p>
      </div>

      <h1 class="hero__title" id="hero-title">
        <span class="hero__line">Local SEO, websites</span>
        <span class="hero__line">and AI automation.</span>
        <span class="hero__place">Get found on Google and in AI search (GEO and AEO), then turn searches into bookings. For Toronto businesses.</span>
      </h1>

      <p class="hero__lead">
        I help local businesses show up when customers search on Google or ask ChatGPT, then turn those searches into enquiries
        and bookings. You own every account, and every price is written down first.
      </p>

      <ul class="hero__services" role="list" aria-label="Services">
        {
          services.map((sv) => (
            <li>
              <a href={sv.href}>{sv.name}</a>
            </li>
          ))
        }
      </ul>

      <div class="hero__actions">
        <div class="btn-row">
          <Button href="/contact/?package=check-up#check">Get a free website and Google check</Button>
          <Button href="/pricing/" variant="ghost" class="hero__price-link">See prices</Button>
        </div>
        <p class="hero__price">
          <span><b>{priceLabel(local).text}</b> Google and AI visibility setup · <b>{priceLabel(launch).text}</b> website · <span class="subtle">CAD, plus tax.</span></span>
        </p>
        <ContactActions compact label="Or reach me directly" class="hero__reach" />
      </div>

    </div>

    <AgentGraph class="hero__graph" />

    <div class="hero__recent">
      <p class="hero__recent-h">Recent work</p>
      <ul role="list">
        {
          recent.map((r) => (
            <li>
              <a href={r.href}>
                <span class="hero__recent-name">{r.name}</span>
                <span class="hero__recent-note">
                  {r.note}, <time>{r.date}</time>
                </span>
                <Icon name="arrow-ne" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(var(--s-4), 3vw, var(--s-7));
    padding-bottom: clamp(var(--s-6), 4vw, var(--s-8));
    overflow: clip;
  }
  .hero::before {
    /* A faint dot grid: the network's graph paper. */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.07) 1px, transparent 0);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%);
  }
  .hero__inner {
    display: grid;
    gap: clamp(var(--s-6), 4vw, var(--s-7));
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    min-width: 0;
  }

  .hero__hello {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .hero__hello p:not(.status) {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    line-height: 1.3;
  }
  .hero__hi {
    font-weight: 600;
    color: var(--text);
  }
  .hero__role {
    font-size: var(--fs-xs);
    color: var(--text-2);
  }
  .hero__status {
    margin-left: auto;
  }

  .hero__title {
    font-size: clamp(2.45rem, 10.4vw, 4.6rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
  }
  .hero__place {
    display: block;
    margin-top: 0.5em;
    color: var(--text-2);
    max-width: 40ch;
    font-size: clamp(1rem, 1.4vw, 1.3rem);
    font-weight: 520;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .hero__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    max-width: 40rem;
  }
  .hero__services a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 520;
    text-decoration: none;
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .hero__services a::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--signal);
  }
  .hero__services a:hover {
    border-color: var(--control);
    background: var(--surface);
  }
  .hero__lead {
    max-width: 52ch;
    color: var(--text-2);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
  }
  .hero__actions {
    display: grid;
    gap: var(--s-3);
  }
  .hero__price {
    display: grid;
    gap: 0.15rem;
    max-width: 52ch;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .hero__actions :global(.hero__reach) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-2);
  }
  .hero__price b {
    color: var(--signal);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .hero__recent {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .hero__recent-h {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .hero__recent ul {
    display: grid;
    gap: var(--s-2);
  }
  .hero__recent a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    min-height: var(--tap);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .hero__recent a:hover {
    border-color: var(--control);
    background: var(--surface);
  }
  .hero__recent-name {
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .hero__recent-note {
    grid-column: 1;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .hero__recent a :global(.icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--signal);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .hero__text > * {
      animation: hero-in 800ms var(--ease-out) both;
    }
    :global(.js-motion) .hero__text > :nth-child(2) { animation-delay: 60ms; }
    :global(.js-motion) .hero__text > :nth-child(3) { animation-delay: 120ms; }
    :global(.js-motion) .hero__text > :nth-child(n + 4) { animation-delay: 180ms; }
  }
  @keyframes hero-in {
    from {
      transform: translateY(14px);
    }
  }

  @media (max-width: 39.99em) {
    .hero__text { gap: var(--s-4); }
    .hero__lead { font-size: 0.95rem; }
    .hero__services { gap: 0.4rem; order: 1; }
    /* Phones: the buttons come straight after the lead so they fit on the first screen; the service list follows them. */
    .hero__place { font-size: 0.98rem; margin-top: 0.45em; }
    .hero__role { font-size: 0.72rem; }
    .hero__services a { font-size: 0.74rem; min-height: 1.9rem; padding-inline: 0.6rem; }
    .hero__status, .hero__actions :global(.hero__reach) { display: none; }
    .hero__actions :global(.btn-row) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--s-3);
    }
    .hero__actions :global(.btn) {
      min-height: 3.1rem;
      padding-inline: var(--s-3);
      font-size: 0.82rem;
    }
    .hero__actions :global(.btn__icon) { width: 1.7rem; height: 1.7rem; }
    .hero__actions :global(.hero__price-link) {
      padding-inline: var(--s-2);
    }
    .hero__actions :global(.hero__price-link .btn__icon) { display: none; }
  }
  @media (max-width: 22.5em) {
    /* The smallest phones (320 px): smaller type so the buttons still fit on the first screen. */
    .hero__title { font-size: 2.1rem; }
    .hero__lead { font-size: 0.88rem; line-height: 1.5; }
    .hero__text { gap: var(--s-3); }
  }
  @media (min-width: 40em) and (max-width: 63.99em) {
    .hero :global(.hero__graph) {
      justify-self: center;
      max-width: 30rem;
    }
  }
  @media (min-width: 40em) {
    .hero__recent ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-areas: 'text graph' 'recent graph';
      align-items: center;
      column-gap: clamp(var(--s-6), 4vw, var(--s-9));
      row-gap: var(--s-6);
    }
    .hero__text { grid-area: text; }
    .hero :global(.hero__graph) { grid-area: graph; }
    .hero__recent { grid-area: recent; align-self: start; }
    .hero__title {
      font-size: clamp(3.1rem, 4.1vw, 4.6rem);
    }
  }
</style>
