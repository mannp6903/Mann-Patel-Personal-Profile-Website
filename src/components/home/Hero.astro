---
/**
 * Home hero (round 7: compact). The H1 is the outcome in three words plus the service descriptor.
 * Two actions with different jobs: Start a project (main) and See selected work (the next
 * section). The portrait is drawn as a live signal (src/scripts/signal-portrait.ts) on wide
 * screens; on phones and tablets the first screen shows a small round photo and the larger
 * portrait art opens on request, so the real work comes sooner.
 */
import { Image } from 'astro:assets';
import cutout from '../../assets/mann-patel-cutout.png';
import face from '../../assets/mann-patel-face.jpg';
import { profile } from '../../data/site';
import Button from '../ui/Button.astro';
import ContactActions from '../ContactActions.astro';
import Field from '../fx/Field.astro';
---

<section class="hero" aria-labelledby="hero-title" data-field-zone>
  <Field preset="hero" class="hero__field" />
  <div class="hero__inner container">
    <div class="hero__meta">
      <Image src={face} alt="" widths={[96, 144]} sizes="3rem" format="webp" loading="eager" class="hero__avatar" />
      <p class="eyebrow hero__where">{profile.name} · {profile.location}, Canada</p>
      <p class="status status--live hero__status"><span class="status__dot" aria-hidden="true"></span>Taking new projects</p>
    </div>

    <h1 class="hero__title" id="hero-title">
      <span class="hw" style="--i:0">Found.</span>
      <span class="hw" style="--i:1">Answered.</span>
      <span class="hw hw--serif" style="--i:2">Booked.</span>
      <span class="hero__sub">Websites, local search and enquiry follow-up for small businesses in Toronto and the GTA.</span>
    </h1>

    <div class="hero__copy">
      <p class="hero__lead">
        I build websites, set up your Google and Maps listing, and connect calls, forms and messages so every enquiry gets an
        answer. Set up by me, owned by you.
      </p>
      <div class="hero__actions">
        <div class="btn-row">
          <Button href="/contact/">Start a project</Button>
          <Button href="#work" variant="ghost" icon="arrow-down">See selected work</Button>
        </div>
        <ContactActions compact label="Or reach me directly" class="hero__reach" />
      </div>
    </div>

    {
      profile.portrait && (
        <figure class="hero__photo">
          <Image
            src={profile.portrait.src}
            alt={profile.portrait.alt}
            widths={[360, 560, 720, 1060]}
            sizes="(min-width: 40em) 28rem, 92vw"
            format="webp"
            quality={80}
            loading="eager"
            class="hero__photo-img"
          />
          <figcaption class="hero__photo-cap num subtle">Mann Patel · Toronto · 43.65° N · 79.38° W</figcaption>
        </figure>
      )
    }

    <figure class="hero__portrait" id="hero-art" data-portrait>
      <div class="hp__stage">
        <Image
          src={cutout}
          alt="Mann Patel smiling, in a dark green sweatshirt."
          widths={[360, 540, 720, 914]}
          sizes="(min-width: 64em) 40vw, 92vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          class="hp__img"
          data-portrait-img
        />
        <canvas class="hp__canvas" aria-hidden="true" data-portrait-canvas></canvas>
        {
          profile.portrait && (
            <Image
              src={profile.portrait.src}
              alt={profile.portrait.alt}
              widths={[540, 720, 1060]}
              sizes="(min-width: 64em) 40vw, 0px"
              format="webp"
              quality={80}
              loading="lazy"
              class="hp__real"
            />
          )
        }
      </div>
      <figcaption class="hp__cap">
        <span class="hp__who">
          <span>Mann Patel</span>
          <span class="num subtle" data-scramble>43.65° N · 79.38° W</span>
        </span>
        <button class="hp__toggle" type="button" aria-pressed="false" data-portrait-toggle>
          <span class="hp__switch" aria-hidden="true"><i></i></span>
          Show photo
        </button>
      </figcaption>
    </figure>
  </div>

</section>

<script>
  import { mountSignalPortrait } from '../../scripts/signal-portrait';
  document.querySelectorAll<HTMLElement>('[data-portrait]').forEach(mountSignalPortrait);
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(var(--s-5), 4vw, var(--s-7));
    overflow: clip;
  }
  /* A faint signal halo behind the portrait. */
  .hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: 10%;
    width: min(70vw, 60rem);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(212 248 74 / 0.09), transparent 70%);
    pointer-events: none;
  }
  /* The signal field: centred low behind the portrait on phones, on the portrait side on desktop. */
  .hero :global(.hero__field) {
    --fx: 50%;
    --fy: 80%;
    --fw: 110%;
    --fh: 62%;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }
  /* Phones: a small round photo beside the name and status (two short lines). */
  .hero__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s-3);
    row-gap: 0.15rem;
    align-items: center;
  }
  .hero__meta :global(.hero__avatar) {
    grid-row: span 2;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--signal);
  }
  .hero__where::before {
    content: none;
  }
  .hero__status {
    justify-self: start;
    padding: 0;
    border: 0;
  }
  @media (min-width: 40em) {
    .hero__meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--s-3);
    }
    .hero__meta :global(.hero__avatar) {
      display: none;
    }
    .hero__where::before {
      content: '';
    }
    .hero__status {
      padding: 0.35em 0.8em 0.35em 0.65em;
      border: 1px solid var(--line);
    }
  }

  /* ── Title ── */
  .hero__title {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-stretch: 116%;
  }
  /* The title's box overlaps the portrait on desktop: let the pointer through to the dots,
     except over the words themselves. */
  .hero__title {
    pointer-events: none;
  }
  .hw,
  .hero__sub {
    pointer-events: auto;
    justify-self: start;
  }
  .hw {
    display: block;
    font-stretch: 116%;
    padding-bottom: 0.04em;
    transition: font-stretch 900ms var(--ease-out), font-weight 900ms var(--ease-out), color 300ms;
  }
  .hw--serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: -0.02em;
    line-height: 0.8;
    color: var(--signal);
    padding-bottom: 0.08em;
  }
  @media (hover: hover) {
    .hw:not(.hw--serif):hover {
      font-stretch: 125%;
      font-weight: 900;
    }
  }
  /* Stretch into place: visible from the first frame, so it never delays the page. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hw {
      animation: hw-stretch 1500ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms);
    }
    :global(.js) .hw--serif {
      animation-name: hw-serif;
    }
  }
  @keyframes hw-stretch {
    from {
      font-stretch: 75%;
      font-weight: 500;
      letter-spacing: 0.02em;
    }
  }
  @keyframes hw-serif {
    from {
      letter-spacing: 0.25em;
      filter: blur(6px);
    }
  }
  .hero__sub {
    display: block;
    margin-top: var(--s-5);
    max-width: 24ch;
    font-size: var(--fs-lead);
    font-weight: 560;
    font-stretch: 100%;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--s-6);
  }
  .hero__lead {
    max-width: 46ch;
    color: var(--text-2);
    font-size: 1.0625rem;
  }
  .hero__actions {
    display: grid;
    gap: var(--s-5);
  }
  /* Direct contact sits on one line under the buttons: label, then round icons. */
  .hero__actions :global(.hero__reach) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  /* ── Portrait ── */
  .hero__portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(34rem, 84vw);
    justify-self: center;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .hp__stage {
    position: relative;
    aspect-ratio: 914 / 964;
  }
  .hp__img,
  .hp__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    transition: opacity 900ms var(--ease-out);
  }
  .hp__canvas {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready) .hp__canvas {
    opacity: 1;
  }
  .hero__portrait:global(.is-ready) .hp__img {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready.is-photo) .hp__canvas {
    opacity: 0;
  }
  .hero__portrait:global(.is-ready.is-photo) .hp__img {
    opacity: 0;
  }
  .hp__cap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: 560;
  }
  .hp__who {
    display: grid;
    gap: 0.1rem;
  }
  .hp__who .num {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .hp__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    padding: 0 0.9rem 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--text-2);
    cursor: pointer;
    transition: border-color var(--t-fast), color var(--t-fast);
  }
  .hero__portrait:global(.is-ready) .hp__toggle {
    display: inline-flex;
  }
  .hp__toggle:hover {
    border-color: var(--control);
    color: var(--text);
  }
  .hp__switch {
    position: relative;
    width: 2rem;
    height: 1.125rem;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    border: 1px solid var(--control);
    transition: background-color var(--t-base);
  }
  .hp__switch i {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--text-2);
    transition: transform var(--t-base) var(--ease-spring), background-color var(--t-base);
  }
  .hp__toggle[aria-pressed='true'] .hp__switch {
    background: var(--signal);
    border-color: var(--signal);
  }
  .hp__toggle[aria-pressed='true'] .hp__switch i {
    transform: translateX(0.85rem);
    background: var(--on-signal);
  }

  /* ── Phones and tablets: the real, whole photo. Wide screens: the signal portrait (photo on switch). ── */
  .hero__photo {
    justify-self: start;
    width: 100%;
    max-width: 26rem;
    display: grid;
    gap: var(--s-2);
  }
  .hero__photo :global(.hero__photo-img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .hero__photo-cap {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  @media (max-width: 63.99em) {
    .hero__portrait {
      display: none;
    }
  }
  @media (min-width: 64em) {
    .hero__photo {
      display: none;
    }
  }
  /* Desktop "Show photo": the real photo fades in over the signal drawing. */
  .hp__stage :global(.hp__real) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    pointer-events: none;
  }
  .hero__portrait:global(.is-photo) .hp__stage :global(.hp__real) {
    opacity: 1;
  }
  /* Phones: the header's Contact button and the footer already carry direct contact. */
  @media (max-width: 39.99em) {
    .hero__actions :global(.hero__reach) {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .hero :global(.hero__field) {
      --fx: 74%;
      --fy: 50%;
      --fw: 62%;
      --fh: 90%;
    }
    .hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr;
      column-gap: var(--s-5);
      row-gap: clamp(var(--s-5), 4vh, var(--s-7));
    }
    .hero__meta {
      grid-column: 1 / -1;
    }
    /* The plain sentence sits beside the short last word, like a caption. */
    .hero__title {
      grid-column: 1 / 11;
      grid-row: 2;
      align-self: start;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-6);
      align-items: end;
      font-size: clamp(3.4rem, 0.75rem + 6.3vw, 7.5rem);
    }
    .hw:not(.hw--serif) {
      grid-column: 1 / -1;
    }
    .hw--serif {
      grid-column: 1;
    }
    .hero__sub {
      grid-column: 2;
      margin-top: 0;
      padding-bottom: 0.55em;
      max-width: 22ch;
    }
    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 3;
      align-self: start;
      gap: var(--s-5);
    }
    .hero__portrait {
      grid-column: 7 / 13;
      grid-row: 2 / 4;
      align-self: end;
      justify-self: end;
      max-width: 34rem;
    }
    .hero__actions {
      gap: var(--s-4);
    }
  }
  @media (min-width: 64em) and (max-height: 760px) {
    .hero__title {
      font-size: clamp(3.4rem, 1rem + 5.4vw, 6.5rem);
    }
  }
</style>
