---
/**
 * How a project works: the five steps as one line (a vertical list on phones, one row from 64em).
 *
 * 23 Nov 2026 (SEO audit copy deck §2.1): Home says the process in one line, "Brief → written scope and price → build →
 * test and launch → handover with every login in your name". The four promises and the testimonial tile were cut: the
 * ownership promise is Home's first question, and real reviews show in the reviews strip once they exist. The full
 * process, with what each side does, stays on About (src/components/Process.astro).
 */
const steps = ['Brief', 'Written scope and price', 'Build', 'Test and launch', 'Handover, with every login in your name'];
---

<section class="about section" id="how-i-work" aria-labelledby="about-title">
  <div class="container about__grid">
    <h2 id="about-title" class="about__title">How a project works</h2>
    <ol class="line" role="list" aria-labelledby="about-title">
      {
        steps.map((s, i) => (
          <li class="line__step">
            <span class="line__n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <b class="line__name">{s}</b>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  @media (max-width: 39.99em) {
    .about { padding-block: var(--section-tight); }
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }
  .about__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 15ch;
  }

  /* The five steps. Phones: a vertical list along a hairline. From 64em: one row, a hairline through the numbers. */
  .line {
    display: grid;
    gap: 0;
    border-left: 1px solid var(--line);
  }
  .line__step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-1);
    padding: 0 0 var(--s-5) var(--s-5);
  }
  .line__step::before {
    /* The node on the line. */
    content: '';
    position: absolute;
    left: calc(-0.3125rem - 0.5px);
    top: 0.45em;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--control);
  }
  .line__step:last-child {
    padding-bottom: 0;
  }
  .line__n {
    font-size: var(--fs-label);
    color: var(--text-3);
  }
  .line__name {
    font-size: var(--fs-lead);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    color: var(--text);
    text-wrap: balance;
  }
  @media (min-width: 64em) {
    .line {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-5);
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .line__step {
      padding: var(--s-5) 0 0;
    }
    .line__step::before {
      left: 0;
      top: calc(-0.3125rem - 0.5px);
    }
  }
</style>
