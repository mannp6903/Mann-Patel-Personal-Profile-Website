---
/**
 * Home: every price on one screen (14 Nov 2026). A price list, not a card grid: what each offer
 * costs and the one-line boundary of what that price covers. Full detail lives on /pricing/.
 * Everything reads from src/data/packages.ts.
 *
 * Launch motion (22 Nov 2026, M7 "odometer prices"): when the list scrolls into view, a script lays rolling digit columns
 * over each price, resting on the real figure; every digit turns one lap and lands on the same number, then the overlay
 * is removed. The prices themselves never change (they stay the text of [data-price], for readers, tests and search),
 * so Home keeps its element budget (gate P3). Transform only, tokens only, once; reduced motion and no JavaScript skip it.
 */
import { packageById, packages, priceLabel, priceTerms } from '../../data/packages';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

// 19 Nov 2026 (answer extractability): the lead opens with the answer to the heading, in prices from the same file.
const launch = packageById('website-launch')!;
const enquiry = packageById('website-enquiry')!;
---

<section class="pt section rule-signal" id="prices" aria-labelledby="pt-title">
  <div class="container pt__grid">
    <div class="pt__head">
      <!-- 16 Nov 2026: a descriptive heading people search for; the slogan is the eyebrow. -->
      <p class="eyebrow">03 / Prices you can see before you call</p>
      <h2 id="pt-title" class="pt__title">Website prices <span class="accent">in Toronto (CAD).</span></h2>
      <p class="muted pt__lead">
        {
          priceLabel(launch).approved && priceLabel(enquiry).approved && (
            <>A website costs {priceLabel(launch).text} for up to five pages, or {priceLabel(enquiry).text} with a booking integration and one follow-up workflow. </>
          )
        }
        Anything outside a price’s written scope is quoted in writing first, and your domain, hosting and tools are billed to
        you directly, in your name.
      </p>
      <p class="small subtle">All prices in Canadian dollars, plus applicable tax. Websites: half at kickoff, half once the agreed launch checks pass.</p>
      <div class="btn-row">
        <Button href="/pricing/" variant="ghost">Full pricing and what’s included</Button>
      </div>
    </div>

    <ul class="pt__list" role="list" data-odometer>
      {
        packages.map((p) => {
          const price = priceLabel(p);
          return (
            <li class:list={['pt__row', { 'pt__row--lead': p.id === 'website-launch' }]}>
              <a href={`/pricing/#pkg-${p.id}`}>
                <span class="pt__name">{p.name}</span>
                <span class="pt__price">
                  <b data-price>{price.text}</b>
                  <span>{priceTerms(p)}</span>
                </span>
                <span class="pt__boundary">{p.boundary}</span>
                <Icon name="arrow" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  @media (max-width: 39.99em) {
    .pt { padding-block: var(--section-tight); }
    /* Phones: tighter rows, so Home stays within 11 screens (gate S4). */
    .pt .pt__row a { padding-block: var(--s-4); }
  }
  .pt__grid {
    display: grid;
    gap: var(--s-7);
  }
  .pt__head {
    display: grid;
    row-gap: var(--head-gap-2);
    align-content: start;
    justify-items: start;
  }
  .pt__head .eyebrow { margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2)); }
  .pt__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 14ch;
  }
  .pt__lead {
    max-width: 44ch;
  }
  .pt__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .pt__row a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-5) var(--s-2) var(--s-5) 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-1), padding var(--dur-3) var(--ease-out);
  }
  .pt__row a:hover,
  .pt__row a:focus-visible {
    background: linear-gradient(90deg, transparent, var(--surface));
  }
  .pt__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.1;
  }
  .pt__price {
    display: grid;
    justify-items: end;
    text-align: right;
    gap: 0.1rem;
  }
  /* Lime budget: every price is white, in tabular figures. */
  .pt__price b {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }
  .pt__price span {
    font-size: var(--fs-label);
    color: var(--text-3);
  }
  .pt__boundary {
    grid-column: 1 / -1;
    max-width: 60ch;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .pt__row a :global(.icon) {
    display: none;
  }
  @media (min-width: 48em) {
    /* 14 Nov 2026: a tidy price table. Name with its one-line scope underneath on the left; every
       price in one fixed, right-aligned column, so names, scopes and prices line up row to row. */
    .pt__row a {
      grid-template-columns: minmax(0, 1fr) 13rem 1.25rem;
      grid-template-areas:
        'name price icon'
        'boundary price icon';
      align-items: start;
      column-gap: var(--s-6);
      row-gap: var(--s-2);
    }
    .pt__name { grid-area: name; }
    .pt__boundary { grid-area: boundary; max-width: 52ch; }
    .pt__price { grid-area: price; }
    .pt__row a :global(.icon) {
      display: block;
      grid-area: icon;
      align-self: center;
      color: var(--text-3);
      transition: transform var(--dur-3) var(--ease-out);
    }
    @media (prefers-reduced-motion: no-preference) {
      .pt__row a:hover :global(.icon),
      .pt__row a:focus-visible :global(.icon) {
        transform: translateX(4px);
      }
    }
  }
  @media (min-width: 64em) {
    .pt__grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: var(--s-8);
    }
    /* Sticky head (design upgrade task 3.4). */
    .pt__head {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
</style>

<style is:global>
  /* M7 overlay (created by the script below, so global, namespaced): one window per digit, one line tall; the column of
     0–9 twice starts on the digit's own figure and turns one lap. */
  .pt__price {
    position: relative;
  }
  .pt__price b.is-rolling {
    color: transparent;
  }
  .pt-odo {
    position: absolute;
    top: 0;
    right: 0;
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: pre;
    pointer-events: none;
  }
  .pt-odo__d {
    display: inline-block;
    height: 1.1em;
    overflow: hidden;
    vertical-align: top;
  }
  .pt-odo__col {
    display: block;
    translate: 0 calc(var(--n) * -1.1em);
    transition: translate calc(var(--dur-5) * 2) var(--ease-out) calc((var(--r) * 2 + var(--k)) * var(--stagger));
  }
  .pt-odo.is-spun .pt-odo__col {
    translate: 0 calc((var(--n) + 10) * -1.1em);
  }
</style>

<script>
  // M7: once, when the price list is well into view. Each price gets an aria-hidden overlay of digit columns that turns
  // one lap and lands on the same figure; the overlay is then removed and the plain price shows again.
  const list = document.querySelector<HTMLElement>('[data-odometer]');
  if (list && document.documentElement.classList.contains('js-motion') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const COLUMN = Array.from({ length: 20 }, (_, i) => i % 10).join('\n');
    const roll = () => {
      const overlays: HTMLElement[] = [];
      list.querySelectorAll<HTMLElement>('[data-price]').forEach((price, r) => {
        const text = price.textContent ?? '';
        if (!/\d/.test(text)) return;
        const odo = document.createElement('span');
        odo.className = 'pt-odo';
        odo.setAttribute('aria-hidden', 'true');
        odo.style.setProperty('--r', String(r));
        let k = 0;
        for (const ch of text) {
          if (!/\d/.test(ch)) {
            odo.append(ch);
            continue;
          }
          const win = document.createElement('span');
          win.className = 'pt-odo__d';
          const col = document.createElement('span');
          col.className = 'pt-odo__col';
          col.style.setProperty('--n', ch);
          col.style.setProperty('--k', String(k++));
          col.textContent = COLUMN;
          win.append(col);
          odo.append(win);
        }
        price.after(odo);
        price.classList.add('is-rolling');
        overlays.push(odo);
      });
      if (!overlays.length) return;
      // Next frame: start the lap. When the last column lands, put the plain prices back.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          overlays.forEach((o) => o.classList.add('is-spun'));
          const cols = list.querySelectorAll('.pt-odo__col');
          const last = cols[cols.length - 1];
          const done = () => {
            overlays.forEach((o) => o.remove());
            list.querySelectorAll('[data-price].is-rolling').forEach((p) => p.classList.remove('is-rolling'));
          };
          let finished = false;
          const finish = () => {
            if (finished) return;
            finished = true;
            done();
          };
          if (last) last.addEventListener('transitionend', finish, { once: true });
          // A backstop for a hidden tab, where transitions may never end.
          setTimeout(finish, 4000);
        }),
      );
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        roll();
      },
      { threshold: 0.35 },
    );
    io.observe(list);
  }
</script>
