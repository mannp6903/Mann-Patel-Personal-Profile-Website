---
/**
 * The hero visual (14 Nov 2026): "the agent graph". A small neural network drawn as a diagram of
 * the work: where customers come from (Google, Maps, AI answers) on one side, what they need to
 * happen (an enquiry, a reply, a booking) on the other, and Mann's real photo as the core node in
 * the middle. Light pulses travel the connections, so the network looks like it is thinking.
 *
 * Built as one inline SVG with CSS animation: no canvas, no WebGL, no script needed to draw it.
 * Two layouts are generated from the same description: left-to-right on wide screens and
 * top-to-bottom on phones (so the photo can be large on a 390 px screen). Reduced motion shows the
 * finished, still diagram. A pause button stops the pulses (WCAG 2.2.2); the small script also
 * pauses them while the graph is off screen.
 *
 * One graph in the page (design upgrade Phase 7, task 7.2): the tall layout is sent in the HTML and the wide one waits
 * in a <template>; the small inline script after the figure swaps them before the first paint where the wide one is
 * used (from 64em, and on phones held sideways). That keeps Home under 950 elements (gate P3).
 *
 * Speed (SEO audit Phase 4, 14 Nov 2026): every animation moves only transform or opacity, which browsers
 * can run cheaply (Lighthouse had found 63 that redrew stroke-dashoffset, stroke, fill or filter). Lines fade
 * in instead of drawing; a lime copy of each node fades in and out for the twinkle; a glowing copy of the
 * Booking pill fades for its glow; and the pulses are short streaks the script moves along each route with
 * transform. Without JavaScript, or with reduced motion, two routes stay lit, as before.
 */
import { Picture } from 'astro:assets';
import { profile } from '../../data/site';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const portrait = profile.portrait;

type Pt = { x: number; y: number };
interface Layout {
  w: number;
  h: number;
  core: Pt & { r: number };
  inputs: Pt[];
  outputs: Pt[];
  hiddenIn: Pt[];
  hiddenOut: Pt[];
  dir: 'x' | 'y';
}

const inLabels = ['Google', 'Maps', 'AI answers'];
const outLabels = ['Enquiry', 'Reply', 'Booking'];

const wide: Layout = {
  w: 640,
  h: 540,
  dir: 'x',
  // Design upgrade Phase 2: the core is a little larger (r 122 → 126) because the graph column is now about 44% wide,
  // and the inner node columns moved out (158/482 → 152/488) so the dotted ring still clears them.
  core: { x: 320, y: 270, r: 126 },
  inputs: [{ x: 64, y: 118 }, { x: 64, y: 270 }, { x: 64, y: 422 }],
  outputs: [{ x: 578, y: 118 }, { x: 578, y: 270 }, { x: 578, y: 422 }],
  hiddenIn: [70, 170, 270, 370, 470].map((y) => ({ x: 152, y })),
  hiddenOut: [70, 170, 270, 370, 470].map((y) => ({ x: 488, y })),
};
// Design upgrade Phase 2: 30 units shorter than before (520), so the phone hero stays within 1.35 screens (gate R3)
// while the photo keeps its size.
const tall: Layout = {
  w: 360,
  h: 490,
  dir: 'y',
  core: { x: 180, y: 245, r: 100 },
  inputs: [{ x: 62, y: 24 }, { x: 180, y: 24 }, { x: 298, y: 24 }],
  outputs: [{ x: 62, y: 466 }, { x: 180, y: 466 }, { x: 298, y: 466 }],
  hiddenIn: [30, 105, 180, 255, 330].map((x) => ({ x, y: 100 })),
  hiddenOut: [30, 105, 180, 255, 330].map((x) => ({ x, y: 390 })),
};

/** A soft S-curve between two points, bending along the flow direction. */
const curve = (a: Pt, b: Pt, dir: 'x' | 'y') => {
  if (dir === 'x') {
    const m = (a.x + b.x) / 2;
    return `M${a.x} ${a.y}C${m} ${a.y} ${m} ${b.y} ${b.x} ${b.y}`;
  }
  const m = (a.y + b.y) / 2;
  return `M${a.x} ${a.y}C${a.x} ${m} ${b.x} ${m} ${b.x} ${b.y}`;
};
/** The same curve, continued from the end of a previous one (for single-path pulse routes). */
const cont = (a: Pt, b: Pt, dir: 'x' | 'y') => curve(a, b, dir).replace(/^M[^C]+/, '');

/** Where an edge meets the edge of the core circle, aimed at its centre. */
const rim = (p: Pt, c: Pt & { r: number }) => {
  const dx = p.x - c.x;
  const dy = p.y - c.y;
  const d = Math.hypot(dx, dy);
  return { x: +(c.x + (dx / d) * (c.r + 10)).toFixed(1), y: +(c.y + (dy / d) * (c.r + 10)).toFixed(1) };
};

function build(L: Layout) {
  // Grouped so the entrance fades a few groups, not 40 single lines (design upgrade Phase 4, gate M7): one group per
  // input (its five lines into the hidden nodes) and one per output (the five lines into it); spokes in and out.
  const mesh: string[][] = [
    ...L.inputs.map((p) => L.hiddenIn.map((h) => curve(p, h, L.dir))),
    ...L.outputs.map((p) => L.hiddenOut.map((h) => curve(h, p, L.dir))),
  ];
  const spokes: string[][] = [L.hiddenIn.map((h) => curve(h, rim(h, L.core), L.dir)), L.hiddenOut.map((h) => curve(rim(h, L.core), h, L.dir))];
  // Pulse routes: input -> hidden node -> core, then core -> hidden node -> output. Six pairs, two per input. Design upgrade
  // Phase 4 (D8): route 0 is Google -> Booking, the first pulse; routes 0 and 4 are the two that loop (and the two lit
  // in the still diagram); hovering an input pill lights both of its routes.
  const pick = [
    [0, 1, 3, 2],
    [1, 2, 1, 2],
    [2, 3, 3, 2],
    [0, 0, 2, 1],
    [1, 4, 4, 1],
    [2, 3, 1, 0],
  ];
  const routes = pick.map(([i, hi, ho, o], k) => {
    const a = L.inputs[i];
    const b = L.hiddenIn[hi];
    const rb = rim(b, L.core);
    const c = L.hiddenOut[ho];
    const rc = rim(c, L.core);
    const d = L.outputs[o];
    return {
      k,
      input: i,
      in: curve(a, b, L.dir) + cont(b, rb, L.dir),
      out: curve(rc, c, L.dir) + cont(c, d, L.dir),
      output: o,
      lit: k === 0 || k === 4,
    };
  });
  return { mesh, spokes, routes };
}

/** Pill width for a label at the layout's text size (Geist, about 0.56em per character). */
const pillW = (t: string, fs: number) => Math.round(t.length * fs * 0.56 + fs * 2.2);
// Larger type on the wide layout: it is drawn smaller per unit on laptop-width screens.
// Design upgrade Phase 7 (task 7.2): only the tall layout is in the page as sent; the wide one waits in a <template>
// (Wrap) and the script after the figure swaps them before the first paint, so Home carries one graph, not two.
const layouts = [
  { id: 'tall', L: tall, g: build(tall), fs: 13.5, Wrap: 'div' },
  { id: 'wide', L: wide, g: build(wide), fs: 16, Wrap: 'template' },
];
/** Where the wide layout is used: from 64em, and on phones held sideways (design upgrade Phase 6, task 6.3). */
const WIDE = '(min-width: 64em), (orientation: landscape) and (max-height: 30em) and (min-width: 40em)';
const pct = (L: Layout) => ({
  x: (L.core.x / L.w) * 100,
  y: (L.core.y / L.h) * 100,
  d: ((L.core.r * 2) / L.w) * 100,
});
const pw = pct(wide);
const pt = pct(tall);
---

<figure
  class:list={['ag', cls]}
  data-agent-graph
  style={`--cx-w:${pw.x}%;--cy-w:${pw.y}%;--cd-w:${pw.d}%;--cx-t:${pt.x}%;--cy-t:${pt.y}%;--cd-t:${pt.d}%`}
>
  <div class="ag__stage">
    {
      layouts.map(({ id, L, g, fs, Wrap }) => (
        <Wrap class={Wrap === 'div' ? 'ag__layout' : undefined} data-ag-alt={Wrap === 'template' ? '' : undefined}>
        <svg class={`ag__svg ag__svg--${id}`} viewBox={`0 0 ${L.w} ${L.h}`} aria-hidden="true" focusable="false">
          <g class="ag__orbit" style={`transform-origin:${L.core.x}px ${L.core.y}px`}>
            <circle cx={L.core.x} cy={L.core.y} r={L.core.r + 34} class="ag__ring ag__ring--dots" />
            <circle cx={L.core.x} cy={L.core.y} r={L.core.r + 18} class="ag__ring ag__ring--scan" pathLength="100" />
          </g>
          <circle cx={L.core.x} cy={L.core.y} r={L.core.r + 6} class="ag__ping" style={`transform-origin:${L.core.x}px ${L.core.y}px`} />
          <g class="ag__mesh">
            {g.mesh.map((group, i) => (
              <g style={`--i:${i}`}>
                {group.map((d) => (
                  <path d={d} pathLength="1" />
                ))}
              </g>
            ))}
          </g>
          <g class="ag__spokes">
            {g.spokes.map((group, i) => (
              <g style={`--i:${i}`}>
                {group.map((d) => (
                  <path d={d} pathLength="1" />
                ))}
              </g>
            ))}
          </g>
          <g class="ag__pulses">
            {g.routes.map((r) => (
              <>
                <path class="ag__pulse ag__pulse--in" d={r.in} pathLength="1" data-route={r.k} data-in={r.input} data-lit={r.lit ? '' : undefined} />
                <path class="ag__pulse ag__pulse--out" d={r.out} pathLength="1" data-route={r.k} data-in={r.input} data-lit={r.lit ? '' : undefined} />
              </>
            ))}
          </g>
          <g class="ag__sparks" />
          <g class="ag__nodes">
            {[L.hiddenIn, L.hiddenOut].map((col, i) => (
              <g style={`--i:${i}`}>
                {col.map((n) => (
                  <circle cx={n.x} cy={n.y} r="4.5" />
                ))}
              </g>
            ))}
          </g>
          <g class="ag__lit">
            {[...L.hiddenIn, ...L.hiddenOut].map((n, i) => (
              <circle cx={n.x} cy={n.y} r="4.5" style={`--i:${i}`} />
            ))}
          </g>
          <g class="ag__pills">
            {L.inputs.map((p, i) => {
              const w = pillW(inLabels[i], fs);
              return (
                <g class="ag__pill" style={`--i:${i}`} data-in={i}>
                  <rect x={p.x - w / 2} y={p.y - fs * 1.3} width={w} height={fs * 2.6} rx={fs * 1.3} />
                  <text x={p.x} y={p.y + fs * 0.34} font-size={fs}>{inLabels[i]}</text>
                </g>
              );
            })}
            {L.outputs.map((p, i) => {
              const w = pillW(outLabels[i], fs);
              return (
                <g
                  class:list={['ag__pill', { 'ag__pill--goal': i === 2 }]}
                  style={`--i:${i + 3}`}
                  data-from={[...new Set(g.routes.filter((r) => r.output === i).map((r) => r.input))].join(' ')}
                >
                  <rect x={p.x - w / 2} y={p.y - fs * 1.3} width={w} height={fs * 2.6} rx={fs * 1.3} />
                  {i === 2 && <rect class="ag__glow" x={p.x - w / 2} y={p.y - fs * 1.3} width={w} height={fs * 2.6} rx={fs * 1.3} />}
                  <text x={p.x} y={p.y + fs * 0.34} font-size={fs}>{outLabels[i]}</text>
                </g>
              );
            })}
          </g>
        </svg>
        </Wrap>
      ))
    }

    {
      portrait && (
        <div class="ag__core">
          <Picture
            src={portrait.src}
            alt={portrait.alt}
            widths={[240, 360, 480, 640]}
            sizes="(min-width: 64em) 15rem, (min-width: 48em) 11rem, (min-width: 40em) 14rem, 48vw"
            formats={['avif']}
            fallbackFormat="webp"
            data-src-w={portrait.src.width}
            quality={60}
            priority
            decoding="async"
            class="ag__photo"
          />
        </div>
      )
    }
  </div>

  <figcaption class="ag__caption">
    <span class="ag__who"><b>Mann Patel</b> connects the middle: your Google profile, website and AI automation, so a search becomes a booking.</span>
    <button type="button" class="ag__toggle" data-ag-toggle aria-pressed="false" hidden>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path class="ag__i-pause" d="M5.5 3.5v9m5-9v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
        <path class="ag__i-play" d="m5.5 3.5 7 4.5-7 4.5z" fill="currentColor" />
      </svg>
      <span data-ag-label>Pause animation</span>
    </button>
  </figcaption>
</figure>
{/*
  Design upgrade Phase 7 (task 7.2): swap in the wide layout where it is used, before the first paint (this runs as
  the page is read, straight after the figure, so nothing shifts), and again if the window crosses over. Without
  JavaScript every width shows the tall one. The animation script (below) follows the 'ag:layout' event. The script
  is inline on purpose (the build allows it by its hash in the Content Security Policy); comments stay out of it.
*/}
<script is:inline define:vars={{ WIDE }}>
  (function (root) {
    var tpl = root && root.querySelector('template[data-ag-alt]');
    if (!tpl) return;
    var mq = matchMedia(WIDE);
    var swap = function () {
      var want = mq.matches ? 'wide' : 'tall';
      if ((root.dataset.layout || 'tall') === want) return;
      var live = root.querySelector('.ag__svg');
      var next = tpl.content.querySelector('.ag__svg');
      if (!live || !next) return;
      live.replaceWith(next);
      tpl.content.append(live);
      root.dataset.layout = want;
      root.dispatchEvent(new Event('ag:layout'));
    };
    swap();
    mq.addEventListener('change', swap);
  })(document.currentScript && document.currentScript.previousElementSibling);
</script>

<script>
  /*
   * The graph's loop (design upgrade Phase 4, D8; DESIGN.md → Motion). After the entrance, one cycle is --dur-loop:
   *   - Route 0 (Google -> core -> Booking) travels first, about 1.2 s after load, in a third of a cycle (1.4 s); route 4
   *     (Maps -> core -> Reply) runs half a cycle behind it. Each travels three times, then everything rests (by about
   *     13 s, gate M2). The first arrival at Booking makes the core's glow breathe once.
   *   - The core pings when a pulse reaches it, the Booking pill glows when one arrives, the hidden nodes twinkle and
   *     the dotted orbit turns a third of a turn, all inside the same window. Every move is transform or opacity.
   *   - Pointer, focus or a tap on the graph wakes it for another three cycles; the pause button stops it (WCAG 2.2.2)
   *     and, once it rests, plays it again. Off screen it pauses.
   *   - Hovering or tapping an input pill lights that pill's two routes and dims the rest to 30% (pointer only: the
   *     graph is decorative and its caption carries the meaning).
   * Reduced motion, or no script: the still diagram with routes 0 and 4 lit.
   * Every duration comes from the motion tokens in tokens.css (gate M1).
   */
  // Reading the tokens forces a style pass, so it waits for the first idle moment (gate M7), as does everything below.
  let css: CSSStyleDeclaration;
  const ms = (name: string) => {
    const v = css.getPropertyValue(name).trim();
    return v.endsWith('ms') ? parseFloat(v) : v.endsWith('s') ? parseFloat(v) * 1000 : parseFloat(v) || 0;
  };
  const ease = (name: string) => css.getPropertyValue(name).trim() || 'ease';
  /** How long the setup may wait for an idle moment, in ms: well before the first pulse is due. */
  const FIRST_IDLE = 600;
  const idle = (fn: () => void, timeout: number) =>
    'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout }) : setTimeout(fn, 0);

  /** The pause button's state before the loop is set up, and the loop's own handler once it is. */
  type Early = { paused: boolean; toggle: (() => void) | null };

  const setup = (root: HTMLElement, early: Early) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-ag-toggle]');
    const label = root.querySelector<HTMLElement>('[data-ag-label]');
    css = getComputedStyle(document.documentElement);

    const LOOP = ms('--dur-loop');
    if (!LOOP) return;
    const TRAVEL = 1 / 3; // share of a cycle a pulse spends travelling (1.4 s of 4.2 s)
    const CYCLES = 3;
    // The first pulse leaves once the core has arrived (its entrance: --dur-3 delay + --dur-5), plus one stagger step.
    const FIRST = ms('--dur-3') + ms('--dur-5') + ms('--stagger');
    const WAKE = ms('--dur-2');

    let anims: Animation[] = [];
    let run = 0;
    let state: 'running' | 'paused' | 'resting' = 'resting';
    let offscreen = false;
    let angle = 0;
    let breathed = false;
    let live = false;

    const setButton = (playing: boolean) => {
      if (!btn) return;
      btn.setAttribute('aria-pressed', String(!playing));
      if (label) label.textContent = playing ? 'Pause animation' : 'Play animation';
    };

    /* One streak per leg, moved along the leg's own curve with transform (no stroke-dashoffset). */
    type Leg = { spark: SVGElement; second: boolean; frames: Keyframe[] };
    const legs = new Map<SVGSVGElement, Leg[]>();
    // Only the layout in the page is animated (the swap script after the figure puts the right one in); the other is
    // built if the window crosses over.
    const svgFor = () => root.querySelector<SVGSVGElement>('.ag__svg');
    let svg = svgFor();
    const STEPS = 16;
    const buildLeg = (path: SVGPathElement, into: Leg[]) => {
      const len = path.getTotalLength();
      if (!len) return;
      const out = path.classList.contains('ag__pulse--out');
      // In: source to core in the first 45% of the travel. Out: leaves the core just after (50% to 100%).
      const [from, to] = out ? [0.5 * TRAVEL, TRAVEL] : [0, 0.45 * TRAVEL];
      const dash = 0.09 * len;
      const spark = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      spark.setAttribute('class', 'ag__spark');
      spark.setAttribute('x', (-dash / 2).toFixed(1));
      spark.setAttribute('y', '-1.5');
      spark.setAttribute('width', dash.toFixed(1));
      spark.setAttribute('height', '3');
      spark.setAttribute('rx', '1.5');
      const pts = Array.from({ length: STEPS + 1 }, (_, i) => path.getPointAtLength((len * i) / STEPS));
      const pose = (i: number) => {
        const a = pts[Math.max(0, i - 1)];
        const b = pts[Math.min(STEPS, i + 1)];
        const deg = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
        return `translate(${pts[i].x.toFixed(1)}px, ${pts[i].y.toFixed(1)}px) rotate(${deg.toFixed(1)}deg)`;
      };
      const frames: Keyframe[] = [];
      if (from > 0) frames.push({ offset: 0, opacity: 0, transform: pose(0) });
      for (let i = 0; i <= STEPS; i++)
        frames.push({ offset: from + ((to - from) * i) / STEPS, opacity: i === 0 || i === STEPS ? 0 : 1, transform: pose(i) });
      frames.push({ offset: 1, opacity: 0, transform: pose(STEPS) });
      into.push({ spark, second: path.dataset.route === '4', frames });
    };

    /** A light that blinks once per cycle at `at` (share of the cycle): on over `rise`, off by `fall`. */
    const blink = (at: number, rise: number, fall: number, peak = 1): Keyframe[] => [
      { offset: 0, opacity: 0 },
      { offset: at, opacity: 0 },
      { offset: at + rise, opacity: peak },
      { offset: at + fall, opacity: 0 },
      { offset: 1, opacity: 0 },
    ];

    const start = (lead: number) => {
      anims.forEach((a) => a.cancel());
      anims = [];
      if (!svg) return;
      const on = svg;
      const id = ++run;
      const opts = (delay: number, iterations: number): KeyframeAnimationOptions => ({ duration: LOOP, delay, iterations, easing: 'linear' });
      // The pulses: route 0 first, route 4 half a cycle behind. Each stops as its third trip ends.
      for (const leg of legs.get(on) ?? []) anims.push(leg.spark.animate(leg.frames, opts(lead + (leg.second ? LOOP / 2 : 0), CYCLES - 1 + TRAVEL)));
      on.querySelectorAll<SVGElement>('.ag__glow').forEach((g) => {
        // Route 0 reaches Booking at the end of its travel.
        anims.push(g.animate(blink(TRAVEL, 0.03, 0.3), opts(lead, CYCLES - 1 + TRAVEL + 0.3)));
      });
      on.querySelectorAll<SVGElement>('.ag__ping').forEach((p) => {
        // The core pings as each pulse reaches it: route 0 at 15% of the cycle, route 4 at 65%.
        const hit = 0.45 * TRAVEL;
        const frames: Keyframe[] = [];
        for (const at of [hit, hit + 0.5]) {
          frames.push({ offset: at - 0.001, opacity: 0, transform: 'scale(1)' }, { offset: at, opacity: 0.7, transform: 'scale(1)' }, { offset: at + 0.15, opacity: 0, transform: 'scale(1.22)' });
        }
        frames.unshift({ offset: 0, opacity: 0, transform: 'scale(1)' });
        frames.push({ offset: 1, opacity: 0, transform: 'scale(1)' });
        anims.push(p.animate(frames, opts(lead, CYCLES - 1 + hit + 0.5 + 0.15)));
      });
      on.querySelectorAll<SVGElement>('.ag__lit').forEach((group) => {
        const nodes = [...group.querySelectorAll<SVGElement>('circle')];
        nodes.forEach((n, i) => {
          const at = 0.05 + (0.55 * i) / Math.max(1, nodes.length - 1);
          anims.push(n.animate(blink(at, 0.05, 0.12), opts(lead, CYCLES - 1 + at + 0.12)));
        });
      });
      // The orbit turns a third of a turn across the whole window, easing in and out, and keeps its place for next time.
      const span = LOOP * (CYCLES - 1 + TRAVEL + 0.5);
      on.querySelectorAll<SVGElement>('.ag__orbit').forEach((o) => {
        anims.push(
          o.animate([{ transform: `rotate(${angle}deg)` }, { transform: `rotate(${angle + 120}deg)` }], {
            duration: span,
            delay: lead,
            easing: ease('--ease-in-out'),
            fill: 'forwards',
          }),
        );
      });
      angle += 120;
      // The glow behind the photo breathes once, when the first pulse reaches Booking (the first run only).
      if (!breathed) {
        breathed = true;
        const stage = root.querySelector<HTMLElement>('.ag__stage');
        if (stage)
          anims.push(
            stage.animate([{ scale: 1 }, { scale: 1.22, offset: 0.45 }, { scale: 1 }], {
              duration: ms('--dur-5') * 2,
              delay: lead + TRAVEL * LOOP,
              easing: ease('--ease-in-out'),
              pseudoElement: '::before',
            }),
          );
      }
      state = 'running';
      root.classList.remove('is-resting', 'is-paused');
      setButton(true);
      if (offscreen) anims.forEach((a) => a.pause());
      Promise.all(anims.map((a) => a.finished)).then(
        () => {
          if (id !== run) return;
          state = 'resting';
          root.classList.add('is-resting');
          setButton(false);
        },
        () => {},
      );
    };

    const pause = () => {
      anims.forEach((a) => a.playState === 'running' && a.pause());
    };
    const resume = () => {
      anims.forEach((a) => a.playState === 'paused' && a.play());
    };

    const pauseNow = () => {
      state = 'paused';
      pause();
      root.classList.add('is-paused');
      setButton(false);
    };
    // Handed to the button once the loop is live (until then the button records the choice: see below).
    const toggle = () => {
      if (state === 'running') pauseNow();
      else if (state === 'paused') {
        state = 'running';
        root.classList.remove('is-paused');
        if (!offscreen) resume();
        setButton(true);
      } else if (live) start(WAKE);
    };
    // Wake on pointer, tap or focus: another three cycles, unless it was paused on purpose or is already running.
    const wake = () => {
      if (live && state === 'resting') start(WAKE);
    };
    root.addEventListener('pointerenter', wake);
    root.addEventListener('pointerdown', wake);
    root.addEventListener('focusin', wake);

    // Explore: an input pill lights its two routes and dims the rest.
    const focusPill = (i: string | null) => {
      if (i === null) delete root.dataset.focus;
      else root.dataset.focus = i;
    };
    // Each layout's pills are bound once, when that layout is first in the page.
    const bound = new WeakSet<SVGSVGElement>();
    const bindPills = (target: SVGSVGElement | null) => {
      if (!target || bound.has(target)) return;
      bound.add(target);
      target.querySelectorAll<SVGElement>('.ag__pill[data-in]').forEach((pill) => {
        pill.addEventListener('pointerenter', (e) => {
          if ((e as PointerEvent).pointerType === 'mouse' || (e as PointerEvent).pointerType === 'pen') focusPill(pill.dataset.in ?? null);
        });
        pill.addEventListener('pointerleave', (e) => {
          if ((e as PointerEvent).pointerType === 'mouse' || (e as PointerEvent).pointerType === 'pen') focusPill(null);
        });
        pill.addEventListener('click', () => focusPill(root.dataset.focus === pill.dataset.in ? null : (pill.dataset.in ?? null)));
      });
    };
    bindPills(svg);
    // A tap anywhere else in the graph clears it.
    root.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.ag__pill[data-in]')) focusPill(null);
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        offscreen = !e.isIntersecting;
        if (state !== 'running') return;
        if (offscreen) pause();
        else resume();
      }).observe(root);
    }

    // Build the streaks off the load path, one leg per idle moment (each is a few ms, so no long frame: gate M7), then
    // start the first cycle on schedule, counted from page load.
    const build = (target: SVGSVGElement, done: () => void) => {
      if (legs.has(target)) return done();
      const into: Leg[] = [];
      const sparks = target.querySelector('.ag__sparks');
      const paths = sparks ? [...target.querySelectorAll<SVGPathElement>('.ag__pulse[data-lit]')] : [];
      const step = (i: number) => {
        if (i >= paths.length) {
          // The streaks join the page together, in the same moment their animations start.
          sparks!.append(...into.map((l) => l.spark));
          legs.set(target, into);
          return done();
        }
        buildLeg(paths[i], into);
        idle(() => step(i + 1), FIRST / 2);
      };
      idle(() => step(0), FIRST / 2);
    };
    if (svg)
      build(svg, () => {
        live = true;
        root.classList.add('is-live');
        start(Math.max(0, FIRST - performance.now()));
        // Paused before the loop was ready (the button works from the first moment): start paused.
        if (early.paused) pauseNow();
        early.toggle = toggle;
      });
    // The swap script changed the layout (the window crossed 64em, or a phone turned): carry on in the new one if it
    // was moving.
    root.addEventListener('ag:layout', () => {
      const was = state;
      anims.forEach((a) => a.cancel());
      svg = svgFor();
      focusPill(null);
      bindPills(svg);
      if (svg)
        build(svg, () => {
          if (was === 'running') return start(WAKE);
          state = 'resting';
          root.classList.remove('is-paused');
          root.classList.add('is-resting');
          setButton(false);
        });
    });
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in Element.prototype)
    document.querySelectorAll<HTMLElement>('[data-agent-graph]').forEach((root) => {
      // The pause button shows and works straight away (so the caption never changes height later, and a press is
      // never lost); until the loop is set up, it just records the choice, and the CSS entrance pauses with it.
      const early: Early = { paused: false, toggle: null };
      const btn = root.querySelector<HTMLButtonElement>('[data-ag-toggle]');
      const label = root.querySelector<HTMLElement>('[data-ag-label]');
      if (btn) {
        btn.hidden = false;
        btn.addEventListener('click', () => {
          if (early.toggle) return early.toggle();
          early.paused = !early.paused;
          root.classList.toggle('is-paused', early.paused);
          btn.setAttribute('aria-pressed', String(early.paused));
          if (label) label.textContent = early.paused ? 'Play animation' : 'Pause animation';
        });
      }
      idle(() => setup(root, early), FIRST_IDLE);
    });
</script>

<style>
  .ag {
    position: relative;
    min-width: 0;
    width: 100%;
    display: grid;
    gap: var(--s-3);
  }
  .ag__stage {
    position: relative;
    isolation: isolate;
    --cx: var(--cx-t);
    --cy: var(--cy-t);
    --cd: var(--cd-t);
  }
  .ag__stage::before {
    /* The glow that the core gives off. */
    content: '';
    position: absolute;
    z-index: -1;
    left: var(--cx);
    top: var(--cy);
    width: calc(var(--cd) * 2.2);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgb(212 248 74 / 0.16), rgb(212 248 74 / 0.04) 45%, transparent 70%);
  }
  .ag__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* Holds whichever layout is in the page (design upgrade Phase 7): it adds no box of its own. */
  .ag__layout {
    display: contents;
  }
  /* The wide, left-to-right layout (from 64em, and on phones held sideways, where the tall one would be about two
     screens high): the swap script after the figure puts it in and marks the figure. Only one layout is ever in the
     page, so there is nothing to hide; without JavaScript the tall layout shows at every width. */
  .ag[data-layout='wide'] .ag__stage {
    --cx: var(--cx-w);
    --cy: var(--cy-w);
    --cd: var(--cd-w);
  }

  /* Static drawing (also the reduced-motion and finished state). */
  .ag__mesh path {
    fill: none;
    stroke: var(--graph-mesh);
    stroke-width: var(--graph-stroke-fine);
    stroke-linecap: round;
  }
  .ag__spokes path {
    fill: none;
    stroke: var(--graph-spoke);
    stroke-width: var(--graph-stroke);
    stroke-linecap: round;
  }
  .ag__ring {
    fill: none;
  }
  .ag__ring--dots {
    stroke: var(--graph-ring);
    stroke-width: var(--graph-stroke-fine);
    stroke-dasharray: 1.5 7;
  }
  .ag__ring--scan {
    stroke: var(--signal);
    stroke-width: var(--graph-stroke-bold);
    stroke-linecap: round;
    stroke-dasharray: 18 8 3 8 30 33;
    opacity: 0.9;
  }
  .ag__ping {
    fill: none;
    stroke: var(--signal);
    stroke-width: var(--graph-stroke);
    opacity: 0;
  }
  /* Still: two routes lit, so the diagram reads as a flow (reduced motion, or no JavaScript). */
  .ag__pulse {
    fill: none;
    stroke: var(--signal);
    stroke-width: var(--graph-stroke-signal);
    stroke-linecap: round;
    opacity: 0.55;
  }
  .ag__pulse:not([data-lit]) {
    display: none;
  }
  /* The moving streaks (created by the script, so styled globally). */
  .ag :global(.ag__spark) {
    fill: var(--signal);
    filter: drop-shadow(0 0 4px rgb(212 248 74 / 0.8));
    opacity: 0;
  }
  .ag__lit circle {
    fill: var(--signal);
    stroke: var(--signal);
    stroke-width: var(--graph-stroke);
    opacity: 0;
  }
  .ag__glow {
    filter: drop-shadow(0 0 10px rgb(212 248 74 / 0.9));
    opacity: 0;
  }
  .ag__nodes circle {
    fill: var(--bg);
    stroke: var(--graph-node);
    stroke-width: var(--graph-stroke);
  }
  .ag__pill rect {
    fill: var(--surface);
    stroke: var(--graph-pill-line);
    stroke-width: var(--graph-stroke-fine);
  }
  .ag__pill text {
    fill: var(--text);
    font-family: var(--font-sans);
    font-weight: var(--w-ui);
    letter-spacing: -0.01em;
    text-anchor: middle;
  }
  .ag__pill--goal rect {
    fill: var(--signal);
    stroke: var(--signal);
  }
  .ag__pill--goal text {
    fill: var(--on-signal);
    font-weight: var(--w-head);
  }

  /* The portrait: a real photo as the core node. */
  .ag__core {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    width: var(--cd);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    padding: 5px;
    background: conic-gradient(from 210deg, var(--signal), rgb(212 248 74 / 0.15) 40%, var(--signal) 70%, rgb(212 248 74 / 0.3));
    box-shadow: 0 0 0 1px rgb(212 248 74 / 0.25), var(--shadow-media);
  }
  .ag__photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    background: var(--surface);
  }

  .ag__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-label);
    color: var(--text-3);
    line-height: 1.45;
  }
  .ag__who b {
    color: var(--text);
    font-weight: var(--w-head);
  }
  .ag__toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding-inline: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-2);
    font: inherit;
    cursor: pointer;
  }
  .ag__toggle:hover,
  .ag__toggle:focus-visible {
    color: var(--text);
    border-color: var(--control);
  }
  .ag__i-play,
  .ag__toggle[aria-pressed='true'] .ag__i-pause {
    display: none;
  }
  .ag__toggle[aria-pressed='true'] .ag__i-play {
    display: inline;
  }
  @media (max-width: 39.99em) {
    .ag__toggle [data-ag-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ag__toggle {
      width: var(--tap);
      justify-content: center;
      padding: 0;
    }
  }

  /* ── Explore (design upgrade Phase 4): an input pill lights its two routes and the pills they reach; the rest dims. ── */
  .ag__mesh,
  .ag__spokes,
  .ag__nodes,
  .ag__lit,
  .ag__sparks,
  .ag__pill > *,
  .ag__pulse {
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .ag[data-focus] :is(.ag__mesh, .ag__spokes, .ag__nodes, .ag__lit, .ag__sparks, .ag__pulse, .ag__pill > *) {
    opacity: 0.3;
  }
  .ag[data-focus='0'] :is(.ag__pill[data-in='0'], .ag__pill[data-from~='0']) > *,
  .ag[data-focus='1'] :is(.ag__pill[data-in='1'], .ag__pill[data-from~='1']) > *,
  .ag[data-focus='2'] :is(.ag__pill[data-in='2'], .ag__pill[data-from~='2']) > * {
    opacity: 1;
  }
  .ag[data-focus='0'] .ag__pulse[data-in='0'],
  .ag[data-focus='1'] .ag__pulse[data-in='1'],
  .ag[data-focus='2'] .ag__pulse[data-in='2'] {
    display: inline;
    opacity: 1;
  }
  .ag__pill[data-in] {
    cursor: pointer;
  }

  /* ── Motion: the entrance, in CSS on load (finished by about 1.15 s; DESIGN.md → Motion → Hero entrance). The loop
     that follows is the script above. Without the script or with reduced motion, the still diagram. ── */
  @media (prefers-reduced-motion: no-preference) {
    /* The network wires itself up: each input's and output's lines fade in, in a cascade, then the spokes. */
    :global(.js-motion) .ag__mesh > g {
      animation: ag-line var(--dur-3) var(--ease-out) both;
      animation-delay: calc(var(--dur-3) + var(--i) * var(--stagger));
    }
    :global(.js-motion) .ag__spokes > g {
      animation: ag-line var(--dur-3) var(--ease-out) both;
      animation-delay: calc(var(--dur-4) + var(--i) * var(--stagger));
    }
    /* The hidden nodes come in a column at a time (two groups, so the first frames stay light: gate M7). */
    :global(.js-motion) .ag__nodes > g {
      animation: ag-fade var(--dur-4) var(--ease-out) both;
      animation-delay: calc(var(--dur-3) + var(--i) * var(--stagger) * 2);
    }
    :global(.js-motion) .ag__pill {
      animation: ag-fade var(--dur-4) var(--ease-out) both;
      animation-delay: calc(var(--dur-2) + var(--i) * var(--stagger));
    }
    /* The core: scale 0.92 → 1 at 320ms, with the dotted orbit fading in around it. */
    :global(.js-motion) .ag__core {
      animation: ag-core var(--dur-5) var(--ease-out) var(--dur-3) both;
    }
    :global(.js-motion) .ag__orbit {
      animation: ag-line var(--dur-5) var(--ease-out) var(--dur-3) both;
    }
    /* With the script, the moving streaks stand in for the still routes, which come back when the loop rests. */
    :global(.js-motion) .ag__pulse {
      opacity: 0;
      transition-duration: var(--dur-4);
    }
    :global(.js-motion) .ag.is-resting .ag__pulse {
      opacity: 0.55;
    }
    :global(.js-motion) .ag[data-focus] .ag__pulse:is([data-in]) {
      opacity: 0;
    }
    :global(.js-motion) .ag[data-focus='0'] .ag__pulse[data-in='0'],
    :global(.js-motion) .ag[data-focus='1'] .ag__pulse[data-in='1'],
    :global(.js-motion) .ag[data-focus='2'] .ag__pulse[data-in='2'] {
      opacity: 1;
    }
    .ag.is-paused *,
    .ag.is-paused::before {
      animation-play-state: paused !important;
    }
  }
  @keyframes ag-line {
    from {
      opacity: 0;
    }
  }
  @keyframes ag-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes ag-core {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.92);
    }
  }
</style>
