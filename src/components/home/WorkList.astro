---
/**
 * Recent work as large rows. On a mouse/trackpad, a small browser window follows the cursor,
 * shows the hovered project's capture and types its address into the address bar. Touch and keyboard users get plain, fully
 * labelled links (the preview is decorative and hidden from assistive tech).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import nestDesktop from '../../assets/work/nest-and-rest/live-2026-10-31-desktop.png';
import sampDesktop from '../../assets/work/samp-hair-spa/preview-2026-10-31-desktop.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const images = {
  'nest-and-rest': { src: nestDesktop, tint: '#dfe8ee' },
  samp: { src: sampDesktop, tint: '#f1dde1' },
} as const;
const status = { launched: 'Live', 'in-progress': 'In progress', prototype: 'Prototype' } as const;
const host = (w: (typeof work)[number]) => {
  const url = w.data.links?.[0]?.url;
  return url ? new URL(url).host.replace(/^www\./, '') : w.data.title;
};
---

<section class="section wl" id="work" aria-labelledby="wl-title" data-worklist>
  <div class="container">
    <p class="label" id="wl-title">Recent work</p>
    <ul class="wl-list" role="list">
      {
        work.map((w, i) => (
          <li>
            <a class="wl-row" href={`/work/${w.id}/`} data-index={i} data-host={host(w)}>
              <span class="wl-thumb" aria-hidden="true" style={`background:${images[w.data.scene].tint}`}>
                <Image src={images[w.data.scene].src} alt="" widths={[360, 640]} sizes="90vw" loading="lazy" decoding="async" />
              </span>
              <span class="wl-title">{w.data.title}</span>
              <span class="wl-meta">
                <span>{w.data.kind.split('·')[0].trim()}</span>
                <span class="wl-status">{status[w.data.status]}</span>
                <span class="wl-cta">Case study <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="wl-more">
      <a class="pill-btn" href="/work/" data-magnetic>
        <span data-magnetic-label>All work <sup>{work.length}</sup></span>
      </a>
    </p>
  </div>

  <div class="wl-preview" aria-hidden="true" data-wl-preview>
    <div class="wl-chrome">
      <span class="wl-dots"><i></i><i></i><i></i></span>
      <span class="wl-url"><span class="wl-lock">●</span> <span data-wl-url></span><span class="wl-caret"></span></span>
    </div>
    <div class="wl-window">
    <div class="wl-slides" data-wl-slides>
      {
        work.map((w) => {
          const img = images[w.data.scene];
          return (
            <div class="wl-slide" style={`background:${img.tint}`}>
              <Image src={img.src} alt="" widths={[480, 720]} sizes="22rem" loading="lazy" decoding="async" />
            </div>
          );
        })
      }
    </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-worklist]');
  const preview = section?.querySelector<HTMLElement>('[data-wl-preview]');
  const slides = section?.querySelector<HTMLElement>('[data-wl-slides]');
  const urlEl = section?.querySelector<HTMLElement>('[data-wl-url]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const motion = document.documentElement.classList.contains('js-motion');

  if (section && preview && slides && fine && motion) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;
    const follow = () => {
      const vx = tx - x;
      x += vx * 0.14;
      y += (ty - y) * 0.14;
      // The window leans into the direction of travel.
      const lean = Math.max(-7, Math.min(7, vx * 0.05));
      preview.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%) rotate(${lean.toFixed(2)}deg)`;
      raf = requestAnimationFrame(follow);
    };
    section.querySelectorAll<HTMLElement>('.wl-row').forEach((row) => {
      let typing = 0;
      row.addEventListener('pointerenter', () => {
        slides.style.transform = `translateY(${-100 * Number(row.dataset.index)}%)`;
        // Type the project's address into the little address bar.
        const text = row.dataset.host ?? '';
        let n = 0;
        window.clearInterval(typing);
        if (urlEl) {
          urlEl.textContent = '';
          typing = window.setInterval(() => {
            urlEl.textContent = text.slice(0, ++n);
            if (n >= text.length) window.clearInterval(typing);
          }, 28);
        }
        preview.classList.add('is-on');
        section.classList.add('is-hovering');
      });
      row.addEventListener('pointerleave', () => {
        preview.classList.remove('is-on');
        section.classList.remove('is-hovering');
      });
    });
    section.addEventListener('pointermove', (e) => {
      const r = section.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!raf) {
        x = tx;
        y = ty;
        raf = requestAnimationFrame(follow);
      }
    });
    section.addEventListener('pointerleave', () => {
      cancelAnimationFrame(raf);
      raf = 0;
    });
  }
</script>

<style>
  .wl {
    position: relative;
    padding-top: 0;
  }
  .wl-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  .wl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-s) var(--space-l);
    align-items: center;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(0rem, 3vw, 3rem);
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: opacity 300ms var(--ease-out), padding 450ms var(--ease-out);
  }
  .wl-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3.4vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .wl-meta {
    display: grid;
    justify-items: end;
    gap: var(--space-3xs);
    color: var(--ink-2);
    text-align: right;
  }
  .wl-cta {
    margin-top: var(--space-2xs);
    font-weight: 700;
    color: var(--accent-text);
  }
  .wl-row:hover .wl-cta,
  .wl-row:focus-visible .wl-cta {
    text-decoration: underline;
  }
  /* Touch screens (no hover): show the project image inside the row. */
  .wl-thumb {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    padding: var(--space-s);
    border-radius: var(--radius-m);
  }
  .wl-thumb :global(img) {
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 10px 24px -16px rgb(0 0 0 / 0.5);
  }
  @media (hover: hover) and (pointer: fine) {
    .wl-thumb {
      display: none;
    }
  }
  .wl-status {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  @media (hover: hover) and (pointer: fine) {
    .wl.is-hovering .wl-row {
      opacity: 0.35;
    }
    .wl.is-hovering .wl-row:hover {
      opacity: 1;
      padding-inline: clamp(1rem, 5vw, 5rem) clamp(0rem, 1vw, 1rem);
    }
  }
  .wl-row:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  @media (max-width: 40em) {
    .wl-row {
      grid-template-columns: 1fr;
    }
    .wl-meta {
      justify-items: start;
      text-align: left;
    }
  }
  .wl-more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xl);
  }
  .pill-btn {
    display: inline-flex;
    align-items: center;
    min-height: 4rem;
    padding: 0 var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .pill-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .pill-btn sup {
    font-size: 0.7em;
    margin-left: 0.15em;
  }

  /* Cursor-following preview (mouse only) */
  .wl-preview {
    position: absolute;
    z-index: 5;
    top: 0;
    left: 0;
    width: 22rem;
    height: 16rem;
    overflow: hidden;
    border-radius: var(--radius-m);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
    pointer-events: none;
    transform: translate(-50%, -50%);
    scale: 0;
    transition: scale 380ms cubic-bezier(0.76, 0, 0.24, 1);
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .wl-preview {
      display: block;
    }
  }
  .wl-preview.is-on {
    scale: 1;
  }
  .wl-slides {
    height: 100%;
    transition: transform 520ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  .wl-slide {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.6rem;
  }
  .wl-slide :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 12px 30px -16px rgb(0 0 0 / 0.5);
  }
  .wl-chrome {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 2rem;
    padding: 0 0.6rem;
    background: var(--ink);
    color: var(--paper);
  }
  .wl-dots {
    display: flex;
    gap: 0.3rem;
  }
  .wl-dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #f4f1ea55;
  }
  .wl-dots i:first-child {
    background: var(--accent-on-night);
  }
  .wl-url {
    flex: 1;
    min-width: 0;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: #ffffff1a;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .wl-lock {
    color: #3ecf8e;
    font-size: 0.6rem;
    vertical-align: 0.1em;
  }
  .wl-caret {
    display: inline-block;
    width: 1px;
    height: 0.85em;
    margin-left: 1px;
    background: currentColor;
    vertical-align: -0.1em;
    animation: wl-blink 1s steps(1) infinite;
  }
  @keyframes wl-blink {
    50% {
      opacity: 0;
    }
  }
  .wl-window {
    height: calc(100% - 2rem);
    overflow: hidden;
  }
</style>
