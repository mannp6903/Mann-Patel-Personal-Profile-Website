---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import ProjectMedia from '../work/ProjectMedia.astro';
import { projectSite } from '../../lib/work';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat('en-CA', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
---

<section class="sw section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="sw__head">
      <p class="eyebrow">01 / Selected work</p>
      <h2 id="work-title" class="sw__title">Work in the wild<span>.</span></h2>
      <a class="link-arrow sw__all" href="/work/">All work <Icon name="arrow-ne" /></a>
      <p class="sw__intro">A business I’m building and a client site in progress. See what each project needed and how I approached it.</p>
    </div>

    <ol class="sw__list" role="list">
      {
        work.map((entry, index) => {
          const project = entry.data;
          const site = projectSite(project);
          const href = `/work/${entry.id}/`;
          return (
            <li>
              <article class="sw__card" aria-labelledby={`sw-${entry.id}`} data-spotlight>
                <a class="sw__media" href={href} tabindex="-1" aria-hidden="true">
                  <ProjectMedia scene={project.scene} sizes="(min-width: 64em) 49vw, 90vw" />
                </a>
                <div class="sw__body">
                  <p class="sw__index num" aria-hidden="true">{String(index + 1).padStart(2, '0')} / {String(work.length).padStart(2, '0')}</p>
                  <h3 class="sw__name" id={`sw-${entry.id}`}>
                    <a href={href}>{project.title}</a>
                  </h3>
                  <p class="sw__labels">
                    <span>{project.relationship}</span>
                    <span class:list={['sw__state', { 'sw__state--live': site.live }]}>
                      {site.websiteStatus}
                    </span>
                  </p>
                  {project.businessStatus && <p class="sw__business">{project.businessStatus}</p>}
                  <dl class="sw__facts">
                    <div><dt>The problem</dt><dd>{project.problem}</dd></div>
                    <div><dt>My role</dt><dd>{project.roleShort}</dd></div>
                  </dl>
                  <div class="sw__foot">
                    <a class="link-arrow" href={href}>
                      Read the case study <span class="visually-hidden">: {project.title}</span>
                      <Icon name="arrow-ne" />
                    </a>
                    <p class="num sw__date">Checked {fmtDate(project.checked)}</p>
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .sw {
    --text: #181a13;
    --text-2: #43473b;
    --text-3: #575a50;
    --line: #c7c8ba;
    --signal: #40541e;
    --focus: #40541e;
    padding-block: clamp(2.5rem, 6vw, 6rem);
    background: #f0f0e8;
    color: var(--text);
    color-scheme: light;
  }
  .sw__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-3) var(--s-4);
    padding-top: var(--s-4);
    margin-bottom: clamp(var(--s-6), 5vw, var(--s-9));
    border-top: 1px solid var(--line);
  }
  .sw__head .eyebrow, .sw__intro { grid-column: 1 / -1; }
  .sw__title {
    font-size: clamp(2.65rem, 8.5vw, 8.25rem);
    letter-spacing: -0.085em;
    line-height: 0.92;
    font-weight: 650;
  }
  .sw__title span { color: var(--signal); }
  .sw__intro { max-width: 58ch; color: var(--text-2); }
  .sw__all { white-space: nowrap; }
  .sw__list { display: grid; }
  .sw__card {
    display: grid;
    gap: var(--s-5);
    padding-block: clamp(var(--s-4), 3vw, var(--s-7));
    border-top: 1px solid var(--line);
  }
  .sw__list > li:last-child { border-bottom: 1px solid var(--line); }
  .sw__media {
    --bg-2: #bfc9c9;
    position: relative;
    display: block;
    align-self: start;
    text-decoration: none;
  }
  .sw__list > li:nth-child(even) .sw__media { --bg-2: #d5c4c9; }
  .sw__media :global(.pm) { border-radius: 0; }
  .sw__body {
    display: grid;
    align-content: center;
    justify-items: start;
    min-width: 0;
    gap: var(--s-3);
  }
  .sw__index, .sw__date {
    color: var(--text-3);
    font-size: var(--fs-xs);
  }
  .sw__name {
    font-size: clamp(2.05rem, 4.25vw, 4.8rem);
    font-weight: 625;
    letter-spacing: -0.065em;
    line-height: 0.98;
    text-wrap: initial;
  }
  .sw__name a { text-decoration: none; }
  .sw__name a:hover { color: var(--signal); }
  .sw__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0.7em;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.73rem;
  }
  .sw__labels > span {
    padding: 0.32em 0.7em;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
  }
  .sw__state--live { color: var(--signal); }
  .sw__business { color: var(--text-3); font-size: var(--fs-sm); }
  .sw__facts { display: grid; gap: var(--s-2); }
  .sw__facts dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .sw__facts dd { color: var(--text-2); max-width: 47ch; }
  .sw__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
  }
  @media (min-width: 64em) {
    .sw__card {
      grid-template-columns: minmax(0, 1.52fr) minmax(0, 1fr);
      gap: clamp(var(--s-6), 5vw, var(--s-9));
    }
    .sw__list > li:nth-child(even) .sw__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1.52fr); }
    .sw__list > li:nth-child(even) .sw__media { grid-column: 2; grid-row: 1; }
    .sw__list > li:nth-child(even) .sw__body { grid-column: 1; grid-row: 1; }
  }
  @media (max-width: 39.99em) {
    .sw { padding-block: var(--s-6); }
    .sw__head { grid-template-columns: 1fr; gap: var(--s-2); }
    .sw__intro, .sw__facts dd { font-size: var(--fs-sm); }
    .sw__index { display: none; }
    .sw__body { gap: var(--s-2); }
    .sw__all { grid-row: 4; justify-self: start; }
  }
</style>
