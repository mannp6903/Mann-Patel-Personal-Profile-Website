---
/**
 * "What I do": the three service areas as one customer path. On desktop a phone stays in view
 * and switches to the example screen of the step being read. On phones and tablets the areas are
 * tabs (A · B · C), one at a time with its own example screen, so the section stays short.
 * Without JavaScript all three show in a column. Screens are decorative examples (fictional
 * business), hidden from assistive tech.
 */
import { groups, servicesInGroup, addOns } from '../../data/services';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import PhoneScreen from './PhoneScreen.astro';

const kinds = groups.map((g) => g.id) as ('found' | 'answered' | 'booked')[];
---

<section class="path section" id="what-i-do" aria-labelledby="path-title" data-path>
  <div class="container">
    <div class="section-head section-head--split">
      <div class="stack" style="--stack: var(--s-5)">
        <p class="eyebrow">What I do</p>
        <Heading id="path-title" lines={['Three jobs.', '<span class="serif">One customer path.</span>']} />
      </div>
      <p class="lead path__lead" data-reveal data-scrub>
        Most small businesses lose work in one of three places: they aren’t found, they don’t answer in time, or booking
        is hard. I fix the one that costs you most, first.
      </p>
    </div>

    <div class="path__tabs" role="tablist" aria-label="What I help with" data-path-tabs hidden>
      {
        groups.map((g, i) => (
          <button class="path__tab" type="button" role="tab" id={`tab-${g.id}`} aria-controls={g.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="path__tab-l num" aria-hidden="true">
              {g.letter}
            </span>
            {g.verb}
          </button>
        ))
      }
    </div>

    <div class="path__grid">
      <ol class="path__steps" role="list">
        {
          groups.map((g, i) => (
            <li class="step" id={g.id} data-step={g.id}>
              <div class="step__head">
                <span class="step__letter" aria-hidden="true">
                  {g.letter}
                </span>
                <p class="eyebrow eyebrow--plain">
                  <span class="visually-hidden">Area {g.letter}: </span>
                  {g.verb}
                </p>
              </div>
              <h3 class="step__title">{g.title}</h3>
              <p class="step__intro muted">{g.intro}</p>
              <ul class="step__list" role="list">
                {servicesInGroup(g.id).map((s) => (
                  <li>
                    <a href={`/services/#${s.id}`}>
                      <span class="roll">
                        <span data-text={s.name}>{s.name}</span>
                      </span>
                      <Icon name="arrow" />
                    </a>
                  </li>
                ))}
              </ul>
              <div class="step__screen" aria-hidden="true">
                <div class="phone is-idle" data-inline-screen>
                  <span class="phone__island" />
                  <span class="phone__tag"><b>Example</b><i>Fictional</i></span>
                  <PhoneScreen kind={kinds[i]} />
                </div>
                <p class="path__note num">Example · fictional business</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="path__device" aria-hidden="true">
        <div class="path__sticky">
          <div class="phone phone--lg">
            <span class="phone__island"></span>
            <span class="phone__tag"><b>Example</b><i>Fictional</i></span>
            {
              kinds.map((k, i) => (
                <div class:list={['dev__screen', i === 0 ? 'is-active' : 'is-idle']} data-dev={k}>
                  <PhoneScreen kind={k} />
                </div>
              ))
            }
          </div>
          <div class="path__meta">
            <p class="path__note num">Example · fictional business</p>
            <ol class="path__dots" role="list">
              {groups.map((g, i) => <li class:list={{ 'is-on': i === 0 }} data-dot={g.id}>{g.letter}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>

    <div class="path__extra" data-reveal>
      <p class="path__addon">
        <span class="eyebrow eyebrow--plain">Add-ons</span>
        <span>{addOns.intro}</span>
      </p>
      <a class="link-arrow" href="/services/">
        Every service, with what’s included and what isn’t
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-path]');
  if (root) {
    const screens = [...root.querySelectorAll<HTMLElement>('[data-dev]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const setActive = (id: string) => {
      screens.forEach((s) => {
        const on = s.dataset.dev === id;
        s.classList.toggle('is-active', on);
        s.classList.toggle('is-idle', !on);
      });
      dots.forEach((d) => d.classList.toggle('is-on', d.dataset.dot === id));
    };
    // The step crossing the middle of the viewport drives the phone.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.step!);
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => io.observe(s));

    // Phones: each inline screen plays when it scrolls into view.
    const io2 = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.remove('is-idle');
          io2.unobserve(e.target);
        }
      },
      { threshold: 0.35 },
    );
    root.querySelectorAll('[data-inline-screen]').forEach((s) => io2.observe(s));

    // Phones and tablets: the three areas become tabs, one at a time.
    const tabsWrap = root.querySelector<HTMLElement>('[data-path-tabs]')!;
    const tabs = [...tabsWrap.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const list = root.querySelector<HTMLElement>('.path__steps')!;
    const mq = matchMedia('(max-width: 63.99em)');
    let current = 0;
    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      if (!mq.matches) return;
      steps.forEach((s, k) => (s.hidden = k !== i));
      // Replay the example screen for the newly shown area.
      const scr = steps[i].querySelector<HTMLElement>('[data-inline-screen]');
      if (scr) {
        scr.classList.add('is-idle');
        requestAnimationFrame(() => requestAnimationFrame(() => scr.classList.remove('is-idle')));
      }
      if (focus) tabs[i].focus();
    };
    const apply = () => {
      if (mq.matches) {
        tabsWrap.hidden = false;
        root.classList.add('is-tabbed');
        list.setAttribute('role', 'none');
        steps.forEach((s, k) => {
          s.setAttribute('role', 'tabpanel');
          s.setAttribute('aria-labelledby', tabs[k].id);
        });
        select(current);
      } else {
        tabsWrap.hidden = true;
        root.classList.remove('is-tabbed');
        list.setAttribute('role', 'list');
        steps.forEach((s) => {
          s.removeAttribute('role');
          s.removeAttribute('aria-labelledby');
          s.hidden = false;
        });
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select((keys[e.key] + tabs.length) % tabs.length, true);
      });
    });
    // Links to #found, #answered or #booked open that tab.
    const fromHash = () => {
      const k = steps.findIndex((s) => `#${s.id}` === location.hash);
      if (k >= 0 && mq.matches) select(k);
    };
    addEventListener('hashchange', fromHash);
    mq.addEventListener('change', apply);
    apply();
    fromHash();
  }
</script>

<style>
  .path__grid {
    display: grid;
    gap: var(--s-8);
  }
  /* Tabs (phones and tablets) */
  .path__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    margin-bottom: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg-2);
  }
  .path__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: var(--tap);
    padding: 0 0.5rem;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 620;
    white-space: nowrap;
    transition: background-color var(--t-base) var(--ease-out), color var(--t-base);
  }
  .path__tab-l {
    font-size: 0.7rem;
    color: var(--signal);
  }
  .path__tab[aria-selected='true'] {
    background: var(--signal);
    color: var(--on-signal);
  }
  .path__tab[aria-selected='true'] .path__tab-l {
    color: var(--on-signal);
  }
  .path:global(.is-tabbed) .path__steps {
    gap: 0;
  }
  .path:global(.is-tabbed) .step__head {
    display: none;
  }
  @media (max-width: 63.99em) {
    .path:global(.is-tabbed) .step {
      animation: tab-in 520ms var(--ease-out);
    }
  }
  @keyframes tab-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .path__steps {
    display: grid;
    gap: var(--s-9);
  }
  .step {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .step__head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .step__letter {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--signal);
    color: var(--signal);
    font-weight: 700;
    font-stretch: 120%;
    font-size: 1.15rem;
  }
  .step__title {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 16ch;
  }
  .step__intro {
    max-width: 48ch;
  }
  .step__list {
    margin-top: var(--s-3);
    border-top: 1px solid var(--line);
  }
  .step__list li {
    border-bottom: 1px solid var(--line);
  }
  .step__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.25rem;
    padding-block: var(--s-2);
    text-decoration: none;
    font-weight: 540;
    color: var(--text);
    transition: color var(--t-fast), padding var(--t-base) var(--ease-out);
  }
  .step__list .icon {
    color: var(--text-3);
    transition: transform var(--t-base) var(--ease-out), color var(--t-fast);
  }
  @media (hover: hover) {
    .step__list a:hover {
      color: var(--signal);
      padding-left: var(--s-3);
    }
    .step__list a:hover .icon {
      transform: translateX(4px);
      color: var(--signal);
    }
  }
  .step__screen {
    margin-top: var(--s-5);
    display: grid;
    justify-items: center;
    gap: var(--s-3);
  }
  /* Phones: a smaller, shorter example phone. Tablets: phone beside the text. */
  .step__screen .phone {
    width: min(12.75rem, 60vw);
    aspect-ratio: 9 / 16;
    border-radius: 2.2rem;
  }
  @media (min-width: 40em) and (max-width: 63.99em) {
    .step {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--s-7);
    }
    .step > * {
      grid-column: 1;
    }
    .step__screen {
      grid-column: 2;
      grid-row: 1 / span 5;
      margin-top: 0;
      align-self: start;
    }
  }

  /* ── Phone frame ── */
  .phone {
    position: relative;
    width: min(18rem, 78vw);
    aspect-ratio: 9 / 18.5;
    border-radius: 2.6rem;
    border: 9px solid #1c1c20;
    box-shadow:
      0 0 0 1px #34343a,
      0 40px 80px -40px rgb(0 0 0 / 0.9),
      0 0 120px -40px rgb(212 248 74 / 0.18);
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
  }
  .phone__island {
    position: absolute;
    top: 0.6rem;
    left: 50%;
    z-index: 3;
    width: 34%;
    height: 1.35rem;
    border-radius: var(--r-pill);
    background: #000;
    transform: translateX(-50%);
  }
  /* Status-bar label on every example screen, so no one mistakes it for a real client. */
  .phone__tag {
    position: absolute;
    top: 0.72rem;
    left: 0.95rem;
    right: 0.95rem;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .phone__tag b {
    font-weight: 600;
    color: var(--signal);
  }
  .phone__tag i {
    font-style: normal;
    color: var(--text-2);
  }
  .phone--lg {
    width: 20rem;
  }
  .dev__screen {
    position: absolute;
    inset: 0;
    transition:
      opacity 600ms var(--ease-out),
      transform 700ms var(--ease-out);
  }
  .dev__screen.is-idle {
    opacity: 0;
    transform: translateY(4%) scale(0.98);
  }
  .path__device {
    display: none;
  }
  .path__note {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }
  .path__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 20rem;
  }
  .path__dots {
    display: flex;
    gap: var(--s-2);
  }
  .path__dots li {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    transition: background-color var(--t-base), color var(--t-base), border-color var(--t-base);
  }
  .path__dots li.is-on {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }

  .path__extra {
    margin-top: var(--s-9);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-4);
  }
  @media (max-width: 47.99em) {
    .path__extra {
      margin-top: var(--s-6);
      padding-top: var(--s-5);
    }
    .path__addon {
      display: none !important;
    }
  }
  .path__addon {
    display: grid;
    gap: var(--s-2);
    max-width: 62ch;
    color: var(--text-2);
  }
  @media (min-width: 64em) {
    .path__extra {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--s-8);
    }
  }

  @media (min-width: 64em) {
    .path__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-8);
    }
    .path__steps {
      gap: 0;
    }
    .step {
      min-height: 88vh;
      padding-block: 10vh;
    }
    .step:first-child {
      padding-top: 0;
    }
    .step__screen {
      display: none;
    }
    .path__device {
      display: block;
    }
    .path__sticky {
      position: sticky;
      top: calc(var(--header-h) + 4vh);
      display: grid;
      justify-items: center;
      gap: var(--s-4);
    }
    .phone--lg {
      width: min(20rem, calc((100vh - var(--header-h) - 8rem) * 9 / 18.5));
    }
    .path__meta {
      width: min(20rem, calc((100vh - var(--header-h) - 8rem) * 9 / 18.5));
    }
  }
</style>
