---
/**
 * Process and founder: a short introduction (the full story lives on About), how a project runs
 * in five steps, with Mann’s interactive portrait alongside the introduction.
 */
import { profile, businesses } from '../../data/site';
import { businessHref } from '../../lib/work';
import { process } from '../../data/services';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';

const nest = businesses[0];
const rules = [
  { t: 'You own every account', d: 'Domains, Google profiles and logins are created in your name.' },
  { t: 'A handover you can use', d: 'Access, what changed and what’s left to do, written down.' },
  { t: 'Real reviews only', d: 'No bought, swapped or incentivised reviews. Ever.' },
  { t: 'No promised rankings', d: 'Google decides rankings. I improve what you control.' },
];
---

<section class="about section section--rule" id="how-i-work" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__head">
      <p class="eyebrow">04 / The person behind it</p>
      <h2 id="about-title" class="about__title">Hi, I’m Mann. <span class="accent">I’m building a business too.</span></h2>
      <p class="lead about__lead">
        I’m starting <a class="link" href={businessHref(nest)} rel={nest.siteLive ? 'noopener' : undefined}>{nest.name}</a> in {nest.area}, and built its website from
        scratch. I set up the same foundations for other small businesses across {profile.serviceArea}, and explain them in plain
        language.
      </p>
      <a class="link-arrow" href="/about/">More about me <Icon name="arrow" /></a>
      {
        profile.portrait && (
          <figure class="about__photo">
            <Image
              src={profile.portrait.src}
              alt={profile.portrait.alt}
              widths={[360, 560, 720, 960]}
              sizes="(min-width: 64em) 30rem, min(28rem, 92vw)"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <b>Mann Patel</b>
              <span>Web designer and AI automation builder · Scarborough, Toronto</span>
            </figcaption>
          </figure>
        )
      }
    </div>

    <div class="about__side">
      <div>
        <h3 class="about__h">How a project runs</h3>
        <ol class="steps" role="list">
          {
            process.map((s, i) => (
              <li>
                <span class="num steps__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>
                  <b>{s.title}.</b> <span class="muted">{s.me}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="about__h">What you can count on</h3>
        <ul class="rules" role="list">
          {
            rules.map((r) => (
              <li>
                <Icon name="check" />
                <span>
                  <b>{r.t}.</b> {r.d}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 39.99em) {
    .about { padding-block: 2.25rem; }
  }
  .about__grid {
    display: grid;
    gap: var(--s-7);
  }
  .about__head {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    justify-items: start;
  }
  .about__title {
    font-size: clamp(2.65rem, 4.5vw, 5.5rem);
    letter-spacing: -0.075em;
    line-height: 0.98;
    max-width: 15ch;
  }
  .about__lead {
    max-width: 40ch;
  }
  .about__photo {
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin-top: var(--s-3);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .about__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .about__photo figcaption {
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: var(--s-3);
    display: grid;
    gap: 0.1rem;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: rgb(11 11 12 / 0.72);
    backdrop-filter: blur(10px);
    font-size: var(--fs-xs);
    color: var(--text-2);
  }
  .about__photo figcaption b {
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .about__side {
    display: grid;
    gap: var(--s-7);
  }
  .about__h {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--s-3);
  }
  .steps,
  .rules {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .steps li,
  .rules li {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .steps b,
  .rules b {
    color: var(--text);
    font-weight: 600;
  }
  .steps__n {
    flex: none;
    width: 2ch;
    font-size: var(--fs-xs);
    color: var(--signal);
  }
  .rules li {
    align-items: flex-start;
    color: var(--text-2);
  }
  .rules :global(.icon) {
    margin-top: 0.2em;
    color: var(--signal);
  }
  @media (min-width: 64em) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    .about__head {
      align-self: start;
    }
  }
  @media (min-width: 48em) {
    .rules {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-6);
    }
  }
</style>
