---
/** A short introduction and the house rules (no photo here: the portrait lives in the hero). */
import { profile, businesses } from '../../data/site';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const nest = businesses[0];
const rules = [
  { t: 'You own every account', d: 'Domains, Google profiles and logins are created in your name.' },
  { t: 'Real reviews only', d: 'No bought, swapped or incentivised reviews. Ever.' },
  { t: 'No promised rankings', d: 'Google decides rankings. I improve what you control.' },
  { t: 'Plain language, in writing', d: 'A written scope with deliverables, exclusions and costs.' },
];
---

<section class="about section section--rule" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__head">
      <p class="eyebrow">About</p>
      <Heading id="about-title" lines={['Hi, I’m Mann.', '<span class="serif">I’m building a business too.</span>']} />
      <div class="btn-row" data-reveal>
        <Button href="/about/" variant="ghost">Read my story</Button>
      </div>
    </div>
    <div class="about__text">
      <div class="stack about__copy" data-reveal style="--stack: var(--s-4)">
        <p class="lead">
          I’m starting <a class="link" href={nest.url} rel="noopener">{nest.name}</a>, a home-cleaning business in {nest.area}. I
          built its website from scratch, and I clean every home myself when bookings open in summer 2027.
        </p>
        <p class="muted about__more">
          That’s where I learned what owners actually need: to be found, to answer quickly, and to make booking easy. Now I set
          up the same foundations for other small businesses across {profile.serviceArea}.
        </p>
      </div>
      <ul class="rules rail" role="list" aria-label="House rules" data-rail>
        {
          rules.map((r, i) => (
            <li data-reveal style={`--d:${i * 70}`}>
              <Icon name="check" />
              <span>
                <b>{r.t}.</b> {r.d}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--s-6);
  }
  .about__head {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    justify-items: start;
  }
  .about__text {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .about__copy .lead {
    max-width: 40ch;
  }
  .rules {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-3);
  }
    .rules li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    color: var(--text-2);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .rules b {
    color: var(--text);
    font-weight: 620;
  }
  .rules .icon {
    margin-top: 0.2em;
    color: var(--signal);
  }
  @media (min-width: 64em) {
    .about__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-9);
    }
    .about__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
    .rules {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--s-6);
    }
  }
  @media (max-width: 47.99em) {
    .rules li {
      padding: var(--s-4);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--surface);
    }
  }
  @media (max-width: 47.99em) {
    .about__more {
      display: none;
    }
  }
</style>
