---
/**
 * What I do, in three short summaries (found → answered → booked). Each links to its focused
 * service page (round 10), which says who it's for, the work, the package and its limits. The longer example
 * screens that used to live here were removed so the real work comes first (round 7).
 */
import { groups, addOns } from '../../data/services';
import { servicePageForGroup } from '../../data/service-pages';
import { packageById, priceLabel } from '../../data/packages';

// The package that matches each area (package preview, audit 8 Nov 2026).
const packageFor: Record<string, ReturnType<typeof packageById>> = {
  found: packageById('local-visibility'),
  answered: packageById('website-enquiry'),
  booked: packageById('website-launch'),
};
import Icon from '../ui/Icon.astro';
---

<section class="ss section section--rule" id="what-i-do" aria-labelledby="ss-title">
  <div class="container">
    <div class="ss__head">
      <p class="eyebrow">02 / Services</p>
      <h2 id="ss-title" class="ss__title">From search <span class="accent">to booked.</span></h2>
      <p class="ss__lead muted">
        I find the point where customers get stuck, then build the site, improve local visibility or connect the follow-up that helps them take the next step.
      </p>
    </div>

    <ol class="ss__list" role="list">
      {
        groups.map((g) => (
          <li class="ss__item" id={g.id}>
            <p class="ss__step">
              <span class="ss__letter num" aria-hidden="true">
                {g.letter}
              </span>
              <span class="eyebrow eyebrow--plain">{g.verb}</span>
            </p>
            <h3 class="ss__name">{servicePageForGroup(g.id)?.name ?? g.title}</h3>
            <div class="ss__detail">
              <p class="muted">{g.intro}</p>
              {packageFor[g.id] && (
                <p class="ss__pkg small">
                  <span class="subtle">Package:</span> {packageFor[g.id]!.name} · <span class="subtle">{priceLabel(packageFor[g.id]!).text}</span>
                </p>
              )}
              <a class="link-arrow" href={servicePageForGroup(g.id) ? `/services/${servicePageForGroup(g.id)!.slug}/` : `/services/#${g.id}`}>
                {servicePageForGroup(g.id)?.short ?? g.title}: who it’s for and what’s included
                <Icon name="arrow-ne" />
              </a>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="ss__extra small">
      <span class="subtle">{addOns.title}, as add-ons.</span>
      <a class="link-arrow" href="/services/">Every service and package <Icon name="arrow" /></a>
    </p>
  </div>
</section>

<style>
  @media (max-width: 39.99em) {
    .ss { padding-block: 2.25rem; }
  }
  .ss__pkg {
    padding-top: var(--s-3);
    border-top: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
  }
  .ss__head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: clamp(var(--s-6), 4vw, var(--s-8));
  }
  .ss__title {
    font-size: clamp(3rem, 6.6vw, 7.25rem);
    letter-spacing: -0.075em;
    line-height: 0.93;
    max-width: 13ch;
  }
  .ss__lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 52ch;
  }
  @media (min-width: 64em) {
    .ss__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--s-8);
    }
    .ss__head .eyebrow,
    .ss__title {
      grid-column: 1;
    }
    .ss__lead {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
    }
  }
  .ss__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .ss__item {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
  }
  .ss__detail { display: grid; gap: var(--s-3); }
  @media (min-width: 56em) {
    .ss__item {
      grid-template-columns: minmax(6.5rem, 0.62fr) minmax(0, 1.25fr) minmax(0, 1.3fr);
      gap: clamp(var(--s-4), 3vw, var(--s-7));
      align-items: start;
      padding-block: clamp(var(--s-6), 4vw, var(--s-8));
    }
  }
  .ss__step {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .ss__letter {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--signal);
    border-radius: 50%;
    color: var(--signal);
    font-size: var(--fs-sm);
  }
  .ss__name {
    font-size: clamp(1.85rem, 3.2vw, 3.65rem);
    letter-spacing: -0.06em;
    line-height: 1.02;
    text-wrap: initial;
  }
  .ss__extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
  }
</style>
