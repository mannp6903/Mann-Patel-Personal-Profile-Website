---
/**
 * What I do: three services as a bento (design upgrade Phase 3, task 3.2, 17 Nov 2026). Each tile names a step of the
 * customer's path, A Found, B Answered, C Booked, with a small scene in the agent graph's line style that acts it out
 * (the round 9 words, DESIGN.md): a map pin drops onto a full stop; a chat bubble's typing dots turn into read ticks; a
 * date is circled by hand. A scene plays once when its tile scrolls into view and again on hover or focus; reduced
 * motion and no JavaScript show the finished picture. Each tile names its package and price and links to its focused
 * service page (round 10). On phones the tiles are a swipe rail (Mann's choice, 17 Nov 2026), so Home stays short.
 */
import { groups, addOns } from '../../data/services';
import { servicePageForGroup } from '../../data/service-pages';
import { packageById, priceLabel } from '../../data/packages';
import Icon from '../ui/Icon.astro';

// The package that matches each area (package preview, audit 8 Nov 2026).
const packageFor: Record<string, ReturnType<typeof packageById>> = {
  found: packageById('local-visibility'),
  answered: packageById('website-enquiry'),
  booked: packageById('website-launch'),
};
---

<section class="ss section" id="what-i-do" aria-labelledby="ss-title">
  <div class="container">
    <div class="ss__head">
      <!-- 16 Nov 2026: a descriptive heading people search for; the slogan is the eyebrow. -->
      <p class="eyebrow">02 / From search to booked</p>
      <h2 id="ss-title" class="ss__title">Web design, local SEO <span class="accent">and booking services.</span></h2>
      <p class="ss__lead muted">
        I find the point where customers get stuck, then build the site, improve local visibility or connect the follow-up that helps them take the next step.
      </p>
    </div>

    <ol class="ss__bento rail" role="list" data-rail>
      {
        groups.map((g) => (
          <li class:list={['ss__tile', `ss__tile--${g.id}`]} id={g.id} data-scene-tile>
            <div class="ss__in">
            <div class="ss__scene" aria-hidden="true">
              {g.id === 'found' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <rect class="scene__card" x="16" y="16" width="208" height="88" rx="14" />
                  <path class="scene__line" d="M36 44H168" />
                  <path class="scene__line scene__line--dim" d="M36 62H196" />
                  <path class="scene__line scene__line--dim" d="M36 80H140" />
                  <circle class="scene__stop" cx="152" cy="80" r="3.5" />
                  <circle class="scene__ripple" cx="152" cy="80" r="9" />
                  <g class="scene__pin">
                    <path d="M152 77c-.5 0-.9-.2-1.2-.7C148 71.8 143.5 66.6 143.5 61a8.5 8.5 0 0 1 17 0c0 5.6-4.5 10.8-7.3 15.3-.3.5-.7.7-1.2.7Z" />
                    <circle class="scene__signal" cx="152" cy="61" r="3.2" />
                  </g>
                </svg>
              )}
              {g.id === 'answered' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <path class="scene__line scene__line--dim" d="M44 28H132" />
                  <path class="scene__bubble" d="M60 42h120a16 16 0 0 1 16 16v16a16 16 0 0 1-16 16H94l-14 13V90H60a16 16 0 0 1-16-16V58a16 16 0 0 1 16-16Z" />
                  <circle class="scene__dot" cx="104" cy="66" r="3.5" style="--k:0" />
                  <circle class="scene__dot" cx="120" cy="66" r="3.5" style="--k:1" />
                  <circle class="scene__dot" cx="136" cy="66" r="3.5" style="--k:2" />
                  <g class="scene__ticks">
                    <path d="M104 66.6l5 5L120 60.6" />
                    <path d="M114.8 69.8l1.8 1.8L128 60.6" />
                  </g>
                </svg>
              )}
              {g.id === 'booked' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <path class="scene__line" d="M40 24H112" />
                  {[0, 1, 2].map((r) =>
                    [0, 1, 2, 3, 4].map((c) => <rect class="scene__day" x={40 + c * 34} y={40 + r * 24} width="20" height="14" rx="4" />),
                  )}
                  <rect class="scene__day scene__day--on" x="108" y="64" width="20" height="14" rx="4" />
                  <path class="scene__circle" d="M101 80c-9-5-9-15 1-20 11-6 28-5 33 2 6 7-1 16-13 18-11 2-23-1-26-6" />
                </svg>
              )}
            </div>
            <div class="ss__copy">
            <p class="ss__step">
              <span class="ss__letter num" aria-hidden="true">
                {g.letter}
              </span>
              <span class="eyebrow eyebrow--plain">{g.verb}</span>
            </p>
            <h3 class="ss__name">{servicePageForGroup(g.id)?.name ?? g.title}</h3>
            <p class="muted ss__intro">{g.intro}</p>
            {packageFor[g.id] && (
              <p class="ss__pkg small">
                <span class="subtle">Package:</span> {packageFor[g.id]!.name} · <span class="subtle">{priceLabel(packageFor[g.id]!).text}</span>
              </p>
            )}
            <a class="link-arrow ss__link" href={servicePageForGroup(g.id) ? `/services/${servicePageForGroup(g.id)!.slug}/` : `/services/#${g.id}`}>
              {servicePageForGroup(g.id)?.short ?? g.title}: who it’s for and what’s included
              <Icon name="arrow-ne" />
            </a>
            </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="ss__extra small">
      <span class="subtle">{addOns.title}, as add-ons.</span>
      <a class="link-arrow" href="/services/">Every service and package <Icon name="arrow" /></a>
    </p>
  </div>
</section>

<script>
  // Each scene plays once when its tile is mostly on screen, and again when the tile is hovered or focused. The
  // animations are CSS, paused at their first frame until then (reduced motion and no JavaScript skip them).
  const tiles = document.querySelectorAll<HTMLElement>('[data-scene-tile]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tiles.length && !still && document.documentElement.classList.contains('js-motion')) {
    const play = (tile: HTMLElement, restart: boolean) =>
      tile.getAnimations({ subtree: true }).forEach((a) => {
        if (restart) a.cancel();
        a.play();
      });
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          play(e.target as HTMLElement, false);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    tiles.forEach((tile) => {
      io.observe(tile);
      tile.addEventListener('pointerenter', () => play(tile, true));
      tile.addEventListener('focusin', () => play(tile, true));
    });
  }
</script>

<style>
  @media (max-width: 39.99em) {
    .ss { padding-block: var(--section-tight); }
  }
  @media (max-width: 47.99em) {
    /* The rail's side padding (the list reset for role="list" would otherwise remove it). */
    .ss__bento { padding-inline: var(--gutter); }
  }
  .ss__head {
    display: grid;
    row-gap: var(--head-gap-2);
    margin-bottom: clamp(var(--s-6), 4vw, var(--s-8));
  }
  .ss__head .eyebrow { margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2)); }
  .ss__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 16ch;
  }
  .ss__lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 52ch;
  }
  @media (min-width: 64em) {
    .ss__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--s-8);
    }
    .ss__head .eyebrow,
    .ss__title {
      grid-column: 1;
    }
    .ss__lead {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
    }
  }

  /* The bento: Found is the large tile (most clients start there); Answered and Booked stack beside it. */
  .ss__bento {
    display: grid;
    gap: var(--s-4);
  }
  /* Each tile is a container (design upgrade Phase 6, task 6.2): its inside follows the tile's width, not the screen's. */
  .ss__tile {
    container: ss-tile / inline-size;
    padding: clamp(var(--s-5), 2.6vw, var(--s-7));
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .ss__in,
  .ss__copy {
    display: grid;
    align-content: start;
    gap: var(--s-3);
  }
  /* A narrow tile (the phone rail, the two-column bento on small tablets) gets a smaller scene, so the words stay near
     the top. This used to follow the screen (under 40em), which gave a 302px tile two different scene sizes. */
  @container ss-tile (max-width: 19.99rem) {
    .ss__tile .ss__scene { max-width: 11rem; }
  }
  @media (min-width: 48em) {
    .ss__bento {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    /* The large tile spans both rows; its scene fills the space above and the words settle at the bottom. */
    .ss__tile--found {
      grid-row: span 2;
    }
    .ss__tile--found .ss__in {
      height: 100%;
      grid-template-rows: 1fr auto;
      align-content: stretch;
    }
    .ss__tile--found .ss__scene {
      align-self: center;
      justify-self: center;
      width: min(100%, 30rem);
      max-width: none;
    }
  }
  .ss__scene {
    max-width: 15rem;
    margin-bottom: var(--s-2);
  }
  .ss__step {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .ss__letter {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--control);
    border-radius: 50%;
    color: var(--text);
    font-size: var(--fs-sm);
  }
  .ss__name {
    font-size: var(--fs-h3);
    letter-spacing: var(--track-head);
    line-height: 1.1;
    text-wrap: balance;
  }
  .ss__pkg {
    padding-top: var(--s-3);
    border-top: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--w-ui);
    letter-spacing: 0.02em;
  }
  .ss__extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
  }

  /* ── Scenes: the agent graph's line style (its stroke tokens, round ends); lime marks only the signal (task 5.4). ── */
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-width: var(--graph-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .scene__card,
  .scene__day {
    stroke: var(--graph-mesh);
  }
  .scene__line {
    stroke: var(--graph-node);
  }
  .scene__line--dim {
    stroke: var(--graph-spoke);
  }
  .scene__stop {
    fill: var(--text-2);
    stroke: none;
  }
  .scene__pin path,
  .scene__bubble {
    stroke: var(--text-2);
    fill: var(--bg-2);
  }
  .scene__signal {
    fill: var(--signal);
    stroke: none;
  }
  .scene__ripple {
    stroke: var(--signal);
    opacity: 0;
  }
  .scene__dot {
    fill: var(--text-2);
    stroke: none;
    opacity: 0;
  }
  .scene__ticks {
    stroke: var(--signal);
    stroke-width: var(--graph-stroke-bold);
  }
  .scene__day--on {
    fill: var(--surface-2);
    stroke: var(--graph-node);
  }
  .scene__circle {
    stroke: var(--text);
    stroke-width: var(--graph-stroke-bold);
  }
  .scene__pin,
  .scene__ripple,
  .scene__dot,
  .scene__ticks,
  .scene__circle,
  .scene__bubble {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .scene__pin {
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Paused on their first frame until the tile scrolls into view (the script plays them). */
    :global(.js-motion) .scene__pin {
      animation: sc-pin var(--dur-4) var(--ease-spring) var(--dur-1) both paused;
    }
    :global(.js-motion) .scene__ripple {
      animation: sc-ripple var(--dur-5) var(--ease-out) calc(var(--dur-1) + var(--dur-4)) both paused;
    }
    :global(.js-motion) .scene__bubble {
      animation: sc-pop var(--dur-3) var(--ease-out) var(--dur-1) both paused;
    }
    :global(.js-motion) .scene__dot {
      animation: sc-typing calc(var(--dur-5) + var(--dur-4)) var(--ease-in-out) both paused;
      animation-delay: calc(var(--dur-3) + var(--k) * var(--dur-1));
    }
    :global(.js-motion) .scene__ticks {
      animation: sc-pop var(--dur-3) var(--ease-out) calc(var(--dur-5) * 2 + var(--dur-1)) both paused;
    }
    :global(.js-motion) .scene__circle {
      animation: sc-circle var(--dur-4) var(--ease-out) var(--dur-2) both paused;
    }
  }
  @keyframes sc-pin {
    from {
      opacity: 0;
      translate: 0 -30px;
    }
  }
  @keyframes sc-ripple {
    from {
      opacity: 0.9;
      scale: 0.3;
    }
    to {
      opacity: 0;
      scale: 1.8;
    }
  }
  @keyframes sc-pop {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }
  @keyframes sc-typing {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    10% {
      opacity: 1;
    }
    25% {
      translate: 0 -4px;
    }
    40% {
      translate: 0 0;
    }
    55% {
      translate: 0 -4px;
    }
    70% {
      translate: 0 0;
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes sc-circle {
    from {
      opacity: 0;
      scale: 0.7;
      rotate: -12deg;
    }
  }
</style>
