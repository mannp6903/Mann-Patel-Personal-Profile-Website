---
/**
 * What I do: three services as a bento (design upgrade Phase 3, task 3.2, 17 Nov 2026). Each tile names a step of the
 * customer's path, A Found, B Answered, C Booked, with a small scene in the agent graph's line style that acts it out
 * (the round 9 words, DESIGN.md): a map pin drops onto a full stop; a chat bubble's typing dots turn into read ticks; a
 * date is circled by hand. A scene plays once when its tile scrolls into view and again on hover or focus; reduced
 * motion and no JavaScript show the finished picture. Each tile names its package and price and links to its focused
 * service page (round 10). On phones the tiles are a swipe rail (Mann's choice, 17 Nov 2026), so Home stays short.
 *
 * Launch motion (22 Nov 2026, M5 "search to booked"): from 64em, with motion on, the tiles stack in one column and a
 * phone stays in view beside them, acting out the tile at the reading line (a little below the middle of the screen): A, a search types itself and the
 * business drops onto the map; B, a missed call gets an automatic text and the customer replies; C, the Book button is
 * tapped and the booking confirms, with a text to the owner. Scroll drives it (nothing runs on a clock). The phone is
 * decoration (aria-hidden), built by the script only when the section is near, so Home keeps its element budget (gate
 * P3); its grid column is sized by CSS from the first paint, so nothing shifts. Phones, tablets, reduced motion and no
 * JavaScript keep the bento exactly as before.
 *
 * 22 Nov 2026 (upgrade report R5.1, R10.1, §9; Phase 2): "What I do, and what it costs". Home's separate Prices section is
 * gone; each tile now leads with its package and price and says what the price covers, and the other two packages
 * (Website Fix, Website Care) and the add-ons sit under the tiles. One decision surface instead of two, with the prices
 * said once on the page (the hero keeps one compact price line).
 */
import { groups, addOns } from '../../data/services';
import { servicePageForGroup } from '../../data/service-pages';
import { packageById, priceLabel } from '../../data/packages';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

// The package that matches each area (package preview, audit 8 Nov 2026).
const packageFor: Record<string, ReturnType<typeof packageById>> = {
  found: packageById('local-visibility'),
  answered: packageById('website-enquiry'),
  booked: packageById('website-launch'),
};
// The two packages that aren't a step of the path: under the tiles.
const more = [packageById('website-fix')!, packageById('care')!];
---

<section class="ss section" id="what-i-do" aria-labelledby="ss-title">
  <div class="container ss__grid">
    <div class="ss__head">
      <h2 id="ss-title" class="ss__title">What I do, <span class="accent">and what it costs.</span></h2>
      <!-- 19 Nov 2026 (answer extractability): the lead names the three services, so it answers on its own. 22 Nov 2026:
           and the price terms, said once. -->
      <p class="ss__lead muted">
        Local SEO, online booking and websites for small businesses in Toronto and the GTA, at fixed prices in Canadian
        dollars, plus tax. Anything outside a package is quoted in writing before I start.
      </p>
    </div>

    <ol class="ss__bento rail" role="list" data-rail>
      {
        groups.map((g) => (
          <li class:list={['ss__tile', `ss__tile--${g.id}`]} id={g.id} data-scene-tile>
            <div class="ss__in">
            <div class="ss__scene" aria-hidden="true">
              {g.id === 'found' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <rect class="scene__card" x="16" y="16" width="208" height="88" rx="14" />
                  <path class="scene__line" d="M36 44H168" />
                  <path class="scene__line scene__line--dim" d="M36 62H196" />
                  <path class="scene__line scene__line--dim" d="M36 80H140" />
                  <circle class="scene__stop" cx="152" cy="80" r="3.5" />
                  <circle class="scene__ripple" cx="152" cy="80" r="9" />
                  <g class="scene__pin">
                    <path d="M152 77c-.5 0-.9-.2-1.2-.7C148 71.8 143.5 66.6 143.5 61a8.5 8.5 0 0 1 17 0c0 5.6-4.5 10.8-7.3 15.3-.3.5-.7.7-1.2.7Z" />
                    <circle class="scene__signal" cx="152" cy="61" r="3.2" />
                  </g>
                </svg>
              )}
              {g.id === 'answered' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <path class="scene__line scene__line--dim" d="M44 28H132" />
                  <path class="scene__bubble" d="M60 42h120a16 16 0 0 1 16 16v16a16 16 0 0 1-16 16H94l-14 13V90H60a16 16 0 0 1-16-16V58a16 16 0 0 1 16-16Z" />
                  <circle class="scene__dot" cx="104" cy="66" r="3.5" style="--k:0" />
                  <circle class="scene__dot" cx="120" cy="66" r="3.5" style="--k:1" />
                  <circle class="scene__dot" cx="136" cy="66" r="3.5" style="--k:2" />
                  <g class="scene__ticks">
                    <path d="M104 66.6l5 5L120 60.6" />
                    <path d="M114.8 69.8l1.8 1.8L128 60.6" />
                  </g>
                </svg>
              )}
              {g.id === 'booked' && (
                <svg class="scene" viewBox="0 0 240 120" focusable="false">
                  <path class="scene__line" d="M40 24H112" />
                  {[0, 1, 2].map((r) =>
                    [0, 1, 2, 3, 4].map((c) => <rect class="scene__day" x={40 + c * 34} y={40 + r * 24} width="20" height="14" rx="4" />),
                  )}
                  <rect class="scene__day scene__day--on" x="108" y="64" width="20" height="14" rx="4" />
                  <path class="scene__circle" d="M101 80c-9-5-9-15 1-20 11-6 28-5 33 2 6 7-1 16-13 18-11 2-23-1-26-6" />
                </svg>
              )}
            </div>
            <div class="ss__copy">
            <p class="ss__step">
              <span class="ss__letter num" aria-hidden="true">
                {g.letter}
              </span>
              <span class="eyebrow eyebrow--plain">{g.verb}</span>
            </p>
            <div class="ss__top">
              <h3 class="ss__name">{packageFor[g.id]?.name ?? g.title}</h3>
              {packageFor[g.id] && <p class="ss__price"><b data-price>{priceLabel(packageFor[g.id]!).text}</b></p>}
            </div>
            <p class="muted ss__intro">{g.intro}</p>
            {packageFor[g.id] && <p class="ss__pkg small">{packageFor[g.id]!.boundary}</p>}
            <a class="link-arrow ss__link" href={servicePageForGroup(g.id) ? `/services/${servicePageForGroup(g.id)!.slug}/` : `/services/#${g.id}`}>
              {servicePageForGroup(g.id)?.short ?? g.title}: who it’s for and what’s included
              <Icon name="arrow-ne" />
            </a>
            </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="ss__extra">
      <ul class="ss__more" role="list">
        {
          more.map((p) => (
            <li>
              <a href={`/pricing/#pkg-${p.id}`}>
                <span class="ss__more-name">{p.name}</span>
                <b class="ss__more-price" data-price>{priceLabel(p).text}</b>
                <span class="ss__more-boundary">{p.boundary}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small subtle ss__terms">
        {addOns.title} are add-ons, quoted in writing. Websites are paid half at kickoff and half once the agreed launch
        checks pass.
      </p>
      <div class="btn-row">
        <Button href="/pricing/" variant="ghost">See every package</Button>
      </div>
    </div>
  </div>
</section>

<script>
  // Each scene plays once when its tile is mostly on screen, and again when the tile is hovered or focused. The
  // animations are CSS, paused at their first frame until then (reduced motion and no JavaScript skip them).
  const tiles = document.querySelectorAll<HTMLElement>('[data-scene-tile]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tiles.length && !still && document.documentElement.classList.contains('js-motion')) {
    const play = (tile: HTMLElement, restart: boolean) =>
      tile.getAnimations({ subtree: true }).forEach((a) => {
        if (restart) a.cancel();
        a.play();
      });
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          play(e.target as HTMLElement, false);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    tiles.forEach((tile) => {
      io.observe(tile);
      tile.addEventListener('pointerenter', () => play(tile, true));
      tile.addEventListener('focusin', () => play(tile, true));
    });
  }

  // M5 (launch motion, 22 Nov 2026): from 64em, the phone acts out the tile at the reading line. The layout is CSS from
  // the first paint (html.js-motion + the media query); the phone, its styles and the code that moves it are one chunk
  // (scripts/service-phone.ts), fetched when the section is near on a wide screen, so phones never download it (P2).
  const section = document.querySelector<HTMLElement>('.ss');
  const bento = section?.querySelector<HTMLElement>('.ss__bento');
  const wide = matchMedia('(min-width: 64em)');
  if (section && bento && !still && document.documentElement.classList.contains('js-motion')) {
    let near = false;
    let loading = false;
    const start = () => {
      if (loading || !near || !wide.matches) return;
      loading = true;
      import('../../scripts/service-phone').then(
        ({ startServicePhone }) => startServicePhone(section, bento, wide),
        () => (loading = false),
      );
    };
    const io = new IntersectionObserver(
      (entries) => {
        near = entries.some((e) => e.isIntersecting);
        start();
      },
      { rootMargin: '50% 0px' },
    );
    io.observe(section);
    wide.addEventListener('change', start);
  }
</script>

<style>
  @media (max-width: 39.99em) {
    .ss { padding-block: var(--section-tight); }
  }
  @media (max-width: 47.99em) {
    /* The rail's side padding (the list reset for role="list" would otherwise remove it). */
    .ss__bento { padding-inline: var(--gutter); }
  }
  .ss__head {
    display: grid;
    row-gap: var(--head-gap-2);
    margin-bottom: clamp(var(--s-6), 4vw, var(--s-8));
  }
  .ss__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 16ch;
  }
  .ss__lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 52ch;
  }
  @media (min-width: 64em) {
    .ss__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--s-8);
    }
    .ss__title {
      grid-column: 1;
    }
    .ss__lead {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
  }

  /* The bento: Found is the large tile (most clients start there); Answered and Booked stack beside it. */
  .ss__bento {
    display: grid;
    gap: var(--s-4);
  }
  /* Each tile is a container (design upgrade Phase 6, task 6.2): its inside follows the tile's width, not the screen's. */
  .ss__tile {
    container: ss-tile / inline-size;
    padding: clamp(var(--s-5), 2.6vw, var(--s-7));
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .ss__in,
  .ss__copy {
    display: grid;
    align-content: start;
    gap: var(--s-3);
  }
  /* A narrow tile (the phone rail, the two-column bento on small tablets) gets a smaller scene, so the words stay near
     the top. This used to follow the screen (under 40em), which gave a 302px tile two different scene sizes. */
  @container ss-tile (max-width: 19.99rem) {
    .ss__tile .ss__scene { max-width: 11rem; }
  }
  @media (min-width: 48em) {
    .ss__bento {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
    /* The large tile spans both rows; its scene fills the space above and the words settle at the bottom. */
    .ss__tile--found {
      grid-row: span 2;
    }
    .ss__tile--found .ss__in {
      height: 100%;
      grid-template-rows: 1fr auto;
      align-content: stretch;
    }
    .ss__tile--found .ss__scene {
      align-self: center;
      justify-self: center;
      width: min(100%, 30rem);
      max-width: none;
    }
  }
  .ss__scene {
    max-width: 15rem;
    margin-bottom: var(--s-2);
  }
  .ss__step {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .ss__letter {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--control);
    border-radius: 50%;
    color: var(--text);
    font-size: var(--fs-sm);
  }
  /* The package and its price on one line (the price drops under the name when the tile is narrow). */
  .ss__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
  }
  .ss__name {
    font-size: var(--fs-h3);
    letter-spacing: var(--track-head);
    line-height: 1.1;
    text-wrap: balance;
  }
  /* Lime budget: prices are white, in tabular figures. */
  .ss__price b {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* What the price covers, under a dashed rule: the body face (upgrade report R4.2: mono is for figures). */
  .ss__pkg {
    padding-top: var(--s-3);
    border-top: 1px dashed var(--line);
    color: var(--text-2);
  }
  .ss__extra {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .ss__more {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .ss__more a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-1);
  }
  .ss__more a:hover,
  .ss__more a:focus-visible {
    background: linear-gradient(90deg, transparent, var(--surface));
  }
  .ss__more-name {
    font-weight: var(--w-head);
    font-size: var(--fs-lead);
  }
  .ss__more-price {
    font-size: var(--fs-lead);
    font-weight: var(--w-head);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ss__more-boundary {
    grid-column: 1 / -1;
    max-width: 60ch;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  @media (min-width: 48em) {
    /* One fixed price column, so the descriptions line up row to row. */
    .ss__more a {
      grid-template-columns: minmax(10rem, 0.5fr) minmax(0, 1.5fr) 10rem;
      align-items: baseline;
    }
    .ss__more-price {
      justify-self: end;
    }
    .ss__more-boundary {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* ── Scenes: the agent graph's line style (its stroke tokens, round ends); lime marks only the signal (task 5.4). ── */
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-width: var(--graph-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .scene__card,
  .scene__day {
    stroke: var(--graph-mesh);
  }
  .scene__line {
    stroke: var(--graph-node);
  }
  .scene__line--dim {
    stroke: var(--graph-spoke);
  }
  .scene__stop {
    fill: var(--text-2);
    stroke: none;
  }
  .scene__pin path,
  .scene__bubble {
    stroke: var(--text-2);
    fill: var(--bg-2);
  }
  .scene__signal {
    fill: var(--signal);
    stroke: none;
  }
  .scene__ripple {
    stroke: var(--signal);
    opacity: 0;
  }
  .scene__dot {
    fill: var(--text-2);
    stroke: none;
    opacity: 0;
  }
  .scene__ticks {
    stroke: var(--signal);
    stroke-width: var(--graph-stroke-bold);
  }
  .scene__day--on {
    fill: var(--surface-2);
    stroke: var(--graph-node);
  }
  .scene__circle {
    stroke: var(--text);
    stroke-width: var(--graph-stroke-bold);
  }
  .scene__pin,
  .scene__ripple,
  .scene__dot,
  .scene__ticks,
  .scene__circle,
  .scene__bubble {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  .scene__pin {
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Paused on their first frame until the tile scrolls into view (the script plays them). */
    :global(.js-motion) .scene__pin {
      animation: sc-pin var(--dur-4) var(--ease-spring) var(--dur-1) both paused;
    }
    :global(.js-motion) .scene__ripple {
      animation: sc-ripple var(--dur-5) var(--ease-out) calc(var(--dur-1) + var(--dur-4)) both paused;
    }
    :global(.js-motion) .scene__bubble {
      animation: sc-pop var(--dur-3) var(--ease-out) var(--dur-1) both paused;
    }
    :global(.js-motion) .scene__dot {
      animation: sc-typing calc(var(--dur-5) + var(--dur-4)) var(--ease-in-out) both paused;
      animation-delay: calc(var(--dur-3) + var(--k) * var(--dur-1));
    }
    :global(.js-motion) .scene__ticks {
      animation: sc-pop var(--dur-3) var(--ease-out) calc(var(--dur-5) * 2 + var(--dur-1)) both paused;
    }
    :global(.js-motion) .scene__circle {
      animation: sc-circle var(--dur-4) var(--ease-out) var(--dur-2) both paused;
    }
  }
  @keyframes sc-pin {
    from {
      opacity: 0;
      translate: 0 -30px;
    }
  }
  @keyframes sc-ripple {
    from {
      opacity: 0.9;
      scale: 0.3;
    }
    to {
      opacity: 0;
      scale: 1.8;
    }
  }
  @keyframes sc-pop {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }
  @keyframes sc-typing {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    10% {
      opacity: 1;
    }
    25% {
      translate: 0 -4px;
    }
    40% {
      translate: 0 0;
    }
    55% {
      translate: 0 -4px;
    }
    70% {
      translate: 0 0;
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes sc-circle {
    from {
      opacity: 0;
      scale: 0.7;
      rotate: -12deg;
    }
  }

  /* ── Launch motion (22 Nov 2026), M5 "search to booked": from 64em with motion on, one column of tiles and a column
     for the phone, which stays in view beside them (the script builds it when the section is near). The column is sized
     from the first paint, so the phone arriving moves nothing. Below 64em, with reduced motion or without JavaScript:
     the bento. ── */
  @media (min-width: 64em) and (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .ss__grid {
      --ssp-h: min(38rem, calc(100vh - var(--header-h) - var(--s-9)));
      display: grid;
      grid-template-columns: minmax(0, 1fr) calc(var(--ssp-h) * 9 / 19);
      column-gap: var(--s-8);
      align-items: start;
    }
    :global(.js-motion) .ss__head,
    :global(.js-motion) .ss__extra {
      grid-column: 1 / -1;
    }
    :global(.js-motion) .ss__bento {
      grid-column: 1;
      grid-row: 2;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    :global(.js-motion) .ss__tile--found {
      grid-row: auto;
    }
    :global(.js-motion) .ss__tile--found .ss__in {
      height: auto;
      grid-template-rows: none;
    }
    :global(.js-motion) .ss__scene {
      display: none;
    }
    :global(.js-motion) .ss__tile {
      display: grid;
      align-content: center;
      min-height: min(24rem, 46vh);
      transition: background-color var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out);
    }
    :global(.js-motion) .ss__tile.is-on {
      background: var(--surface);
      border-color: var(--control);
    }
  }

</style>

