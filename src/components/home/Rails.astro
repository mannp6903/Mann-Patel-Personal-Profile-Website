---
/**
 * Two rows of real project images that slide in opposite directions as the page scrolls.
 * Decorative (the same projects are listed and linked above), so hidden from assistive tech.
 * Still with reduced motion.
 */
import { Image } from 'astro:assets';
import nestDesktop from '../../assets/work/nest-and-rest/live-2026-10-31-desktop.png';
import nestMobile from '../../assets/work/nest-and-rest/live-2026-10-31-mobile.png';
import nestPrice from '../../assets/work/nest-and-rest/detail-price-estimate.png';
import nestPostal from '../../assets/work/nest-and-rest/detail-postal-check.png';
import sampDesktop from '../../assets/work/samp-hair-spa/preview-2026-10-31-desktop.png';
import sampMobile from '../../assets/work/samp-hair-spa/preview-2026-10-31-mobile.png';
import sampType from '../../assets/work/samp-hair-spa/detail-type.png';
import sampActions from '../../assets/work/samp-hair-spa/detail-actions-mobile.png';

const nest = '#dfe8ee';
const samp = '#f1dde1';
const rows = [
  [
    { src: nestDesktop, tint: nest },
    { src: sampType, tint: samp },
    { src: nestPrice, tint: nest },
    { src: sampDesktop, tint: samp },
  ],
  [
    { src: sampMobile, tint: samp },
    { src: nestPostal, tint: nest },
    { src: sampActions, tint: samp },
    { src: nestMobile, tint: nest },
  ],
];
---

<section class="rails" aria-hidden="true" data-rails>
  {
    rows.map((row, r) => (
      <div class="rail" data-rail={r}>
        {row.map((card) => (
          <div class="card" style={`background:${card.tint}`}>
            <Image src={card.src} alt="" widths={[320, 520]} sizes="(min-width: 48em) 26vw, 60vw" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    ))
  }
</section>

<script>
  const rails = document.querySelector<HTMLElement>('[data-rails]');
  if (rails && document.documentElement.classList.contains('js-motion')) {
    const rows = rails.querySelectorAll<HTMLElement>('[data-rail]');
    let ticking = false;
    let visible = false;
    const update = () => {
      ticking = false;
      const r = rails.getBoundingClientRect();
      // 0 when the rails enter from the bottom, 1 when they leave at the top.
      const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
      rows[0].style.transform = `translate3d(${-4 - p * 10}%, 0, 0)`;
      rows[1]?.style.setProperty('transform', `translate3d(${-14 + p * 10}%, 0, 0)`);
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) update();
    }).observe(rails);
    window.addEventListener(
      'scroll',
      () => {
        if (visible && !ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .rails {
    display: grid;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(4rem, 2rem + 6vw, 8rem);
    overflow: hidden;
  }
  .rail {
    display: flex;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    width: max-content;
    transform: translate3d(-9%, 0, 0);
    will-change: transform;
  }
  .rail:nth-child(2) {
    margin-left: 6vw;
  }
  .card {
    display: grid;
    place-items: center;
    width: clamp(15rem, 10rem + 18vw, 28rem);
    aspect-ratio: 4 / 3;
    padding: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .card :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.55);
  }
</style>
