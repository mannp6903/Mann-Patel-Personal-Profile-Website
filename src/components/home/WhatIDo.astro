---
/**
 * What I do (23 Nov 2026 SEO audit, copy deck §2.1; backlog PRICE-1). Replaces the A/B/C bento with its scenes and the
 * scroll-driven phone: three packages, cheapest first ($650 → $1,950 → $3,350), one plain line each, then the smaller
 * jobs, and one link to /pricing/, where every inclusion, exclusion and third-party cost lives (one fact, one place).
 * Names, prices and links come from src/data/packages.ts.
 */
import { packageById, priceLabel, type PackageId } from '../../data/packages';
import Icon from '../ui/Icon.astro';

const items: { id: PackageId; line: string }[] = [
  { id: 'local-visibility', line: 'Your Google, Apple Maps and Bing details corrected, and a routine for getting real reviews.' },
  { id: 'website-launch', line: 'Up to five pages, built for phones, with a quote or booking button on every page.' },
  { id: 'website-enquiry', line: 'The website, plus online booking and an automatic reply to missed calls or forms.' },
];
const cards = items.map((i) => ({ ...i, pkg: packageById(i.id)! }));
const fix = packageById('website-fix')!;
const care = packageById('care')!;
---

<section class="wid section" id="what-i-do" aria-labelledby="wid-title">
  <div class="container wid__grid">
    <h2 id="wid-title" class="wid__title">Websites, Google listings and booking, at fixed prices</h2>

    <ol class="wid__list" role="list">
      {
        cards.map(({ pkg, line }) => (
          <li class="wid__item">
            <h3 class="wid__name">
              <a href={pkg.page}>
                {pkg.name}, <span class="wid__price num">{priceLabel(pkg).text}</span>
              </a>
            </h3>
            <p class="wid__line">{line}</p>
          </li>
        ))
      }
    </ol>

    <div class="wid__foot">
      <p class="wid__more">
        Smaller jobs: <a class="link" href={fix.page}>one website fix</a>, {priceLabel(fix).text}. <a class="link" href={care.page}>{care.name}</a>,
        {' '}{priceLabel(care).text}.
      </p>
      <a class="link-arrow" href="/pricing/">See every package <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .wid__grid {
    display: grid;
    gap: var(--s-7);
  }
  .wid__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 18ch;
  }
  .wid__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .wid__item {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }
  .wid__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.15;
  }
  .wid__name a {
    color: var(--text);
    text-decoration: none;
  }
  .wid__name a:hover,
  .wid__name a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .wid__price {
    color: var(--text-2);
    white-space: nowrap;
  }
  .wid__line {
    color: var(--text-2);
    max-width: 48ch;
  }
  .wid__foot {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .wid__more {
    color: var(--text-2);
  }
  @media (min-width: 64em) {
    .wid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-6);
      border-top: 0;
    }
    .wid__item {
      align-content: start;
      padding-top: var(--s-5);
      border-top: 1px solid var(--line);
      border-bottom: 0;
    }
  }
</style>
