---
/**
 * The free website and Google check: the one full-bleed signal-colour moment on the page.
 * 22 Nov 2026 (upgrade report R8.1): the rotating "FREE CHECK · NO OBLIGATION" ring is gone (decoration text that
 * moved with the scroll), and the button uses the site-wide primary label (R7.2).
 *
 * 23 Nov 2026 (SEO audit copy deck §2.1, rule 5): the full block is on Home only (other pages get the one-line
 * CheckBanner.astro). One paragraph says what the check is; the four-step list, the "Not included" line and the finder
 * prompt are gone (the steps are on /contact/ and /free-check/, the finder on /services/).
 */
import { cta } from '../../data/site';
import Button from '../ui/Button.astro';

interface Props {
  id?: string;
}
const { id = 'check' } = Astro.props;
---

<section class="fc" id={id} aria-labelledby={`${id}-title`}>
  <div class="fc__inner container">
    <div class="fc__copy">
      <h2 id={`${id}-title`} class="fc__title">Not sure what to fix first?</h2>
      <p class="fc__lead">
        Send your website or business name. I look you up the way a customer would (Google, Maps and AI assistants),
        compare your reviews with three nearby businesses, send a test enquiry, and email you a short list of fixes, most
        important first. Free, no obligation.
      </p>
      <div class="btn-row">
        <Button href={cta.checkHref} variant="ink">{cta.check}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .fc {
    position: relative;
    background: var(--signal);
    color: var(--on-signal);
    overflow: clip;
  }
  .fc ::selection {
    background: var(--ink);
    color: var(--signal);
  }
  .fc__inner {
    position: relative;
    display: grid;
    padding-block: var(--section);
  }
  .fc__copy {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .fc__title {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 15ch;
  }
  .fc__lead {
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    font-weight: var(--w-ui);
  }
  .fc :global(.btn--ink:focus-visible) {
    outline-color: var(--focus-on-light);
  }
  .fc :global(:focus-visible) {
    outline-color: var(--focus-on-light);
  }
  @media (max-width: 47.99em) {
    .fc__inner {
      padding-block: var(--section-tight);
    }
  }
</style>
