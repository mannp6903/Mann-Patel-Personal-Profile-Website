---
/**
 * Selected work as stacking cards: on desktop each card sticks near the top and the next one
 * slides over it, while the covered card recedes. Phones get a plain list of cards.
 */
import { getCollection } from 'astro:content';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Status from '../work/Status.astro';
import ProjectMedia from '../work/ProjectMedia.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="stack" style="--stack: var(--s-5)">
        <p class="eyebrow">Selected work</p>
        <Heading id="work-title" lines={['Real work,', '<span class="serif">clearly labelled.</span>']} />
      </div>
      <div class="stack" data-reveal style="--stack: var(--s-4)">
        <p class="lead">
          The business I run, and a client site I’m building now. Each one says what’s live, what isn’t, and what I actually
          did. No invented results.
        </p>
        <a class="link-arrow" href="/work/">All work <Icon name="arrow" /></a>
      </div>
    </div>

    <ol class="cards" role="list" data-stack>
      {
        work.map((w, i) => (
          <li class="card" style={`--i:${i}`} data-card>
            <article class="card__inner pm-host" aria-labelledby={`card-${w.id}`}>
              <div class="card__text">
                <div class="card__top">
                  <span class="num card__no">{String(i + 1).padStart(2, '0')}</span>
                  <Status status={w.data.status} />
                </div>
                <p class="card__kind subtle">
                  {w.data.kind} · {w.data.year}
                </p>
                <h3 class="card__title" id={`card-${w.id}`}>
                  {w.data.title}
                </h3>
                <p class="muted">{w.data.summary}</p>
                <ul class="card__hl" role="list">
                  {w.data.highlights.slice(0, 3).map((h) => (
                    <li>
                      <Icon name="check" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
                <div class="card__actions">
                  <Button href={`/work/${w.id}/`} size="sm" aria-label={`Read the case study: ${w.data.title}`}>
                    Read the case study
                  </Button>
                  {w.data.links[0] && (
                    <a class="link-arrow" href={w.data.links[0].url} rel="noopener">
                      {w.data.links[0].label}
                      <Icon name="arrow-ne" class="icon--ne" />
                    </a>
                  )}
                </div>
              </div>
              <div class="card__media">
                <ProjectMedia scene={w.data.scene} />
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // The covered card recedes as the next one slides over it (desktop, motion allowed).
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const desktop = matchMedia('(min-width: 64em)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (stack) {
    const cards = [...stack.querySelectorAll<HTMLElement>('[data-card]')];
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!desktop.matches || reduced.matches) {
        cards.forEach((c) => c.style.removeProperty('--cover'));
        return;
      }
      for (let i = 0; i < cards.length - 1; i++) {
        const a = cards[i].getBoundingClientRect();
        const b = cards[i + 1].getBoundingClientRect();
        const cover = Math.min(1, Math.max(0, 1 - (b.top - a.top) / a.height));
        cards[i].style.setProperty('--cover', cover.toFixed(3));
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<style>
  .cards {
    display: grid;
    gap: var(--s-6);
  }
  .card__inner {
    display: grid;
    gap: var(--s-6);
    padding: clamp(1.25rem, 3vw, 2.75rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--cover, 0) * 0.06));
    filter: brightness(calc(1 - var(--cover, 0) * 0.45));
  }
  .card__text {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .card__no {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .card__kind {
    font-size: var(--fs-sm);
  }
  .card__title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.75rem);
    font-weight: 740;
    font-stretch: 114%;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .card__hl {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .card__hl li {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
  }
  .card__hl .icon {
    margin-top: 0.15em;
    color: var(--signal);
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-3);
  }
  .card__media {
    align-self: center;
  }

  @media (min-width: 64em) {
    .cards {
      gap: 14vh;
      padding-bottom: 4vh;
    }
    .card {
      position: sticky;
      top: calc(var(--header-h) + 2rem + var(--i) * 1.25rem);
    }
    .card__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--s-8);
      min-height: min(40rem, calc(100vh - var(--header-h) - 5rem));
      align-items: center;
    }
  }
</style>
