---
/**
 * Home intro: one statement, one supporting line, a link to my story.
 * As the statement scrolls through the screen, its words darken one by one (reading
 * along with you). Grey and ink both pass contrast; static with reduced motion.
 */
const statement =
  'Helping Toronto small businesses get found on Google, answer every enquiry and turn visits into bookings. Plain language, a written scope, and everything handed over in your name.';
const words = statement.split(' ');
---

<section class="section ix" aria-label="Introduction">
  <div class="container ix-grid">
    <p class="ix-statement" data-ix-words>
      {words.map((w) => <><span class="w">{w}</span>{' '}</>)}
    </p>
    <div class="ix-side" data-reveal data-reveal-delay="120">
      <p>
        I’m a small business founder myself, starting a home-cleaning company. I know what a missed call or a bad
        Google listing costs, so that’s where I start.
      </p>
      <a class="btn btn--secondary" href="/about/">My story <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  const p = document.querySelector<HTMLElement>('[data-ix-words]');
  if (p && document.documentElement.classList.contains('js-motion')) {
    const words = [...p.querySelectorAll<HTMLElement>('.w')];
    let lit = -1;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = p.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the top reaches 85% of the screen, 1 when the bottom reaches 45%.
      const start = vh * 0.85;
      const end = vh * 0.45;
      const progress = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height)));
      const n = Math.round(progress * words.length);
      if (n === lit) return;
      lit = n;
      words.forEach((w, i) => w.classList.toggle('is-lit', i < n));
    };
    p.classList.add('is-reading');
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .ix-statement.is-reading .w {
    color: var(--ink-3);
    transition: color 260ms var(--ease-out);
  }
  .ix-statement.is-reading .w.is-lit {
    color: var(--ink);
  }
  .ix {
    padding-block: clamp(5rem, 3rem + 7vw, 10rem);
  }
  .ix-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 56em) {
    .ix-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }
  .ix-statement {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    max-width: 24ch;
  }
  .ix-side {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    color: var(--ink-2);
    font-size: var(--step-0);
    max-width: 34ch;
  }
  @media (min-width: 56em) {
    .ix-side {
      padding-top: var(--space-s);
    }
    .ix-side .btn {
      margin-top: var(--space-s);
    }
  }
</style>
