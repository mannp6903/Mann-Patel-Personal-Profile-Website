---
/**
 * Home: "You work with me" (upgrade report R3.2 and §9, 22 Nov 2026).
 *
 * 22 Nov 2026, later (Mann: the same photo showed twice on Home): one portrait per page. His face stays in the hero
 * (HeroPortrait.astro, about 480px across at 1440), and this block makes the same point without repeating it: a roster
 * of every job in a project, and the one name against each of them. The person you talk to is the person
 * who does the work. Real claims only: each row is a step the process and the packages already describe.
 *
 * Wide screens: the statement on the left, the roster from grid column 7. Phones: stacked. No lime here (the hero, the
 * band and the buttons carry it), and nothing moves.
 */
import { profile } from '../../data/site';
import BookingButton from '../ui/BookingButton.astro';
import Icon from '../ui/Icon.astro';

const first = profile.name.split(' ')[0];
// The jobs in a project, in the order they happen (src/data/services.ts → process, and the packages' scope).
const roster = ['Your written scope', 'Design and build', 'Your Google listing', 'Calls and messages', 'Testing and launch', 'The written handover'];
---

<section class="wwm section" id="with-me" aria-labelledby="wwm-title">
  <div class="container wwm__grid">
    <div class="wwm__text">
      <h2 id="wwm-title" class="wwm__title">You work with me, <span class="accent">start to finish.</span></h2>
      <p class="lead wwm__lead">
        I’m {profile.name}, a web designer in {profile.location}. There’s no account manager and no hand-off: the person
        you talk to is the person who does the work, and every account is set up in your name.
      </p>
      <div class="btn-row wwm__actions">
        <BookingButton />
        <a class="link-arrow" href="/about/">More about me <Icon name="arrow" /></a>
      </div>
    </div>

    <figure class="roster" aria-labelledby="roster-title">
      <figcaption id="roster-title" class="roster__title">Who does what on your project</figcaption>
      <dl class="roster__list">
        {
          roster.map((job) => (
            <div class="roster__row">
              <dt>{job}</dt>
              <dd>{first}</dd>
            </div>
          ))
        }
      </dl>
    </figure>
  </div>
</section>

<style>
  .wwm__grid {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }
  .wwm__text {
    display: grid;
    gap: var(--head-gap-2);
    justify-items: start;
  }
  .wwm__title {
    font-size: var(--fs-h2);
    letter-spacing: var(--track-head);
    line-height: 1;
    max-width: 14ch;
    text-wrap: balance;
  }
  .wwm__lead {
    max-width: 44ch;
  }
  .wwm__actions {
    margin-top: var(--s-3);
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }

  /* The roster: every job, one name. A ledger, not a card: hairlines, a dotted leader, the name set like a heading. */
  .roster {
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }
  .roster__title {
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: var(--w-ui);
  }
  .roster__list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .roster__row {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .roster__row dt {
    color: var(--text-2);
  }
  /* The dotted leader between the job and the name, as in a table of contents. */
  .roster__row::after {
    content: '';
    order: 1;
    flex: 1;
    min-width: var(--s-5);
    border-bottom: 1px dotted var(--control);
    transform: translateY(-0.3em);
  }
  .roster__row dd {
    order: 2;
    margin: 0;
    color: var(--text);
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.1;
  }
  @media (max-width: 39.99em) {
    .wwm {
      padding-block: var(--section-tight);
    }
    .roster__row {
      padding-block: var(--s-3);
    }
    .roster__row dd {
      font-size: var(--fs-lead);
    }
  }
  /* Statement on grid columns 1 to 6, the roster from column 7 (about half the container). */
  @media (min-width: 64em) {
    .wwm__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: var(--s-8);
    }
    .roster {
      padding-top: var(--s-2);
    }
  }
</style>
