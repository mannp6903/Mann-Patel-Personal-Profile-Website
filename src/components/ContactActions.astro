---
/**
 * Direct contact buttons: Email, Call, WhatsApp, Text.
 * The phone buttons appear only when PUBLIC_CONTACT_PHONE is set at build time; their real
 * links are filled in by src/scripts/reach.ts (without JS they open the contact page).
 */
import { contact, emailHref } from '../lib/contact';

interface Props {
  /** Visible heading-like label above the buttons (optional). */
  label?: string;
  /** Show the masked number line under the buttons. */
  showNumber?: boolean;
  /** Smaller buttons (menu, footer). */
  compact?: boolean;
  class?: string;
}
const { label, showNumber = false, compact = false, class: cls } = Astro.props;
const mail = emailHref();
const phone = contact.phone;

const icons = {
  email:
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  call: '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 3.5h2.6l1.4 4.1-2 1.5a12.3 12.3 0 0 0 6.3 6.3l1.5-2 4.1 1.4v2.6a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>',
  whatsapp:
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20l1.2-4.1A8.2 8.2 0 1 1 8.4 19z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.1.3 0 .5.6 1 1.5 1.8 2.6 2.4.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .6-.3 1.3-.9 1.6-.6.3-1.6.4-3.2-.3a9 9 0 0 1-3.9-3.7c-.8-1.4-.6-2.6-.1-3.2z" fill="currentColor"/></svg>',
  text: '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8l-4.5 3.5V17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M7.5 10.5h.01M12 10.5h.01M16.5 10.5h.01" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>',
};
const channels = [
  ...(mail ? [{ id: 'email', label: 'Email', name: `Email Mann at ${contact.email}`, href: mail }] : []),
  ...(phone
    ? [
        { id: 'call', label: 'Call', name: 'Call Mann', reach: 'call' },
        { id: 'whatsapp', label: 'WhatsApp', name: 'Message Mann on WhatsApp', reach: 'whatsapp' },
        { id: 'text', label: 'Text', name: 'Send Mann a text message', reach: 'text' },
      ]
    : []),
] as { id: keyof typeof icons; label: string; name: string; href?: string; reach?: string }[];
---

{
  channels.length > 0 && (
    <div class:list={['ca', { 'ca--compact': compact }, cls]}>
      {label && <p class="ca-label">{label}</p>}
      <ul class="ca-list" role="list">
        {channels.map((c) => (
          <li>
            <a
              class={`ca-btn ca-btn--${c.id}`}
              href={c.href ?? '/contact/#reach'}
              data-reach={c.reach}
              data-k={c.reach ? phone!.key : undefined}
              data-contact={c.id === 'call' ? 'phone' : c.id}
              aria-label={c.name}
              rel={c.id === 'whatsapp' ? 'noopener' : undefined}
            >
              <span class="ca-icon" set:html={icons[c.id]} />
              <span class="ca-text">{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
      {showNumber && (
        <p class="ca-number">
          {contact.email && <span>{contact.email}</span>}
          {phone && (
            <span>
              <span class="visually-hidden">Phone, partly hidden for privacy: </span>
              {phone.masked}
            </span>
          )}
        </p>
      )}
    </div>
  )
}

<style>
  .ca {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
  }
  .ca-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  :global(.on-night) .ca-label {
    color: var(--night-ink-2);
  }
  .ca-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  .ca-btn {
    --c: var(--ink);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 3rem;
    padding: 0 1.1rem 0 0.85rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  /* A colour wash rises from the icon on hover. */
  .ca-btn::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 1.35rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 420ms var(--ease-out);
  }
  .ca-btn:hover,
  .ca-btn:focus-visible {
    border-color: var(--c);
    color: #fff;
    transform: translateY(-2px);
  }
  .ca-btn:hover::before,
  .ca-btn:focus-visible::before {
    transform: translate(-50%, -50%) scale(40);
  }
  .ca-btn:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .ca-btn--email {
    --c: var(--ink);
  }
  .ca-btn--call {
    --c: #1f6b4e;
  }
  .ca-btn--whatsapp {
    --c: #11734b;
  }
  .ca-btn--text {
    --c: var(--accent-text);
  }
  .ca-icon {
    display: inline-grid;
    width: 1.25rem;
    height: 1.25rem;
  }
  .ca-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .ca-number {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  :global(.on-night) .ca-btn {
    background: transparent;
    border-color: var(--night-line);
    color: var(--night-ink);
  }
  :global(.on-night) .ca-btn--email {
    --c: #f4f1ea;
  }
  :global(.on-night) .ca-btn--email:hover,
  :global(.on-night) .ca-btn--email:focus-visible {
    color: var(--night);
  }
  :global(.on-night) .ca-btn:focus-visible {
    outline-color: var(--accent-on-night);
  }
  :global(.on-night) .ca-number {
    color: var(--night-ink-2);
  }
  .ca--compact .ca-btn {
    min-height: var(--tap);
    padding: 0 0.95rem 0 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-btn,
    .ca-btn::before {
      transition: none;
    }
    .ca-btn:hover,
    .ca-btn:focus-visible {
      transform: none;
    }
  }
  /* Phones: a tidy 2 × 2 grid instead of a ragged wrap. */
  @media (max-width: 29.99em) {
    .ca-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ca-btn {
      width: 100%;
      justify-content: center;
    }
    .ca-btn::before {
      left: 50%;
    }
  }
</style>
