---
import { groups, servicesInGroup } from '../data/services';
---

<div class="ledger">
  {
    groups.map((g) => (
      <section class="row" id={`overview-${g.id}`} aria-labelledby={`ov-${g.id}`} data-reveal>
        <div class="row-head">
          <p class="letter" aria-hidden="true">
            {g.letter}
          </p>
          <div>
            <p class="verb">{g.verb}</p>
            <h3 id={`ov-${g.id}`}>{g.title}</h3>
          </div>
        </div>
        <p class="intro muted">{g.intro}</p>
        <ul class="list" role="list">
          {servicesInGroup(g.id).map((s) => (
            <li>
              <a href={`/services/#${s.id}`}>{s.name}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .ledger {
    border-top: 2px solid var(--ink);
  }
  .row {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--line);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 60em) {
    .row {
      grid-template-columns: 1.15fr 1fr 1.1fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }
  .row-head {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
  }
  .letter {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.8;
    color: var(--accent);
    min-width: 1.1ch;
  }
  .verb {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3xs);
  }
  h3 {
    font-size: var(--step-2);
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--tap);
    padding-block: var(--space-2xs);
    border-bottom: 1px dashed var(--line);
    font-weight: 600;
    text-decoration: none;
  }
  .list a::after {
    content: '→';
    color: var(--ink-3);
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .list a:hover {
    text-decoration: underline;
  }
  .list a:hover::after {
    transform: translateX(3px);
    color: var(--accent-text);
  }
</style>
