---
import type { CollectionEntry } from 'astro:content';
import Scene from './mocks/Scene.astro';
import StatusChip from './StatusChip.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingLevel?: 'h2' | 'h3';
  large?: boolean;
}
const { entry, headingLevel = 'h3', large = false } = Astro.props;
const { title, status, kind, summary, highlights, scene } = entry.data;
const Heading = headingLevel;
const href = `/work/${entry.id}/`;
---

<article class:list={['work-card', { large }]} data-reveal>
  <div class="visual">
    <Scene scene={scene} variant="thumb" />
  </div>
  <div class="body">
    <div class="meta">
      <StatusChip status={status} />
      <span class="kind">{kind}</span>
    </div>
    <Heading class="title">
      <a href={href} class="stretched">{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    {
      large && (
        <ul class="highlights" role="list">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <span class="more" aria-hidden="true">Read the {status === 'concept' ? 'concept' : 'case study'} →</span>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    min-width: 0;
    display: grid;
    gap: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .work-card:hover,
  .work-card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .work-card.large {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 56em) {
    .work-card.large {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }
  }
  .visual {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 56em) {
    .large .visual {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
  }
  .body {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    padding: var(--space-m);
  }
  .large .body {
    padding: var(--space-l);
    align-content: center;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: center;
  }
  .kind {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .title {
    font-size: var(--step-2);
  }
  .stretched {
    text-decoration: none;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .work-card:has(.stretched:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .summary {
    color: var(--ink-2);
  }
  .highlights {
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-3xs);
  }
  .highlights li::marker {
    color: var(--accent);
  }
  .more {
    font-weight: 700;
    color: var(--accent-text);
  }
  .work-card:hover .more {
    text-decoration: underline;
  }
</style>
