---
interface Props {
  status: 'launched' | 'concept' | 'prototype' | 'in-progress';
}
const { status } = Astro.props;
const labels = {
  launched: 'Launched',
  concept: 'Concept · not a client project',
  prototype: 'Prototype',
  'in-progress': 'In progress',
} as const;
---

<span class:list={['chip', `chip--${status}`]}>{labels[status]}</span>
