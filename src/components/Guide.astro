---
/**
 * "What does your business need?" — progressive enhancement.
 * No JS: the form GETs /contact/ and the quick-guide table below is always visible.
 * With JS: the recommendation appears inline, then links to a pre-filled brief.
 */
import { questions } from '../lib/guide';
import { packages, checkUp } from '../data/packages';
import { services } from '../data/services';

const pkgNames = Object.fromEntries([...packages, checkUp].map((p) => [p.id, p.name]));
const svcNames = Object.fromEntries(services.map((s) => [s.id, s.name]));
---

<div class="guide" data-guide data-pkg-names={JSON.stringify(pkgNames)} data-svc-names={JSON.stringify(svcNames)}>
  <form class="guide-form" action="/contact/" method="get" data-guide-form>
    {
      questions.map((q, qi) => (
        <fieldset class="q">
          <legend>
            <span class="q-no" aria-hidden="true">
              {String(qi + 1).padStart(2, '0')}
            </span>
            {q.legend}
          </legend>
          <div class="options">
            {q.options.map((o) => (
              <label class="option">
                <input type="radio" name={q.name} value={o.value} required />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <div class="actions">
      <button class="btn" type="submit" data-guide-submit>Show my starting point</button>
      <p class="small muted" data-guide-hint>Answer all three questions. Nothing is sent.</p>
    </div>
  </form>

  <section class="result" data-guide-result aria-live="polite" hidden tabindex="-1" aria-labelledby="guide-result-title">
    <p class="label">Suggested starting point</p>
    <h3 id="guide-result-title" data-r-headline></h3>
    <ul class="reasons" data-r-reasons role="list"></ul>
    <p class="label">Services involved</p>
    <ul class="svc" data-r-services role="list"></ul>
    <p class="small muted">
      A suggestion, not a quote. Every project gets a written scope after a short brief.
    </p>
    <div class="btn-row">
      <a class="btn" href="/contact/" data-r-cta>Start a brief with this <span class="arrow" aria-hidden="true">→</span></a>
      <button class="btn btn--secondary" type="button" data-guide-reset>Start over</button>
    </div>
  </section>

  <details class="quick-guide">
    <summary>Quick guide without the questions</summary>
    <table>
      <caption class="visually-hidden">Quick guide: situation and suggested starting point</caption>
      <thead>
        <tr><th scope="col">If you…</th><th scope="col">Start with</th></tr>
      </thead>
      <tbody>
        <tr><td>are starting out, or have no website</td><td>Business Launch</td></tr>
        <tr><td>are hard to find on Google, or have few recent reviews</td><td>Found &amp; Chosen</td></tr>
        <tr><td>miss calls, or reply to enquiries late</td><td>Never Miss an Enquiry</td></tr>
        <tr><td>have a dated website that’s hard to book from</td><td>Website That Books</td></tr>
        <tr><td>aren’t sure what’s wrong</td><td>Free Found &amp; Answered check</td></tr>
      </tbody>
    </table>
  </details>
</div>

<script>
  import { parseAnswers, recommend, briefHref } from '../lib/guide';
  import { track } from '../scripts/analytics';
  import { sitePath } from '../scripts/paths';

  document.querySelectorAll<HTMLElement>('[data-guide]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-guide-form]')!;
    form.noValidate = true; // JS handles validation messaging; native validation remains without JS
    const submit = root.querySelector<HTMLButtonElement>('[data-guide-submit]')!;
    const hint = root.querySelector<HTMLElement>('[data-guide-hint]')!;
    const result = root.querySelector<HTMLElement>('[data-guide-result]')!;
    const pkgNames: Record<string, string> = JSON.parse(root.dataset.pkgNames || '{}');
    const svcNames: Record<string, string> = JSON.parse(root.dataset.svcNames || '{}');

    const read = () => parseAnswers(Object.fromEntries(new FormData(form).entries()));
    const sync = () => {
      const ready = Boolean(read());
      submit.classList.toggle('is-waiting', !ready);
      hint.textContent = ready ? 'Ready. Nothing is sent.' : 'Answer all three questions. Nothing is sent.';
    };
    form.addEventListener('change', sync);
    sync();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const answers = read();
      if (!answers) {
        const firstEmpty = form.querySelector<HTMLInputElement>('fieldset:not(:has(input:checked)) input');
        firstEmpty?.focus();
        hint.textContent = 'Please answer all three questions first.';
        return;
      }
      const rec = recommend(answers);
      result.querySelector('[data-r-headline]')!.textContent = rec.headline;
      const reasons = result.querySelector('[data-r-reasons]')!;
      reasons.replaceChildren(
        ...rec.reasons.map((r) => {
          const li = document.createElement('li');
          li.textContent = r;
          return li;
        }),
      );
      const svcs = result.querySelector('[data-r-services]')!;
      svcs.replaceChildren(
        ...rec.serviceIds.map((id) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = sitePath(`/services/#${id}`);
          a.textContent = svcNames[id] ?? id;
          li.append(a);
          return li;
        }),
      );
      result.querySelector<HTMLAnchorElement>('[data-r-cta]')!.href = sitePath(briefHref(rec));
      result.hidden = false;
      result.classList.remove('is-in');
      void result.offsetWidth;
      result.classList.add('is-in');
      result.focus({ preventScroll: true });
      result.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      track('select_content', { content_type: 'service_guide_result', content_id: rec.packageId, item_name: pkgNames[rec.packageId] ?? rec.packageId });
    });

    root.querySelector('[data-guide-reset]')?.addEventListener('click', () => {
      form.reset();
      result.hidden = true;
      sync();
      form.querySelector<HTMLInputElement>('input')?.focus();
    });
  });
</script>

<style>
  .guide {
    display: grid;
    gap: var(--space-l);
  }
  .guide-form {
    display: grid;
    gap: var(--space-l);
  }
  .q {
    border: 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }
  legend {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-s);
    padding: 0;
  }
  .q-no {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-text);
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: 0.55em 1em 0.55em 0.8em;
    border: 1.5px solid var(--control);
    border-radius: var(--radius-pill);
    background: var(--card);
    cursor: pointer;
    line-height: 1.3;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .option:hover {
    border-color: var(--ink);
  }
  .option input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0;
    accent-color: var(--ink);
    flex: none;
  }
  .option:has(input:checked) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .option:has(input:checked) input {
    accent-color: var(--accent);
  }
  .option:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .option input:focus-visible {
    outline: none;
  }
  .btn.is-waiting {
    opacity: 0.6;
    box-shadow: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
  }
  .result {
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: var(--radius-l);
    padding: var(--space-l);
    display: grid;
    gap: var(--space-s);
    box-shadow: 6px 6px 0 var(--accent);
  }
  .result:focus {
    outline: none;
  }
  .result:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  :global(.js-motion) .result.is-in {
    animation: rise 300ms var(--ease-out);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .result h3 {
    font-size: var(--step-2);
  }
  .reasons {
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-2xs);
  }
  .reasons li::marker {
    color: var(--accent);
  }
  .svc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  .svc a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    padding: 0.2em 0.8em;
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    text-decoration: none;
    font-weight: 600;
  }
  .svc a:hover {
    text-decoration: underline;
  }
  .quick-guide summary {
    cursor: pointer;
    font-weight: 700;
    min-height: var(--tap);
    display: flex;
    align-items: center;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
  th,
  td {
    text-align: left;
    padding: var(--space-xs) var(--space-s) var(--space-xs) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  td:last-child {
    font-weight: 700;
  }
</style>
