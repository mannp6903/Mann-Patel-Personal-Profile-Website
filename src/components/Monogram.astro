---
/** "MP" monogram (Bodoni Moda outlines). Decorative. */
import logo from '../data/logo.json';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const m = logo.monogram;
---

<svg class:list={['monogram', className]} viewBox={m.viewBox} aria-hidden="true" focusable="false">
  <path d={m.letters} fill="currentColor"></path>
</svg>

<style>
  .monogram {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
