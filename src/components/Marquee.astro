---
/**
 * Slow, decorative services marquee (the same services are listed in full right after it,
 * so it is hidden from assistive tech). A Pause button stops it for touch and keyboard users
 * (WCAG 2.2.2 Pause, Stop, Hide); it also pauses on hover and while off screen, and is static
 * with reduced motion. A paused choice is remembered for the visit.
 */
const items = [
  'Google Business Profile',
  'Reviews & replies',
  'Apple Maps & Bing',
  'Missed-call text-back',
  'Online booking',
  'Appointment reminders',
  'Websites that book',
  'Monthly care',
  'Flyers & gift cards',
  'Reels & stories',
];
---

<div class="marquee-wrap" data-marquee>
<div class="marquee" aria-hidden="true">
  <div class="track">
    {
      [0, 1].map(() => (
        <ul class="set">
          {items.map((t) => (
            <li>
              <span>{t}</span>
              <i class="sq" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
<button class="mq-toggle" type="button" aria-pressed="false" data-marquee-toggle>
  <span class="mq-icon" aria-hidden="true"></span>
  <span class="visually-hidden">Pause the moving list of services</span>
</button>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-marquee]');
  const btn = wrap?.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  if (wrap && btn) {
    const set = (paused: boolean) => {
      wrap.classList.toggle('is-paused', paused);
      btn.setAttribute('aria-pressed', String(paused));
      try {
        sessionStorage.setItem('mp-marquee-paused', paused ? '1' : '0');
      } catch {
        /* storage blocked: the choice lasts for this page only */
      }
    };
    let saved = false;
    try {
      saved = sessionStorage.getItem('mp-marquee-paused') === '1';
    } catch {
      /* ignore */
    }
    if (saved) set(true);
    btn.addEventListener('click', () => set(!wrap.classList.contains('is-paused')));
    // Don't animate while nobody can see it.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => wrap.classList.toggle('is-offscreen', !e.isIntersecting)).observe(wrap);
    }
  }
</script>

<style>
  .marquee-wrap {
    position: relative;
  }
  .marquee {
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    padding-block: 0.95rem;
    border-block: 1px solid var(--ink);
    user-select: none;
  }
  .track {
    display: flex;
    width: max-content;
  }
  .set {
    display: flex;
    flex-shrink: 0;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.5rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .sq {
    width: 0.5em;
    height: 0.5em;
    background: var(--accent-on-night);
    transform: rotate(8deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: marquee 48s linear infinite;
    }
    .marquee:hover .track,
    .is-paused .track,
    .is-offscreen .track {
      animation-play-state: paused;
    }
  }
  .mq-toggle {
    position: absolute;
    right: max(var(--space-2xs), env(safe-area-inset-right, 0px));
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1.5px solid var(--night-line);
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .mq-toggle:hover {
    border-color: var(--paper);
  }
  .mq-toggle:focus-visible {
    outline: 3px solid var(--accent-on-night);
    outline-offset: 2px;
  }
  /* Pause icon (two bars) / play icon (triangle) */
  .mq-icon {
    width: 12px;
    height: 14px;
    border-inline: 4px solid currentColor;
  }
  .mq-toggle[aria-pressed='true'] .mq-icon {
    width: 0;
    height: 0;
    border-inline: 0;
    border-block: 7px solid transparent;
    border-left: 12px solid currentColor;
    margin-left: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-toggle {
      display: none;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
