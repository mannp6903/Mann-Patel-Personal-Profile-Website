---
/**
 * Renders nothing unless PUBLIC_GA4_ID is configured.
 * When configured: a small, non-blocking consent prompt; GA loads only after "Allow".
 */
import { PUBLIC_GA4_ID } from 'astro:env/client';
---

{
  PUBLIC_GA4_ID && (
    <div class="consent" data-consent hidden>
      <p>
        May I count visits? It shows me which pages are useful. No ads, and nothing you type into forms.{' '}
        <a href="/privacy/#analytics">Details</a>
      </p>
      <div class="btn-row">
        <button class="btn btn--sm btn--plain" type="button" data-consent-allow>
          Allow
        </button>
        <button class="btn btn--sm btn--plain btn--ghost" type="button" data-consent-deny>
          No thanks
        </button>
      </div>
    </div>
  )
}

<script>
  import { analyticsConfigured, getConsent, setConsent, loadGa } from '../scripts/analytics';

  if (analyticsConfigured()) {
    const box = document.querySelector<HTMLElement>('[data-consent]');
    const choice = getConsent();
    if (choice === 'granted') loadGa();
    if (box && choice === null) {
      box.hidden = false;
      box.querySelector('[data-consent-allow]')?.addEventListener('click', () => {
        setConsent('granted');
        box.hidden = true;
      });
      box.querySelector('[data-consent-deny]')?.addEventListener('click', () => {
        setConsent('denied');
        box.hidden = true;
      });
    }
  }
</script>

<style>
  .consent {
    position: fixed;
    z-index: 60;
    inset: auto var(--s-4) var(--s-4) auto;
    max-width: 24rem;
    padding: var(--s-5);
    background: var(--surface);
    color: var(--text);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-pop);
    font-size: var(--fs-sm);
    display: grid;
    gap: var(--s-4);
  }
  .consent a {
    color: var(--text);
  }
  @media (max-width: 30em) {
    .consent {
      inset: auto var(--s-2) var(--s-2) var(--s-2);
    }
  }
</style>
