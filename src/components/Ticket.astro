---
/**
 * Signature hero graphic: a sample enquiry "ticket" stamped through four stages.
 * Fictional data, clearly labelled. Static and fully visible when motion is reduced or JS is off.
 */
const stages = [
  { label: 'Received', detail: 'Website form · 9:42 a.m.' },
  { label: 'Acknowledged', detail: 'Reply sent to Priya · 9:42 a.m.' },
  { label: 'Owner notified', detail: 'Email to the owner · 9:42 a.m.' },
  { label: 'Follow-up set', detail: 'Reminder Monday 9:00 a.m. if unanswered' },
];
---

<figure class="ticket-wrap">
  <div class="ticket">
    <div class="ticket-head">
      <span class="no">Enquiry #0142</span>
      <span class="sample">Sample</span>
    </div>
    <dl class="ticket-meta">
      <div>
        <dt>From</dt>
        <dd>Priya S., Bloom &amp; Bark Grooming</dd>
      </div>
      <div>
        <dt>Asked</dt>
        <dd>“Do you have Saturday openings for a large dog?”</dd>
      </div>
    </dl>
    <ol class="stages" role="list">
      {
        stages.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="stamp" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="stage-text">
              <strong>{s.label}</strong>
              <span>{s.detail}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="done-stamp" aria-hidden="true">Nothing slipped</p>
  </div>
  <figcaption>
    A fictional enquiry, followed through four stages. <a href="#follow-up">See how it works</a>.
  </figcaption>
</figure>

<style>
  .ticket-wrap {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
  }
  .ticket {
    position: relative;
    width: min(100%, 26rem);
    background: var(--card);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-ticket);
    padding: var(--space-l) var(--space-m) 4.75rem;
    transform: rotate(-1.2deg);
    /* perforated top edge */
    -webkit-mask: radial-gradient(circle 6px at 10px 0, transparent 98%, #000) 0 0 / 20px 100% repeat-x;
    mask: radial-gradient(circle 6px at 10px 0, transparent 98%, #000) 0 0 / 20px 100% repeat-x;
  }
  .ticket-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    padding-bottom: var(--space-s);
    border-bottom: 1.5px dashed var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sample {
    color: var(--accent-text);
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 0.05em 0.6em;
  }
  .ticket-meta {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-s);
    font-size: var(--step--1);
  }
  .ticket-meta div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-2xs);
  }
  .ticket-meta dt {
    font-family: var(--font-mono);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85em;
    padding-top: 0.15em;
  }
  .stages {
    list-style: none;
    padding: var(--space-s) 0 0;
    border-top: 1.5px dashed var(--line);
    display: grid;
    gap: var(--space-xs);
  }
  .stages li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-xs);
    align-items: center;
  }
  .stamp {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    color: var(--accent);
    transform: rotate(-8deg);
  }
  .stamp svg {
    width: 1.2rem;
  }
  .stage-text {
    display: grid;
    line-height: 1.3;
    font-size: var(--step--1);
  }
  .stage-text strong {
    font-size: var(--step-0);
  }
  .stage-text span {
    color: var(--ink-2);
  }
  .done-stamp {
    position: absolute;
    right: var(--space-m);
    bottom: 0.9rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-text);
    background: var(--card);
    border: 3px double var(--accent-text);
    border-radius: var(--radius-s);
    padding: 0.15em 0.5em;
    transform: rotate(-12deg);
    pointer-events: none;
  }
  figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
    text-align: center;
  }

  /* Stamp sequence: only when motion is allowed and JS has marked the page. */
  :global(.js-motion) .stamp {
    animation: stamp 200ms var(--ease-stamp) both;
    animation-delay: calc(500ms + var(--i) * 280ms);
  }
  :global(.js-motion) .done-stamp {
    animation: stamp-big 260ms var(--ease-stamp) both;
    animation-delay: 1.8s;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(1.8) rotate(-24deg);
    }
  }
  @keyframes stamp-big {
    from {
      opacity: 0;
      transform: scale(1.6) rotate(-20deg);
    }
  }
  @media (max-width: 22.5em) {
    .done-stamp {
      display: none;
    }
  }
</style>
