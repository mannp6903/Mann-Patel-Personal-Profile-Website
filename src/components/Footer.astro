---
/**
 * Footer: closing call to action (hidden on the contact page), link columns, the kinetic name
 * (letters widen near the pointer) and the bottom bar with the Toronto clock.
 */
import { profile, social, businesses, nav } from '../data/site';
import { groups } from '../data/services';
import { contact, emailHref } from '../lib/contact';
import Button from './ui/Button.astro';
import Heading from './ui/Heading.astro';
import Icon from './ui/Icon.astro';
import ContactActions from './ContactActions.astro';

interface Props {
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const mail = emailHref();
const links = social.filter((s) => s.url);
const nest = businesses[0];
const name = [...profile.name];
---

<footer class="ftr">
  {
    cta && (
      <section class="ftr__cta container" aria-labelledby="ftr-cta-title">
        <p class="eyebrow">Next step</p>
        <Heading id="ftr-cta-title" class="ftr__title" lines={['Tell me what isn’t working.', '<span class="serif serif--signal">I’ll tell you where to start.</span>']} />
        <div class="ftr__cta-row">
          <p class="lead ftr__lead" data-reveal>
            A short brief takes two minutes. I read every one myself and reply by email<span class="ftr__more">, usually with a few questions or a
            suggested first step</span>.
          </p>
          <div class="ftr__actions" data-reveal style="--d:120">
            <div class="btn-row">
              <Button href="/contact/">Start a project</Button>
              <Button href="/contact/?package=check-up#brief" variant="ghost">
                Request the free check
              </Button>
            </div>
            <ContactActions label="Or reach me directly" class="ftr__reach" />
          </div>
        </div>
      </section>
    )
  }

  <div class="ftr__grid container">
    <nav class="ftr__col ftr__col--pages" aria-label="Footer">
      <h2 class="ftr__h">Pages</h2>
      <ul role="list">
        <li><a class="link-quiet" href="/">Home</a></li>
        {nav.map((n) => <li><a class="link-quiet" href={n.href}>{n.label}</a></li>)}
        <li><a class="link-quiet" href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <div class="ftr__col ftr__col--services">
      <h2 class="ftr__h">Services</h2>
      <ul role="list">
        {groups.map((g) => <li><a class="link-quiet" href={`/services/#${g.id}`}>{g.title}</a></li>)}
        <li><a class="link-quiet" href="/services/#packages">Packages</a></li>
        <li><a class="link-quiet" href="/services/#check">Free Found &amp; Answered check</a></li>
      </ul>
    </div>
    <div class="ftr__col ftr__col--wide">
      <h2 class="ftr__h">Contact</h2>
      <ul role="list">
        {
          contact.email && (
            <li class="ftr__email">
              <a class="link-quiet" href={mail} data-contact="email">
                {contact.email}
              </a>
              <button class="copy" type="button" data-copy={contact.email}>
                <Icon name="copy" />
                <span class="visually-hidden">Copy email address</span>
              </button>
            </li>
          )
        }
        {
          contact.phone && (
            <li>
              <a class="link-quiet num" href="/contact/#reach" data-reach="call" data-k={contact.phone.key} data-contact="phone">
                <span class="visually-hidden">Call, number partly hidden for privacy: </span>
                {contact.phone.masked}
              </a>
            </li>
          )
        }
        <li class="subtle">Based in {profile.location}. Working across {profile.serviceArea}.</li>
      </ul>
    </div>
    <div class="ftr__col">
      <h2 class="ftr__h">Elsewhere</h2>
      <ul role="list">
        {
          links.map((s) => (
            <li>
              <a class="link-quiet" href={s.url!} rel="me noopener" data-contact={s.id}>
                {s.label}
                <Icon name="arrow-ne" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="link-quiet" href={nest.url} rel="noopener">
            {nest.name}
            <Icon name="arrow-ne" />
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="ftr__name" data-kinetic aria-hidden="true">
    {name.map((ch) => (ch === ' ' ? <span class="k-space" /> : <span data-k-ch>{ch}</span>))}
    <span class="k-dot" />
  </div>

  <div class="ftr__bottom container">
    <p>© {year} {profile.name} · Toronto, Canada</p>
    <p class="num ftr__clock">
      <span class="status__dot" aria-hidden="true"></span>
      Toronto time <time data-clock>--:--</time>
    </p>
    <p class="ftr__legal">
      <a class="link-quiet" href="/privacy/">Privacy</a>
      <a class="link-quiet" href="/terms/">Terms</a>
      <a class="link-quiet ftr__top" href="#main">Back to top <Icon name="arrow" class="up" /></a>
    </p>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    margin-top: auto;
    border-top: 1px solid var(--line);
    overflow: clip;
  }
  .ftr__cta {
    padding-block: var(--section) calc(var(--section) * 0.7);
    display: grid;
    gap: var(--s-5);
  }
  .ftr__title {
    font-size: clamp(2.1rem, 1.2rem + 4.8vw, 6.25rem);
    font-weight: 760;
    font-stretch: 114%;
    letter-spacing: -0.045em;
    line-height: 0.95;
    max-width: 18ch;
  }
  .ftr__cta-row {
    display: grid;
    gap: var(--s-5);
    align-items: start;
  }
  .ftr__actions {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 64em) {
    .ftr__cta-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-8);
    }
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-5);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .ftr__col--wide {
    grid-column: 1 / -1;
  }
    @media (min-width: 48em) {
    .ftr__grid {
      gap: var(--s-7) var(--s-5);
      padding-block: var(--s-8);
    }
  }
  @media (min-width: 56em) {
    .ftr__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ftr__col--wide {
      grid-column: auto;
    }
  }
  .ftr__h {
    margin-bottom: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
    font-stretch: 100%;
  }
  .ftr__col ul {
    display: grid;
    gap: var(--s-1);
    font-size: 0.9875rem;
  }
  .ftr__col li {
    min-height: 2rem;
    display: flex;
    align-items: center;
  }
  .ftr__col li.subtle {
    font-size: var(--fs-sm);
    line-height: 1.45;
    margin-top: var(--s-2);
  }
  .link-quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 2rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--t-fast);
    overflow-wrap: anywhere;
  }
  .link-quiet:hover {
    color: var(--signal);
  }
  .link-quiet .icon {
    width: 0.95em;
    height: 0.95em;
  }
  .ftr__email {
    gap: var(--s-2);
  }
  .copy {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--text-2);
    transition: border-color var(--t-fast), color var(--t-fast), background-color var(--t-fast);
  }
  .copy:hover {
    border-color: var(--control);
    color: var(--text);
  }
  .copy:global(.is-copied) {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }
  .copy .icon {
    width: 1rem;
    height: 1rem;
  }

  /* The kinetic name: sized to the viewport; letters respond to the pointer through --g. */
  .ftr__name {
    display: flex;
    justify-content: center;
    align-items: baseline;
    padding-inline: var(--gutter);
    font-size: clamp(3.4rem, 16.2vw, 17.5rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--text);
    user-select: none;
    white-space: nowrap;
    padding-bottom: 0.06em;
  }
  .ftr__name [data-k-ch] {
    --g: 0;
    flex: none;
    display: inline-block;
    font-variation-settings:
      'wdth' calc(96 + var(--g) * 29),
      'wght' calc(760 + var(--g) * 140);
    color: color-mix(in oklab, var(--text) calc(100% - var(--g) * 100%), var(--signal));
    transition: font-variation-settings 420ms var(--ease-out), color 420ms var(--ease-out);
  }
  .k-space {
    width: 0.24em;
  }
  .k-dot {
    flex: none;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.04em;
    border-radius: 50%;
    background: var(--signal);
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    padding-block: var(--s-5) var(--s-6);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .ftr__clock {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .ftr__top .up {
    transform: rotate(-90deg);
  }
  /* Phones: contact first, pages as one wrapped line, services left to the menu and Services page. */
  @media (max-width: 47.99em) {
    .ftr__col--wide {
      order: -1;
    }
    .ftr__col--services {
      display: none;
    }
    .ftr__col--pages {
      grid-column: 1 / -1;
    }
    .ftr__col--pages ul {
      display: flex;
      row-gap: 0;
      flex-wrap: wrap;
      column-gap: var(--s-5);
    }
    .ftr__more {
      display: none;
    }
    .ftr__actions :global(.ftr__reach .ca__label) {
      display: none;
    }
    .ftr__cta {
      padding-bottom: var(--s-7);
    }
    .ftr__grid {
      gap: var(--s-4) var(--s-5);
      padding-block: var(--s-5);
    }
    .ftr__h {
      margin-bottom: var(--s-2);
    }
    .ftr__col li.subtle {
      display: none;
    }
    .ftr__col:not(.ftr__col--wide) {
      grid-column: 1 / -1;
    }
    .ftr__col:not(.ftr__col--wide) ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--s-5);
    }
    .ftr__bottom {
      padding-block: var(--s-4) var(--s-5);
      gap: var(--s-2) var(--s-5);
    }
  }
</style>
