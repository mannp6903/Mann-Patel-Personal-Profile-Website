---
import { profile, businesses, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="container grid">
    <div class="brand">
      <p class="wordmark">Mann Patel<span class="dot" aria-hidden="true">.</span></p>
      <p class="muted">{profile.descriptor}.</p>
    </div>

    <nav aria-label="Footer">
      <p class="label">Site</p>
      <ul role="list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact/">Start a project</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <p class="label">My businesses</p>
      <ul role="list">
        {
          businesses.map((b) => (
            <li>
              <a href={b.url} rel="noopener" data-track="nest_and_rest">
                {b.name}&nbsp;<span aria-hidden="true">↗</span>
              </a>
              <span class="muted small block">Home cleaning · {b.area}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container base">
    <p class="small muted">© {year} {profile.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: var(--space-s);
  }
  .dot {
    color: var(--accent-on-night);
  }
  .brand p.muted {
    max-width: 30ch;
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-2xs);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .block {
    display: block;
  }
  .base {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--night-line);
  }
</style>
