---
/**
 * Footer: a closing invitation with the main action and every direct contact channel
 * (Email / Call / WhatsApp / Text), a copyable email, live Toronto time and the small print.
 * Plain document flow: nothing is absolutely positioned, so nothing can overlap.
 */
import { profile, businesses, nav } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import ContactActions from './ContactActions.astro';

const year = new Date().getFullYear();
const email = profile.contact.email;
const nest = businesses[0];
---

<footer class="site-footer on-night">
  <div class="container">
    <div class="ft-cta">
      <div class="ft-head">
        <p class="ft-label">Have a project in mind?</p>
        <h2 class="ft-title">Let’s make your business <span class="ft-accent">easy to choose.</span></h2>
        <p class="ft-sub">Send a short brief, or reach me directly. I reply myself, usually with a question or two.</p>
      </div>
      <div class="ft-actions">
        <a class="btn ft-start" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <ContactActions compact class="ft-reach" />
        {
          email && (
            <p class="ft-copy">
              <a href={`mailto:${email}`} data-contact="email">{email}</a>
              <button class="ft-copy-btn" type="button" data-copy-email={email}>
                Copy email
              </button>
              <span class="ft-copied" role="status" data-copy-email-status></span>
            </p>
          )
        }
      </div>
    </div>

    <div class="ft-bottom">
      <div>
        <p class="ft-label">Local time</p>
        <p data-local-time>Toronto</p>
      </div>
      <nav aria-label="Footer">
        <p class="ft-label">Pages</p>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </nav>
      <div>
        <p class="ft-label">Socials</p>
        <SocialLinks />
      </div>
      <div>
        <p class="ft-label">My business</p>
        <p>
          <a href={nest.url} rel="noopener" data-track="nest_and_rest">{nest.name}&nbsp;<span aria-hidden="true">↗</span></a>
        </p>
        <p class="small ft-muted">Home cleaning · bookings open summer 2027</p>
      </div>
    </div>

    <div class="ft-legal">
      <p>© {year} {profile.name} · Toronto, Ontario</p>
      <nav class="ft-legal-links" aria-label="Legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Use</a>
        <a href="/privacy/#analytics">Cookies</a>
      </nav>
      <a class="ft-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<script>
  // Live local time in Toronto, e.g. "9:41 p.m. EST · Toronto".
  const out = document.querySelector<HTMLElement>('[data-local-time]');
  if (out) {
    const fmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short',
    });
    const tick = () => (out.textContent = `${fmt.format(new Date())} · Toronto`);
    tick();
    window.setInterval(tick, 30_000);
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-email-status]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copyEmail ?? '');
      if (status) status.textContent = 'Copied';
      copy.classList.add('is-copied');
      window.setTimeout(() => {
        copy.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, 2400);
    } catch {
      if (status) status.textContent = copy.dataset.copyEmail ?? '';
    }
  });
</script>

<style>
  .site-footer {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) var(--space-l);
    overflow: hidden;
  }
  .ft-cta {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  @media (min-width: 64em) {
    .ft-cta {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-2xl);
    }
  }
  .ft-head {
    display: grid;
    gap: var(--space-s);
  }
  .ft-title {
    font-size: clamp(2.4rem, 1.5rem + 4vw, 5rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--night-ink);
    max-width: 14ch;
    text-wrap: balance;
  }
  .ft-accent {
    color: var(--accent-on-night);
    font-style: italic;
    font-weight: 500;
  }
  .ft-sub {
    max-width: 42ch;
    color: var(--night-ink-2);
  }
  .ft-actions {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    min-width: 0;
  }
  .ft-actions :global(.ft-reach) {
    width: min(100%, 28rem);
  }
  .ft-start {
    font-size: var(--step-1);
    padding: 0.8em 1.5em;
  }
  .ft-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    font-weight: 700;
  }
  .ft-copy a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--night-ink);
    overflow-wrap: anywhere;
  }
  .ft-copy-btn {
    min-height: var(--tap);
    padding: 0 var(--space-s);
    border: 1px solid var(--night-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--night-ink-2);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .ft-copy-btn:hover,
  .ft-copy-btn.is-copied {
    border-color: var(--night-ink);
    color: var(--night-ink);
  }
  .ft-copied {
    font-size: var(--step--1);
    color: var(--night-ink-2);
  }
  .ft-bottom {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l);
    border-top: 1px solid var(--night-line);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    font-size: var(--step--1);
  }
  .ft-label {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--night-ink-2);
  }
  .ft-bottom ul {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .ft-bottom ul a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
  }
  .ft-bottom a {
    color: var(--night-ink);
    text-decoration: none;
  }
  .ft-bottom a:hover {
    text-decoration: underline;
  }
  .ft-muted {
    color: var(--night-ink-2);
  }
  .ft-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
    border-top: 1px solid var(--night-line);
    font-size: var(--step--1);
    color: var(--night-ink-2);
  }
  .ft-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
  }
  .ft-legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--night-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ft-legal-links a:hover {
    color: var(--accent-on-night);
  }
  .ft-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
    color: var(--night-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .ft-top:hover {
    text-decoration: underline;
  }
</style>
