---
import { profile, businesses, nav } from '../data/site';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="container grid">
    <div class="brand">
      <p class="label">{profile.name}</p>
      <p class="muted">{profile.descriptor}.</p>
      {profile.contact.email && (
        <p>
          <a class="email" href={`mailto:${profile.contact.email}`} data-contact="email">{profile.contact.email}</a>
        </p>
      )}
      <SocialLinks />
    </div>

    <nav aria-label="Footer">
      <p class="label">Site</p>
      <ul role="list">
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact/">Start a project</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <p class="label">My businesses</p>
      <ul role="list">
        {
          businesses.map((b) => (
            <li>
              <a href={b.url} rel="noopener" data-track="nest_and_rest">
                {b.name}&nbsp;<span aria-hidden="true">↗</span>
              </a>
              <span class="muted small block">Home cleaning · {b.area}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container signature">
    <a href="/" aria-label="Mann Patel, home"><Logo master="display" motion="reveal" /></a>
  </div>
  <div class="container base">
    <p class="small muted">© {year} {profile.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }
  /* Signature: the wordmark set across the full width of the page. */
  .signature {
    margin-top: var(--space-2xl);
  }
  .signature a {
    display: block;
    width: 100%;
    color: var(--night-ink);
    --logo-dot: var(--accent-on-night);
    border-radius: var(--radius-s);
  }
  .signature a:hover {
    text-decoration: none;
  }
  .signature :global(.logo) {
    width: 100%;
    height: auto;
  }
  .brand {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  .email {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .brand p.muted {
    max-width: 30ch;
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-2xs);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .block {
    display: block;
  }
  .base {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--night-line);
  }
</style>
