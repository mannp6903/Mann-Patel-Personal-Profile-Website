---
/** Samp Hair & Spa — screenshots of the in-progress preview (31 Oct 2026). */
import Captures from './Captures.astro';
import desktop from '../../assets/work/samp-hair-spa/preview-2026-10-31-desktop.png';
import mobile from '../../assets/work/samp-hair-spa/preview-2026-10-31-mobile.png';

interface Props {
  variant?: 'thumb' | 'full';
  eager?: boolean;
}
const { variant = 'thumb', eager = false } = Astro.props;
---

<Captures
  variant={variant}
  eager={eager}
  tint="#f3e4e6"
  url="https://samp-hair-spa.lovable.app/"
  desktop={{
    src: desktop,
    alt: 'Samp Hair & Spa preview on desktop: the headline “Where beauty meets calm.” in an elegant serif, with Book an appointment and phone buttons beside salon photography.',
    caption: 'Work-in-progress preview on desktop, captured 31 Oct 2026. The preview’s photography is stock, labelled “Illustrative photography” on the site.',
  }}
  mobile={{
    src: mobile,
    alt: 'Samp Hair & Spa preview on a phone: the salon logo, the headline “Where beauty meets calm.” and a short description of services.',
    caption: 'Same preview on a phone, 360 px.',
  }}
/>
