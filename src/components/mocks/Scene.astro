---
import NestScene from './NestScene.astro';
import SampScene from './SampScene.astro';

interface Props {
  scene: 'nest-and-rest' | 'samp';
  variant?: 'thumb' | 'full';
  eager?: boolean;
}
const { scene, variant = 'thumb', eager = false } = Astro.props;
---

{scene === 'nest-and-rest' && <NestScene variant={variant} eager={eager} />}
{scene === 'samp' && <SampScene variant={variant} eager={eager} />}
