---
/**
 * Kettle & Crumb — fictional bakery-café concept. All artwork is coded (HTML/CSS/SVG).
 * variant="thumb": a composed arrangement for cards. variant="full": every piece with captions.
 */
interface Props {
  variant?: 'thumb' | 'full';
}
const { variant = 'thumb' } = Astro.props;

const mark = `<svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M24 14c-2-4 2-6 0-10M32 14c-2-4 2-6 0-10M40 14c-2-4 2-6 0-10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M14 30c0-6 8-10 18-10s18 4 18 10v14c0 8-8 12-18 12s-18-4-18-12z" fill="currentColor"/><path d="M50 32c6-2 10 2 10 6s-4 7-10 6" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><rect x="26" y="16" width="12" height="5" rx="2" fill="currentColor"/></svg>`;
---

<div class:list={['kettle', variant]}>
  {
    variant === 'thumb' ? (
      <div class="thumb-stage" aria-hidden="true">
        <div class="piece flyer">
          <div class="flyer-in">
            <span class="k-mark" set:html={mark} />
            <p class="k-serif big">Now open.</p>
            <p class="k-serif">Bread, coffee & a seat by the window.</p>
            <p class="k-band">Tue–Sun · 7 a.m.–4 p.m.</p>
          </div>
        </div>
        <div class="piece post">
          <div class="post-in">
            <p class="k-serif big">Sourdough Saturdays</p>
            <span class="k-mark sm" set:html={mark} />
          </div>
        </div>
        <div class="piece card-front">
          <div class="card-in">
            <span class="k-mark" set:html={mark} />
            <p class="k-serif name">Kettle &amp; Crumb</p>
            <p class="k-mono">Bakery · Café</p>
          </div>
        </div>
      </div>
    ) : (
      <div class="gallery">
        <figure class="g-site">
          <div class="piece site" aria-hidden="true">
            <div class="site-in">
              <div class="browser">
                <span />
                <span />
                <span />
                <p class="k-mono url">kettleandcrumb.example</p>
              </div>
              <div class="site-nav">
                <span class="k-mark sm" set:html={mark} />
                <p class="k-serif">Kettle &amp; Crumb</p>
                <p class="k-mono nav">Menu · Visit · Gift cards</p>
              </div>
              <div class="site-hero">
                <p class="k-serif big">Bread, coffee &amp; a seat by the window.</p>
                <p class="k-mono">Open Tue–Sun · 7 a.m.–4 p.m. · Example Ave, Toronto</p>
                <span class="k-btn">See today’s bake</span>
              </div>
            </div>
          </div>
          <figcaption>One-page website hero: what’s on, when they’re open, where they are.</figcaption>
        </figure>

        <figure class="g-card">
          <div class="card-pair" aria-hidden="true">
            <div class="piece card-front">
              <div class="card-in">
                <span class="k-mark" set:html={mark} />
                <p class="k-serif name">Kettle &amp; Crumb</p>
                <p class="k-mono">Bakery · Café</p>
              </div>
            </div>
            <div class="piece card-back">
              <div class="card-in back">
                <p class="k-serif">Ada &amp; Lou</p>
                <p class="k-mono">Owners</p>
                <p class="k-mono">kettleandcrumb.example</p>
                <p class="k-mono">Example Ave, Toronto</p>
              </div>
            </div>
          </div>
          <figcaption>Business card, front and back. 3.5 × 2 in with 0.125 in bleed.</figcaption>
        </figure>

        <figure class="g-flyer">
          <div class="piece flyer" aria-hidden="true">
            <div class="flyer-in">
              <span class="k-mark" set:html={mark} />
              <p class="k-serif big">Now open.</p>
              <p class="k-serif">Bread, coffee &amp; a seat by the window.</p>
              <ul class="k-list">
                <li>Sourdough, baked daily</li>
                <li>Cardamom buns</li>
                <li>Pour-over coffee</li>
              </ul>
              <p class="k-band">Tue–Sun · 7 a.m.–4 p.m. · Example Ave</p>
            </div>
          </div>
          <figcaption>Neighbourhood flyer. 5.5 × 8.5 in, print PDF plus a web version.</figcaption>
        </figure>

        <figure class="g-post">
          <div class="piece post" aria-hidden="true">
            <div class="post-in">
              <p class="k-mono">This weekend</p>
              <p class="k-serif big">Sourdough Saturdays</p>
              <span class="k-mark sm" set:html={mark} />
            </div>
          </div>
          <figcaption>Instagram post, 1080 × 1350 px, from an editable template.</figcaption>
        </figure>

        <figure class="g-gift">
          <div class="piece gift" aria-hidden="true">
            <div class="gift-in">
              <span class="k-mark sm" set:html={mark} />
              <p class="k-serif">Gift card</p>
              <p class="k-serif amount">A treat, on us.</p>
            </div>
          </div>
          <figcaption>
            Gift-card <strong>artwork only</strong>. Selling and redeeming cards needs a separate system.
          </figcaption>
        </figure>
      </div>
    )
  }
</div>

<style>
  .kettle {
    --k-brown: #6b3e26;
    --k-cream: #f7ebd8;
    --k-jam: #b8352a;
    --k-ink: #2b1b12;
    --k-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
  }
  .piece {
    container-type: inline-size;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .piece > div {
    font-size: 5cqi;
  }
  .k-serif {
    font-family: var(--k-serif);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .k-serif.big {
    font-size: 1.9em;
    font-weight: 700;
  }
  .k-mono {
    font-family: var(--font-mono);
    font-size: 0.62em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .k-mark {
    display: block;
    width: 2.6em;
    color: currentColor;
  }
  .k-mark.sm {
    width: 1.8em;
  }
  .k-band {
    margin-top: auto;
    background: var(--k-brown);
    color: var(--k-cream);
    padding: 0.5em 0.7em;
    font-family: var(--font-mono);
    font-size: 0.6em;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Business card */
  .card-front,
  .card-back {
    aspect-ratio: 3.5 / 2;
  }
  .card-in {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.25em;
    text-align: center;
    background: var(--k-cream);
    color: var(--k-brown);
    font-size: 7cqi !important;
  }
  .card-in .name {
    font-size: 1.15em;
    font-weight: 700;
  }
  .card-in.back {
    background: var(--k-brown);
    color: var(--k-cream);
    justify-items: start;
    text-align: left;
    padding-inline: 1.2em;
  }

  /* Flyer */
  .flyer {
    aspect-ratio: 5.5 / 8.5;
  }
  .flyer-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: 1.2em 1.2em 0;
    background: var(--k-cream);
    color: var(--k-ink);
    font-size: 7cqi !important;
  }
  .flyer-in .k-mark {
    color: var(--k-jam);
  }
  .flyer-in .k-band {
    margin-inline: -1.2em;
  }
  .k-list {
    font-family: var(--k-serif);
    font-size: 0.8em;
    padding-left: 1.1em;
  }

  /* Post */
  .post {
    aspect-ratio: 4 / 5;
  }
  .post-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.2em;
    background: var(--k-jam);
    color: var(--k-cream);
    font-size: 8cqi !important;
  }

  /* Gift card */
  .gift {
    aspect-ratio: 3.375 / 2.125;
  }
  .gift-in {
    height: 100%;
    display: grid;
    align-content: space-between;
    padding: 1em;
    color: var(--k-cream);
    background: radial-gradient(circle at 85% 20%, #8a5236 0 18%, transparent 19%),
      repeating-linear-gradient(135deg, transparent 0 1.2em, rgb(247 235 216 / 0.08) 1.2em 1.35em), var(--k-brown);
    font-size: 7cqi !important;
  }
  .gift-in .amount {
    font-size: 1.4em;
    font-weight: 700;
  }

  /* Website */
  .site {
    border: 1px solid var(--line);
  }
  .site-in {
    height: 100%;
    background: var(--k-cream);
    color: var(--k-ink);
    font-size: 3cqi !important;
    display: grid;
    grid-template-rows: auto auto 1fr;
  }
  .browser {
    display: flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.5em 0.8em;
    background: #e6d8c1;
  }
  .browser span {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: #c9b597;
  }
  .browser .url {
    margin-left: 1em;
    background: var(--k-cream);
    padding: 0.15em 0.8em;
    border-radius: 99px;
    text-transform: none;
    letter-spacing: 0;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.8em 1.6em;
    color: var(--k-brown);
    border-bottom: 1px solid #e6d8c1;
    font-weight: 700;
  }
  .site-nav .nav {
    margin-left: auto;
  }
  .site-hero {
    display: grid;
    align-content: center;
    gap: 0.8em;
    padding: 2.4em 1.6em 2.8em;
    max-width: 72%;
    font-size: 1.3em;
  }
  .site-hero .big {
    font-size: 2em;
  }
  .k-btn {
    justify-self: start;
    background: var(--k-jam);
    color: var(--k-cream);
    padding: 0.5em 1em;
    border-radius: 99px;
    font-weight: 700;
    font-size: 0.7em;
  }

  /* Thumb composition */
  .thumb-stage {
    position: relative;
    aspect-ratio: 16 / 11;
    background: #efe3cf;
    overflow: hidden;
  }
  .thumb-stage .flyer {
    position: absolute;
    width: 34%;
    left: 8%;
    top: 9%;
    transform: rotate(-4deg);
  }
  .thumb-stage .post {
    position: absolute;
    width: 30%;
    left: 40%;
    top: 16%;
    transform: rotate(3deg);
  }
  .thumb-stage .card-front {
    position: absolute;
    width: 34%;
    right: 5%;
    bottom: 12%;
    transform: rotate(-2deg);
  }

  /* Full gallery */
  .gallery {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    grid-template-columns: repeat(6, 1fr);
  }
  figure {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }
  figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .g-site {
    grid-column: 1 / -1;
  }
  .g-card {
    grid-column: span 3;
  }
  .card-pair {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .g-flyer {
    grid-column: span 3;
    grid-row: span 2;
  }
  .g-flyer .flyer {
    max-width: 22rem;
  }
  .g-post {
    grid-column: span 2;
  }
  .g-gift {
    grid-column: span 1;
  }
  @media (max-width: 47.99em) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .g-site,
    .g-card,
    .g-flyer {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .g-post,
    .g-gift {
      grid-column: span 1;
    }
  }
  @media (max-width: 29.99em) {
    .g-post,
    .g-gift {
      grid-column: 1 / -1;
    }
    .card-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
