---
/**
 * Northline Plumbing — fictional trades concept. Coded artwork; every name and enquiry is made up.
 */
interface Props {
  variant?: 'thumb' | 'full';
}
const { variant = 'thumb' } = Astro.props;

const leads = [
  { at: 'Mon 7:12', who: 'Dana R.', area: 'M1P', problem: 'Kitchen sink leak', urgency: 'Urgent', status: 'Replied' },
  { at: 'Mon 9:40', who: 'Omar K.', area: 'M2J', problem: 'Water heater check', urgency: 'This week', status: 'Booked' },
  { at: 'Mon 21:05', who: 'Lee W.', area: 'M3A', problem: 'Slow shower drain', urgency: 'Flexible', status: 'New' },
  { at: 'Sun 16:30', who: 'Ana P.', area: 'M1W', problem: 'Outdoor tap', urgency: 'Flexible', status: 'Done' },
];
---

<div class:list={['northline', variant]}>
  {
    variant === 'thumb' ? (
      <div class="thumb-stage" aria-hidden="true">
        <div class="piece phone">
          <div class="phone-in">
            <div class="n-hero">
              <p class="n-brand">Northline Plumbing</p>
              <p class="n-head">Leak? Clog? No hot water?</p>
              <span class="n-btn">Request a visit</span>
            </div>
            <p class="n-mono dark">Replies by 8 a.m. next working day</p>
          </div>
        </div>
        <div class="piece mail">
          <div class="mail-in">
            <p class="n-mono">To: Dana R. · 7:12 a.m.</p>
            <p class="n-subj">Got your request. Here’s what happens next</p>
            <p>This is a request, not a booked visit. I’ll reply by 8 a.m.</p>
          </div>
        </div>
        <div class="piece sheet-mini">
          <div class="sheet-in">
            {leads.slice(0, 3).map((l) => (
              <p class="row">
                <span>{l.who}</span>
                <span class:list={['st', l.status.toLowerCase()]}>{l.status}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class="gallery">
        <figure class="g-phone">
          <div class="piece phone" aria-hidden="true">
            <div class="phone-in">
              <div class="n-hero">
                <p class="n-brand">Northline Plumbing</p>
                <p class="n-head">Leak? Clog? No hot water?</p>
                <p class="n-sub">Two vans serving the GTA. Licensed, insured, tidy.</p>
                <span class="n-btn">Request a visit</span>
              </div>
              <p class="n-mono dark">Replies by 8 a.m. next working day</p>
              <div class="n-form">
                <p class="n-label">What’s the problem?</p>
                <p class="n-input">Kitchen sink leaking under the cabinet</p>
                <p class="n-label">Postal code</p>
                <p class="n-input">M1P</p>
                <p class="n-label">How urgent?</p>
                <p class="n-chips">
                  <span class="on">Urgent</span>
                  <span>This week</span>
                  <span>Flexible</span>
                </p>
              </div>
            </div>
          </div>
          <figcaption>
            Mobile-first "Request a visit" page. It asks only what the plumber needs to reply.
          </figcaption>
        </figure>

        <figure class="g-mail">
          <div class="piece mail" aria-hidden="true">
            <div class="mail-in">
              <p class="n-mono">From: Northline Plumbing · To: Dana R.</p>
              <p class="n-subj">Got your request. Here’s what happens next</p>
              <p>Hi Dana, thanks for telling me about the kitchen sink leak.</p>
              <p>
                This is a <strong>request, not a booked visit</strong>. I reply to every request by 8 a.m. the next
                working day, and sooner for urgent leaks. If water is spreading, turn off the valve under the sink.
              </p>
              <p>— Sam, Northline Plumbing</p>
            </div>
          </div>
          <figcaption>Acknowledgement email, sent instantly. It promises only the real reply routine.</figcaption>
        </figure>

        <figure class="g-sheet">
          <div class="piece sheet" aria-hidden="true">
            <div class="sheet-in">
              <p class="row head">
                <span>Received</span>
                <span>Name</span>
                <span>Area</span>
                <span>Problem</span>
                <span>Urgency</span>
                <span>Status</span>
              </p>
              {leads.map((l) => (
                <p class="row">
                  <span>{l.at}</span>
                  <span>{l.who}</span>
                  <span>{l.area}</span>
                  <span>{l.problem}</span>
                  <span>{l.urgency}</span>
                  <span class:list={['st', l.status.toLowerCase()]}>{l.status}</span>
                </p>
              ))}
            </div>
          </div>
          <figcaption>
            Lead list (a shared spreadsheet is enough to start). Requests still "New" the next morning trigger a
            reminder.
          </figcaption>
        </figure>

        <figure class="g-gbp">
          <div class="piece gbp" aria-hidden="true">
            <div class="gbp-in">
              <p class="n-mono">Business Profile checklist</p>
              <ul>
                <li>Real business name, no keywords added</li>
                <li>Service-area business: home address hidden</li>
                <li>Service areas listed by neighbourhood</li>
                <li>Hours match what the phone is answered</li>
                <li>Photos of real vans and real jobs</li>
              </ul>
            </div>
          </div>
          <figcaption>Business Profile set up as a service-area business, following Google’s guidelines.</figcaption>
        </figure>
      </div>
    )
  }
</div>

<style>
  .northline {
    --n-teal: #0e4d5c;
    --n-teal-2: #0a3a46;
    --n-yellow: #f2c230;
    --n-paper: #f5f7f6;
    --n-ink: #102126;
  }
  .piece {
    container-type: inline-size;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: var(--n-paper);
    color: var(--n-ink);
  }
  .n-brand {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.75em;
  }
  .n-head {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6em;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .n-sub {
    font-size: 0.75em;
    opacity: 0.85;
  }
  .n-btn {
    display: inline-block;
    justify-self: start;
    background: var(--n-yellow);
    color: var(--n-ink);
    font-weight: 800;
    padding: 0.5em 0.9em;
    border-radius: 0.4em;
    font-size: 0.8em;
  }
  .n-mono {
    font-family: var(--font-mono);
    font-size: 0.6em;
    letter-spacing: 0.04em;
  }

  /* Phone */
  .phone {
    aspect-ratio: 9 / 17;
    border: 0.5em solid var(--n-ink);
    border-radius: 1.6em;
  }
  .phone-in {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.6em;
    padding-bottom: 1em;
    background: var(--n-paper);
    font-size: 7.4cqi;
  }
  .n-hero {
    display: grid;
    gap: 0.55em;
    padding: 1.1em 1em 1.2em;
    background: var(--n-teal);
    color: #fff;
  }
  .phone-in > .n-mono,
  .phone-in > .n-form {
    margin-inline: 1em;
  }
  .n-mono.dark {
    color: var(--n-ink);
  }
  .n-form {
    margin-top: 0.2em;
    background: #fff;
    color: var(--n-ink);
    border-radius: 0.5em;
    padding: 0.8em;
    display: grid;
    gap: 0.3em;
    font-size: 0.75em;
    box-shadow: 0 0.3em 1em -0.5em rgb(0 0 0 / 0.35);
  }
  .n-label {
    font-weight: 700;
  }
  .n-input {
    border: 1px solid #9aa7aa;
    border-radius: 0.3em;
    padding: 0.25em 0.45em;
    font-size: 0.9em;
  }
  .n-chips {
    display: flex;
    gap: 0.3em;
    flex-wrap: wrap;
  }
  .n-chips span {
    border: 1px solid var(--n-teal);
    border-radius: 99px;
    padding: 0.1em 0.6em;
    font-size: 0.85em;
  }
  .n-chips .on {
    background: var(--n-teal);
    color: #fff;
  }

  /* Mail */
  .mail-in {
    display: grid;
    gap: 0.7em;
    padding: 1.4em;
    font-size: 4.2cqi;
    line-height: 1.45;
    background: #fff;
  }
  .n-subj {
    font-weight: 800;
    font-size: 1.15em;
    line-height: 1.2;
  }

  /* Sheet */
  .sheet-in {
    font-size: 2.3cqi;
    background: #fff;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr 0.6fr 1.6fr 1fr 0.9fr;
    gap: 0.6em;
    padding: 0.55em 1em;
    border-bottom: 1px solid #e3e8e8;
    align-items: center;
  }
  .row.head {
    background: var(--n-teal);
    color: #fff;
    font-weight: 700;
  }
  .st {
    justify-self: start;
    padding: 0.1em 0.6em;
    border-radius: 99px;
    font-weight: 700;
    font-size: 0.9em;
  }
  .st.new {
    background: var(--n-yellow);
  }
  .st.replied {
    background: #d6e8ee;
  }
  .st.booked {
    background: #cfe9d9;
  }
  .st.done {
    background: #e7eaea;
  }

  /* GBP checklist */
  .gbp-in {
    padding: 1.4em;
    font-size: 4.4cqi;
    background: #fff;
    display: grid;
    gap: 0.6em;
  }
  .gbp-in ul {
    padding-left: 1.2em;
    display: grid;
    gap: 0.35em;
  }

  /* Thumb composition */
  .thumb-stage {
    position: relative;
    aspect-ratio: 16 / 11;
    background: #dfe8e7;
    overflow: hidden;
  }
  .thumb-stage .phone {
    position: absolute;
    width: 26%;
    left: 8%;
    top: 7%;
  }
  .thumb-stage .mail {
    position: absolute;
    width: 44%;
    right: 6%;
    top: 12%;
  }
  .thumb-stage .mail-in {
    font-size: 5.6cqi;
  }
  .thumb-stage .sheet-mini {
    position: absolute;
    width: 44%;
    right: 6%;
    bottom: 10%;
  }
  .sheet-mini .sheet-in {
    font-size: 6cqi;
  }
  .sheet-mini .row {
    grid-template-columns: 1fr auto;
  }

  /* Full gallery */
  .gallery {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    align-items: start;
  }
  figure {
    display: grid;
    gap: var(--space-s);
  }
  figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .g-phone {
    grid-row: span 2;
  }
  .g-phone .phone {
    max-width: 19rem;
  }
  .g-sheet {
    grid-column: 1 / -1;
  }
  @media (max-width: 47.99em) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .g-phone {
      grid-row: auto;
    }
    .sheet-in {
      font-size: 3.2cqi;
    }
    .row {
      grid-template-columns: 1fr 1fr 1.6fr 0.9fr;
    }
    .row span:nth-child(3),
    .row span:nth-child(5) {
      display: none;
    }
  }
</style>
