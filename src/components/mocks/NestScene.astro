---
/** Nest & Rest — screenshots of Mann's own live site (31 Oct 2026) plus the archived 19 Oct version. */
import Captures from './Captures.astro';
import desktop from '../../assets/work/nest-and-rest/live-2026-10-31-desktop.png';
import mobile from '../../assets/work/nest-and-rest/live-2026-10-31-mobile.png';
import earlier from '../../assets/work/nest-and-rest/archive-2026-10-19-desktop.png';

interface Props {
  variant?: 'thumb' | 'full';
  eager?: boolean;
}
const { variant = 'thumb', eager = false } = Astro.props;
---

<Captures
  variant={variant}
  eager={eager}
  tint="#e5eef2"
  url="https://nestnrestcleaning.com/"
  desktop={{
    src: desktop,
    alt: 'Nest & Rest Cleaning home page on desktop: “We clean. You rest.” with a postal-code check, a “Request a clean” button and a “Your price, in seconds” estimator.',
    caption: 'Live site on desktop, 1440 px, captured 31 Oct 2026.',
  }}
  mobile={{
    src: mobile,
    alt: 'Nest & Rest Cleaning home page on a phone: an Airbnb turnovers banner, the headline, illustrated Toronto skyline and Scarborough Bluffs, and a fixed “Request a clean” bar.',
    caption: 'Live site on a phone, 360 px, same day.',
  }}
  earlier={{
    src: earlier,
    alt: 'Earlier Nest & Rest home page from 19 October 2026 with a navy headline and a price estimator card.',
    caption: 'Earlier version, 19 Oct 2026 (Internet Archive). Two weeks later the site had Airbnb turnovers, a room-by-room checklist, gift cards and neighbourhood pages.',
  }}
/>
