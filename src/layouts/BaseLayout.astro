---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickMenu from '../components/QuickMenu.astro';
import Analytics from '../components/Analytics.astro';
import { profile } from '../data/site';
import { absoluteUrl, indexing } from '../lib/mode';

interface Props {
  title: string;
  description: string;
  /** Full title override (the home page and About put the name first or inside the title). */
  fullTitle?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Describes the sharing image (it changes per case study). */
  ogAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Show the closing call to action in the footer (off on the contact page). */
  footerCta?: boolean;
}

const {
  title,
  description,
  fullTitle,
  noindex = false,
  ogImage = '/og/default.png',
  ogAlt = 'Mann Patel: web design and local SEO for Toronto service businesses. Found, answered, booked.',
  jsonLd,
  footerCta = true,
} = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${profile.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImageUrl = absoluteUrl(ogImage) ?? ogImage;
const robots = indexing && !noindex ? 'index, follow' : 'noindex, nofollow';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/geist-sans-wght.sub.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_CA" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Presenter mode (src/scripts/present.ts): ?present=1 turns it on for this tab, ?present=0 off.
        try {
          var q = new URLSearchParams(location.search).get('present');
          if (q === '1') sessionStorage.setItem('present', '1');
          if (q === '0') sessionStorage.removeItem('present');
          if (sessionStorage.getItem('present') === '1') d.setAttribute('data-present', '');
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('js-motion');
          // Failsafe: if the motion script never runs, never leave content hidden.
          setTimeout(function () {
            if (!window.__revealReady) d.classList.remove('js-motion');
          }, 2500);
        }
      })();
    </script>
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer cta={footerCta} />
    <QuickMenu />
    <script>
      import '../scripts/motion';
      import '../scripts/reach';
      import '../scripts/fx/index';
      import '../scripts/present';
    </script>
  </body>
</html>
