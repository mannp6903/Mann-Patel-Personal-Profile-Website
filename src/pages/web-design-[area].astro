---
/**
 * Area pages (SEO audit Phase 3, 14 Nov 2026; plan B2): /web-design-scarborough/ and, once Mann lists its
 * neighbourhoods, /web-design-north-york/ (Nov 2026 audit fixes). Content: src/data/areas.ts.
 *
 * A page is a draft until Mann lists the neighbourhoods he serves (`neighbourhoods: null`): built in previews
 * and `astro dev` with a "To confirm" note, never in production (src/lib/published.ts). It carries the full
 * business node (city-level address only), real local proof and the Google Business Profile link.
 */
import { accentLine } from '../lib/headline';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Crumbs from '../components/Crumbs.astro';
import DraftNote from '../components/DraftNote.astro';
import Confirm from '../components/Confirm.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import { bookingUrl, gbp, profile } from '../data/site';
import { areaIsDraft, areaPath, type Area } from '../data/areas';
import { servicePages } from '../data/service-pages';
import { industryPages } from '../data/industry-pages';
import { packages, priceLabel } from '../data/packages';
import { breadcrumbJsonLd, businessJsonLd } from '../lib/seo';
import { projectSite } from '../lib/work';
import { visibleAreas } from '../lib/published';

export function getStaticPaths() {
  return visibleAreas().map((area) => ({ params: { area: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}
const { area } = Astro.props;
const draft = areaIsDraft(area);
const path = areaPath(area);
// Local proof: the projects in this area, with their honest labels.
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).filter((w) => w.data.location?.includes(area.name));
const lines = area.lines.map((l, i) => (i === area.lines.length - 1 ? accentLine(l) : l));
// "What I found in <area>" (SEO report follow-up, 19 Nov 2026): shown only once Mann fills it in.
const findings = area.localFindings?.points.length ? area.localFindings : null;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: area.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: area.h1, path },
]);
---

<BaseLayout title={area.title} description={area.description} jsonLd={[businessJsonLd(), faqLd, ...(crumbs ? [crumbs] : [])]}>
  <Crumbs items={[{ label: 'Home', href: '/' }, { label: `Web design in ${area.name}` }]} />
  {
    draft && (
      <DraftNote
        note={`It is left out of the live site, the sitemap and every link until ${[
          !area.neighbourhoods?.length && 'the neighbourhoods',
          area.localExample === null && 'a local example',
        ]
          .filter(Boolean)
          .join(' and ')} ${area.localExample === null && !area.neighbourhoods?.length ? 'are' : 'is'} added in src/data/areas.ts.`}
      />
    )
  }

  <PageHead eyebrow={area.eyebrow} lines={lines} lead={area.lead} compact>
    <div class="ar__actions" data-reveal="load" style="--d:5">
      <div class="btn-row">
        <Button href="/contact/#brief">Request a quote</Button>
        <Button href="/contact/?package=check-up#check" variant="ghost">Start with the free check</Button>
        {
          // 16 Nov 2026: a plain link to Mann's booking page, once he adds it (src/data/site.ts → bookingUrl).
          bookingUrl && (
            <Button href={bookingUrl} variant="ghost" icon="arrow-ne" target="_blank" rel="noopener" aria-label="Book a free 15-minute call (opens in a new tab)" data-booking>
              Book a free 15-minute call
            </Button>
          )
        }
      </div>
      <a class="link-arrow small" href={gbp.url} rel="noopener">
        {profile.name} on Google Maps <Icon name="arrow-ne" />
      </a>
    </div>
  </PageHead>

  {
    // Local work (16 Nov 2026): shown when there is a project in this area or a local example (or, in previews, the
    // "To confirm" note while a needed example is missing), so a published page never shows an empty list.
    (work.length > 0 || area.localExample !== undefined) && (
      <section class="section section--rule" aria-labelledby="ar-work-title">
        <div class="container stack" style="--stack: var(--s-6)">
          <div class="section-head">
            <p class="eyebrow">Local work</p>
            <h2 id="ar-work-title" class="ar__h2">Real work in {area.name}, <span class="accent">clearly labelled.</span></h2>
          </div>
          {work.length > 0 && (
          <ul class="ar__work" role="list">
            {
              work.map((w) => (
                <li>
                  <p class="ar__tags small">
                    <span>{w.data.relationship}</span>
                    <span>{projectSite(w.data).websiteStatus}</span>
                    {w.data.businessStatus && <span>{w.data.businessStatus}</span>}
                  </p>
                  <h3>
                    <a href={`/work/${w.id}/`}>{w.data.title}</a>
                  </h3>
                  <p class="muted">
                    {w.data.industry} · {w.data.location}
                  </p>
                  <p class="small">{w.data.result}</p>
                  <a class="link-arrow" href={`/work/${w.id}/`}>
                    Case study<span class="visually-hidden">: {w.data.title}</span> <Icon name="arrow" />
                  </a>
                </li>
              ))
            }
          </ul>
          )}
          {area.localExample && <p class="ar__example" data-local-example>{area.localExample}</p>}
          {
            area.localExample === null && (
              <p>
                <Confirm note={`a real ${area.name} example, in Mann’s words (src/data/areas.ts → localExample)`} />
              </p>
            )
          }
        </div>
      </section>
    )
  }

  {
    // What I found here (19 Nov 2026): Mann's own local checks, only once he fills them in (src/data/areas.ts).
    findings && (
      <section class="section section--rule" data-local-findings aria-labelledby="ar-found-title">
        <div class="container sp-found">
          <div class="stack" style="--stack: var(--s-4)">
            <p class="eyebrow">Local findings</p>
            <h2 id="ar-found-title" class="ar__h2">
              What I found <span class="accent">in {area.name}.</span>
            </h2>
            <p class="muted small">{findings.how}</p>
          </div>
          <ul class="ar__found" role="list">
            {findings.points.map((point) => (
              <li>
                <Icon name="check" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* Real client reviews only (src/data/reviews.ts); renders nothing until there are some. */}
  <ReviewsStrip />

  <section class="section section--alt" data-neighbourhoods aria-labelledby="ar-areas-title">
    <div class="container ar__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">Where I work</p>
        <h2 id="ar-areas-title" class="ar__h2">Neighbourhoods <span class="accent">I serve.</span></h2>
      </div>
      <div class="stack" style="--stack: var(--s-4)">
        {
          area.neighbourhoods?.length ? (
            <>
              <p class="muted">{area.neighbourhoodsLead ?? `Every neighbourhood in ${area.name}, including:`}</p>
              <ul class="ar__hoods" role="list">
                {area.neighbourhoods.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </>
          ) : (
            <p>
              <Confirm note={`the ${area.name} neighbourhoods Mann serves (src/data/areas.ts)`} />
            </p>
          )
        }
        <p class="muted">Based in {profile.location}, working across {profile.serviceArea}.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ar-services-title">
    <div class="container stack" style="--stack: var(--s-6)">
      <div class="section-head">
        <p class="eyebrow">What I do</p>
        <h2 id="ar-services-title" class="ar__h2">Found, answered, <span class="accent">booked.</span></h2>
        <p class="muted">
          Published prices:{' '}
          {packages.map((p, i) => (
            <>
              {i > 0 && (i === packages.length - 1 ? ' and ' : ', ')}
              {p.name} <b class="num">{priceLabel(p).text}</b>
            </>
          ))}
          , in Canadian dollars plus tax.
        </p>
      </div>
      <ul class="ar__more" role="list">
        {
          servicePages.map((s) => (
            <li>
              <a class="ar__more-link" href={`/services/${s.slug}/`}>
                <span>{s.short}</span>
                <span class="muted small">{s.card}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        {
          industryPages.map((p) => (
            <li>
              <a class="ar__more-link" href={`/${p.slug}/`}>
                <span>{p.linkLabel}</span>
                <span class="muted small">{p.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="ar__more-link" href="/pricing/">
            <span>Pricing</span>
            <span class="muted small">Every package side by side, and what each leaves out</span>
            <Icon name="arrow" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="ar-faq-title">
    <div class="container ar__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">Questions</p>
        <h2 id="ar-faq-title" class="ar__h2">Asked <span class="accent">locally.</span></h2>
      </div>
      <div>
        {
          area.faqs.map((f) => (
            <details class="acc" name="ar-faq">
              <summary>
                <h3 class="acc__q">{f.q}</h3>
                <span class="acc__plus" aria-hidden="true" />
              </summary>
              <div class="acc__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FreeCheck id="check" />
</BaseLayout>

<style>
  .ar__actions {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    margin-top: var(--s-2);
  }
  .ar__h2 {
    font-size: var(--fs-h2);
    max-width: 20ch;
  }
  .ar__split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .ar__split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    /* The head stays beside its content instead of leaving an empty column (gate L1, re-audit 18 Nov 2026; as on Home,
       task 3.4). */
    .ar__split > :first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
  .ar__work {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 56em) {
    .ar__work {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ar__work li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: clamp(var(--s-4), 2.5vw, var(--s-6));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .ar__work h3 {
    font-size: var(--fs-h3);
  }
  .ar__work h3 a {
    text-decoration: none;
  }
  .ar__work h3 a:hover,
  .ar__work h3 a:focus-visible {
    text-decoration: underline;
  }
  .ar__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .ar__tags span {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-2);
  }
  .ar__example {
    max-width: 60ch;
    color: var(--text-2);
  }
  .sp-found {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .sp-found {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
  }
  .ar__found {
    display: grid;
    gap: var(--s-3);
  }
  .ar__found li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .ar__found li > span {
    max-width: var(--measure);
  }
  .ar__found :global(.icon) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2em;
    color: var(--signal);
  }
  .ar__hoods {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .ar__hoods li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
  }
  .ar__more {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .ar__more li {
    border-bottom: 1px solid var(--line);
  }
  .ar__more-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem var(--s-4);
    padding-block: var(--s-4);
    text-decoration: none;
  }
  .ar__more-link > span:first-child {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: -0.02em;
  }
  .ar__more-link > .small {
    grid-column: 1;
  }
  .ar__more-link :global(.icon) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--signal);
    transition: transform var(--dur-1) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ar__more-link:hover :global(.icon),
    .ar__more-link:focus-visible :global(.icon) {
      transform: translateX(4px);
    }
  }
</style>
