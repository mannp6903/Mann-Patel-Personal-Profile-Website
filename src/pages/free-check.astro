---
/**
 * /free-check/ · Campaign landing page for the launch posts (Instagram, Facebook, LinkedIn).
 *
 * One goal: the free website and Google check. The copy matches the posts that link here: the reel's
 * "10:42" missed-call story and its closing line ("Don't miss the next call"), and the receipt post's
 * published prices. Every price and check comes from src/data/packages.ts.
 *
 * noindex and left out of the sitemap on purpose: the free check already lives on / and /contact/ for
 * search, and this page is only reached from campaign links (tag them with UTMs; GA4 records them).
 * scripts/prelaunch-check.mjs allows it as an unlisted, unlinked campaign page.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import CheckForm from '../components/CheckForm.astro';
import { checkUp, packageById, priceLabel } from '../data/packages';
import { profile } from '../data/site';

const title = 'Free Website & Google Check';
const description =
  'A free website and Google check for Toronto small businesses: I look you up the way a customer would and send a short list of fixes. No obligation.';

// The receipt: the paid packages in the order a small business usually meets them.
const lines: { id: Parameters<typeof packageById>[0]; note: string }[] = [
  { id: 'website-launch', note: 'Up to 5 pages, one enquiry path, tested' },
  { id: 'website-enquiry', note: 'Plus online booking and one follow-up' },
  { id: 'local-visibility', note: 'Google profile, listings, review routine' },
  { id: 'care', note: 'A monthly test enquiry and small edits' },
  { id: 'website-fix', note: 'One defined problem, fixed and tested' },
];
const receipt = lines.map(({ id, note }) => {
  const p = packageById(id)!;
  return { name: p.name, note, price: priceLabel(p).text };
});
const enquiry = packageById('website-enquiry')!;

const checkIcons = ['search', 'chat', 'phone', 'check'] as const;
const email = profile.contact.email;

const faq = [
  {
    q: 'Is the check really free?',
    a: `Yes. ${checkUp.forWho.replace(/^.*?\.\s*/, '')} If you want the fixes done, I quote them separately, in writing.`,
  },
  {
    q: 'What do you need from me?',
    a: `${checkUp.youProvide.map((s, i) => (i ? s.charAt(0).toLowerCase() + s.slice(1) : s)).join(', and ')}.`,
  },
  { q: 'I don’t have a website yet. Can I still ask?', a: 'Yes. Leave the website blank and give your business name; I’ll check your Google and Maps listing by name.' },
  { q: 'What happens after I send it?', a: `${checkUp.timeline} You get ${checkUp.boundary.charAt(0).toLowerCase()}${checkUp.boundary.slice(1)}` },
  { q: 'Who is it for?', a: checkUp.forWho.split('. ')[0] + '.' },
];
---

<BaseLayout title={title} fullTitle={`${title} | ${profile.name}`} description={description} noindex footerCta={false}>
  <!-- 1 · Hero: the reel's closing line, and its 10:42 story as a labelled example -->
  <header class="lp-hero">
    <div class="container lp-hero__grid">
      <div class="lp-hero__copy">
        <p class="eyebrow">Free website &amp; Google check · Toronto &amp; GTA</p>
        <Heading as="h1" lines={['Don’t miss', '<span class="accent">the next call.</span>']} class="lp-hero__title" load />
        <p class="lead lp-hero__lead" data-reveal="load" style="--d:4">
          I look your business up the way a customer would, test what happens when someone calls or writes, and send you a
          short list of fixes, most important first.
        </p>
        <div class="btn-row" data-reveal="load" style="--d:5">
          <Button href="#check">Get my free check</Button>
          <Button href="#what" variant="ghost" icon="arrow-down">What I check</Button>
        </div>
        <p class="lp-hero__meta num" data-reveal="load" style="--d:7">Free · No obligation · About a minute</p>
      </div>

      <figure class="mc" aria-labelledby="mc-cap" data-reveal="load-media" style="--d:4">
        <figcaption class="mc__cap" id="mc-cap">
          <span class="mc__tag num">Example · Missed-call text-back</span>
          <span class="mc__title">The same call, answered</span>
        </figcaption>
        <ol class="mc__list" role="list">
          <li class="mc__row" style="--n:0">
            <span class="mc__time num">10:42</span>
            <div class="mc__item mc__item--missed">
              <span class="mc__icon"><Icon name="phone" /></span>
              <span><b>Missed call</b> · New customer<br /><span class="subtle">You were on a job.</span></span>
            </div>
          </li>
          <li class="mc__row" style="--n:1">
            <span class="mc__time num">10:42</span>
            <div class="mc__bubble mc__bubble--out">
              Sorry we missed you! We’re with a client. Book a time here:
              <span class="mc__link">Book online <Icon name="arrow" /></span>
              <span class="mc__meta num">Automatic text</span>
            </div>
          </li>
          <li class="mc__row" style="--n:2">
            <span class="mc__time num">10:43</span>
            <div class="mc__bubble mc__bubble--in">Perfect, booking now.</div>
          </li>
          <li class="mc__row" style="--n:3">
            <span class="mc__time num">10:46</span>
            <div class="mc__item mc__item--booked">
              <span class="mc__icon"><Icon name="calendar" /></span>
              <span><b>Booked</b> · Thu, 10:30 AM<br /><span class="subtle">Confirmation and reminder sent.</span></span>
            </div>
          </li>
        </ol>
        <p class="mc__note small subtle">
          One follow-up workflow, part of {enquiry.name} ({priceLabel(enquiry).text}). How fast a customer books depends on
          them and your booking tool; nothing here is a promise of bookings.
        </p>
      </figure>
    </div>
  </header>

  <!-- 2 · What the check covers -->
  <section class="section section--rule lp-what" id="what" aria-labelledby="what-title">
    <div class="container lp-what__grid">
      <div>
        <p class="eyebrow">What I check</p>
        <Heading id="what-title" lines={['Four checks.', '<span class="accent">One short list of fixes.</span>']} class="lp-h2" />
      </div>
      <ol class="lp-checks" role="list">
        {
          checkUp.includes.map((item, i) => (
            <li>
              <span class="lp-checks__icon">
                <Icon name={checkIcons[i] ?? 'check'} />
              </span>
              <span class="lp-checks__n num">{String(i + 1).padStart(2, '0')}</span>
              <span class="lp-checks__text">{item}</span>
            </li>
          ))
        }
      </ol>
      <p class="small subtle lp-what__note">Not included: {checkUp.notIncluded.join('; ')}.</p>
    </div>
  </section>

  <!-- 3 · The form (the page's one goal) -->
  <section class="section lp-form" id="check" aria-labelledby="check-title" tabindex="-1">
    <div class="container lp-form__grid">
      <div class="lp-form__main">
        <p class="eyebrow">Free · No obligation</p>
        <h2 id="check-title" class="lp-form__title">Request your free check</h2>
        <p class="muted lp-form__lead">Your website, or your business name if you don’t have one yet. That’s all I need to start.</p>
        <CheckForm />
      </div>
      <aside class="lp-me" aria-label="Who does the check">
        {
          profile.portrait && (
            <Picture
              class="lp-me__photo"
              src={profile.portrait.src}
              alt={profile.portrait.alt}
              formats={['avif']}
              fallbackFormat="webp"
              data-src-w={profile.portrait.src.width}
              widths={[96, 192, 288]}
              sizes="96px"
              loading="lazy"
            />
          )
        }
        <p class="lp-me__name">{profile.name}</p>
        <p class="muted lp-me__role">Web designer in {profile.location}, working across {profile.serviceArea}.</p>
        <p class="lp-me__quote">I read every request myself and reply by email.</p>
        <ul class="lp-me__rules" role="list">
          <li><Icon name="check" /> Published prices</li>
          <li><Icon name="check" /> Written scope first</li>
          <li><Icon name="check" /> Every login in your name</li>
        </ul>
        {
          email && (
            <p class="small lp-me__mail">
              Rather email? <a class="link" href={`mailto:${email}`} data-contact="email">{email}</a>
            </p>
          )
        }
      </aside>
    </div>
  </section>

  <!-- 4 · Published prices, as the receipt post shows them -->
  <section class="section section--rule lp-prices" aria-labelledby="prices-title">
    <div class="container lp-prices__grid">
      <div>
        <p class="eyebrow">If you want the fixes done</p>
        <Heading id="prices-title" lines={['Every price,', '<span class="accent">on one receipt.</span>']} class="lp-h2" />
        <p class="muted lp-prices__lead">
          The check is free either way. If you’d like me to do the fixes, these are the published prices, with a written scope
          before any work starts.
        </p>
        <a class="link-arrow" href="/pricing/">See every package in full <Icon name="arrow" /></a>
      </div>
      <div class="rc">
        <div class="rc__paper">
          <p class="rc__head num"><span>Mann Patel</span><span>Price list</span></p>
          <ul class="rc__list" role="list">
            {
              receipt.map((r) => (
                <li class="rc__row">
                  <span class="rc__name">{r.name}</span>
                  <span class="rc__price num">{r.price}</span>
                  <span class="rc__note">{r.note}</span>
                </li>
              ))
            }
          </ul>
          <ul class="rc__list rc__list--zero" role="list">
            <li class="rc__row"><span class="rc__name">Hidden fees</span><span class="rc__price num">$0</span></li>
            <li class="rc__row rc__row--free">
              <span class="rc__name">Free website &amp; Google check</span><span class="rc__price num">Free</span>
            </li>
          </ul>
          <p class="rc__foot num">CAD, plus applicable tax · Every login in your name</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Questions -->
  <section class="section section--rule lp-faq" aria-labelledby="faq-title">
    <div class="container lp-faq__grid">
      <Heading id="faq-title" lines={['Before you send it']} class="lp-h2" />
      <div class="lp-faq__list">
        {
          faq.map((f) => (
            <details class="lp-faq__item">
              <summary>
                {f.q}
                <Icon name="plus" />
              </summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6 · Close -->
  <section class="section lp-close" aria-labelledby="close-title">
    <div class="container lp-close__inner">
      <Heading id="close-title" lines={['Your free check', '<span class="accent">takes about a minute.</span>']} class="lp-close__title" />
      <div class="btn-row">
        <Button href="#check">Get my free check</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .lp-hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--s-7), 7vw, var(--s-10)) clamp(var(--s-7), 6vw, var(--s-9));
  }
  .lp-hero__grid {
    display: grid;
    gap: clamp(var(--s-7), 6vw, var(--s-9));
    align-items: center;
  }
  @media (min-width: 64em) {
    .lp-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .lp-hero__copy {
    display: grid;
    /* Eyebrow → title → intro on the head-gap tokens, as PageHead (gate L4, re-audit 18 Nov 2026; was 24px). */
    gap: var(--head-gap-2);
    justify-items: start;
  }
  .lp-hero__copy > .eyebrow {
    margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2));
  }
  .lp-hero__copy :global(.lp-hero__title) {
    /* Two lines at every width: "Don’t miss / the next call." */
    font-size: var(--fs-hero);
    line-height: 0.92;
    letter-spacing: var(--track-hero);
  }
  .lp-hero__lead {
    max-width: 40ch;
  }
  .lp-hero__meta {
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* The 10:42 example */
  .mc {
    margin: 0;
    padding: clamp(var(--s-5), 3vw, var(--s-6));
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
    display: grid;
    gap: var(--s-5);
  }
  .mc__cap {
    display: grid;
    gap: var(--s-1);
  }
  .mc__tag {
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .mc__title {
    font-size: var(--fs-h3);
    font-weight: var(--w-ui);
    letter-spacing: -0.025em;
  }
  .mc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }
  .mc__row {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: var(--s-4);
    align-items: start;
  }
  .mc__time {
    padding-top: 0.55rem;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .mc__item {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--bg-2);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .mc__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--surface-2);
  }
  .mc__item--missed .mc__icon {
    background: var(--error-wash);
    color: var(--error);
  }
  .mc__item--booked .mc__icon {
    background: var(--text);
    color: var(--ink);
  }
  .mc__bubble {
    max-width: 30ch;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .mc__bubble--out {
    justify-self: end;
    background: var(--paper);
    color: var(--ink);
    border-bottom-right-radius: 4px;
  }
  .mc__bubble--in {
    justify-self: start;
    background: var(--surface-2);
    border-bottom-left-radius: 4px;
  }
  .mc__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    margin-top: var(--s-2);
    padding: 0.25rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-weight: var(--w-head);
  }
  .mc__meta {
    display: block;
    margin-top: var(--s-2);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    opacity: 0.6;
  }
  .mc__note {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  /* Steps arrive one after another (CSS only; the list is complete without motion), and finish within the
     site's entrance budget (about 1.2 s), like every other first-screen reveal. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mc__row {
      animation: lp-step var(--dur-4) var(--ease-out) both;
      animation-delay: calc(var(--dur-2) + var(--n) * var(--stagger) * 2.5);
    }
  }
  @keyframes lp-step {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* ── Shared section headings ── */
  :global(.lp-h2) {
    font-size: var(--fs-h2);
    line-height: 1;
    max-width: 16ch;
  }
  /* Section heads: eyebrow → heading → intro on the head-gap tokens (gate L4, re-audit 18 Nov 2026; the heading had
     its own 16px margin on top of each head's gap). */
  .lp-what__grid > div:first-child {
    display: grid;
    gap: var(--head-gap-2);
    justify-items: start;
  }
  .lp-what__grid > div:first-child > .eyebrow {
    margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2));
  }

  /* ── What I check ── */
  .lp-what__grid {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 64em) {
    .lp-what__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .lp-what__note {
      grid-column: 2;
    }
  }
  .lp-checks {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .lp-checks li {
    display: grid;
    grid-template-columns: 2.75rem 2.25rem 1fr;
    gap: var(--s-3);
    align-items: center;
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }
  .lp-checks__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }
  .lp-checks__n {
    color: var(--text-3);
    font-size: var(--fs-sm);
  }
  .lp-checks__text {
    font-size: var(--fs-lead);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* ── The form ── */
  .lp-form {
    scroll-margin-top: calc(var(--header-h) + var(--s-4));
  }
  .lp-form__grid {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 64em) {
    .lp-form__grid {
      grid-template-columns: 1.4fr 0.6fr;
      align-items: start;
    }
  }
  .lp-form__main {
    display: grid;
    gap: var(--head-gap-2);
  }
  .lp-form__main > .eyebrow {
    margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2));
  }
  .lp-form__title {
    font-size: var(--fs-h2);
    line-height: 1;
  }
  .lp-form__lead {
    max-width: 52ch;
    margin-bottom: var(--s-3);
  }
  .lp-me {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
  }
  .lp-me__photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .lp-me__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: -0.03em;
  }
  .lp-me__role {
    font-size: var(--fs-sm);
  }
  .lp-me__quote {
    padding-block: var(--s-3);
    border-block: 1px solid var(--line);
  }
  .lp-me__rules {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-2);
  }
  .lp-me__rules li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* ── The receipt ── */
  .lp-prices__grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }
  @media (min-width: 64em) {
    .lp-prices__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lp-prices__grid > div:first-child {
    display: grid;
    gap: var(--head-gap-2);
    justify-items: start;
  }
  .lp-prices__grid > div:first-child > .eyebrow {
    margin-bottom: calc(var(--head-gap-1) - var(--head-gap-2));
  }
  .lp-prices__lead {
    max-width: 44ch;
  }
  .rc {
    filter: drop-shadow(var(--shadow-media));
  }
  .rc__paper {
    --z: 18px;
    padding: var(--s-6) var(--s-6) calc(var(--s-6) + var(--z));
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    mask: conic-gradient(from -45deg at bottom, transparent, black 1deg 89deg, transparent 90deg) 50% / var(--z) 100%;
  }
  .rc__head {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--s-4);
    border-bottom: 2px dashed rgb(11 11 12 / 0.4);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-weight: var(--w-head);
  }
  .rc__list {
    list-style: none;
    padding: var(--s-3) 0;
    margin: 0;
    border-bottom: 2px dashed rgb(11 11 12 / 0.4);
  }
  .rc__row {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--s-4);
    padding-block: var(--s-2);
  }
  .rc__name {
    text-transform: uppercase;
    font-weight: var(--w-head);
    letter-spacing: 0.02em;
  }
  .rc__price {
    font-weight: var(--w-head);
    text-align: right;
  }
  .rc__note {
    grid-column: 1 / -1;
    font-size: var(--fs-label);
    color: var(--paper-text-3);
  }
  .rc__list--zero .rc__name {
    font-weight: var(--w-ui);
  }
  .rc__row--free {
    margin: var(--s-2) calc(var(--s-3) * -1) 0;
    padding: var(--s-3);
    border-radius: var(--r-sm);
    background: var(--signal);
  }
  .rc__row--free .rc__name {
    font-weight: var(--w-head);
  }
  .rc__foot {
    padding-top: var(--s-4);
    text-align: center;
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--paper-text-3);
  }

  /* ── Questions ── */
  .lp-faq__grid {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 64em) {
    .lp-faq__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    /* The head stays beside its content instead of leaving an empty column (gate L1, re-audit 18 Nov 2026; as on Home,
       task 3.4). */
    .lp-faq__grid > :global(:first-child) {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
  .lp-faq__list {
    border-top: 1px solid var(--line);
  }
  .lp-faq__item {
    border-bottom: 1px solid var(--line);
  }
