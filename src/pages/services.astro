---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import Finder from '../components/Finder.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import { groups, servicesInGroup, addOns, type ServiceGroup } from '../data/services';
import { packages } from '../data/packages';
import { faqs } from '../data/faqs';
import { servicesJsonLd } from '../lib/seo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs
    .filter((f) => !f.confirm)
    .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const areaGroups: ServiceGroup[] = [...groups, addOns];
const jump = [
  ...areaGroups.map((g) => ({ href: `#${g.id}`, label: g.verb, letter: g.letter })),
  { href: '#packages', label: 'Packages', letter: '' },
  { href: '#check', label: 'Free check', letter: '' },
  { href: '#process', label: 'Process', letter: '' },
  { href: '#faq', label: 'Questions', letter: '' },
];
---

<BaseLayout
  title="Google Business Profile, reviews, missed-call text-back & booking websites"
  description="Get found and chosen on Google, never miss an enquiry, and a website that books work: Google Business Profile, reviews, missed-call text-back, online booking, websites, plus flyers and social content for Toronto and GTA small businesses."
  jsonLd={[faqLd, servicesJsonLd()]}
>
  <PageHead
    eyebrow="Services"
    lines={['Clear deliverables.', 'Plain language.', '<span class="serif serif--signal">Yours to keep.</span>']}
    lead="Three areas that follow your customer’s path: they find you, they contact you, they book. Every service lists what’s included, what I need from you and what isn’t included, and every project gets a written quote."
  />

  <nav class="jump" aria-label="On this page" data-jump>
    <div class="container">
      <ul role="list">
        {
          jump.map((j) => (
            <li>
              <a href={j.href}>
                {j.letter && (
                  <span class="jump__l num" aria-hidden="true">
                    {j.letter}
                  </span>
                )}
                {j.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    areaGroups.map((g) => (
      <section class="area section section--rule" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="container area__grid">
          <div class="area__head">
            <span class="area__letter" aria-hidden="true">
              {g.letter}
            </span>
            <p class="eyebrow">{g.verb}</p>
            <h2 id={`${g.id}-title`} class="area__title" data-split>
              <span class="line-mask">
                <span>{g.title}</span>
              </span>
            </h2>
            <p class="muted">{g.intro}</p>
          </div>
          <div class="area__list">
            {servicesInGroup(g.id).map((s) => (
              <details class="acc svc" id={s.id} data-svc>
                <summary>
                  <span class="svc__sum">
                    <span class="svc__name">{s.name}</span>
                    <span class="svc__one">{s.summary}</span>
                  </span>
                  <span class="acc__plus" aria-hidden="true" />
                </summary>
                <div class="svc__body">
                  <p class="svc__lead">{s.summary}</p>
                  <p class="svc__problem">
                    <span class="svc__k">Sounds familiar?</span> {s.problem}
                  </p>
                  <div class="svc__cols">
                    <div>
                      <h3 class="svc__h">What you get</h3>
                      <ul class="svc__list svc__list--yes" role="list">
                        {s.deliverables.map((d) => (
                          <li>
                            <Icon name="check" />
                            <span>{d}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h3 class="svc__h">What I need from you</h3>
                      <ul class="svc__list" role="list">
                        {s.inputs.map((d) => (
                          <li>
                            <Icon name="arrow" />
                            <span>{d}</span>
                          </li>
                        ))}
                      </ul>
                      <h3 class="svc__h">Not included</h3>
                      <ul class="svc__list svc__list--no" role="list">
                        {s.exclusions.map((d) => (
                          <li>
                            <Icon name="close" />
                            <span>{d}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <p class="svc__handover">
                    <span class="svc__k">At handover</span> {s.handover}
                  </p>
                  {s.terms && (
                    <dl class="svc__terms">
                      {s.terms.map((t) => (
                        <div>
                          <dt>{t.term}</dt>
                          <dd>{t.plain}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <div class="svc__cta">
                    <Button href={`/contact/?service=${s.id}#brief`} size="sm">
                      Ask about this
                    </Button>
                    <span class="small subtle">{s.nextStep}</span>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="pkgs section section--alt" id="packages" aria-labelledby="packages-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" style="--stack: var(--s-5)">
          <p class="eyebrow">Packages</p>
          <Heading id="packages-title" lines={['Common starting points,', '<span class="serif">quoted for you.</span>']} />
        </div>
        <p class="lead" data-reveal>
          Each package is a starting point. After a short brief you get a written scope and a quote for what your business
          actually needs. Third-party fees (domain, email, booking tools) are billed to you by the provider.
        </p>
      </div>
      <ol class="pkgs__grid rail" role="list" data-rail>
        {
          packages.map((p, i) => (
            <li class:list={['pkg', { 'pkg--featured': p.featured }]} id={`pkg-${p.id}`} data-reveal style={`--d:${i * 80}`}>
              <div class="pkg__top">
                <span class="num subtle">{String(i + 1).padStart(2, '0')}</span>
                {p.featured && <span class="pkg__badge">Most complete</span>}
              </div>
              <h3 class="pkg__name">{p.name}</h3>
              <p class="pkg__for muted">{p.forWho}</p>
              <ul class="pkg__list" role="list">
                {p.includes.map((d) => (
                  <li>
                    <Icon name="check" />
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
              <details class="pkg__more">
                <summary>Not included, and what you provide</summary>
                <p class="small">
                  <b>Not included:</b> {p.notIncluded.join('; ')}.
                </p>
                <p class="small">
                  <b>You provide:</b> {p.youProvide.join('; ')}.
                </p>
              </details>
              <div class="pkg__cta">
                <Button href={`/contact/?package=${p.id}#brief`} size="sm" variant={p.featured ? 'primary' : 'ghost'} aria-label={`Request a quote for ${p.name}`}>
                  Request a quote
                </Button>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FreeCheck id="check" />
  <Finder />
  <Process />
  <Faq />
</BaseLayout>

<script>
  // Open the service named in the address (e.g. /services/#booking), now and on later hash changes.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement && el.hasAttribute('data-svc')) {
      el.open = true;
      requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
    }
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);

  // Highlight the section being read in the "On this page" bar.
  const jump = document.querySelector<HTMLElement>('[data-jump]');
  if (jump) {
    const links = [...jump.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            const on = a.hash === `#${e.target.id}`;
            if (on) {
              a.setAttribute('aria-current', 'location');
              // Keep the current item in view inside the bar (scrolls the bar only, never the page).
              const bar = a.closest('ul')!;
              bar.scrollTo({ left: a.offsetLeft - bar.clientWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' });
            } else a.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* ── On this page ── */
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: rgb(11 11 12 / 0.88);
    backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
  }
  .jump ul {
    display: flex;
    gap: var(--s-1);
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: var(--s-2);
  }
  .jump ul::-webkit-scrollbar {
    display: none;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: var(--tap);
    padding-inline: var(--s-4);
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--t-fast), color var(--t-fast);
  }
  .jump a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .jump a[aria-current] {
    background: var(--signal);
    color: var(--on-signal);
  }
  .jump__l {
    font-size: 0.75rem;
    opacity: 0.8;
  }
  :global(html) {
    scroll-padding-top: calc(var(--header-h) + 4.5rem);
  }

  /* ── Areas ── */
  .area__grid {
    display: grid;
    gap: var(--s-7);
  }
  .area__head {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .area__letter {
    font-size: clamp(6rem, 4rem + 9vw, 13rem);
    font-weight: 820;
    font-stretch: 125%;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--signal);
    margin-bottom: var(--s-4);
  }
  .area__title {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    font-weight: 720;
    font-stretch: 112%;
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 14ch;
  }
  .svc > summary {
    align-items: flex-start;
    padding-block: var(--s-5);
  }
  .svc__sum {
    display: grid;
    gap: var(--s-2);
  }
  .svc__name {
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem);
    font-weight: 640;
    letter-spacing: -0.02em;
  }
  .svc__one {
    font-size: var(--fs-sm);
    font-weight: 400;
    font-stretch: 100%;
    color: var(--text-2);
    line-height: 1.5;
    letter-spacing: 0;
    max-width: 60ch;
  }
  .svc > summary:hover .svc__one {
    color: var(--text-2);
  }
  .svc__body {
    display: grid;
    gap: var(--s-5);
    padding-bottom: var(--s-7);
    color: var(--text-2);
  }
  .svc__k {
    display: block;
    margin-bottom: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .svc__problem {
    padding: var(--s-4) var(--s-5);
    border-left: 2px solid var(--signal);
    background: var(--bg-2);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    color: var(--text);
  }
  .svc__cols {
    display: grid;
    gap: var(--s-5);
  }
  .svc__h {
    margin: var(--s-4) 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .svc__cols > div > .svc__h:first-child {
    margin-top: 0;
  }
  .svc__list {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }
  .svc__list li {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
  }
  .svc__list .icon {
    margin-top: 0.12em;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--text-3);
  }
  .svc__list--yes li {
    color: var(--text);
  }
  .svc__list--yes .icon {
    color: var(--signal);
  }
  .svc__list--no .icon {
    color: var(--error);
  }
  .svc__terms {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border: 1px dashed var(--line);
    border-radius: var(--r-md);
    font-size: var(--fs-sm);
  }
  .svc__terms dt {
    color: var(--text);
    font-weight: 620;
  }
  .svc__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }
  @media (min-width: 48em) {
    .svc__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-7);
    }
  }
  @media (min-width: 64em) {
    .area__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    .area__head {
      position: sticky;
      top: calc(var(--header-h) + 6rem);
      align-self: start;
    }
  }

  /* ── Packages ── */
  .pkgs__grid {
    display: grid;
    gap: var(--s-4);
  }
  .pkg {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .pkg--featured {
    border-color: var(--signal);
    box-shadow: 0 0 0 1px var(--signal), 0 0 80px -30px rgb(212 248 74 / 0.35);
  }
  .pkg__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-xs);
  }
  .pkg__badge {
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pkg__name {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: 720;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .pkg__for {
    font-size: var(--fs-sm);
  }
  .pkg__list {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .pkg__list li {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
  }
  .pkg__list .icon {
    margin-top: 0.12em;
    width: 1rem;
    height: 1rem;
    color: var(--signal);
  }
  .pkg__more {
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .pkg__more summary {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 560;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--control);
    text-underline-offset: 0.25em;
  }
  .pkg__more p + p {
    margin-top: var(--s-2);
  }
  .pkg__more b {
    color: var(--text);
  }
  .pkg__cta {
    margin-top: auto;
    padding-top: var(--s-3);
  }
  @media (min-width: 48em) {
    .pkgs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 80em) {
    .pkgs__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Phones: one line per service until opened, no giant letters, packages swipe sideways. */
  .svc__lead {
    display: none;
  }
  @media (max-width: 47.99em) {
    .area__letter {
      display: none;
    }
    .area__head {
      gap: var(--s-3);
    }
    .area__grid {
      gap: var(--s-5);
    }
    .svc > summary {
      min-height: 3.75rem;
      padding-block: var(--s-3);
      align-items: center;
    }
    .svc__one {
      display: none;
    }
    .svc__lead {
      display: block;
      color: var(--text);
    }
    .svc__name {
      font-size: 1.0625rem;
    }
    .pkg {
      height: 100%;
    }
  }
</style>
