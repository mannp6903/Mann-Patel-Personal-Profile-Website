---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactActions from '../../components/ContactActions.astro';
import Icon from '../../components/ui/Icon.astro';
import { contact, emailHref } from '../../lib/contact';
import { profile } from '../../data/site';

const mail = emailHref();
// Only promise the channels that exist (the phone buttons need PUBLIC_CONTACT_PHONE).
const description = contact.phone
  ? 'Send Mann Patel a short project brief, or reach him directly by email, phone, WhatsApp or text. Helping small businesses in Toronto and the GTA.'
  : 'Send Mann Patel a short project brief, or email him directly. Helping small businesses in Toronto and the GTA get found, answer every enquiry and get booked.';
---

<BaseLayout
  title="Contact"
  description={description}
  footerCta={false}
>
  <PageHead
    eyebrow="Contact"
    lines={['Tell me about', '<span class="serif serif--signal">your business.</span>']}
    lead="Two minutes is enough. I read every brief myself and reply by email with questions or a suggested next step."
  />

  <section class="section contact" aria-label="Project brief and direct contact">
    <div class="container contact__grid">
      <div class="contact__form">
        <ContactForm />
      </div>

      <aside class="contact__aside" id="reach" aria-labelledby="reach-title">
        <div class="aside__card" data-spotlight>
          <h2 id="reach-title" class="aside__title">Prefer to talk?</h2>
          <ContactActions showNumber />
          {
            contact.email && (
              <p class="aside__email">
                <a class="link" href={mail} data-contact="email" data-alt-email>
                  {contact.email}
                </a>
                <button class="copy" type="button" data-copy={contact.email}>
                  <Icon name="copy" />
                  <span>Copy</span>
                </button>
              </p>
            )
          }
          <p class="small subtle">
            Toronto time <time class="num" data-clock>--:--</time>. Based in {profile.location}, working across {profile.serviceArea}.
          </p>
        </div>

        <div class="aside__card" data-spotlight>
          <h2 class="aside__title">What happens next</h2>
          <ol class="aside__steps" role="list">
            <li><span class="num">01</span><span>I read your brief and reply by email, usually with a few questions.</span></li>
            <li><span class="num">02</span><span>If it’s a fit, you get a written scope and quote. If not, I’ll say so.</span></li>
            <li><span class="num">03</span><span>Nothing starts, and nothing is charged, until you agree.</span></li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-top: var(--s-4);
  }
  .contact__grid {
    display: grid;
    gap: var(--s-8);
  }
  .contact__aside {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .aside__card {
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .aside__title {
    font-size: 1.35rem;
    font-weight: 680;
    letter-spacing: -0.02em;
  }
  .aside__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
    padding: 0 0.9rem;
    border: 1px solid var(--control);
    border-radius: var(--r-pill);
    background: transparent;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .copy:hover {
    background: var(--surface-2);
  }
  .copy:global(.is-copied) {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }
  .copy :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .aside__steps {
    display: grid;
    gap: var(--s-3);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .aside__steps li {
    display: flex;
    gap: var(--s-3);
  }
  .aside__steps .num {
    color: var(--signal);
    font-size: var(--fs-xs);
    padding-top: 0.25em;
  }
  @media (min-width: 64em) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--s-9);
    }
    .contact__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>
