---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ContactForm from '../../components/ContactForm.astro';
import CheckForm from '../../components/CheckForm.astro';
import ContactActions from '../../components/ContactActions.astro';
import Icon from '../../components/ui/Icon.astro';
import { contact, emailHref } from '../../lib/contact';
import { profile } from '../../data/site';

const mail = emailHref();
// Only promise the channels that exist (the phone buttons need a configured number, src/lib/contact.ts).
const description = contact.phone
  ? 'Send Mann Patel a short project brief, or reach him directly by email, phone, WhatsApp or text. Helping small businesses in Toronto and the GTA.'
  : 'Send Mann Patel a short project brief, or email him directly. Helping small businesses in Toronto and the GTA get found, answer every enquiry and get booked.';
---

<BaseLayout
  title="Contact"
  description={description}
  footerCta={false}
>
  <PageHead
    eyebrow="Contact"
    lines={['Tell me about', '<span class="accent accent--signal">your business.</span>']}
    lead="Choose a short project brief or the free check. I read every one myself and reply by email."
  />

  <section class="section contact" aria-label="Project brief, free check and direct contact">
    <div class="container contact__grid">
      <div class="contact__form">
        <!-- Two ways in. Without JavaScript both forms show, one after the other. -->
        <nav class="choose" aria-label="What would you like to send?" data-choose>
          <a class="choose__opt" href="#brief" data-choose-opt="brief" aria-current="true">
            <b>Project brief</b>
            <span>About 2 minutes. For a project, a package or a quote.</span>
          </a>
          <a class="choose__opt" href="#check" data-choose-opt="check">
            <b>Free check</b>
            <span>About 1 minute. Your website or Google listing, checked for free.</span>
          </a>
        </nav>
        <div class="panel" data-panel="brief">
          <ContactForm />
        </div>
        <section class="panel panel--check" id="check" data-panel="check" aria-labelledby="check-title" tabindex="-1">
          <h2 id="check-title" class="panel__title">Free Found &amp; Answered check</h2>
          <p class="muted panel__lead">
            I look you up the way a customer would and send a short written list of fixes, most important first. Tell me
            where to look; that’s all I need.
          </p>
          <CheckForm />
        </section>
      </div>

      <aside class="contact__aside" id="reach" aria-labelledby="reach-title">
        <div class="aside__card" data-spotlight>
          <h2 id="reach-title" class="aside__title">Prefer to talk?</h2>
          <ContactActions showNumber />
          {
            contact.email && (
              <p class="aside__email">
                <a class="link" href={mail} data-contact="email" data-alt-email>
                  {contact.email}
                </a>
                <button class="copy" type="button" data-copy={contact.email}>
                  <Icon name="copy" />
                  <span>Copy</span>
                </button>
              </p>
            )
          }
          <p class="small subtle">
            Toronto time <time class="num" data-clock>--:--</time>. Based in {profile.location}, working across {profile.serviceArea}.
          </p>
        </div>

        <div class="aside__card" data-spotlight>
          <h2 class="aside__title">What happens next</h2>
          <ol class="aside__steps" role="list">
            <li><span class="num">01</span><span>I read your brief and reply by email, usually with a few questions.</span></li>
            <li><span class="num">02</span><span>If it’s a fit, you get a written scope and quote. If not, I’ll say so.</span></li>
            <li><span class="num">03</span><span>Nothing starts, and nothing is charged, until you agree.</span></li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Show one form at a time. ?package=check-up or #check opens the free check.
  const nav = document.querySelector<HTMLElement>('[data-choose]');
  if (nav) {
    const opts = [...nav.querySelectorAll<HTMLAnchorElement>('[data-choose-opt]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (which: string) => {
      panels.forEach((p) => (p.hidden = p.dataset.panel !== which));
      opts.forEach((o) => {
        if (o.dataset.chooseOpt === which) o.setAttribute('aria-current', 'true');
        else o.removeAttribute('aria-current');
      });
    };
    const params = new URLSearchParams(location.search);
    const initial = location.hash === '#check' || params.get('package') === 'check-up' ? 'check' : 'brief';
    show(initial);
    // Arriving at #check or #brief: show the choice above the form, so the other option stays visible.
    if (location.hash === '#check' || location.hash === '#brief') requestAnimationFrame(() => nav.scrollIntoView({ block: 'start' }));
    opts.forEach((o) =>
      o.addEventListener('click', (e) => {
        e.preventDefault();
        const which = o.dataset.chooseOpt!;
        show(which);
        history.replaceState(null, '', `${location.pathname}${location.search}#${which}`);
      }),
    );
  }
</script>

<style>
  .choose {
    display: grid;
    gap: var(--s-2);
    margin-bottom: var(--s-6);
  }
  @media (min-width: 30em) {
    .choose {
      grid-template-columns: 1fr 1fr;
    }
  }
  .choose__opt {
    display: grid;
    gap: 0.15rem;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--control);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: border-color var(--t-fast), background-color var(--t-fast);
  }
  .choose__opt b {
    font-weight: 600;
  }
  .choose__opt span {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.4;
  }
  .choose__opt:hover {
    border-color: var(--text-3);
    background: var(--surface);
  }
  .choose__opt[aria-current='true'] {
    border-color: var(--signal);
    background: var(--signal-wash);
    box-shadow: inset 0 0 0 1px var(--signal);
  }
  .panel + .panel {
    margin-top: var(--s-8);
  }
  :global(.js) .panel + .panel {
    margin-top: 0;
  }
  .panel--check {
    display: grid;
    gap: var(--s-4);
  }
  .panel--check:focus {
    outline: none;
  }
  .panel__title {
    font-size: var(--fs-h3);
  }
  .panel__lead {
    max-width: 56ch;
  }
  .contact {
    padding-top: var(--s-4);
  }
  .contact__grid {
    display: grid;
    gap: var(--s-8);
  }
  .contact__aside {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .aside__card {
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .aside__title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .aside__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap);
    padding: 0 0.9rem;
    border: 1px solid var(--control);
    border-radius: var(--r-pill);
    background: transparent;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .copy:hover {
    background: var(--surface-2);
  }
  .copy:global(.is-copied) {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }
  .copy :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .aside__steps {
    display: grid;
    gap: var(--s-3);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .aside__steps li {
    display: flex;
    gap: var(--s-3);
  }
  .aside__steps .num {
    color: var(--signal);
    font-size: var(--fs-xs);
    padding-top: 0.25em;
  }
  @media (min-width: 64em) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--s-9);
    }
    .contact__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
</style>
