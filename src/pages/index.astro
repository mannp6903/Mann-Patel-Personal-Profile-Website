---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ticket from '../components/Ticket.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import WorkCard from '../components/WorkCard.astro';
import Guide from '../components/Guide.astro';
import WorkflowDemo from '../components/WorkflowDemo.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import Marquee from '../components/Marquee.astro';
import Confirm from '../components/Confirm.astro';
import Logo from '../components/Logo.astro';
import { Image } from 'astro:assets';
import { profile, businesses } from '../data/site';
import { personJsonLd } from '../lib/seo';
import { absoluteUrl } from '../lib/mode';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const real = work.filter((w) => w.data.status !== 'concept');
const concepts = work.filter((w) => w.data.status === 'concept');
const nest = businesses[0];

// Hero headline, split into words for the staggered reveal (reads as plain text without motion).
let wi = 0;
const w = (text: string) => text.split(' ').map((t) => `<span class="w" style="--i:${wi++}">${t}</span>`).join(' ');
const verb = (text: string, href: string, u: number) => `<a class="verb" href="${href}" style="--u:${u}">${w(text)}</a>`;
const heroHtml = [
  w('I help small businesses'),
  ' ',
  verb('look professional', '#overview-content', 0),
  w(','),
  ' ',
  verb('get found', '#overview-visibility', 1),
  w(','),
  ' ',
  w('and'),
  ' ',
  verb('follow up', '#overview-follow-up', 2),
  w('.'),
].join('');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  ...(absoluteUrl('/') ? { url: absoluteUrl('/') } : {}),
  mainEntity: personJsonLd(),
};
---

<BaseLayout
  title="Home"
  fullTitle="Mann Patel · Websites, Google visibility & follow-up for Toronto small businesses"
  description="I help small businesses in Toronto look professional, get found and follow up: websites, Google Search Console and Business Profile support, professional email, enquiry follow-up and social content."
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="label eyebrow">
          {profile.name} · {profile.location}
          {!profile.locationConfirmed && <Confirm note="preferred public location (Toronto, Scarborough or GTA?)" />}
        </p>
        <h1 class="hero-title" set:html={heroHtml} />
        <p class="lead intro">{profile.intro}</p>
        <div class="btn-row">
          <a class="btn" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="#guide">Find your starting point</a>
        </div>
        <p class="cleaning small">
          Looking for home cleaning? <a href={nest.url} rel="noopener">Visit {nest.name}&nbsp;↗</a>
        </p>
      </div>
      <div class="hero-visual">
        {
          profile.portrait && (
            <figure class="portrait-card">
              <Image
                src={profile.portrait.src}
                alt={profile.portrait.alt}
                widths={[320, 480, 640, 860]}
                sizes="(min-width: 64em) 27rem, 78vw"
                width={860}
                height={1032}
                loading="eager"
                fetchpriority="high"
                class="portrait-img"
              />
              <figcaption class="portrait-tag">Mann Patel</figcaption>
            </figure>
          )
        }
        <div class="ticket-slot">
          <Ticket />
        </div>
      </div>
    </div>
  </section>

  <Marquee />

  <!-- ── What I do ────────────────────────────────────── -->
  <section class="section section--tight" aria-labelledby="what-title">
    <div class="container">
      <div class="section-head">
        <p class="label">What I do</p>
        <h2 id="what-title">Three kinds of help, one goal: a business that’s easy to choose.</h2>
        <p class="muted measure">
          Every service has written deliverables, a list of what I need from you, and what isn’t included. <a
            class="link-accent"
            href="/services/">See every service in detail</a
          >.
        </p>
      </div>
      <ServiceOverview />
    </div>
  </section>

  <!-- ── Evidence ─────────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <p class="label">Evidence, not promises</p>
        <h2 id="work-title">Real work, clearly labelled.</h2>
        <p class="muted measure">
          The business I run, a client website I’m building now, and two concept samples. Every card says which is
          which, and no results are invented.
        </p>
      </div>
      <div class="work-grid">
        {real.map((r) => <div class="featured"><WorkCard entry={r} headingLevel="h3" large /></div>)}
        {concepts.map((c) => <WorkCard entry={c} headingLevel="h3" />)}
      </div>
      <p class="more-link"><a class="link-accent" href="/work/">All work and how it’s labelled →</a></p>
    </div>
  </section>

  <!-- ── Guide ────────────────────────────────────────── -->
  <section class="section" id="guide" aria-labelledby="guide-title">
    <div class="container guide-grid">
      <div class="section-head sticky">
        <p class="label">Not sure where to start?</p>
        <h2 id="guide-title">What does your business need?</h2>
        <p class="muted">
          Three quick questions. You’ll get a suggested starting point with the reasons, and you can pass it straight
          into a brief.
        </p>
      </div>
      <Guide />
    </div>
  </section>

  <!-- ── Workflow demo ────────────────────────────────── -->
  <section class="section on-night" id="follow-up" aria-labelledby="demo-title">
    <div class="container">
      <div class="section-head">
        <p class="label">What “follow up” looks like</p>
        <h2 id="demo-title">From enquiry to answer, without anything slipping through.</h2>
        <p class="muted measure">
          This is the kind of simple routine I set up for owners: an honest acknowledgement, one place to see every
          enquiry, and a reminder before anyone is forgotten.
        </p>
      </div>
      <WorkflowDemo />
    </div>
  </section>

  <!-- ── Process ──────────────────────────────────────── -->
  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <p class="label">How a project works</p>
        <h2 id="process-title">Written down, built with you, handed over.</h2>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <!-- ── Founder note ─────────────────────────────────── -->
  <section class="section section--alt" aria-labelledby="founder-title">
    <div class="container founder">
      <div class="stamp-mark" aria-hidden="true" data-reveal><Logo variant="stacked" motion="reveal" /></div>
      <div class="stack" style="--stack: var(--space-m)">
        <p class="label">Why me</p>
        <h2 id="founder-title">I’m building a small business too.</h2>
        <p class="lead">
          I run {nest.name} in {nest.area}, and I still clean every home myself. Setting it up meant doing what my
          clients need: a clear offer, a website people understand on their phone, booking requests, email, and a
          habit of answering every enquiry.
        </p>
        <p class="btn-row">
          <a class="btn btn--secondary" href="/about/">More about me</a>
          <a class="link-accent" href="/work/nest-and-rest-cleaning/">Read the Nest &amp; Rest case study →</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    overflow-x: clip;
    padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) clamp(3rem, 1rem + 6vw, 6rem);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 64em) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
  .hero-copy {
    display: grid;
    gap: var(--space-m);
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: center;
  }
  h1 {
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 15ch;
  }
  .hero-title :global(.verb) {
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 100% 0.12em;
    background-position: 0 92%;
    padding-bottom: 0.02em;
    transition: background-size var(--dur-base) var(--ease-out);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .hero-title :global(.verb:hover) {
    background-size: 100% 0.3em;
  }
  /* Motion: words rise in sequence, then the verb underlines draw left to right. */
  :global(.js-motion) .hero-title :global(.w) {
    display: inline-block;
    animation: word-rise 720ms var(--ease-out) backwards;
    animation-delay: calc(60ms + var(--i) * 55ms);
  }
  :global(.js-motion) .hero-title :global(.verb) {
    animation: underline-draw 620ms cubic-bezier(0.65, 0, 0.35, 1) backwards;
    animation-delay: calc(820ms + var(--u) * 160ms);
  }
  @keyframes word-rise {
    from {
      opacity: 0;
      transform: translateY(0.42em);
    }
  }
  @keyframes underline-draw {
    from {
      background-size: 0% 0.12em;
    }
  }
  .intro {
    max-width: 40ch;
  }
  .cleaning {
    color: var(--ink-2);
  }
  .hero-visual {
    display: grid;
    justify-items: center;
    position: relative;
  }
  .portrait-card {
    position: relative;
    width: min(78%, 27rem);
    justify-self: end;
    margin: 0;
    padding: 0.6rem 0.6rem 2.6rem;
    background: var(--card);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-ticket);
    transform: rotate(1.6deg);
  }
  .portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 8px;
  }
  .portrait-tag {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ticket-slot {
    position: relative;
    z-index: 1;
    width: min(88%, 24rem);
    justify-self: start;
    margin-top: -24%;
  }
  .ticket-slot :global(.ticket) {
    width: 100%;
  }
  @media (min-width: 64em) {
    .ticket-slot {
      margin-top: -34%;
      margin-left: -6%;
    }
  }

  .work-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 48em) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .featured {
    grid-column: 1 / -1;
  }
  .more-link {
    margin-top: var(--space-l);
  }

  .guide-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 64em) {
    .guide-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      align-items: start;
    }
    .sticky {
      position: sticky;
      top: 6rem;
    }
  }

  .founder {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 56em) {
    .founder {
      grid-template-columns: auto 1fr;
      gap: var(--space-2xl);
    }
  }
  .founder .lead {
    max-width: 52ch;
  }
  .stamp-mark :global(.logo) {
    width: 100%;
    height: auto;
  }
  .stamp-mark {
    display: grid;
    place-items: center;
    width: clamp(9rem, 6rem + 10vw, 13rem);
    aspect-ratio: 1;
    padding: 14%;
    border: 6px double var(--accent);
    border-radius: var(--radius-l);
    color: var(--ink);
    transform: rotate(-4deg);
  }
  /* Motion: the stamp lands with a small thud when it scrolls into view. */
  :global(.js-motion) .stamp-mark[data-reveal] {
    transform: rotate(-13deg) scale(1.22);
    transition:
      opacity 260ms var(--ease-out),
      transform 520ms var(--ease-stamp);
  }
  :global(.js-motion) .stamp-mark[data-reveal]:global(.is-revealed) {
    transform: rotate(-4deg);
  }
</style>
