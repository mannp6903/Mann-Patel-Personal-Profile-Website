---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Path from '../components/home/Path.astro';
import WorkStack from '../components/home/WorkStack.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import Finder from '../components/Finder.astro';
import Process from '../components/Process.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import { personJsonLd } from '../lib/seo';
import { absoluteUrl } from '../lib/mode';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  ...(absoluteUrl('/') ? { url: absoluteUrl('/') } : {}),
  mainEntity: personJsonLd(),
};
---

<BaseLayout
  title="Home"
  fullTitle="Mann Patel · Get found, answer every enquiry, get booked · Toronto small businesses"
  description="Mann Patel helps small businesses in Toronto and the GTA get found and chosen on Google, answer every call and message, and turn website visits into bookings. Free Found & Answered check."
  jsonLd={jsonLd}
>
  <Hero />
  <Path />
  <WorkStack />
  <FreeCheck />
  <Finder />
  <Process />
  <AboutTeaser />
  <Faq limit={6} more />
</BaseLayout>
