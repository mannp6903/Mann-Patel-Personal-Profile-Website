---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ServiceSummary from '../components/home/ServiceSummary.astro';
import Walkthrough from '../components/home/Walkthrough.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import { personWithServicesJsonLd, websiteJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Home"
  fullTitle="Mann Patel | Web Design, Local SEO & Automation in Toronto"
  description="Web design, local SEO and automation for Toronto businesses. Serving Toronto and the GTA, with a focus on Scarborough and North York."
  jsonLd={[websiteJsonLd(), personWithServicesJsonLd()]}
>
  <Hero />
  <SelectedWork />
  <Walkthrough />
  <ServiceSummary />
  <FreeCheck />
  <AboutTeaser />
  <Faq limit={4} more />
</BaseLayout>
