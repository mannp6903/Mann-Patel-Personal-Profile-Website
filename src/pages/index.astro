---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import WhatIDo from '../components/home/WhatIDo.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import HowIWork from '../components/home/HowIWork.astro';
import Faq from '../components/Faq.astro';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import { packageById, priceLabel } from '../data/packages';
import { faqs } from '../data/faqs';
import { businessJsonLd, personJsonLd, websiteJsonLd } from '../lib/seo';

// The prices come from src/data/packages.ts.
const launch = packageById('website-launch')!;
const local = packageById('local-visibility')!;
// FAQPage for the questions this page shows (SEO audit Phase 2: they used to be marked up only on /services/).
// 23 Nov 2026 (SEO audit copy deck §2.1): three questions on Home; prices and inclusions are answered on /pricing/.
const HOME_FAQS = 3;
const homeFaqs = faqs.slice(0, HOME_FAQS).filter((f) => !f.confirm); // the same three <Faq limit={HOME_FAQS}> shows
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
// 23 Nov 2026 (SEO audit copy deck §2.1).
const description = `Independent web designer in Scarborough. Websites from ${priceLabel(launch).text} and Google Business Profile setup for ${priceLabel(local).text}, at fixed prices in CAD. Free website and Google check.`;
---

<BaseLayout
  title="Home"
  fullTitle={`Web Designer in Scarborough, Websites from ${priceLabel(launch).text} | Mann Patel`}
  description={description}
  jsonLd={[websiteJsonLd(), businessJsonLd({ withServices: true }), { '@context': 'https://schema.org', ...personJsonLd() }, faqLd]}
>
  <Hero />
  <!-- 23 Nov 2026 (SEO audit copy deck §2.1), in the deck's order: what I do and what it costs, recent work, the free
       check, how a project works, three questions. The "You work with me" table, the A/B/C tiles and five of the eight
       questions are cut. -->
  <WhatIDo />
  <SelectedWork />
  <!-- Real client reviews only (src/data/reviews.ts); renders nothing until there are some. -->
  <ReviewsStrip />
  <FreeCheck />
  <HowIWork />
  <Faq limit={HOME_FAQS} rule />
</BaseLayout>
