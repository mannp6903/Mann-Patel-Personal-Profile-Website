---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ServiceSummary from '../components/home/ServiceSummary.astro';
import Walkthrough from '../components/home/Walkthrough.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import { personWithServicesJsonLd, websiteJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Home"
  fullTitle="Mann Patel | Web Design & Local SEO in Toronto"
  description="I build websites, improve local SEO and connect enquiry follow-up for Toronto service businesses. Start with a free website and Google check."
  jsonLd={[websiteJsonLd(), personWithServicesJsonLd()]}
>
  <Hero />
  <SelectedWork />
  <Walkthrough />
  <ServiceSummary />
  <FreeCheck />
  <AboutTeaser />
  <Faq limit={4} more />
</BaseLayout>
