---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ServiceSummary from '../components/home/ServiceSummary.astro';
import PricingTeaser from '../components/home/PricingTeaser.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import { personWithServicesJsonLd, websiteJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Home"
  fullTitle="Mann Patel | Web Design, Local SEO & AI Automation in Toronto"
  description="Web design, local SEO and AI automation for Toronto businesses. Websites from $1,950 CAD for up to five pages. Serving Toronto and the GTA, with a focus on Scarborough and North York."
  jsonLd={[websiteJsonLd(), personWithServicesJsonLd()]}
>
  <Hero />
  <SelectedWork />
  <ServiceSummary />
  <PricingTeaser />
  <FreeCheck />
  <AboutTeaser />
  <Faq limit={5} more />
</BaseLayout>
