---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Real projects by Mann Patel: the Nest & Rest Cleaning business and website, and Samp Hair & Spa, a salon website in progress in Scarborough."
>
  <section class="section page-head">
    <div class="container head">
      <p class="label">Work</p>
      <h1>Real work, clearly labelled.</h1>
      <p class="lead measure">
        I’m early in offering these services, so this page is clear about what’s what. Every item carries one of these
        labels:
      </p>
      <dl class="legend">
        <div><dt><span class="chip chip--launched">Launched</span></dt><dd>Real and live.</dd></div>
        <div><dt><span class="chip chip--in-progress">In progress</span></dt><dd>Real client work that isn’t finished yet.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="own-title">
    <div class="container">
      <h2 id="own-title" class="sub">Real projects</h2>
      <div class="list">
        {work.map((w) => <WorkCard entry={w} large headingLevel="h3" />)}
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="yours-title">
    <div class="container">
      <h2 id="yours-title" class="sub">Your project could be next</h2>
      <p class="muted measure">
        I only show client work here with the client’s permission. If you want help and are happy to be a case study,
        say so in your brief.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-m);
  }
  .page-head {
    padding-bottom: var(--space-l);
  }
  .legend {
    display: grid;
    gap: var(--space-xs);
  }
  .legend div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-s);
    align-items: center;
  }
  @media (max-width: 30em) {
    .legend div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }
  }
  .legend dd {
    margin: 0;
    color: var(--ink-2);
  }
  .sub {
    font-size: var(--step-2);
    margin-bottom: var(--space-l);
  }
  .list {
    display: grid;
    gap: var(--space-l);
  }
</style>
