---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const real = work.filter((w) => w.data.status !== 'concept');
const concepts = work.filter((w) => w.data.status === 'concept');
---

<BaseLayout
  title="Work"
  description="Nest & Rest Cleaning, Mann Patel’s own home-cleaning business, plus clearly labelled concept samples of websites, branding and enquiry follow-up for small businesses."
>
  <section class="section page-head">
    <div class="container head">
      <p class="label">Work</p>
      <h1>Real work, clearly labelled.</h1>
      <p class="lead measure">
        I’m early in offering these services, so this page is clear about what’s what. Every item carries one of these
        labels:
      </p>
      <dl class="legend">
        <div><dt><span class="chip chip--launched">Launched</span></dt><dd>Real and live.</dd></div>
        <div><dt><span class="chip chip--concept">Concept</span></dt><dd>An original sample for a fictional business. Not a client project.</dd></div>
        <div><dt><span class="chip chip--in-progress">In progress</span></dt><dd>Real client work that isn’t finished yet.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="own-title">
    <div class="container">
      <h2 id="own-title" class="sub">Real projects</h2>
      <div class="list">
        {real.map((w) => <WorkCard entry={w} large headingLevel="h3" />)}
      </div>
    </div>
  </section>

  <section class="section section--tight section--alt" aria-labelledby="concept-title">
    <div class="container">
      <h2 id="concept-title" class="sub">Concept samples</h2>
      <p class="muted measure intro">
        Made to show the kind of launch kit and follow-up workflow I offer. The businesses, people and data are
        fictional.
      </p>
      <div class="grid">
        {concepts.map((w) => <WorkCard entry={w} headingLevel="h3" />)}
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="yours-title">
    <div class="container">
      <h2 id="yours-title" class="sub">Your project could be next</h2>
      <p class="muted measure">
        I only show client work here with the client’s permission. If you want help and are happy to be a case study,
        say so in your brief.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: var(--space-m);
  }
  .page-head {
    padding-bottom: var(--space-l);
  }
  .legend {
    display: grid;
    gap: var(--space-xs);
  }
  .legend div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-s);
    align-items: center;
  }
  @media (max-width: 30em) {
    .legend div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }
  }
  .legend dd {
    margin: 0;
    color: var(--ink-2);
  }
  .sub {
    font-size: var(--step-2);
    margin-bottom: var(--space-l);
  }
  .intro {
    margin-top: calc(var(--space-m) * -1);
    margin-bottom: var(--space-l);
  }
  .list {
    display: grid;
    gap: var(--space-l);
  }
  .grid {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 48em) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
