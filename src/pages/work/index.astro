---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Status from '../../components/work/Status.astro';
import ProjectMedia from '../../components/work/ProjectMedia.astro';
import Icon from '../../components/ui/Icon.astro';
import { breadcrumbJsonLd } from '../../lib/seo';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work/' },
]);
---

<BaseLayout
  title="Work"
  description="Real projects by Mann Patel, clearly labelled: Nest & Rest Cleaning (his own business, built from scratch) and Samp Hair & Spa (a client website in progress)."
  jsonLd={crumbs ?? undefined}
>
  <PageHead
    eyebrow="Work"
    lines={['Real projects.', '<span class="serif serif--signal">Honest labels.</span>']}
    lead="Every project says whether it’s live or in progress and what I actually did. No invented results, no stock photos passed off as real work."
  />

  <section class="section section--tight" aria-label="Projects">
    <div class="container">
      <ol class="rows" role="list">
        {
          work.map((w, i) => (
            <li class="row" data-reveal={i === 0 ? 'load' : ''} style={`--d:${i * 100 + 200}`}>
              <a class="row__link" href={`/work/${w.id}/`} data-spotlight data-cursor="Open">
                <div class="row__text">
                  <div class="row__meta">
                    <span class="num subtle">{String(i + 1).padStart(2, '0')}</span>
                    <Status status={w.data.status} />
                  </div>
                  <h2 class="row__title">{w.data.title}</h2>
                  <p class="subtle small">
                    {w.data.kind} · {w.data.year}
                  </p>
                  <p class="muted">{w.data.summary}</p>
                  <span class="row__cta">
                    Read the case study <Icon name="arrow" />
                  </span>
                </div>
                <ProjectMedia scene={w.data.scene} eager={i === 0} tilt />
              </a>
            </li>
          ))
        }
      </ol>

      <aside class="note" data-reveal>
        <p class="eyebrow eyebrow--plain">What you won’t see here</p>
        <p>
          Made-up results, borrowed client logos, or concept mock-ups dressed up as clients. When there’s more real work to
          show, it goes here with the same labels.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .rows {
    display: grid;
    gap: var(--s-5);
  }
  .row__link {
    display: grid;
    gap: var(--s-6);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: border-color var(--t-base), background-color var(--t-base);
  }
  .row__link:hover {
    border-color: var(--control);
    background: var(--surface-2);
  }
  .row__text {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }
  .row__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-xs);
  }
  .row__title {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.75rem);
    font-weight: 760;
    font-stretch: 112%;
    letter-spacing: -0.05em;
    line-height: 0.95;
    transition: font-stretch 800ms var(--ease-out), color var(--t-base);
  }
  .row__link:hover .row__title {
    font-stretch: 122%;
    color: var(--signal);
  }
  .row__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 620;
    margin-top: var(--s-2);
  }
  .row__cta .icon {
    transition: transform var(--t-base) var(--ease-out);
  }
  .row__link:hover .row__cta .icon {
    transform: translateX(5px);
  }
  .note {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-3);
    max-width: 60ch;
    color: var(--text-2);
  }
  @media (min-width: 64em) {
    .row__link {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--s-8);
    }
  }
</style>
