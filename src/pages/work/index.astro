---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Status from '../../components/work/Status.astro';
import ProjectMedia from '../../components/work/ProjectMedia.astro';
import Icon from '../../components/ui/Icon.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { projectSite } from '../../lib/work';
import { industryPages } from '../../data/industry-pages';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work/' },
]);
---

<BaseLayout
  title="Toronto Small Business Website Projects"
  description="See the Nest & Rest Cleaning website case study and Samp Hair & Spa preview, with dated work, project status and documented checks."
  jsonLd={crumbs ?? undefined}
>
  <PageHead
    eyebrow="Work"
    compact
    lines={['Website projects', '<span class="accent accent--signal">for Toronto service businesses</span>']}
    lead="Real projects, honest labels. Every project says whether it’s live or in progress and what I actually did. No invented results, no stock photos passed off as real work."
  />

  <section class="section section--tight" aria-label="Projects">
    <div class="container">
      <ol class="rows" role="list">
        {
          work.map((w, i) => (
            <li class="row" data-reveal={i === 0 ? 'load' : ''} style={`--d:${i * 100 + 200}`}>
              <a class="row__link" href={`/work/${w.id}/`} data-spotlight data-cursor="Open">
                <div class="row__text">
                  <div class="row__meta">
                    <span class="num subtle">{String(i + 1).padStart(2, '0')}</span>
                    <Status status={w.data.status} paused={projectSite(w.data).paused} />
                  </div>
                  <h2 class="row__title">{w.data.title}</h2>
                  <p class="subtle small">
                    {w.data.kind} · {w.data.year}
                  </p>
                  <p class="muted">{w.data.summary}</p>
                  {(w.data.industry || w.data.location || w.data.result) && (
                    <dl class="row__facts small">
                      {w.data.industry && (
                        <div>
                          <dt>Industry</dt>
                          <dd>{w.data.industry}</dd>
                        </div>
                      )}
                      {w.data.location && (
                        <div>
                          <dt>Location</dt>
                          <dd>{w.data.location}</dd>
                        </div>
                      )}
                      {w.data.result && (
                        <div>
                          <dt>Result</dt>
                          <dd>{w.data.result}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                  <span class="row__cta">
                    Read the case study <Icon name="arrow" />
                  </span>
                </div>
                <ProjectMedia scene={w.data.scene} eager={i === 0} />
              </a>
            </li>
          ))
        }
      </ol>

      <!-- SEO audit Phase 3 (14 Nov 2026): each project leads an industry page. -->
      <p class="trades small">
        <span class="subtle">By trade:</span>{' '}
        {industryPages.map((ip, i) => (
          <>
            {i > 0 && ' · '}
            <a class="link" href={`/${ip.slug}/`}>{ip.linkLabel}</a>
          </>
        ))}
      </p>

      <aside class="note" data-reveal>
        <p class="eyebrow eyebrow--plain">What you won’t see here</p>
        <p>
          Made-up results, borrowed client logos, or concept mock-ups dressed up as clients. When there’s more real work to
          show, it goes here with the same labels.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .rows {
    display: grid;
    gap: var(--s-5);
  }
  .row__link {
    display: grid;
    gap: var(--s-6);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: border-color var(--t-base), background-color var(--t-base);
  }
  .row__link:hover {
    border-color: var(--control);
    background: var(--surface-2);
  }
  .row__text {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }
  .row__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-xs);
  }
  .row__title {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    transition: letter-spacing 800ms var(--ease-out), color var(--t-base);
  }
  .row__link:hover .row__title {
    letter-spacing: -0.025em;
    color: var(--signal);
  }
  /* Industry, location and result (SEO audit Phase 2, 14 Nov 2026). */
  .row__facts {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px dashed var(--line);
  }
  .row__facts div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-3);
  }
  .row__facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 0.15em;
  }
  .row__facts dd {
    color: var(--text-2);
  }
  .row__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 600;
    margin-top: var(--s-2);
  }
  .row__cta .icon {
    transition: transform var(--t-base) var(--ease-out);
  }
  .row__link:hover .row__cta .icon {
    transform: translateX(5px);
  }
  .note {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-3);
    max-width: 60ch;
    color: var(--text-2);
  }
  @media (min-width: 64em) {
    .row__link {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--s-8);
    }
  }
  .trades {
    margin-top: var(--s-6);
  }
</style>
