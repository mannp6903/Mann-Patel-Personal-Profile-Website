---
/**
 * Pricing (published 14 Nov 2026). Every number and boundary comes from src/data/packages.ts.
 * If every price is set back to null (`pricesPublished` false), this page leaves search and the menus.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import PackageCard from '../components/packages/PackageCard.astro';
import PackageCompare from '../components/packages/PackageCompare.astro';
import { packages, checkUp, pricesPublished, packageById, priceLabel } from '../data/packages';
import { breadcrumbJsonLd } from '../lib/seo';

// SEO audit copy (14 Nov 2026, 146 characters). Every number comes from src/data/packages.ts.
const price = (id: string) => priceLabel(packageById(id)!).text;
const care = packageById('care')!;
const description = `Published prices in CAD: 5-page website ${price('website-launch')}, website + booking ${price('website-enquiry')}, fixes ${price('website-fix')}, local SEO setup ${price('local-visibility')}, care $${care.price.amount}/month. Toronto and GTA.`;

const costs = [...new Set(packages.flatMap((p) => p.thirdParty).filter((c) => !c.startsWith('Everything in')))];

const affects = [
  { t: 'Pages beyond the boundary', d: 'Website Launch covers up to five pages. More pages, or pages that need new writing, are quoted in writing on top.' },
  { t: 'What you supply', d: 'Ready text and real photos keep the price at the boundary. Writing from scratch or arranging photos adds time.' },
  { t: 'Your tools', d: 'A booking tool or phone set-up that connects easily is quicker than one that needs a workaround, or can’t connect at all.' },
  { t: 'The state of what exists', d: 'An old profile with duplicates, or a site with broken forms, can need clean-up before the new work starts.' },
];

const questions = [
  {
    q: 'Is the free check really free?',
    a: 'Yes, with no obligation. You get a written list of fixes, most important first. If you want them done, I quote them separately.',
  },
  {
    q: 'Are these the final prices?',
    a: 'Yes, for the scope written on each package. Your written scope lists the deliverables, exclusions, price and timing before any work starts, and that is what we agree. Prices are in Canadian dollars, plus applicable tax.',
  },
  {
    q: 'How do payments work?',
    a: 'For a website, half at kickoff and half once the site passes the launch checks agreed in your scope. A Website Fix is paid once the agreed test passes. Website Care is billed monthly.',
  },
  {
    q: 'Do I own the website?',
    a: 'Yes. The domain, hosting, Google accounts and files are in your name from the start. At handover you get the site, a short editing guide, every login and renewal date, and the test results.',
  },
  {
    q: 'What if I want something outside the scope?',
    a: 'I tell you what it costs first. Anything outside the written scope is quoted, and agreed in writing, before it starts.',
  },
  {
    q: 'Who pays for the domain, hosting and tools?',
    a: 'You do, directly to each provider and in your name, so you keep them whatever happens. They are listed in your scope before you decide.',
  },
  {
    q: 'Can I stop Website Care?',
    a: 'Any month. You keep the site, the change log and every login, and my access is removed.',
  },
];

const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing/' },
]);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Web Design & Local SEO Pricing in Toronto"
  description={description}
  noindex={!pricesPublished}
  jsonLd={[faqLd, ...(crumbs ? [crumbs] : [])]}
>
  <PageHead
    eyebrow="Pricing"
    lines={['What it costs,', '<span class="accent accent--signal">and what it covers.</span>']}
    lead="Five offers for small businesses in Toronto and the GTA, each with a published price and a clear boundary, plus a free check if you’re not sure where to start. All prices in Canadian dollars, plus applicable tax."
  />

  <section class="section section--rule" aria-labelledby="pr-packages">
    <div class="container stack" style="--stack: var(--s-6)">
      <h2 id="pr-packages" class="visually-hidden">Packages</h2>
      <!-- 14 Nov 2026: the free check is the sixth tile, so the offers sit in a tidy grid (3 × 2 on
           desktop, 2 × 3 on tablets) instead of three cards, two wider cards and a banner. -->
      <ol class="pr__grid" role="list">
        {packages.map((p, i) => <PackageCard pkg={p} index={i} level={3} />)}
        <li class="pr__free" id="pkg-check-up">
          <p class="eyebrow">Not sure yet?</p>
          <h3 class="pr__free-name">{checkUp.name}</h3>
          <p class="pr__free-cost">
            <span class="pr__free-price">Free</span>
            <span class="pr__free-terms">No obligation to buy anything</span>
          </p>
          <p class="pr__free-boundary">{checkUp.boundary}</p>
          <ul class="pr__free-list" role="list">
            {
              checkUp.includes.map((d) => (
                <li>
                  <Icon name="check" />
                  <span>{d}</span>
                </li>
              ))
            }
          </ul>
          <p class="small subtle">Not included: {checkUp.notIncluded[0].charAt(0).toLowerCase() + checkUp.notIncluded[0].slice(1)}.</p>
          <div class="pr__free-cta">
            <Button href="/contact/?package=check-up#check" variant="ghost" size="sm">Request the free check</Button>
          </div>
        </li>
      </ol>
      <PackageCompare id="pr-compare" title="Side by side" level={2} />
    </div>
  </section>


  <section class="section section--alt" aria-labelledby="pr-example">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">Example</p>
        <h2 id="pr-example" class="pr__h2">A salon website <span class="accent">for $1,950.</span></h2>
        <p class="muted">What Website Launch looks like for a neighbourhood salon, similar to the <a class="link" href="/work/samp-hair-spa/">Samp Hair &amp; Spa preview</a>: affordable web design in Toronto, with the price and the boundary written down before you start.</p>
      </div>
      <dl class="pr__affects">
        <div><dt>Pages</dt><dd>Home, Services and Pricing, About, Gallery and Contact.</dd></div>
        <div><dt>You provide</dt><dd>Your current service menu, approved photos, opening hours and account access.</dd></div>
        <div><dt>The booking step</dt><dd>The site sends one enquiry to your inbox, or takes visitors to your existing booking link. A connected booking workflow is the $3,350 package.</dd></div>
        <div><dt>Signed off when</dt><dd>The service menu reads well on a phone, the booking destination or a test enquiry works, and you have had a short walkthrough of how to edit it.</dd></div>
        <div><dt>Payment</dt><dd>$975 at kickoff and $975 once the site passes those checks, plus applicable tax.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="pr-affects">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">How the price is set</p>
        <h2 id="pr-affects" class="pr__h2">What moves it <span class="accent">up or down.</span></h2>
      </div>
      <dl class="pr__affects">
        {
          affects.map((a) => (
            <div>
              <dt>{a.t}</dt>
              <dd>{a.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="pr-costs">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">Paid to other providers</p>
        <h2 id="pr-costs" class="pr__h2">Billed to you, <span class="accent">in your name.</span></h2>
        <p class="muted">Each provider bills you directly, at their own prices, so the accounts stay yours.</p>
      </div>
      <ul class="pr__costs" role="list">
        {
          costs.map((c) => (
            <li>
              <Icon name="arrow" />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="pr-faq">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">Buying questions</p>
        <h2 id="pr-faq" class="pr__h2">Before you <span class="accent">decide.</span></h2>
      </div>
      <div>
        {
          questions.map((f) => (
            <details class="acc" name="pr-faq">
              <summary>
                <span>{f.q}</span>
                <span class="acc__plus" aria-hidden="true" />
              </summary>
              <div class="acc__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pr__grid {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 48em) {
    .pr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 72em) {
    /* Five offers and the free check: three equal columns, two equal rows. */
    .pr__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pr__free {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px dashed var(--control);
    border-radius: var(--r-lg);
  }
  .pr__free-name {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .pr__free-cost {
    display: grid;
    gap: 0.15rem;
  }
  .pr__free-price {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--signal);
  }
  .pr__free-terms {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .pr__free-boundary {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text);
  }
  .pr__free-list {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .pr__free-list li {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
  }
  .pr__free-list :global(.icon) {
    flex: none;
    margin-top: 0.2em;
    color: var(--signal);
  }
  .pr__free-cta {
    margin-top: auto;
    padding-top: var(--s-2);
  }
  .pr__h2 {
    font-size: var(--fs-h2);
    max-width: 20ch;
  }
  .pr__split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .pr__split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
  }
  .pr__affects {
    display: grid;
    gap: var(--s-5);
  }
  .pr__affects div {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .pr__affects dt {
    font-weight: 600;
  }
  .pr__affects dd {
    color: var(--text-2);
  }
  .pr__costs {
    display: grid;
    gap: var(--s-3);
  }
  .pr__costs li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .pr__costs :global(.icon) {
    flex: none;
    margin-top: 0.2em;
    color: var(--signal);
  }
</style>
