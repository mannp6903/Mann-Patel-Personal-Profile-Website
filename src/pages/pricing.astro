---
/**
 * Pricing (published 14 Nov 2026). Every number and boundary comes from src/data/packages.ts.
 * If every price is set back to null (`pricesPublished` false), this page leaves search and the menus.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
import PackageCompare from '../components/packages/PackageCompare.astro';
import { packages, pricesPublished, packageById, priceLabel } from '../data/packages';
import { servicePages } from '../data/service-pages';
import ReviewsStrip from '../components/ReviewsStrip.astro';
import { cta } from '../data/site';
import { breadcrumbJsonLd } from '../lib/seo';
import { visibleGuides } from '../lib/published';

// SEO audit copy (14 Nov 2026, 146 characters). Every number comes from src/data/packages.ts.
const price = (id: string) => priceLabel(packageById(id)!).text;
const care = packageById('care')!;
const description = `Published prices in CAD: 5-page website ${price('website-launch')}, website + booking ${price('website-enquiry')}, fixes ${price('website-fix')}, local SEO setup ${price('local-visibility')}, care $${care.price.amount}/month. Toronto and GTA.`;

// SEO audit Phase 3 (14 Nov 2026): the cost guide links here; this page links back once it is published.
const costGuide = (await visibleGuides()).find((g) => g.id === 'how-much-does-a-website-cost-in-toronto');

const costs = [...new Set(packages.flatMap((p) => p.thirdParty).filter((c) => !c.startsWith('Everything in')))];

// 23 Nov 2026 (SEO audit copy deck §2.7): four questions; ownership is answered on Home, Website Care's terms on its page.
const questions = [
  {
    q: 'Are these the final prices?',
    a: 'Yes, for the scope written on each package. Your written scope lists the deliverables, exclusions, price and timing before any work starts, and that is what we agree. Prices are in Canadian dollars, plus applicable tax.',
  },
  {
    q: 'How do payments work?',
    a: 'For a website, half at kickoff and half once the site passes the launch checks agreed in your scope. A Website Fix is paid once the agreed test passes. Website Care is billed monthly.',
  },
  {
    q: 'What if I want something outside the scope?',
    a: 'I tell you what it costs first. Anything outside the written scope is quoted, and agreed in writing, before it starts.',
  },
  {
    q: 'Is the free check really free?',
    a: 'Yes, with no obligation. You get a written list of fixes, most important first. If you want them done, I quote them separately.',
  },
];

const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing/' },
]);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={`Website Design Prices in Toronto, from ${price('website-launch')}`}
  description={description}
  noindex={!pricesPublished}
  jsonLd={[faqLd, ...(crumbs ? [crumbs] : [])]}
>
  {/* 23 Nov 2026 (SEO audit copy deck §2.7; intro from the audit's §C5): one table, three short service cards, what other
      providers bill, four questions. The long package cards above the table repeated it word for word and are gone. */}
  <PageHead
    lines={['Website and Google listing', '<span class="accent">prices, in CAD</span><span class="stop">.</span>']}
    lead="Every price here is fixed and in Canadian dollars, plus tax. If something isn’t in a package, I quote it in writing before I start. Domain, hosting and booking tools are billed to you directly, in your name."
  >
    <div class="btn-row" data-reveal="load" style="--d:5">
      <Button href={cta.checkHref}>{cta.check}</Button>
      <a class="link-arrow" href={cta.briefHref}>{cta.brief} <Icon name="arrow" /></a>
    </div>
  </PageHead>

  <section class="section section--rule" aria-labelledby="pr-compare">
    <div class="container">
      <PackageCompare id="pr-compare" title="Every package, side by side" level={2} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="pr-services">
    <div class="container stack" style="--stack: var(--s-6)">
      <h2 id="pr-services" class="pr__h2">What each service is for</h2>
      <ul class="pr__cards" role="list">
        {
          servicePages.map((sp) => (
            <li>
              <a class="pr__card" href={`/services/${sp.slug}/`}>
                <span class="pr__card-name">{sp.name}</span>
                <span class="muted small">{sp.card}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Real client reviews only (src/data/reviews.ts); renders nothing until there are some. -->
  <ReviewsStrip />

  <section class="section" aria-labelledby="pr-costs">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <h2 id="pr-costs" class="pr__h2">Billed to you, in your name</h2>
        <p class="muted">Each provider bills you directly, at their own prices, so the accounts stay yours.</p>
      </div>
      <ul class="pr__costs" role="list">
        {
          costs.map((c) => (
            <li>
              <Icon name="arrow" />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="pr-faq">
    <div class="container pr__split">
      <div class="stack" style="--stack: var(--s-4)">
        <h2 id="pr-faq" class="pr__h2">Questions</h2>
        {
          costGuide && (
            <a class="link-arrow" href={`/guides/${costGuide.id}/`}>
              Guide: {costGuide.data.title} <Icon name="arrow" />
            </a>
          )
        }
      </div>
      <div>
        {
          questions.map((f) => (
            <details class="acc" name="pr-faq">
              <summary>
                <h3 class="acc__q">{f.q}</h3>
                <span class="acc__plus" aria-hidden="true" />
              </summary>
              <div class="acc__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 23 Nov 2026 audit (copy deck §2.7): three short cards, each linking to its service page. */
  .pr__cards {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 56em) {
    .pr__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pr__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2) var(--s-4);
    height: 100%;
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
  }
  .pr__card:hover,
  .pr__card:focus-visible {
    border-color: var(--control);
  }
  .pr__card > .small {
    grid-column: 1;
  }
  .pr__card :global(.icon) {
    grid-column: 2;
    grid-row: 1;
    color: var(--signal);
  }
  .pr__card-name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--track-head);
    line-height: 1.15;
  }
  
  
  @media (min-width: 72em) {
    /* Five offers and the free check: three equal columns, two equal rows. */
    
  }
  .pr__h2 {
    font-size: var(--fs-h2);
    max-width: 20ch;
  }
  .pr__split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .pr__split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    /* The head stays beside its content instead of leaving an empty column (gate L1, re-audit 18 Nov 2026; as on Home,
       task 3.4). */
    .pr__split > :first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
  .pr__costs {
    display: grid;
    gap: var(--s-3);
  }
  .pr__costs li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  .pr__costs :global(.icon) {
    flex: none;
    margin-top: 0.2em;
    color: var(--signal);
  }
</style>
