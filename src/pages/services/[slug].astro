---
/**
 * Focused service pages (round 10): /services/web-design/, /services/local-visibility/,
 * /services/enquiry-follow-up/. Content: src/data/service-pages.ts. Packages and prices:
 * src/data/packages.ts. The overview at /services/ (and its #anchors) is unchanged.
 */
import { accentLine } from '../../lib/headline';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Heading from '../../components/ui/Heading.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import DemoLine from '../../components/DemoLine.astro';
import MissedCallCalculator from '../../components/MissedCallCalculator.astro';
import ReviewsStrip from '../../components/ReviewsStrip.astro';
import { cta } from '../../data/site';
import { servicePages, moreServicePages, type ServicePage } from '../../data/service-pages';
import CheckBanner from '../../components/CheckBanner.astro';
import { packageById, priceLabel, type Package } from '../../data/packages';
import { absoluteUrl } from '../../lib/mode';
import { breadcrumbJsonLd, businessRef, packageOffer, videoJsonLd } from '../../lib/seo';
import { videos, videoLength } from '../../data/videos';
import { projectSite } from '../../lib/work';
import { industryPages } from '../../data/industry-pages';
import { visibleGuides } from '../../lib/published';

export function getStaticPaths() {
  // The three main services, plus Website Care and AI search optimization (SEO audit Phase 4, 14 Nov 2026).
  return [...servicePages, ...moreServicePages].map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: ServicePage;
}
const { page } = Astro.props;
const pkgs = page.packages.map((id) => packageById(id)).filter(Boolean) as Package[];
const main = pkgs[0];
const work = (await getCollection('work')).filter((w) => page.work.includes(w.id)).sort((a, b) => a.data.order - b.data.order);
const others = servicePages.filter((p) => p.slug !== page.slug);
// SEO audit Phase 3 (14 Nov 2026): the industry pages that need this service, its guides (once published) and
// the Scarborough page (once published) are linked from here.
const industries = industryPages.filter((ip) => (ip.services as readonly string[]).includes(page.slug));
const guides = (await visibleGuides()).filter((g) => g.data.service === `/services/${page.slug}/`);
const path = `/services/${page.slug}/`;
const url = absoluteUrl(path);

const lines = page.lines.map((l, i) => (i === page.lines.length - 1 ? accentLine(l) : l));

// Structured data matches what the page shows: no price unless one is approved and shown.
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  description: page.description,
  serviceType: page.short,
  ...(url ? { url } : {}),
  // The business (ProfessionalService "Mann Patel", full node on / and /contact/), founded by Mann.
  provider: businessRef(),
  areaServed: [
    { '@type': 'City', name: 'Toronto' },
    { '@type': 'AdministrativeArea', name: 'Greater Toronto Area' },
  ],
  // Prices from src/data/packages.ts through one helper (src/lib/seo.ts → offerPrice): a range stays a range
  // (Website Fix, $450–$850) and a monthly plan says so (Website Care, $149 a month).
  ...(pkgs.some((p) => p.price.amount !== null) ? { offers: pkgs.filter((p) => p.price.amount !== null).map(packageOffer) } : {}),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: page.short, path },
]);
// SEO report follow-up (19 Nov 2026): demo videos, each with its transcript, only while src/data/videos.ts has some.
const shownVideos = page.proof ? videos : [];
const videoLd = shownVideos.map(videoJsonLd);
---

<BaseLayout title={page.title} description={page.description} jsonLd={[serviceLd, faqLd, ...videoLd, ...(crumbs ? [crumbs] : [])]}>
  <nav class="crumbs container" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="/services/">Services</a></li>
      <li aria-current="page">{page.short}</li>
    </ol>
  </nav>

  <PageHead lines={lines} lead={page.lead} compact>
    <div class="sp__actions" data-reveal="load" style="--d:5">
      <div class="btn-row">
        <Button href={cta.checkHref}>{cta.check}</Button>
        <a class="link-arrow" href={`/contact/?package=${main.id}#brief`}>{page.ask} <Icon name="arrow" /></a>
      </div>
      {
        work.length > 0 && (
          <p class="sp__local small" data-local>
            Examples:{' '}
            {work.map((w, i) => (
              <>
                {i > 0 && ' · '}
                <a class="link" href={`/work/${w.id}/`}>{w.data.title}</a> ({w.data.relationship.toLowerCase()})
              </>
            ))}
          </p>
        )
      }
    </div>
  </PageHead>

  <section class="section section--rule" aria-labelledby="fit-title">
    <div class="container sp__split">
      <h2 id="fit-title" class="sp__h2">Who it’s for</h2>
      <ul class="sp__list" role="list">
        {
          page.forWho.map((f) => (
            <li>
              <Icon name="check" />
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="what-you-get" aria-labelledby="get-title">
    <div class="container sp__split">
      <h2 id="get-title" class="sp__h2">{page.getTitle ?? `What you get for ${priceLabel(main).text}`}</h2>
      <div class="stack" style="--stack: var(--s-5)">
        {page.getTitle && main.price.amount !== null && !page.getTitle.includes(priceLabel(main).text) && (
          <p class="sp__price" data-price>{main.name}: {priceLabel(main).text}, fixed, CAD plus tax.</p>
        )}
        <ul class="sp__list" role="list">
          {
            page.get.map((g) => (
              <li>
                <Icon name="check" />
                <span>{g}</span>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow" href="/pricing/#pr-compare">What’s not included, and what other providers bill you <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="how-title">
    <div class="container sp__split">
      <h2 id="how-title" class="sp__h2">How it works</h2>
      <ol class="sp__how" role="list">
        {
          page.how.map((step, i) => (
            <li>
              <span class="num sp__n">{i + 1}.</span> {step}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    page.next && (
      <section class="section section--rule" id="next" aria-labelledby="next-title">
        <div class="container sp__split">
          <h2 id="next-title" class="sp__h2">{page.next.title}</h2>
          <div class="stack" style="--stack: var(--s-4)">
            <p>{page.next.body}</p>
            {page.next.link && (
              <a class="link-arrow" href={page.next.link.href}>
                {page.next.link.label} <Icon name="arrow" />
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    page.proof && (
      <section class="section section--rule" id="calculator" aria-labelledby="calc-title">
        <div class="container sp__split">
          <div class="stack" style="--stack: var(--s-4)">
            <h2 id="calc-title" class="sp__h2">What missed calls may be worth</h2>
            <p class="muted">Four numbers from your own week. The result uses only what you type.</p>
            <DemoLine />
          </div>
          <MissedCallCalculator id="calc" />
        </div>
      </section>
    )
  }

  {
    shownVideos.length > 0 && (
      <section class="section section--rule" id="videos" aria-labelledby="videos-title">
        <div class="container stack" style="--stack: var(--s-6)">
          <div class="section-head">
            <h2 id="videos-title" class="sp__h2">Each workflow on a real screen</h2>
            <p class="muted">Short screen recordings with test data. Each transcript is below its video.</p>
          </div>
          <ul class="sp__videos" role="list">
            {shownVideos.map((v) => (
              <li class="sp__video">
                <h3>{v.title}</h3>
                <p class="muted small">
                  {v.description}
                  {videoLength(v.duration) && <span class="num"> · {videoLength(v.duration)}</span>}
                </p>
                <a class="link-arrow" href={v.url} rel="noopener">
                  Watch the video<span class="visually-hidden">: {v.title}</span> <Icon name="arrow" />
                </a>
                <div class="sp__transcript">
                  <h4>Transcript</h4>
                  <p>{v.transcript}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ReviewsStrip />

  <section class="section" aria-labelledby="sp-faq-title">
    <div class="container sp__split">
      <div class="stack" style="--stack: var(--s-4)">
        <h2 id="sp-faq-title" class="sp__h2">Questions</h2>
        {
          guides.map((g) => (
            <a class="link-arrow" href={`/guides/${g.id}/`}>
              Guide: {g.data.title} <Icon name="arrow" />
            </a>
          ))
        }
      </div>
      <div>
        {
          page.faqs.map((f) => (
            <details class="acc" name="sp-faq">
              <summary>
                <h3 class="acc__q">{f.q}</h3>
                <span class="acc__plus" aria-hidden="true" />
              </summary>
              <div class="acc__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
        {
          page.sources && (
            <p class="sp__sources small subtle">
              Sources:{' '}
              {page.sources.map((s, i) => (
                <>
                  {i > 0 && ' · '}
                  <a class="link" href={s.url} rel="noopener">
                    {s.label}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <nav class="section section--rule" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" class="eyebrow">More services</h2>
      <ul class="sp__more" role="list">
        {
          others.map((o) => (
            <li>
              <a class="sp__more-link" href={`/services/${o.slug}/`}>
                <span>{o.short}</span>
                <span class="muted small">{o.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        {
          industries.map((ip) => (
            <li>
              <a class="sp__more-link" href={`/${ip.slug}/`}>
                <span>{ip.linkLabel}</span>
                <span class="muted small">{ip.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="sp__more-link" href="/services/">
            <span>All services</span>
            <span class="muted small">All three services, the add-ons and the finder</span>
            <Icon name="arrow" />
          </a>
        </li>
      </ul>
    </div>
  </nav>

  {/* 23 Nov 2026 (copy deck rule 5): the free check in one line, on every service page. */}
  <CheckBanner />
</BaseLayout>

<style>
  .crumbs {
    padding-top: var(--s-5);
    font-size: var(--fs-label);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-3);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--control);
  }
  .crumbs a {
    color: var(--text-2);
  }
  .sp__actions {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .sp__price {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .sp__local {
    max-width: 60ch;
    color: var(--text-2);
  }
  .sp__h2 {
    font-size: var(--fs-h2);
    max-width: 20ch;
  }
  .sp__split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 64em) {
    .sp__split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-9);
    }
    /* The head stays beside its content instead of leaving an empty column (gate L1, re-audit 18 Nov 2026; as on Home,
       task 3.4). */
    .sp__split > :first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      align-self: start;
    }
  }
  .sp__list {
    display: grid;
    gap: var(--s-3);
  }
  .sp__list li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
  }
  /* Checklist lines and the intros above samples keep the body measure (gate T6, re-audit 18 Nov 2026: up to 92
     characters a line at 1280). */
  .sp__list li > span {
    max-width: var(--measure);
  }
  .sp__list :global(.icon) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2em;
    color: var(--signal);
  }
  /* "How it works": five short steps, numbered, one per line (copy deck §2.2). */
  .sp__how {
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-lead);
    font-weight: var(--w-ui);
  }
  .sp__how li {
    display: flex;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .sp__n {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .sp__sources {
    margin-top: var(--s-5);
  }
  .sp__videos {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 56em) {
    .sp__videos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .sp__video {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: clamp(var(--s-4), 2.5vw, var(--s-6));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  .sp__video h3 {
    font-size: var(--fs-h3);
  }
  .sp__transcript {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .sp__transcript h4 {
    font-size: var(--fs-ui);
    font-weight: var(--w-head);
    color: var(--text);
  }
  .sp__transcript p {
    max-width: var(--measure);
    white-space: pre-line;
  }
  .sp__more {
    display: grid;
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .sp__more li {
    border-bottom: 1px solid var(--line);
  }
  .sp__more-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem var(--s-4);
    padding-block: var(--s-4);
    text-decoration: none;
  }
  .sp__more-link > span:first-child {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: -0.02em;
  }
  .sp__more-link > .small {
    grid-column: 1;
  }
  .sp__more-link :global(.icon) {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--signal);
    transition: transform var(--dur-1) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sp__more-link:hover :global(.icon),
    .sp__more-link:focus-visible :global(.icon) {
      transform: translateX(4px);
    }
  }
</style>
