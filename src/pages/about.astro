---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ContactActions from '../components/ContactActions.astro';
import Field from '../components/fx/Field.astro';
import { profile, businesses, social } from '../data/site';
import { personJsonLd } from '../lib/seo';

const nest = businesses[0];
const links = social.filter((s) => s.url);
const principles = [
  {
    title: 'Plain language, written down.',
    text: 'Every proposal lists the deliverables, what you provide, what’s excluded and who pays any third-party fees. Technical terms come with a one-line explanation.',
  },
  {
    title: 'You own it.',
    text: 'Domains, accounts, files and logins are created in your name. I’m added as a user, not the owner, and removed at handover if you prefer.',
  },
  {
    title: 'Foundations first.',
    text: 'Launch a small, working version, check it with real enquiries, then improve, instead of a big project that never ships.',
  },
  {
    title: 'Honest about limits.',
    text: 'No guaranteed rankings, followers, leads or inbox placement. I’ll tell you what I control, what Google or Meta control, and what you’ll need to keep doing.',
  },
];
// Mann's story, in his words (confirmed for the site). Each chapter is tied to a place.
const chapters = [
  {
    place: 'Palana, Gujarat → Toronto',
    text: 'I grew up in Palana, a very small rural village in Gujarat, India. After immigrating to Canada, I studied computer programming at Seneca College and paid my way with low-wage jobs: first at Subway in North York, then as a security guard at the Pan Am Sports Centre in Scarborough.',
  },
  {
    place: 'Toronto → Saint John, NB',
    text: 'I failed C++ three times, and it pushed me into a very dark phase. I kept going and finished my studies, then moved to Saint John, New Brunswick, where I worked at a burrito restaurant and at a bubble tea shop in Rothesay.',
  },
  {
    place: 'Thunder Bay, ON',
    text: 'Next I moved back to Thunder Bay with no job lined up. I worked at Dairy Queen, then got a job as a housekeeper at a casino. That winter I fell into depression. I lost the job after missing shifts while I was unwell, and for about six months after that I was in a very bad place.',
  },
  {
    place: 'North York',
    text: 'I moved back to North York and struggled to find work. I took jobs at a few gas stations, but none of them lasted long. Slowly I came out of the depression and started learning new skills.',
  },
  {
    place: 'Today',
    text: 'Today I work overnight at Walmart Canada, with a second role as a modular associate. I was trained on power equipment within my first 45 days, and I’ve been trusted as acting lead for the dairy and frozen department. I still learn something new every day.',
  },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'AboutPage', mainEntity: personJsonLd() };
---

<BaseLayout
  title="About"
  description="Mann Patel’s story, from Palana in Gujarat to Toronto: founder of Nest & Rest Cleaning, helping small businesses in Toronto and the GTA get found on Google, answer every enquiry and get booked."
  jsonLd={jsonLd}
>
  <header class="ab-head" data-field-zone>
    <Field preset="head" class="ab-field" />
    <div class="container ab-head__grid">
      <div class="ab-head__text">
        <p class="eyebrow">About</p>
        <Heading
          as="h1"
          class="ab-title"
          lines={['I’m Mann Patel.', 'I’m building a small business,', '<span class="serif serif--signal">and I help other owners with theirs.</span>']}
          load
        />
        <p class="lead" data-reveal="load" style="--d:200">
          I’m starting {nest.name}, a home-cleaning business in {nest.area}, which opens for bookings in summer 2027. I also
          help small-business owners in {profile.serviceArea} get found on Google, answer every enquiry, and turn website
          visits into bookings.
        </p>
        <div class="ab-reach" data-reveal="load" style="--d:300">
          <ContactActions label="Say hello" />
          {
            links.length > 0 && (
              <p class="ab-links">
                {links.map((s) => (
                  <a class="link-arrow" href={s.url!} rel="me noopener" data-contact={s.id}>
                    {s.label} <Icon name="arrow-ne" class="icon--ne" />
                  </a>
                ))}
              </p>
            )
          }
        </div>
      </div>
      {
        profile.portrait && (
          <figure class="ab-photo" data-reveal="load-media" style="--d:150">
            <Image
              src={profile.portrait.src}
              alt={profile.portrait.alt}
              widths={[360, 560, 800, 1060]}
              sizes="(min-width: 64em) 38vw, 92vw"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption class="num">
              <span>Mann Patel</span>
              <span>Toronto · 2026</span>
            </figcaption>
          </figure>
        )
      }
    </div>
  </header>

  <section class="section section--rule" aria-labelledby="story-title">
    <div class="container story">
      <div class="story__head">
        <p class="eyebrow">My story</p>
        <Heading id="story-title" lines={['Not a straight line.', '<span class="serif">Still going.</span>']} />
      </div>
      <ol class="chapters rail" role="list" aria-label="My story, in six chapters" data-rail>
        {
          chapters.map((c, i) => (
            <li class="chapter" data-reveal>
              <p class="chapter__place num">
                <span class="chapter__n">{String(i + 1).padStart(2, '0')}</span>
                {c.place}
              </p>
              <p class="chapter__text">{c.text}</p>
            </li>
          ))
        }
        <li class="chapter chapter--now" data-reveal>
          <p class="chapter__place num">
            <span class="chapter__n">06</span>
            {nest.name}
          </p>
          <p class="chapter__text text-links">
            I also built <a href={nest.url} rel="noopener">nestnrestcleaning.com</a> from scratch for my own home-cleaning business,
            {nest.name}. It starts taking clients in summer 2027, and I’ll clean every home myself.
          </p>
        </li>
      </ol>

      <div class="why" data-reveal>
        <h3 class="why__title">Why I do this</h3>
        <p>
          Building {nest.name} showed me how much the basics matter: a clear offer, a website people understand on their phone, a
          simple way to ask for a booking, and a habit of answering every message. Many owners are stuck with a page they can’t
          update, enquiries spread across DMs and voicemail, and no idea whether anyone finds them on Google. That’s the work I
          offer: help small businesses get found and chosen on Google, answer every enquiry, and turn website visits into
          bookings.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How I work</p>
        <Heading id="principles-title" lines={['Four', '<span class="serif">house rules.</span>']} />
      </div>
      <ol class="rules rail" role="list" aria-label="House rules" data-rail>
        {
          principles.map((p, i) => (
            <li data-reveal style={`--d:${i * 80}`}>
              <span class="rules__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="vision-title">
    <div class="container vision">
      <p class="eyebrow">Where I’m going</p>
      <Heading id="vision-title" lines={['Foundations done properly,', '<span class="serif">explained clearly.</span>']} />
      <p class="lead vision__lead" data-reveal data-scrub>
        My aim is to be the person Toronto’s small-business owners call when they want their Google presence, website and
        follow-up set up properly and explained in plain language, while I grow {nest.name} into a business that proves those
        foundations work.
      </p>
    </div>
  </section>

  <section class="section section--rule" id="businesses" aria-labelledby="biz-title">
    <div class="container biz">
      <div class="stack" style="--stack: var(--s-4)">
        <p class="eyebrow">My business</p>
        <h2 id="biz-title" class="biz__title">{nest.name}</h2>
        <p class="subtle small">{nest.role} · {nest.area}</p>
        <p class="muted biz__desc">{nest.description}</p>
      </div>
      <div class="btn-row">
        <Button href={nest.url} variant="ghost" icon="arrow-ne" rel="noopener">Visit {nest.name}</Button>
        <Button href="/work/nest-and-rest-cleaning/">Read the case study</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ab-head {
    overflow: clip;
    padding-block: clamp(var(--s-6), 6vw, var(--s-9)) var(--section);
  }
  /* Signal dots around the photo (behind the text column they fade out). */
  .ab-head :global(.ab-field) {
    --fx: 80%;
    --fy: 45%;
    --fw: 55%;
    --fh: 90%;
  }
  @media (max-width: 63.99em) {
    .ab-head :global(.ab-field) {
      --fx: 50%;
      --fy: 78%;
      --fw: 100%;
      --fh: 45%;
    }
  }
  .ab-head__grid {
    display: grid;
    gap: var(--s-7);
  }
  .ab-head__text {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .ab-head__text :global(.ab-title) {
    font-size: clamp(2.4rem, 1.5rem + 3.6vw, 5.25rem);
    max-width: 17ch;
  }
  .ab-reach {
    display: grid;
    gap: var(--s-4);
  }
  .ab-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }
  .ab-photo {
    display: grid;
    gap: var(--s-3);
  }
  .ab-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--r-lg);
  }
  .ab-photo figcaption {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }
  @media (min-width: 64em) {
    .ab-head__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
      gap: var(--s-9);
      align-items: end;
    }
  }

  .story {
    display: grid;
    gap: var(--s-7);
  }
  .chapters {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .chapter {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
  }
  .chapter__place {
    display: flex;
    gap: var(--s-3);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .chapter__n {
    color: var(--signal);
  }
  .chapter__text {
    overflow-wrap: anywhere;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.55;
    max-width: 58ch;
  }
  .chapter--now .chapter__text {
    color: var(--text);
  }
  .why {
    display: grid;
    gap: var(--s-4);
    max-width: 62ch;
    color: var(--text-2);
  }
  .why__title {
    color: var(--text);
  }
  @media (min-width: 64em) {
    .story {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: var(--s-9);
    }
    .story__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
      display: grid;
      gap: var(--s-5);
    }
    .chapter {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--s-6);
    }
    .why {
      grid-column: 2;
    }
  }
  .story__head {
    display: grid;
    gap: var(--s-5);
  }

  .rules {
    display: grid;
    gap: var(--s-6);
  }
  .rules li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .rules__n {
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.05em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--signal);
  }
  @media (min-width: 48em) {
    .rules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 80em) {
    .rules {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .vision {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .vision :global(h2) {
    max-width: 18ch;
  }
  .vision .lead {
    max-width: 56ch;
  }

  .biz {
    display: grid;
    gap: var(--s-6);
  }
  .biz__title {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4.75rem);
    font-weight: 760;
    font-stretch: 114%;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .biz__desc {
    max-width: 56ch;
  }
  @media (min-width: 64em) {
    .biz {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* Phones: the story and the rules become swipeable cards, so the page reads in a few screens. */
  @media (max-width: 47.99em) {
    .ab-head__grid {
      gap: var(--s-6);
    }
    .ab-photo :global(img) {
      aspect-ratio: 4 / 3;
      object-position: 50% 22%;
    }
    .story {
      gap: var(--s-6);
    }
    .chapters {
      border-top: 0;
    }
    .chapter {
      align-content: start;
      padding: var(--s-5);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--surface);
    }
    .chapter__text {
      font-size: 1rem;
      overflow-wrap: break-word;
    }
    .rules li {
      padding: var(--s-5);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--surface);
    }
    .rules__n {
      font-size: 2rem;
    }
  }
</style>
